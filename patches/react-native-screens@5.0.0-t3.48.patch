+- (void)applyControlFont
+{
+  NSNumber *size = _configDataProvider.controlFontSize;
+  if (size == nil) {
+    return;
+  }
+  UIFont *font = [UIFont systemFontOfSize:size.doubleValue];
+  for (NSArray<UIBarButtonItem *> *items in @[_leadingBarButtonItems, _trailingBarButtonItems, _toolbarBarButtonItems]) {
+    for (UIBarButtonItem *item in items) {
+      NSMutableDictionary *attributes = [[item titleTextAttributesForState:UIControlStateNormal] mutableCopy];
+      if (attributes == nil) {
+        attributes = [NSMutableDictionary new];
+      }
+      attributes[NSFontAttributeName] = font;
+      [item setTitleTextAttributes:attributes forState:UIControlStateNormal];
+    }
+  }
+}
