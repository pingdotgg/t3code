+- (void)findTargetBeforeEachCommitIn:(UIWindow *)window API_AVAILABLE(ios(18.0))
+{
+  if (_target != nil) {
+    return;
+  }
+  __weak RNSModalDismissalMove *weakSelf = self;
+  __weak UIWindow *weakWindow = window;
+  _commitLink = [UIUpdateLink updateLinkForView:window];
+  [_commitLink addActionToPhase:UIUpdateActionPhase.beforeCATransactionCommit
+                        handler:^(UIUpdateLink *updateLink, UIUpdateInfo *updateInfo) {
+                          [weakWindow layoutIfNeeded];
+                          [weakSelf findTarget];
+                        }];
+  _commitLink.enabled = YES;
+}
+
+- (BOOL)findTarget
+{
+  if (_target != nil) {
+    return YES;
+  }
+  UIView *root = _root;
+  UIView *target = root == nil ? nil : RNSFindViewWithNativeId(root, _nativeId);
+  if (target == nil) {
+    return NO;
+  }
+  UIView *revealed = target;
+  for (UIResponder *responder = target; responder != nil; responder = responder.nextResponder) {
+    if ([responder isKindOfClass:UIViewController.class]) {
+      revealed = static_cast<UIViewController *>(responder).navigationController.view ?: target;
+      break;
+    }
+  }
+  _target = target;
+  _revealed = revealed.layer;
+  RNSAnimateOpacity(_revealed, 0, 0, RNSModalDismissalTimeout + RNSModalDismissalFadeDuration);
+  if (@available(iOS 18.0, *)) {
+    _commitLink.enabled = NO;
+  }
+  return YES;
+}
+
+- (void)step:(CADisplayLink *)link
+{
+  const CFTimeInterval now = CACurrentMediaTime();
+  if (_target != nil && _target.window == nil) {
+    [_revealed removeAnimationForKey:RNSModalDismissalFadeKey];
+    [self finish:link];
+    return;
+  }
+  if (_fadeStart > 0 && now >= _fadeStart + RNSModalDismissalFadeDuration) {
+    [self finish:link];
+    return;
+  }
+  if ([self findTarget]) {
+    const CGRect targetFrame = [_target convertRect:_target.bounds toView:_snapshot.superview];
+    // A column resizing into place only passes through its other widths, so the snapshot takes the target's width once
+    // the target holds still.
+    if (!CGRectEqualToRect(targetFrame, _targetFrame)) {
+      _targetFrame = targetFrame;
+      _stillSince = now;
+      _moveStart = _moveStart ?: now;
+      [self moveSnapshotTo:targetFrame.origin];
+    } else if (_scale != CGRectGetWidth(targetFrame) / _size.width) {
+      _scale = CGRectGetWidth(targetFrame) / _size.width;
+      [self moveSnapshotTo:targetFrame.origin];
+    }
+    if (_modalView.window != nil) {
+      _stillSince = now;
+    }
+  }
+  const BOOL settled = _moveStart > 0 &&
+      now - _moveStart >= RNSModalDismissalMoveDuration - RNSModalDismissalFadeDuration &&
+      now - _stillSince >= RNSModalDismissalSettleDuration;
+  if (_fadeStart == 0 && (settled || now - _start >= RNSModalDismissalTimeout)) {
+    _fadeStart = now;
+    _snapshot.layer.opacity = 0;
+    RNSAnimateOpacity(_snapshot.layer, 1, 0, RNSModalDismissalFadeDuration);
+    RNSAnimateOpacity(_revealed, 0, _revealed.opacity, RNSModalDismissalFadeDuration);
+  }
+}
+
+/**
+ * Core Animation runs the move, so it stays smooth while the main thread lays out the new posture. UIKit adds each
+ * retargeted animation to the ones in flight, so following a moving target keeps the snapshot's momentum.
+ */
+- (void)moveSnapshotTo:(CGPoint)origin
+{
+  UIView *snapshot = _snapshot;
+  const CGFloat scale = _scale;
+  [UIView animateWithDuration:RNSModalDismissalMoveDuration
+                        delay:0
+       usingSpringWithDamping:1
+        initialSpringVelocity:0
+                      options:0
+                   animations:^{
+                     snapshot.transform = CGAffineTransformMakeScale(scale, scale);
+                     snapshot.layer.position = origin;
+                   }
+                   completion:nil];
+}
+
+- (void)finish:(CADisplayLink *)link
+{
+  if (@available(iOS 18.0, *)) {
+    _commitLink.enabled = NO;
+  }
+  [_snapshot removeFromSuperview];
+  // Releases the move, so nothing may touch it afterwards.
+  [link invalidate];
+}
