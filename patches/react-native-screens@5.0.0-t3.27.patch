@@ -0,0 +1,26 @@
+package com.swmansion.rnscreens.core.modals.formsheet
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class FormSheetWidthTest {
+    @Test
+    fun compactWindowsRemainEdgeToEdge() {
+        assertEquals(412, FormSheetWidth.resolve(412, 1f))
+        assertEquals(1198, FormSheetWidth.resolve(1198, 2f))
+    }
+
+    @Test
+    fun wideWindowsUseGuttersBeforeReachingMaximumWidth() {
+        assertEquals(568, FormSheetWidth.resolve(600, 1f))
+        assertEquals(1136, FormSheetWidth.resolve(1200, 2f))
+        assertEquals(640, FormSheetWidth.resolve(800, 1f))
+        assertEquals(1280, FormSheetWidth.resolve(1600, 2f))
+    }
+
+    @Test
+    fun resizingAcrossFoldedAndUnfoldedWidthsRecomputesFromTheCurrentWindow() {
+        val widths = listOf(840, 412, 650, 840)
+        assertEquals(listOf(640, 412, 618, 640), widths.map { FormSheetWidth.resolve(it, 1f) })
+    }
+}
