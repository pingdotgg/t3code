+    if (preferredWidth >= 0 && preferredWidth < 1) {
+      splitHostController.preferredPrimaryColumnWidthFraction = preferredWidth;
+    } else if (preferredWidth >= 1) {
+      splitHostController.preferredPrimaryColumnWidth = preferredWidth;
+    }
+    return;
+  }
