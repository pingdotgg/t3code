+  _primaryColumnMinimumWidth = provider.minimumPrimaryColumnWidth;
+  _primaryColumnMaximumWidth = provider.maximumPrimaryColumnWidth;
+  UIView *view = splitHostController.viewIfLoaded;
+  const CGFloat containerWidth = view.bounds.size.width;
+  const BOOL keepsContainerWidth = containerWidth == _primaryColumnContainerWidth;
+  _primaryColumnContainerWidth = containerWidth;
