+static const CFTimeInterval RNSModalDismissalMoveDuration = 0.4;
+static const CFTimeInterval RNSModalDismissalFadeDuration = 0.2;
+static const CFTimeInterval RNSModalDismissalSettleDuration = 0.1;
+static const CFTimeInterval RNSModalDismissalTimeout = 1;
+static NSString *const RNSModalDismissalFadeKey = @"rnsModalDismissalFade";
+
+static UIView *_Nullable RNSFindViewWithNativeId(UIView *view, NSString *nativeId)
+{
+  if ([view isKindOfClass:RCTViewComponentView.class] &&
+      [static_cast<RCTViewComponentView *>(view).nativeId isEqualToString:nativeId]) {
+    return view;
+  }
+  for (UIView *subview in view.subviews) {
+    UIView *match = RNSFindViewWithNativeId(subview, nativeId);
+    if (match != nil) {
+      return match;
+    }
+  }
+  return nil;
+}
+
+/**
+ * Explicit animations, because Fabric and UIKit write the model opacity of the revealed view during the layout changes
+ * this move covers.
+ */
+static void RNSAnimateOpacity(CALayer *layer, float from, float to, CFTimeInterval duration)
+{
+  CABasicAnimation *animation = [CABasicAnimation animationWithKeyPath:@"opacity"];
+  animation.fromValue = @(from);
+  animation.toValue = @(to);
+  animation.duration = duration;
+  animation.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
+  [layer addAnimation:animation forKey:RNSModalDismissalFadeKey];
+}
