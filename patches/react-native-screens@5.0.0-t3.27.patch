++ (void)moveModal:(UIViewController *)modal ontoViewWithNativeId:(NSString *)nativeId within:(UIView *)root
+{
+  UIView *modalView = modal.presentationController.presentedView ?: modal.view;
+  UIWindow *window = root.window;
+  if (window == nil || modalView.window != window || modalView.hidden || UIAccessibilityIsReduceMotionEnabled()) {
+    return;
+  }
+  UIView *snapshot = [modalView snapshotViewAfterScreenUpdates:NO];
+  if (snapshot == nil) {
+    return;
+  }
+  const CGRect from = [modalView convertRect:modalView.bounds toView:window];
+  RNSModalDismissalMove *move = [RNSModalDismissalMove new];
+  move->_snapshot = snapshot;
+  move->_modalView = modalView;
+  move->_root = root;
+  move->_nativeId = nativeId;
+  move->_size = from.size;
+  move->_scale = 1;
+  move->_targetFrame = CGRectNull;
+  move->_start = CACurrentMediaTime();
+  // Scaling about the corner keeps the snapshot's edge on its way to the target's while its size changes.
+  snapshot.layer.anchorPoint = CGPointZero;
+  snapshot.frame = from;
+  [window addSubview:snapshot];
+  modalView.hidden = YES;
+  [move findTarget];
+  if (@available(iOS 18.0, *)) {
+    [move findTargetBeforeEachCommitIn:window];
+  }
+  UIView *container = modal.presentationController.containerView;
+  [UIView animateWithDuration:RNSModalDismissalFadeDuration
+                   animations:^{
+                     container.alpha = 0;
+                   }];
