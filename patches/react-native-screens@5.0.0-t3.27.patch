+  CADisplayLink *link = [CADisplayLink displayLinkWithTarget:move selector:@selector(step:)];
+  [link addToRunLoop:NSRunLoop.mainRunLoop forMode:NSRunLoopCommonModes];
+}
+
+/**
+ * The target can attach while a commit lays it out, and with the main thread busy the display link may only run again
+ * after that commit has shown it.
