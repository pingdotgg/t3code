+package com.swmansion.rnscreens.core.modals.formsheet
+
+import kotlin.math.roundToInt
+
+/** Keep compact sheets edge-to-edge, with Material gutters and a readable width in wide windows. */
+internal object FormSheetWidth {
+    fun resolve(windowWidth: Int, density: Float): Int =
+        if (windowWidth / density < 600f) {
+            windowWidth
+        } else {
+            minOf((640f * density).roundToInt(), windowWidth - (32f * density).roundToInt())
+        }
+}
