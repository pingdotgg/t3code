diff --git a/android/src/main/java/expo/modules/video/player/ThumbnailHttpSource.kt b/android/src/main/java/expo/modules/video/player/ThumbnailHttpSource.kt
new file mode 100644
index 0000000000000000000000000000000000000000..617b002210e35819e774ae7f31ffddaa5ad43a91
--- /dev/null
+++ b/android/src/main/java/expo/modules/video/player/ThumbnailHttpSource.kt
@@ -0,0 +1,77 @@
+package expo.modules.video.player
+
+import android.media.MediaDataSource
+import android.net.Uri
+import androidx.media3.common.C
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.okhttp.OkHttpDataSource
+import okhttp3.Call
+import okhttp3.OkHttpClient
+import java.io.IOException
+
+private val thumbnailHttpClient = OkHttpClient()
+
+@UnstableApi
+internal class ThumbnailHttpSource(private val uri: Uri, headers: Map<String, String>) : MediaDataSource() {
+  private val callLock = Any()
+  private var canceled = false
+  private var activeCall: Call? = null
+  private val source = OkHttpDataSource.Factory { request ->
+    synchronized(callLock) {
+      thumbnailHttpClient.newCall(request).also { call ->
+        if (canceled) {
+          call.cancel()
+        } else {
+          activeCall = call
+        }
+      }
+    }
+  }.setDefaultRequestProperties(headers).createDataSource()
+
+  private var nextPosition = -1L
+  private var length: Long? = null
+
+  override fun getSize(): Long {
+    checkOpen()
+    if (length == null) openAt(0)
+    return length ?: C.LENGTH_UNSET.toLong()
+  }
+
+  override fun readAt(position: Long, buffer: ByteArray, offset: Int, size: Int): Int {
+    if (size == 0) return 0
+    checkOpen()
+    if (position != nextPosition) openAt(position)
+    val read = source.read(buffer, offset, size)
+    if (read > 0) nextPosition += read
+    return read
+  }
+
+  private fun openAt(position: Long) {
+    nextPosition = -1
+    source.close()
+    val remaining = source.open(DataSpec.Builder().setUri(uri).setPosition(position).build())
+    if (position == 0L) length = remaining
+    nextPosition = position
+  }
+
+  private fun checkOpen() {
+    synchronized(callLock) {
+      if (canceled) throw IOException("Thumbnail source was canceled")
+    }
+  }
+
+  // The player may be released while the framework is blocked inside readAt.
+  fun cancel() {
+    synchronized(callLock) {
+      canceled = true
+      activeCall?.cancel()
+      activeCall = null
+    }
+  }
+
+  override fun close() {
+    cancel()
+    source.close()
+  }
+}
