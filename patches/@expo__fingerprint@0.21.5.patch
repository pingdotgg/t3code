diff --git a/build/hash/PnpmPath.js b/build/hash/PnpmPath.js
new file mode 100644
--- /dev/null
+++ b/build/hash/PnpmPath.js
@@ -0,0 +1,33 @@
+"use strict";
+const fs = require("node:fs");
+const path = require("node:path");
+const { getNodeModulesPackageJsonPath } = require("../utils/Path");
+
+// pnpm's project virtual store and global virtual store encode install location,
+// peer resolution and store hashes outside the package. None is a native source ID.
+const PROJECT_STORE = /(?:^|\/)node_modules\/\.pnpm\/[^/]+\/$/;
+const GLOBAL_STORE = /(?:^|\/)v\d+\/links\/(?:@\/|@[^/]+\/)?[^/]+\/[^/]+\/[^/]+\/$/;
+
+function createPnpmPathNormalizer(projectRoot) {
+    const identities = new Map();
+    return (filePath)=>{
+        const marker = filePath.lastIndexOf('node_modules/');
+        if (marker === -1) return filePath;
+        const container = filePath.slice(0, marker);
+        if (!PROJECT_STORE.test(container) && !GLOBAL_STORE.test(container)) return filePath;
+        const packageJsonPath = getNodeModulesPackageJsonPath(filePath);
+        if (!packageJsonPath) return filePath;
+        const packageRoot = packageJsonPath.slice(0, -'/package.json'.length);
+        let identity = identities.get(packageRoot);
+        if (identity === undefined) {
+            const { name, version } = JSON.parse(fs.readFileSync(path.resolve(projectRoot, packageJsonPath), 'utf8'));
+            if (typeof name !== 'string' || !name || typeof version !== 'string' || !version) {
+                throw new Error(`Cannot fingerprint pnpm package without name and version: ${packageJsonPath}`);
+            }
+            identity = `node_modules/${name}@${version}`;
+            identities.set(packageRoot, identity);
+        }
+        return identity + filePath.slice(packageRoot.length);
+    };
+}
+module.exports = { createPnpmPathNormalizer };
