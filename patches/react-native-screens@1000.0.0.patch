++ (void)applyBackgroundFromDictionary:(nullable NSDictionary *)appearanceDict
+                        toAppearance:(nonnull UINavigationBarAppearance *)appearance
+{
+  UIColor *backgroundColor = [RCTConvert UIColor:appearanceDict[@"backgroundColor"]];
+  if (backgroundColor != nil) {
+    // Explicit transparent headers must also remove UIKit's default bar material.
+    if (CGColorGetAlpha(backgroundColor.CGColor) == 0) {
+      [appearance configureWithTransparentBackground];
+    } else {
+      [appearance configureWithOpaqueBackground];
+    }
+    appearance.backgroundColor = backgroundColor;
+  }
+  if (appearanceDict[@"shadowColor"] != nil) {
+    appearance.shadowColor = [RCTConvert UIColor:appearanceDict[@"shadowColor"]];
+  }
+}
