+
+// CJK and full-width punctuation (`，`, `。`, `（`) ends a URL the way whitespace does,
+// since CJK prose puts no space after a link. Symbols (`￥`, `＋`) and connectors (`＿`) stay part of the URL.
+function cjkPunctuation(code) {
+  return (
+    code !== null &&
+    ((code >= 0x3000 && code <= 0x303f) ||
+      (code >= 0xfe10 && code <= 0xfe1f) ||
+      (code >= 0xfe30 && code <= 0xfe6f) ||
