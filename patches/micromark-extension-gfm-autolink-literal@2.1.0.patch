--- a/dev/lib/syntax.js
+++ b/dev/lib/syntax.js
@@ -662,7 +662,8 @@ function tokenizePath(effects, ok) {
     if (
       code === codes.eof ||
       markdownLineEndingOrSpace(code) ||
-      unicodeWhitespace(code)
+      unicodeWhitespace(code) ||
+      cjkPunctuation(code)
     ) {
       return ok(code)
     }
@@ -762,7 +763,8 @@ function tokenizeTrail(effects, ok, nok) {
       // So is whitespace.
       code === codes.eof ||
       markdownLineEndingOrSpace(code) ||
-      unicodeWhitespace(code)
+      unicodeWhitespace(code) ||
+      cjkPunctuation(code)
     ) {
       return ok(code)
     }
@@ -791,7 +793,8 @@ function tokenizeTrail(effects, ok, nok) {
       code === codes.leftParenthesis ||
       code === codes.leftSquareBracket ||
       markdownLineEndingOrSpace(code) ||
-      unicodeWhitespace(code)
+      unicodeWhitespace(code) ||
+      cjkPunctuation(code)
     ) {
       return ok(code)
     }
@@ -981,3 +984,16 @@ function previousUnbalanced(events) {
 
   return result
 }
+
+// CJK and full-width punctuation (`，`, `。`, `（`) ends a URL the way whitespace does,
+// since CJK prose puts no space after a link.
+function cjkPunctuation(code) {
+  return (
+    code !== null &&
+    ((code >= 0x3000 && code <= 0x303f) ||
+      (code >= 0xfe10 && code <= 0xfe1f) ||
+      (code >= 0xfe30 && code <= 0xfe6f) ||
+      (code >= 0xff00 && code <= 0xffef)) &&
+    unicodePunctuation(code)
+  )
+}
