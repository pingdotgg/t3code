+  )
+}
+
+function cjkLetter(code) {
+  return (
+    code !== null &&
+    code > 0x7f &&
+    /[\p{sc=Han}\p{sc=Hiragana}\p{sc=Katakana}\p{sc=Hangul}]/u.test(String.fromCodePoint(code))
+  )
+}
