index 0d603caf9eeabe7b1374ca20bb2d02f191fb1a3d..8afb04be76ece82b7f278256776e14d9e0471319 100644
--- a/android/link.mjs
+++ b/android/link.mjs
@@ -1,12 +1,108 @@
+import fs from 'fs'
+import os from 'os'
 import path from 'path'
 import { fileURLToPath } from 'url'
 import link from 'bare-link'
 
 const __filename = fileURLToPath(import.meta.url)
+const packageRoot = path.resolve(path.join(__filename, '..', '..'))
 
-for await (const resource of link(path.join(__filename, '..', '..', '..', '..'), {
-  hosts: ['android-arm64', 'android-arm', 'android-ia32', 'android-x64'],
-  out: path.join(__filename, '..', 'src', 'main', 'addons')
-})) {
-  console.log('Wrote', resource)
+/**
+ * Classic installs resolve four parents up to the app root. pnpm's virtual
+ * store nests the package deeper, so walk upward (and check apps/mobile in a
+ * monorepo) for a package that declares Holepunch deps bare-link must vendor.
+ */
+function findAppPackage(start) {
+  let dir = start
+  for (let i = 0; i < 12; i++) {
+    for (const candidate of [dir, path.join(dir, 'apps', 'mobile')]) {
+      const pkgPath = path.join(candidate, 'package.json')
+      if (!fs.existsSync(pkgPath)) continue
+      try {
+        const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'))
+        const deps = {
+          ...pkg.dependencies,
+          ...pkg.optionalDependencies,
+          ...pkg.peerDependencies,
+          ...pkg.devDependencies
+        }
+        if (deps.hyperdht || deps['bare-tcp'] || deps['udx-native']) {
+          return { dir: candidate, pkg }
+        }
+      } catch {
+        // Keep walking.
+      }
+    }
+    const parent = path.dirname(dir)
+    if (parent === dir) break
+    dir = parent
+  }
+  return null
+}
+
+/**
+ * bare-link resolves dependencies by walking node_modules from each package
+ * directory. pnpm's symlink layout hides transitive addons (udx-native lives
+ * next to hyperdht in the virtual store, not under apps/mobile/node_modules).
+ * Stage against the flat `.pnpm/node_modules` hoist — same trick as the P2P
+ * worklet packer — so every Holepunch addon resolves as a sibling.
+ */
+function prepareLinkBase(app) {
+  const classic = path.resolve(path.join(__filename, '..', '..', '..', '..'))
+  if (app === null) return { base: classic, cleanup: () => {} }
+
+  let repoRoot = app.dir
+  for (let i = 0; i < 6; i++) {
+    if (fs.existsSync(path.join(repoRoot, 'pnpm-workspace.yaml'))) break
+    const parent = path.dirname(repoRoot)
+    if (parent === repoRoot) break
+    repoRoot = parent
+  }
+
+  const flatModules = path.join(repoRoot, 'node_modules', '.pnpm', 'node_modules')
+  if (!fs.existsSync(flatModules)) {
+    return { base: app.dir, cleanup: () => {} }
+  }
+
+  const stage = fs.mkdtempSync(path.join(os.tmpdir(), 't3-bare-link-'))
+  const deps = {
+    ...app.pkg.dependencies,
+    ...app.pkg.optionalDependencies
+  }
+  fs.writeFileSync(
+    path.join(stage, 'package.json'),
+    JSON.stringify(
+      {
+        name: 't3-bare-link-stage',
+        private: true,
+        dependencies: Object.fromEntries(
+          Object.entries(deps).filter(([name]) =>
+            /^(hyperdht|bare-tcp|udx-native|sodium-native)$/.test(name)
+          )
+        )
+      },
+      null,
+      2
+    )
+  )
+  fs.symlinkSync(flatModules, path.join(stage, 'node_modules'))
+  return {
+    base: stage,
+    cleanup: () => fs.rmSync(stage, { recursive: true, force: true })
+  }
+}
+
+const app = findAppPackage(path.dirname(packageRoot))
+const { base, cleanup } = prepareLinkBase(app)
+console.log(`[react-native-bare-kit] linking Android addons from ${base}`)
+
+try {
+  for await (const resource of link(base, {
+    hosts: ['android-arm64', 'android-arm', 'android-ia32', 'android-x64'],
+    out: path.join(__filename, '..', 'src', 'main', 'addons')
+  })) {
+    console.log('Wrote', resource)
+  }
+} finally {
+  cleanup()
 }
