+internal fun recordingInputs(manager: AudioManager): List<AudioDeviceInfo> {
+  val inputs = manager.getDevices(AudioManager.GET_DEVICES_INPUTS).filter {
+    recordingInputType(it.type) != null
+  }
+  val bluetooth = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
