@@ -0,0 +1,35 @@
+package expo.modules.audio
+
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.Assert.*
+import org.junit.Test
+
+class RecordingInputIdentityTest {
+  private fun device(id: Int) = mockk<AudioDeviceInfo> {
+    every { this@mockk.id } returns id
+    every { type } returns AudioDeviceInfo.TYPE_USB_DEVICE
+    every { productName } returns "USB Microphone"
+    every { address } returns "card=$id;device=0;"
+  }
+
+  @Test
+  fun identicalUsbMicrophonesRemainSelectable() {
+    val first = device(1)
+    val second = device(2)
+    val manager = mockk<AudioManager> {
+      every { getDevices(AudioManager.GET_DEVICES_INPUTS) } returns arrayOf(first, second)
+    }
+    val inputs = recordingInputs(manager)
+    assertEquals(2, inputs.size)
+    val firstUid = recordingInputUid(first, inputs)
+    val secondUid = recordingInputUid(second, inputs)
+    assertNotEquals(firstUid, secondUid)
+    assertSame(first, inputs.single { recordingInputUid(it, inputs) == firstUid })
+    assertSame(second, inputs.single { recordingInputUid(it, inputs) == secondUid })
+    val reconnected = device(99)
+    assertEquals(recordingInputUid(first, listOf(first)), recordingInputUid(reconnected, listOf(reconnected)))
+  }
+}
