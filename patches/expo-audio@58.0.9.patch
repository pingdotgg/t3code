+fun recordingInputs(manager: AudioManager): List<AudioDeviceInfo> {
+  val inputs = manager.getDevices(AudioManager.GET_DEVICES_INPUTS).filter {
+    recordingInputType(it.type) != null
+  }
+  val bluetooth = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+    manager.availableCommunicationDevices.filter { isBluetoothInput(it.type) }
+  } else {
+    emptyList()
+  }
+  // Some Bluetooth microphone ports appear only after the communication route is activated.
+  return (inputs + bluetooth).distinctBy {
+    if (isBluetoothInput(it.type)) recordingInputUid(it) else "port:${it.id}"
+  }
