@@ -0,0 +1,89 @@
+package expo.modules.audio
+
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.Assert.*
+import org.junit.Test
+
+class RecordingInputTest {
+  private fun device(type: Int, id: Int, address: String, name: String = "Headset", sink: Boolean = false) =
+    mockk<AudioDeviceInfo> {
+      every { this@mockk.type } returns type
+      every { this@mockk.id } returns id
+      every { this@mockk.address } returns address
+      every { productName } returns name
+      every { isSink } returns sink
+      every { isSource } returns !sink
+    }
+
+  @Test
+  fun microphoneTypesExcludePlaybackDevices() {
+    val types = mapOf(
+      AudioDeviceInfo.TYPE_BUILTIN_MIC to "MicrophoneBuiltIn",
+      AudioDeviceInfo.TYPE_WIRED_HEADSET to "MicrophoneWired",
+      AudioDeviceInfo.TYPE_USB_DEVICE to "USBAudio",
+      AudioDeviceInfo.TYPE_USB_HEADSET to "USBAudio",
+      AudioDeviceInfo.TYPE_BLUETOOTH_SCO to "BluetoothSCO",
+      AudioDeviceInfo.TYPE_BLE_HEADSET to "BluetoothLE",
+      AudioDeviceInfo.TYPE_HEARING_AID to "HearingAid"
+    )
+    for ((type, label) in types) assertEquals(label, recordingInputType(type))
+    assertNull(recordingInputType(AudioDeviceInfo.TYPE_BLUETOOTH_A2DP))
+    assertNull(recordingInputType(AudioDeviceInfo.TYPE_BUILTIN_SPEAKER))
+  }
+
+  @Test
+  fun preferenceSurvivesPortIdChanges() {
+    val first = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 10, "", "Buds")
+    val reconnected = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 99, "", "Buds")
+    val other = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 10, "", "Other buds")
+    assertEquals(recordingInputUid(first), recordingInputUid(reconnected))
+    assertNotEquals(recordingInputUid(first), recordingInputUid(other))
+  }
+
+  @Test
+  fun communicationRouteUsesMatchingOutputAndRestoresMode() {
+    for (type in listOf(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, AudioDeviceInfo.TYPE_BLE_HEADSET)) {
+      val input = device(type, 10, "target")
+      val wrong = device(type, 20, "other", sink = true)
+      val output = device(type, 30, "target", sink = true)
+      val manager = mockk<AudioManager>()
+      var mode = AudioManager.MODE_NORMAL
+      var routed: AudioDeviceInfo? = null
+      every { manager.availableCommunicationDevices } returns listOf(input, wrong, output)
+      every { manager.mode } answers { mode }
+      every { manager.mode = any() } answers { mode = firstArg() }
+      every { manager.setCommunicationDevice(any()) } answers { routed = firstArg(); true }
+      every { manager.clearCommunicationDevice() } answers { routed = null }
+      val route = RecordingInputRoute(manager)
+      route.select(input)
+      assertSame(output, routed)
+      assertEquals(AudioManager.MODE_IN_COMMUNICATION, mode)
+      route.close()
+      route.close()
+      assertNull(routed)
+      assertEquals(AudioManager.MODE_NORMAL, mode)
+      route.select(output)
+      route.select(device(AudioDeviceInfo.TYPE_BUILTIN_MIC, 1, ""))
+      assertNull(routed)
+      assertEquals(AudioManager.MODE_NORMAL, mode)
+    }
+  }
+
+  @Test
+  fun rejectedRouteDoesNotLeaveCommunicationModeActive() {
+    val input = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 1, "target")
+    val output = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 2, "target", sink = true)
+    val manager = mockk<AudioManager>()
+    var mode = AudioManager.MODE_NORMAL
+    every { manager.availableCommunicationDevices } returns listOf(output)
+    every { manager.mode } answers { mode }
+    every { manager.mode = any() } answers { mode = firstArg() }
+    every { manager.setCommunicationDevice(any()) } returns false
+    every { manager.clearCommunicationDevice() } returns Unit
+    assertThrows(PreferredInputNotFoundException::class.java) { RecordingInputRoute(manager).select(input) }
+    assertEquals(AudioManager.MODE_NORMAL, mode)
+  }
+}
