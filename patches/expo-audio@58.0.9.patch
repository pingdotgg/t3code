@@ -0,0 +1,151 @@
+package expo.modules.audio
+
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.async
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.advanceUntilIdle
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.*
+import org.junit.Test
+
+class RecordingInputTest {
+  private fun device(type: Int, id: Int, address: String, name: String = "Headset", sink: Boolean = false) =
+    mockk<AudioDeviceInfo> {
+      every { this@mockk.type } returns type
+      every { this@mockk.id } returns id
+      every { this@mockk.address } returns address
+      every { productName } returns name
+      every { isSink } returns sink
+      every { isSource } returns !sink
+    }
+
+  @Test
+  fun microphoneTypesExcludePlaybackDevices() {
+    val types = mapOf(
+      AudioDeviceInfo.TYPE_BUILTIN_MIC to "MicrophoneBuiltIn",
+      AudioDeviceInfo.TYPE_WIRED_HEADSET to "MicrophoneWired",
+      AudioDeviceInfo.TYPE_USB_DEVICE to "USBAudio",
+      AudioDeviceInfo.TYPE_USB_HEADSET to "USBAudio",
+      AudioDeviceInfo.TYPE_BLUETOOTH_SCO to "BluetoothSCO",
+      AudioDeviceInfo.TYPE_BLE_HEADSET to "BluetoothLE",
+      AudioDeviceInfo.TYPE_HEARING_AID to "HearingAid"
+    )
+    for ((type, label) in types) assertEquals(label, recordingInputType(type))
+    assertNull(recordingInputType(AudioDeviceInfo.TYPE_BLUETOOTH_A2DP))
+    assertNull(recordingInputType(AudioDeviceInfo.TYPE_BUILTIN_SPEAKER))
+  }
+
+  @Test
+  fun preferenceSurvivesPortIdChanges() {
+    val first = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 10, "", "Buds")
+    val reconnected = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 99, "", "Buds")
+    val other = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 10, "", "Other buds")
+    assertEquals(recordingInputUid(first), recordingInputUid(reconnected))
+    assertNotEquals(recordingInputUid(first), recordingInputUid(other))
+  }
+
+  @Test
+  fun communicationRouteWaitsForMatchingOutputAndRestoresMode() = runTest {
+    for (type in listOf(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, AudioDeviceInfo.TYPE_BLE_HEADSET)) {
+      val input = device(type, 10, "target")
+      val wrong = device(type, 20, "other", sink = true)
+      val output = device(type, 30, "target", sink = true)
+      val harness = RouteHarness(listOf(input, wrong, output))
+      val route = RecordingInputRoute(harness.manager)
+      val preparing = async(start = CoroutineStart.UNDISPATCHED) { route.select(input) }
+      assertSame(output, harness.requested)
+      assertFalse(preparing.isCompleted)
+      harness.confirm(wrong)
+      assertFalse(preparing.isCompleted)
+      harness.confirm(output)
+      preparing.await()
+      assertEquals(AudioManager.MODE_IN_COMMUNICATION, harness.mode)
+      assertTrue(harness.listeners.isEmpty())
+      route.close()
+      route.close()
+      assertNull(harness.requested)
+      assertEquals(AudioManager.MODE_NORMAL, harness.mode)
+      harness.active = output
+      route.select(output)
+      route.select(device(AudioDeviceInfo.TYPE_BUILTIN_MIC, 1, ""))
+      assertNull(harness.requested)
+      assertEquals(AudioManager.MODE_NORMAL, harness.mode)
+    }
+  }
+
+  @Test
+  fun rejectedRouteDoesNotLeaveCommunicationModeActive() = runTest {
+    val input = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 1, "target")
+    val output = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 2, "target", sink = true)
+    val harness = RouteHarness(listOf(output), accepted = false)
+    val error = runCatching { RecordingInputRoute(harness.manager).select(input) }.exceptionOrNull()
+    assertTrue(error is PreferredInputNotFoundException)
+    assertEquals(AudioManager.MODE_NORMAL, harness.mode)
+    assertTrue(harness.listeners.isEmpty())
+  }
+
+  @Test
+  fun cancellationRemovesListenerAndPendingRoute() = runTest {
+    val output = device(AudioDeviceInfo.TYPE_BLE_HEADSET, 2, "target", sink = true)
+    val harness = RouteHarness(listOf(output))
+    val route = RecordingInputRoute(harness.manager)
+    val preparing = launch(start = CoroutineStart.UNDISPATCHED) { route.select(output) }
+    preparing.cancelAndJoin()
+    assertNull(harness.requested)
+    assertEquals(AudioManager.MODE_NORMAL, harness.mode)
+    assertTrue(harness.listeners.isEmpty())
+  }
+
+  @OptIn(ExperimentalCoroutinesApi::class)
+  @Test
+  fun timeoutRemovesListenerAndPendingRoute() = runTest {
+    val output = device(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, 2, "target", sink = true)
+    val harness = RouteHarness(listOf(output))
+    val route = RecordingInputRoute(harness.manager)
+    val preparing = async(start = CoroutineStart.UNDISPATCHED) {
+      runCatching { route.select(output) }.exceptionOrNull()
+    }
+    advanceUntilIdle()
+    assertTrue(preparing.await() is TimeoutCancellationException)
+    assertNull(harness.requested)
+    assertEquals(AudioManager.MODE_NORMAL, harness.mode)
+    assertTrue(harness.listeners.isEmpty())
+  }
+
+  private class RouteHarness(devices: List<AudioDeviceInfo>, accepted: Boolean = true) {
+    val manager = mockk<AudioManager>()
+    var mode = AudioManager.MODE_NORMAL
+    var requested: AudioDeviceInfo? = null
+    var active: AudioDeviceInfo? = null
+    val listeners = mutableSetOf<AudioManager.OnCommunicationDeviceChangedListener>()
+
+    init {
+      every { manager.availableCommunicationDevices } returns devices
+      every { manager.mode } answers { mode }
+      every { manager.mode = any() } answers { mode = firstArg() }
+      every { manager.communicationDevice } answers { active }
+      every { manager.setCommunicationDevice(any()) } answers { requested = firstArg(); accepted }
+      every { manager.clearCommunicationDevice() } answers { requested = null }
+      every { manager.addOnCommunicationDeviceChangedListener(any(), any()) } answers {
+        listeners.add(secondArg())
+        Unit
+      }
+      every { manager.removeOnCommunicationDeviceChangedListener(any()) } answers {
+        listeners.remove(firstArg())
+        Unit
+      }
+    }
+
+    fun confirm(device: AudioDeviceInfo) {
+      active = device
+      listeners.toList().forEach { it.onCommunicationDeviceChanged(device) }
+    }
+  }
+}
