+
+internal fun isBluetoothInput(type: Int) = type == AudioDeviceInfo.TYPE_BLUETOOTH_SCO ||
+  type == AudioDeviceInfo.TYPE_BLE_HEADSET
+
+internal fun recordingInputType(type: Int): String? = when (type) {
+  AudioDeviceInfo.TYPE_BUILTIN_MIC -> "MicrophoneBuiltIn"
+  AudioDeviceInfo.TYPE_BLUETOOTH_SCO -> "BluetoothSCO"
+  AudioDeviceInfo.TYPE_BLE_HEADSET -> "BluetoothLE"
+  AudioDeviceInfo.TYPE_WIRED_HEADSET -> "MicrophoneWired"
+  AudioDeviceInfo.TYPE_USB_DEVICE, AudioDeviceInfo.TYPE_USB_HEADSET -> "USBAudio"
+  AudioDeviceInfo.TYPE_LINE_ANALOG, AudioDeviceInfo.TYPE_LINE_DIGITAL -> "LineIn"
+  else -> null
+}
+
+fun recordingInputUid(device: AudioDeviceInfo, inputs: List<AudioDeviceInfo> = emptyList()): String {
+  val base = recordingInputBaseUid(device)
+  val ambiguous = !isBluetoothInput(device.type) && inputs.any {
+    it.id != device.id && recordingInputBaseUid(it) == base
+  }
+  return if (ambiguous) "$base:port:${device.id}" else base
+}
+
+private fun recordingInputBaseUid(device: AudioDeviceInfo): String {
+  // Port IDs and USB addresses (ALSA card numbers) change on reconnect; Bluetooth addresses don't.
+  val stable = Build.VERSION.SDK_INT >= Build.VERSION_CODES.P && isBluetoothInput(device.type)
+  return "android:${device.type}:${if (stable) device.address.ifBlank { device.productName } else device.productName}"
+}
