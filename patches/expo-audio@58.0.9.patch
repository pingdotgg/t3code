diff --git a/android/src/main/java/expo/modules/audio/RecordingInputRoute.kt b/android/src/main/java/expo/modules/audio/RecordingInputRoute.kt
new file mode 100644
index 0000000000000000000000000000000000000000..2d584666da29c3f87ee5ee819e880b003ccceb32
--- /dev/null
+++ b/android/src/main/java/expo/modules/audio/RecordingInputRoute.kt
@@ -0,0 +1,41 @@
+package expo.modules.audio
+
+import android.media.AudioDeviceInfo
+import android.media.AudioManager
+import androidx.annotation.RequiresApi
+import java.io.Closeable
+
+@RequiresApi(31)
+internal class RecordingInputRoute(private val manager: AudioManager) : Closeable {
+  private var previousMode: Int? = null
+
+  fun select(input: AudioDeviceInfo) {
+    if (!isBluetoothInput(input.type)) {
+      close()
+      return
+    }
+    // Communication routing takes the headset's output; Android pairs its microphone.
+    val output = manager.availableCommunicationDevices.firstOrNull {
+      it.isSink && it.type == input.type &&
+        if (input.address.isNotBlank()) it.address == input.address else it.productName == input.productName
+    } ?: throw PreferredInputNotFoundException()
+    if (previousMode == null) previousMode = manager.mode
+    try {
+      manager.mode = AudioManager.MODE_IN_COMMUNICATION
+      if (!manager.setCommunicationDevice(output)) throw PreferredInputNotFoundException()
+    } catch (error: Exception) {
+      close()
+      throw error
+    }
+  }
+
+  override fun close() {
+    val mode = previousMode ?: return
+    previousMode = null
+    try {
+      manager.clearCommunicationDevice()
+    } finally {
+      if (manager.mode == AudioManager.MODE_IN_COMMUNICATION) manager.mode = mode
+    }
+  }
+}
