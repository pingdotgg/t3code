diff --git a/templates/nsis/include/extractAppPackage.nsh b/templates/nsis/include/extractAppPackage.nsh
index f5470bf..b91625c 100644
--- a/templates/nsis/include/extractAppPackage.nsh
+++ b/templates/nsis/include/extractAppPackage.nsh
@@ -98,6 +98,36 @@
   Pop $R0
   SetOutPath $R0
 
+  # T3 Code: move extracted entries into $OUTDIR when it has none of that name. Copying them wrote
+  # the whole app a second time. CopyFiles below still handles leftovers (an occupied name, another volume).
+  Push $R2
+  Push $R3
+  FindFirst $R2 $R3 "$PLUGINSDIR\7z-out\*"
+  ${DoWhile} $R3 != ""
+    ${If} $R3 != "."
+    ${AndIf} $R3 != ".."
+    ${AndIfNot} ${FileExists} "$OUTDIR\$R3"
+      Rename "$PLUGINSDIR\7z-out\$R3" "$OUTDIR\$R3"
+    ${EndIf}
+    FindNext $R2 $R3
+  ${Loop}
+  FindClose $R2
+  # CopyFiles fails on an empty source, so skip it once everything has moved.
+  FindFirst $R2 $R3 "$PLUGINSDIR\7z-out\*"
+  ${DoWhile} $R3 != ""
+    ${If} $R3 != "."
+    ${AndIf} $R3 != ".."
+      ${ExitDo}
+    ${EndIf}
+    FindNext $R2 $R3
+  ${Loop}
+  FindClose $R2
+  StrCpy $R1 $R3
+  Pop $R3
+  Pop $R2
+  ClearErrors
+  StrCmp $R1 "" DoneExtract7za
+
   # Retry counter
   StrCpy $R1 0
 
