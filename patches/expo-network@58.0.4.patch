diff --git a/ios/NetworkModule.swift b/ios/NetworkModule.swift
index ce150f792f0a717696b24d3930d8ea55b1dc12a6..ec1d2cdd11861f8862ba58c20fd7f1c75845efdb 100644
--- a/ios/NetworkModule.swift
+++ b/ios/NetworkModule.swift
@@ -101,10 +101,18 @@ public final class NetworkModule: Module {
     // since we want to wait for the result to be updated once:
     let tempMonitor = NWPathMonitor()
     var tempPath: NWPath?
+    let pathLock = NSLock()
 
     let semaphore = DispatchSemaphore(value: 0)
 
     tempMonitor.pathUpdateHandler = { updatedPath in
+      // Cancellation does not drain queued updates. Publish only the first path
+      // and synchronize its retain with the caller reading it on another queue.
+      pathLock.lock()
+      defer { pathLock.unlock() }
+      guard tempPath == nil else {
+        return
+      }
       tempPath = updatedPath
       semaphore.signal() // Notify that we got the path
     }
