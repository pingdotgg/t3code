+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [28])
+class DirectionClipboardTest {
+  private fun selection(): SpannableStringBuilder = SpannableStringBuilder("\u200Freal \u2066code()\u2069 \u200F").apply {
+    setSpan(DirectionControlSpan(), 6, 7, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+    setSpan(DirectionControlSpan(), 13, 14, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+  }
+
+  @Test fun plainAndMarkdownPreserveAuthoredMarks() {
+    val text = selection()
+    val expected = "\u200Freal code() \u200F"
+    assertEquals(expected, canonicalClipboardText(text, SelectionClipboardConfig()))
+    assertEquals(expected, MarkdownExtractor.extractFromSpannable(text, 0, text.length))
+    assertEquals("code()", MarkdownExtractor.extractFromSpannable(text, 6, 14))
+    assertEquals("code()", canonicalClipboardText(text.subSequence(6, 14) as android.text.Spanned, SelectionClipboardConfig()))
+    assertEquals("\u200Freal \u2066code()\u2069 \u200F", text.toString())
+  }
+
+  @Test fun htmlRoundTripPreservesOnlyAuthoredMarks() {
+    val text = selection()
+    val expected = SpannableStringBuilder("\u200Freal code() \u200F")
+    val style = style()
+    val html = HTMLGenerator.generateHTML(text, style)
+    assertEquals(HTMLGenerator.generateHTML(expected, style), html)
+    assertEquals(expected.toString(), Html.fromHtml(html, Html.FROM_HTML_MODE_LEGACY).toString().trimEnd('\n'))
+    fun tableHTML(cell: CharSequence) = HTMLGenerator.generateTableHTML(
+      listOf(listOf(Triple(cell, false, Layout.Alignment.ALIGN_NORMAL))), style,
+    )
+    assertEquals(tableHTML(expected), tableHTML(text))
+    assertEquals(tableHTML("code()"), tableHTML(text.subSequence(6, 14)))
+    assertEquals(
+      HTMLGenerator.generateHTML(SpannableStringBuilder("code()"), style),
+      HTMLGenerator.generateHTML(SpannableStringBuilder(text.subSequence(6, 14)), style),
+    )
+  }
+
+  @Test fun customActionReceivesCleanTextWithViewSelectionOffsets() {
+    val context = RuntimeEnvironment.getApplication()
+    val view = TextView(context)
+    view.setText(selection(), TextView.BufferType.SPANNABLE)
+    Selection.setSelection(view.text as Spannable, 6, 14)
+    var received: Triple<String, Int, Int>? = null
+    val callback = createSelectionActionModeCallback(view, getCustomItemTexts = { listOf("Use text") },
+      onCustomItemPress = { _, text, start, end -> received = Triple(text, start, end) })
+    val item = PopupMenu(context, view).menu.add(0, 2000, 0, "Use text")
+    callback.onActionItemClicked(null, item)
+    assertEquals(Triple("code()", 6, 14), received)
+    assertEquals("\u200Freal code() \u200F", textWithoutDirectionControls(view.text))
+  }
+
+  @Test fun directionControlsKeepCodeBlockAndListIndentRanges() {
+    val context = RuntimeEnvironment.getApplication()
+    val style = style()
+    val code = MarkdownASTNode(NodeType.CodeBlock, children = listOf(MarkdownASTNode(NodeType.Text, content = "שלום\ncode()")))
+    for (listed in listOf(false, true)) {
+      val node = if (listed) MarkdownASTNode(NodeType.UnorderedList, children = listOf(
+        MarkdownASTNode(NodeType.ListItem, children = listOf(code)),
+      )) else code
+      val text = Renderer().apply { configure(style, context) }.renderContent(listOf(withWordMajority(node, { false })))
+      val span = text.getSpans(0, text.length, CodeBlockSpan::class.java).single()
+      val start = text.getSpanStart(span)
+      assertEquals('\u200E', text[start])
+      assertEquals(0, start)
+      assertEquals(span.getLeadingMargin(true), text.getSpans(start, start + 1, LeadingMarginSpan::class.java).sumOf { it.getLeadingMargin(true) })
+      assertEquals("שלום\ncode()", textWithoutDirectionControls(text).trimEnd('\n'))
+    }
+  }
+
+  @Test fun multilineCodeMarkdownCleansControlsBeforeWalkingSpanTransitions() {
+    val context = RuntimeEnvironment.getApplication()
+    val style = style()
+    val code = MarkdownASTNode(NodeType.CodeBlock, children = listOf(
+      MarkdownASTNode(NodeType.Text, content = "\u200Ffoo\nbar\u2066\n"),
+    ))
+    var node = code
+    for (depth in 0..2) {
+      val text = SpannableStringBuilder()
+      val factory = RendererFactory(RendererConfig(style), context) { }
+      factory.renderNodes(listOf(withWordMajority(node, { false })), text, null, null)
+      factory.flushDeferredSpans(text)
+      val span = text.getSpans(0, text.length, CodeBlockSpan::class.java).single()
+      val start = text.getSpanStart(span)
+      val end = text.getSpanEnd(span)
+      val source = text.toString()
+      assertEquals("```\n\u200Ffoo\nbar\u2066\n```\n", MarkdownExtractor.extractFromSpannable(text, start, end))
+      assertEquals("```\noo\nbar\u2066\n```\n", MarkdownExtractor.extractFromSpannable(text, text.indexOf("foo") + 1, end))
+      assertEquals(source, text.toString())
+      assertEquals(start, text.getSpanStart(span))
+      assertEquals(end, text.getSpanEnd(span))
+      node = MarkdownASTNode(NodeType.UnorderedList, children = listOf(
+        MarkdownASTNode(NodeType.ListItem, children = listOf(node)),
+      ))
+    }
+  }
+
+  @Test fun tableAlignmentUsesEachCellDirectionWithoutReorderingColumns() {
+    assertTableAlignment(false)
+  }
+
+  @Test
+  fun rtlLocaleKeepsColumnOrderWhileCellsResolveTheirOwnDirection() {
+    assertTableAlignment(true)
+  }
+
+  private fun assertTableAlignment(rtlColumns: Boolean) {
+    val application = RuntimeEnvironment.getApplication()
+    val locale = if (rtlColumns) Locale.forLanguageTag("ar") else Locale.ENGLISH
+    val configuration = Configuration(application.resources.configuration).apply {
+      setLocale(locale)
+      setLayoutDirection(locale)
+    }
+    val context = application.createConfigurationContext(configuration)
+    assertEquals(rtlColumns, context.resources.configuration.layoutDirection == View.LAYOUT_DIRECTION_RTL)
+    val style = style()
+    val alignments = listOf("left", "right", "center", "")
+    val cells = listOf("ltr", "rtl").flatMap { direction ->
+      alignments.map { alignment ->
+        MarkdownASTNode(NodeType.TableCell, attributes = mapOf(PROSE_DIRECTION to direction, "align" to alignment),
+          children = listOf(MarkdownASTNode(NodeType.Text, content = if (direction == "rtl") "שלום" else "Hello")))
+      }
+    }
+    val table = MarkdownASTNode(NodeType.Table, attributes = mapOf(PROSE_DIRECTION to "ltr"), children = listOf(
+      MarkdownASTNode(NodeType.TableBody, children = listOf(MarkdownASTNode(NodeType.TableRow, children = cells))),
+    ))
+    val view = TableContainerView(context, style)
+    view.applyTableNode(table)
+    fun textViews(view: View): List<TextView> = when (view) {
+      is TextView -> listOf(view)
+      is ViewGroup -> (0 until view.childCount).flatMap { textViews(view.getChildAt(it)) }
+      else -> emptyList()
+    }
+    val views = textViews(view)
+    assertEquals(8, views.size)
+    views.forEachIndexed { index, cell ->
+      val rtl = index >= 4
+      val expected = when (index % 4) {
+        0 -> if (rtl) Layout.Alignment.ALIGN_OPPOSITE else Layout.Alignment.ALIGN_NORMAL
+        1 -> if (rtl) Layout.Alignment.ALIGN_NORMAL else Layout.Alignment.ALIGN_OPPOSITE
+        2 -> Layout.Alignment.ALIGN_CENTER
+        else -> Layout.Alignment.ALIGN_NORMAL
+      }
+      val text = cell.text as android.text.Spanned
+      assertEquals(expected, text.getSpans(0, text.length, AlignmentSpan::class.java).lastOrNull()?.alignment
+        ?: Layout.Alignment.ALIGN_NORMAL)
+      assertEquals(if (rtl) "שלום" else "Hello", textWithoutDirectionControls(text))
+      if (index > 0) {
+        val previous = (views[index - 1].parent as View).layoutParams as android.widget.FrameLayout.LayoutParams
+        val current = (cell.parent as View).layoutParams as android.widget.FrameLayout.LayoutParams
+        org.junit.Assert.assertTrue(
+          if (rtlColumns) current.leftMargin < previous.leftMargin else current.leftMargin > previous.leftMargin,
+        )
+      }
+    }
+  }
+
+  private fun style(): StyleConfig {
+    val context = RuntimeEnvironment.getApplication()
+    DisplayMetricsHolder.initDisplayMetricsIfNotInitialized(context)
+    val block = JavaOnlyMap()
+    for (name in listOf("fontSize", "marginTop", "marginBottom", "lineHeight", "borderWidth", "borderRadius", "padding",
+      "gapWidth", "bulletSize", "markerMinWidth", "marginLeft", "itemSpacing", "checkboxSize", "checkboxBorderRadius",
+      "height", "maxHeight", "aspectRatio", "cellPaddingHorizontal", "cellPaddingVertical", "horizontalOverflow",
+      "fontScale", "baselineOffsetScale", "size")) block.putDouble(name, 0.0)
+    block.putDouble("fontSize", 16.0)
+    block.putDouble("padding", 4.0)
+    for (name in listOf("color", "backgroundColor", "borderColor", "bulletColor", "markerColor", "checkedColor",
+      "checkmarkColor", "checkedTextColor", "headerBackgroundColor", "headerTextColor", "rowEvenBackgroundColor", "rowOddBackgroundColor")) block.putDouble(name, 0.0)
+    block.putBoolean("checkedStrikethrough", false)
+    block.putBoolean("underline", false)
+    val map = JavaOnlyMap()
+    for (name in listOf("paragraph", "codeBlock", "code", "blockquote", "list", "taskList", "link", "strong", "em",
+      "strikethrough", "underline", "highlight", "image", "video", "inlineImage", "thematicBreak", "table",
+      "math", "inlineMath", "superscript", "subscript", "h1", "h2", "h3", "h4", "h5", "h6")) map.putMap(name, block)
+    val spoiler = JavaOnlyMap().apply {
+      putDouble("color", 0.0)
+      putMap("particles", JavaOnlyMap.of("density", 0.0, "speed", 0.0))
+      putMap("solid", JavaOnlyMap.of("borderRadius", 0.0))
+    }
+    map.putMap("spoiler", spoiler)
+    return StyleConfig(map, context, false, 0f)
+  }
+}
