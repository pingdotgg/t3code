+package com.swmansion.enriched.markdown.utils.text.view
+
+import android.text.Spanned
+import com.swmansion.enriched.markdown.spans.DirectionControlSpan
+
+internal fun textWithoutDirectionControls(text: CharSequence): String {
+  if (text !is Spanned) return text.toString()
+  val ranges = text.getSpans(0, text.length, DirectionControlSpan::class.java)
+    .map { text.getSpanStart(it).coerceAtLeast(0) to text.getSpanEnd(it).coerceAtMost(text.length) }
+    .filter { it.second > it.first }
+    .sortedByDescending { it.first }
+  return StringBuilder(text.toString()).apply {
+    ranges.forEach { (start, end) -> delete(start, end) }
+  }.toString()
+}
