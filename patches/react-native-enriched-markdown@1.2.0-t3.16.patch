diff --git a/ios/utils/ENRMWordMajority.h b/ios/utils/ENRMWordMajority.h
new file mode 100644
index 0000000..b8f9c00
--- /dev/null
+++ b/ios/utils/ENRMWordMajority.h
@@ -0,0 +1,13 @@
+#import <Foundation/Foundation.h>
+@class MarkdownASTNode;
+
+__BEGIN_DECLS
+
+// Internal AST metadata; never inserted into markdown or copied text.
+extern NSString *const ENRMProseDirectionKey;
+extern NSString *const ENRMDirectionControlKey;
+NSAttributedString *ENRMWithoutDirectionControls(NSAttributedString *text);
+NSString *ENRMWordMajorityDirection(NSString *text);
+void ENRMAnnotateWordMajority(MarkdownASTNode *root, BOOL (^isChip)(NSString *url));
+
+__END_DECLS
diff --git a/ios/utils/ENRMWordMajority.m b/ios/utils/ENRMWordMajority.m
new file mode 100644
index 0000000..3c40447
--- /dev/null
+++ b/ios/utils/ENRMWordMajority.m
@@ -0,0 +1,118 @@
+#import "ENRMWordMajority.h"
+#import "MarkdownASTNode.h"
+
+NSString *const ENRMProseDirectionKey = @"_enrmProseDirection";
+NSString *const ENRMDirectionControlKey = @"ENRMDirectionControl";
+
+NSAttributedString *ENRMWithoutDirectionControls(NSAttributedString *text)
+{
+  NSMutableAttributedString *result = [text mutableCopy];
+  [text enumerateAttribute:ENRMDirectionControlKey inRange:NSMakeRange(0, text.length)
+                  options:NSAttributedStringEnumerationReverse
+               usingBlock:^(id value, NSRange range, BOOL *stop) {
+    if ([value boolValue]) [result deleteCharactersInRange:range];
+  }];
+  return result;
+}
+
+static BOOL ENRMWordSpace(UTF32Char c)
+{
+  // Match JavaScript's /\s/ rather than locale-specific word segmentation.
+  return (c >= 9 && c <= 13) || c == 32 || c == 0xA0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200A) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202F || c == 0x205F || c == 0x3000 || c == 0xFEFF;
+}
+
+NSString *ENRMWordMajorityDirection(NSString *text)
+{
+  NSInteger rtl = 0, ltr = 0;
+  NSString *first = nil;
+  BOOL counted = NO;
+  static NSRegularExpression *letters;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{ letters = [NSRegularExpression regularExpressionWithPattern:@"\\p{L}" options:0 error:nil]; });
+  for (NSUInteger i = 0; i < text.length; i++) {
+    UTF32Char c = [text characterAtIndex:i];
+    if (CFStringIsSurrogateHighCharacter(c) && i + 1 < text.length &&
+        CFStringIsSurrogateLowCharacter([text characterAtIndex:i + 1])) {
+      c = CFStringGetLongCharacterForSurrogatePair(c, [text characterAtIndex:++i]);
+    }
+    if (ENRMWordSpace(c)) {
+      counted = NO;
+    } else if (!counted && [letters firstMatchInString:text options:NSMatchingAnchored
+        range:NSMakeRange(i - (c > 0xFFFF ? 1 : 0), c > 0xFFFF ? 2 : 1)]) {
+      BOOL isRTL = (c >= 0x0590 && c <= 0x08FF) || (c >= 0xFB1D && c <= 0xFDFF) ||
+                   (c >= 0xFE70 && c <= 0xFEFF) || (c >= 0x10800 && c <= 0x10FFF) ||
+                   (c >= 0x1E800 && c <= 0x1EFFF);
+      if (!first) first = isRTL ? @"rtl" : @"ltr";
+      if (isRTL) rtl++; else ltr++;
+      counted = YES;
+    }
+  }
+  return rtl == ltr ? first : (rtl > ltr ? @"rtl" : @"ltr");
+}
+
+static BOOL ENRMChipHasBlocker(MarkdownASTNode *node)
+{
+  if (node.type == MarkdownNodeTypeImage || node.type == MarkdownNodeTypeLatexMathInline ||
+      node.type == MarkdownNodeTypeSpoiler || node.type == MarkdownNodeTypeLineBreak ||
+      (node.content && [node.content rangeOfCharacterFromSet:NSCharacterSet.newlineCharacterSet].location != NSNotFound))
+    return YES;
+  for (MarkdownASTNode *child in node.children) if (ENRMChipHasBlocker(child)) return YES;
+  return NO;
+}
+
+static void ENRMCollectProse(MarkdownASTNode *node, NSMutableString *text, BOOL (^isChip)(NSString *))
+{
+  switch (node.type) {
+    case MarkdownNodeTypeCode:
+    case MarkdownNodeTypeCodeBlock:
+    case MarkdownNodeTypeTable:
+    case MarkdownNodeTypeImage:
+    case MarkdownNodeTypeVideo:
+    case MarkdownNodeTypeLatexMathInline:
+    case MarkdownNodeTypeLatexMathDisplay:
+      [text appendString:@" "];
+      return;
+    case MarkdownNodeTypeLink:
+      if (isChip && isChip(node.attributes[@"url"] ?: @"") && !ENRMChipHasBlocker(node)) {
+        [text appendString:@" "];
+        return;
+      }
+      break;
+    default: break;
+  }
+  BOOL block = ENRMIsTopLevelBlockType(node.type) || node.type == MarkdownNodeTypeListItem ||
+               node.type == MarkdownNodeTypeLineBreak || node.type == MarkdownNodeTypeSoftBreak;
+  if (block) [text appendString:@" "];
+  if (node.type == MarkdownNodeTypeText) [text appendString:node.content ?: @""];
+  for (MarkdownASTNode *child in node.children) ENRMCollectProse(child, text, isChip);
+  if (block) [text appendString:@" "];
+}
+
+static void ENRMAnnotateNode(MarkdownASTNode *node, NSString *inherited, BOOL (^isChip)(NSString *))
+{
+  if (node.type == MarkdownNodeTypeDocument || node.type == MarkdownNodeTypeTable ||
+      node.type == MarkdownNodeTypeTableHead || node.type == MarkdownNodeTypeTableBody ||
+      node.type == MarkdownNodeTypeTableRow) {
+    if (node.type == MarkdownNodeTypeTable) node.attributes[ENRMProseDirectionKey] = @"ltr";
+    for (MarkdownASTNode *child in node.children) ENRMAnnotateNode(child, nil, isChip);
+    return;
+  }
+  NSString *direction = inherited;
+  if (!direction) {
+    NSMutableString *text = [NSMutableString new];
+    ENRMCollectProse(node, text, isChip);
+    direction = ENRMWordMajorityDirection(text) ?: @"ltr";
+  }
+  if (ENRMIsTopLevelBlockType(node.type) || node.type == MarkdownNodeTypeListItem ||
+      node.type == MarkdownNodeTypeCode || node.type == MarkdownNodeTypeTableCell ||
+      node.type == MarkdownNodeTypeTableHeaderCell)
+    node.attributes[ENRMProseDirectionKey] = direction;
+  for (MarkdownASTNode *child in node.children) ENRMAnnotateNode(child, direction, isChip);
+}
+
+void ENRMAnnotateWordMajority(MarkdownASTNode *root, BOOL (^isChip)(NSString *url))
+{
+  ENRMAnnotateNode(root, nil, isChip);
+}
