diff --git a/tests/word-majority/Android.kt b/tests/word-majority/Android.kt
new file mode 100644
index 0000000..8c86c5d
--- /dev/null
+++ b/tests/word-majority/Android.kt
@@ -0,0 +1,44 @@
+package com.swmansion.enriched.markdown.utils.text
+
+import com.swmansion.enriched.markdown.parser.MarkdownASTNode
+import com.swmansion.enriched.markdown.parser.MarkdownASTNode.NodeType
+
+private fun node(type: NodeType, text: String = "", vararg children: MarkdownASTNode) =
+  MarkdownASTNode(type, content = text, children = children.toList())
+
+fun main() {
+  val cases = listOf(
+    "StrictMode: يعيد الـ render مرتين" to "rtl",
+    "Supercalifragilisticexpialidocious مرحبا بكم" to "rtl",
+    "שלום documentation is available" to "ltr",
+    "hello שלום" to "ltr", "שלום hello" to "rtl", "123 !!!" to null,
+    "\uFEFFhello\u00A0שלום\u3000עולם" to "rtl", "𐤀 hello שלום" to "rtl",
+    "َhello שלום" to "ltr", "APIשלום مرحبا" to "ltr", "مرحباAPI hello" to "rtl",
+  )
+  cases.forEach { (text, expected) -> check(wordMajorityDirection(text) == expected) { text } }
+  val english = node(NodeType.Paragraph, "", node(NodeType.Text, "English"))
+  val arabic = node(NodeType.Paragraph, "", node(NodeType.Text, "مرحبا بكم"), node(NodeType.SoftBreak),
+    node(NodeType.Code, "", node(NodeType.Text, "many english code words")),
+    MarkdownASTNode(NodeType.Link, attributes = mapOf("url" to "chip"), children = listOf(node(NodeType.Text, "more english words here"))))
+  val table = node(NodeType.Table, "", node(NodeType.TableRow, "",
+    node(NodeType.TableCell, "", node(NodeType.Text, "Hello world")),
+    node(NodeType.TableCell, "", node(NodeType.Text, "مرحبا بكم"))))
+  val quote = node(NodeType.Blockquote, "", english, arabic, table)
+  val list = node(NodeType.UnorderedList, "", node(NodeType.ListItem, "", node(NodeType.Text, "English")),
+    node(NodeType.ListItem, "", node(NodeType.Text, "مرحبا بكم")))
+  val root = withWordMajority(node(NodeType.Document, "", quote, list), { it == "chip" })
+  val result = root.children[0]
+  check(result.attributes[PROSE_DIRECTION] == "rtl")
+  check(result.children.take(2).all { it.attributes[PROSE_DIRECTION] == "rtl" })
+  check(root.children[1].children.all { it.attributes[PROSE_DIRECTION] == "rtl" })
+  val cells = result.children[2].children[0].children
+  check(cells[0].attributes[PROSE_DIRECTION] == "ltr")
+  check(cells[1].attributes[PROSE_DIRECTION] == "rtl")
+  check(result.children[2].attributes[PROSE_DIRECTION] == "ltr")
+  check(english.children[0].content == "English" && english.attributes.isEmpty())
+  val fallback = arabic.copy(children = arabic.children.map { child ->
+    if (child.type == NodeType.Link) child.copy(children = child.children + node(NodeType.LineBreak)) else child
+  })
+  check(withWordMajority(fallback, { it == "chip" }).attributes[PROSE_DIRECTION] == "ltr")
+  println("Android JVM: 11 word-direction cases and AST inheritance/code/chip/table checks passed")
+}
diff --git a/tests/word-majority/ClipboardTests.m b/tests/word-majority/ClipboardTests.m
