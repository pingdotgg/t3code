+++ b/android/src/main/java/com/swmansion/enriched/markdown/utils/text/WordMajority.kt
@@ -0,0 +1,81 @@
+package com.swmansion.enriched.markdown.utils.text
+
+import com.swmansion.enriched.markdown.parser.MarkdownASTNode
+import com.swmansion.enriched.markdown.parser.MarkdownASTNode.NodeType
+import com.swmansion.enriched.markdown.parser.isTopLevelBlock
+
+internal const val PROSE_DIRECTION = "_enrmProseDirection"
+
+private fun wordSpace(c: Int): Boolean =
+  c in 9..13 || c == 32 || c == 0xA0 || c == 0x1680 || c in 0x2000..0x200A ||
+    c == 0x2028 || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000 || c == 0xFEFF
+
+internal fun wordMajorityDirection(text: String): String? {
+  var rtl = 0
+  var ltr = 0
+  var first: String? = null
+  var counted = false
+  var offset = 0
+  while (offset < text.length) {
+    val c = text.codePointAt(offset)
+    offset += Character.charCount(c)
+    if (wordSpace(c)) {
+      counted = false
+    } else if (!counted && Character.isLetter(c)) {
+      val isRtl = c in 0x0590..0x08FF || c in 0xFB1D..0xFDFF || c in 0xFE70..0xFEFF ||
+        c in 0x10800..0x10FFF || c in 0x1E800..0x1EFFF
+      val direction = if (isRtl) "rtl" else "ltr"
+      if (first == null) first = direction
+      if (isRtl) rtl++ else ltr++
+      counted = true
+    }
+  }
+  return if (rtl == ltr) first else if (rtl > ltr) "rtl" else "ltr"
+}
+
+private fun chipHasBlocker(node: MarkdownASTNode): Boolean =
+  node.type in listOf(NodeType.Image, NodeType.LatexMathInline, NodeType.Spoiler, NodeType.LineBreak) ||
+    node.content.any { it == '\n' || it == '\r' || it == '\u2028' || it == '\u2029' } ||
+    node.children.any(::chipHasBlocker)
+
+private fun collectProse(node: MarkdownASTNode, text: StringBuilder, isChip: (String) -> Boolean) {
+  when (node.type) {
+    NodeType.Code, NodeType.CodeBlock, NodeType.Table, NodeType.Image, NodeType.Video,
+    NodeType.LatexMathInline, NodeType.LatexMathDisplay -> {
+      text.append(' ')
+      return
+    }
+    NodeType.Link -> if (isChip(node.attributes["url"] ?: "") && !chipHasBlocker(node)) {
+      text.append(' ')
+      return
+    }
+    else -> Unit
+  }
+  val block = node.type.isTopLevelBlock() || node.type == NodeType.ListItem ||
+    node.type == NodeType.LineBreak || node.type == NodeType.SoftBreak
+  if (block) text.append(' ')
+  if (node.type == NodeType.Text) text.append(node.content)
+  node.children.forEach { collectProse(it, text, isChip) }
+  if (block) text.append(' ')
+}
+
+internal fun withWordMajority(
+  node: MarkdownASTNode,
+  isChip: (String) -> Boolean,
+  inherited: String? = null,
+): MarkdownASTNode {
+  if (node.type in listOf(NodeType.Document, NodeType.Table, NodeType.TableHead, NodeType.TableBody, NodeType.TableRow)) {
+    return node.copy(
+      attributes = if (node.type == NodeType.Table) node.attributes + (PROSE_DIRECTION to "ltr") else node.attributes,
+      children = node.children.map { withWordMajority(it, isChip) },
+    )
+  }
+  val direction = inherited ?: wordMajorityDirection(buildString { collectProse(node, this, isChip) }) ?: "ltr"
+  val needsDirection = node.type.isTopLevelBlock() || node.type == NodeType.ListItem ||
+    node.type == NodeType.Code || node.type == NodeType.TableCell || node.type == NodeType.TableHeaderCell
+  if (!needsDirection && node.children.isEmpty()) return node
+  return node.copy(
+    attributes = if (needsDirection) node.attributes + (PROSE_DIRECTION to direction) else node.attributes,
+    children = node.children.map { withWordMajority(it, isChip, direction) },
+  )
+}
