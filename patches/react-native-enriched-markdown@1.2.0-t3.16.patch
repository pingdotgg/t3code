+++ b/tests/word-majority/ClipboardTests.m
@@ -0,0 +1,115 @@
+#import <XCTest/XCTest.h>
+#import "CodeBackground.h"
+#import "ENRMWordMajority.h"
+#import "ENRMLinkPillText.h"
+#import "HTMLGenerator.h"
+#import "MarkdownExtractor.h"
+#import "StyleConfig.h"
+#import "AttributedRenderer.h"
+#import "ENRMLinkPillAttachment.h"
+#import "MarkdownASTNode.h"
+#import "RenderContext.h"
+#import "TableContainerView.h"
+
+@interface ENRMDirectionClipboardTests : XCTestCase
+@end
+@implementation ENRMDirectionClipboardTests
+- (void)testPlainHTMLMarkdownAndCustomSelectionPreserveAuthoredMarks
+{
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@"\u200Freal \u2066code()\u2069 \u200F"];
+  for (NSNumber *index in @[ @6, @13 ]) {
+    [text addAttributes:@{ ENRMDirectionControlKey: @YES }
+                  range:NSMakeRange(index.unsignedIntegerValue, 1)];
+  }
+  NSAttributedString *expected = [[NSAttributedString alloc] initWithString:@"\u200Freal code() \u200F"];
+  XCTAssertEqualObjects(ENRMWithoutDirectionControls(text).string, expected.string);
+  XCTAssertEqualObjects(ENRMStringByExpandingLinkPills(text), expected.string);
+  XCTAssertEqualObjects(extractMarkdownFromAttributedString(text, NSMakeRange(0, text.length)), expected.string);
+  XCTAssertEqualObjects(extractMarkdownFromAttributedString(text, NSMakeRange(6, 8)), @"code()");
+  StyleConfig *style = [StyleConfig new];
+  XCTAssertEqualObjects(generateHTML(text, style), generateHTML(expected, style));
+  XCTAssertEqualObjects(generateHTML([text attributedSubstringFromRange:NSMakeRange(6, 8)], style),
+                        generateHTML([[NSAttributedString alloc] initWithString:@"code()"], style));
+  XCTAssertEqualObjects(text.string, @"\u200Freal \u2066code()\u2069 \u200F");
+  NSAttributedString *control = [[NSAttributedString alloc] initWithString:@"\u200E"
+      attributes:@{ ENRMDirectionControlKey: @YES }];
+  XCTAssertNil(generateHTML(control, style));
+}
+- (void)testCodeLedPillsPreserveSourceAndAuthoredDirectionMarks
+{
+  for (NSString *suffix in @[ @"", @" more \u200Ftext" ]) {
+    NSString *source = @"\u200Ffile.ts\u2066";
+    MarkdownASTNode *text = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+    text.content = source;
+    MarkdownASTNode *code = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeCode];
+    [code addChild:text];
+    MarkdownASTNode *link = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeLink];
+    link.attributes[@"url"] = @"file:///file.ts";
+    [link addChild:code];
+    MarkdownASTNode *tail = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+    tail.content = suffix;
+    [link addChild:tail];
+    MarkdownASTNode *paragraph = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeParagraph];
+    [paragraph addChild:link];
+    ENRMAnnotateWordMajority(paragraph, ^BOOL(NSString *url) { return YES; });
+    StyleConfig *style = [StyleConfig new];
+    LinkVariantConfig *variant = [LinkVariantConfig new];
+    variant.pattern = @"^file:";
+    variant.pill = [LinkPillConfig new];
+    [style setLinkVariants:@[ variant ]];
+    NSAttributedString *rendered = [[[AttributedRenderer alloc] initWithConfig:style]
+        renderNodes:@[ paragraph ] context:[RenderContext new] block:nil];
+    __block ENRMLinkPillAttachment *pill = nil;
+    [rendered enumerateAttribute:NSAttachmentAttributeName inRange:NSMakeRange(0, rendered.length) options:0
+                     usingBlock:^(id value, NSRange range, BOOL *stop) {
+      if (![value isKindOfClass:ENRMLinkPillAttachment.class]) return;
+      pill = value;
+      XCTAssertNil([rendered attribute:ENRMDirectionControlKey atIndex:range.location effectiveRange:NULL]);
+    }];
+    XCTAssertNotNil(pill);
+    NSString *expanded = ENRMStringByExpandingLinkPills(rendered);
+    XCTAssertTrue([expanded containsString:source]);
+    XCTAssertTrue([expanded hasSuffix:suffix]);
+    XCTAssertEqualObjects(expanded, ENRMWithoutDirectionControls(pill.originalText).string);
+    NSAttributedString *attributed = ENRMAttributedStringByExpandingLinkPills(rendered, NULL);
+    NSRange sourceRange = [attributed.string rangeOfString:source];
+    XCTAssertNotEqual(sourceRange.location, NSNotFound);
+    XCTAssertNotNil([attributed attribute:CodeAttributeName atIndex:sourceRange.location effectiveRange:NULL]);
+  }
+}
+
+- (void)testRTLTableCellsDistinguishExplicitLeftFromNaturalAlignment
+{
+  NSMutableArray<MarkdownASTNode *> *cells = [NSMutableArray new];
+  for (NSString *align in @[ @"left", @"right", @"center", @"" ]) {
+    MarkdownASTNode *cell = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeTableCell];
+    if (align.length > 0) cell.attributes[@"align"] = align;
+    MarkdownASTNode *text = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeText];
+    text.content = @"שלום";
+    [cell addChild:text];
+    [cells addObject:cell];
+  }
+  MarkdownASTNode *row = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeTableRow];
+  for (MarkdownASTNode *cell in cells) [row addChild:cell];
+  MarkdownASTNode *body = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeTableBody];
+  [body addChild:row];
+  MarkdownASTNode *table = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeTable];
+  [table addChild:body];
+  ENRMAnnotateWordMajority(table, nil);
+  TableContainerView *view = [[TableContainerView alloc] initWithConfig:[StyleConfig new]];
+  [view applyTableNode:table];
+  NSArray *rendered = [view valueForKey:@"rows"];
+  NSArray<NSNumber *> *expected = @[ @(NSTextAlignmentLeft), @(NSTextAlignmentRight),
+                                    @(NSTextAlignmentCenter), @(NSTextAlignmentNatural) ];
+  XCTAssertEqual(rendered.count, 1);
+  NSArray *renderedCells = rendered.firstObject;
+  XCTAssertEqual(renderedCells.count, expected.count);
+  for (NSUInteger i = 0; i < renderedCells.count; i++) {
+    NSAttributedString *text = [renderedCells[i] valueForKey:@"attributedText"];
+    NSParagraphStyle *paragraph = [text attribute:NSParagraphStyleAttributeName atIndex:0 effectiveRange:NULL];
+    XCTAssertEqual(paragraph.baseWritingDirection, NSWritingDirectionRightToLeft);
+    XCTAssertEqual(paragraph.alignment, expected[i].integerValue);
+  }
+}
+
+@end
