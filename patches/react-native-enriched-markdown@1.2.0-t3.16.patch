+import com.swmansion.enriched.markdown.parser.MarkdownASTNode
+import com.swmansion.enriched.markdown.styles.StyleConfig
+
+internal fun wordMajorityAST(node: MarkdownASTNode, style: StyleConfig, mode: String): MarkdownASTNode {
+  if (mode != "word-majority") return node
+  val variants = style.linkVariants.mapNotNull { entry ->
+    runCatching { Regex(entry.pattern) to entry }.getOrNull()
+  }
+  return withWordMajority(node, { url -> variants.firstOrNull { it.first.containsMatchIn(url) }?.second?.pill != null })
+}
