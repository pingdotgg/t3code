new file mode 100644
index 0000000..0a63d90
--- /dev/null
+++ b/tests/word-majority/ios.m
@@ -0,0 +1,59 @@
+#import <Foundation/Foundation.h>
+#import "ENRMWordMajority.h"
+#import "MarkdownASTNode.h"
+
+static MarkdownASTNode *node(MarkdownNodeType type, NSString *text, NSArray *children) {
+  MarkdownASTNode *result = [[MarkdownASTNode alloc] initWithType:type];
+  result.content = text;
+  [result.children addObjectsFromArray:children ?: @[]];
+  return result;
+}
+static void check(BOOL value) { if (!value) abort(); }
+int main(void) {
+  @autoreleasepool {
+    NSArray *cases = @[
+      @[@"StrictMode: يعيد الـ render مرتين", @"rtl"],
+      @[@"Supercalifragilisticexpialidocious مرحبا بكم", @"rtl"],
+      @[@"שלום documentation is available", @"ltr"],
+      @[@"hello שלום", @"ltr"], @[@"שלום hello", @"rtl"],
+      @[@"123 !!!", @""], @[@"\uFEFFhello\u00A0שלום\u3000עולם", @"rtl"],
+      @[@"𐤀 hello שלום", @"rtl"], @[@"َhello שלום", @"ltr"],
+      @[@"APIשלום مرحبا", @"ltr"], @[@"مرحباAPI hello", @"rtl"]
+    ];
+    for (NSArray *test in cases) check([(ENRMWordMajorityDirection(test[0]) ?: @"") isEqual:test[1]]);
+    MarkdownASTNode *english = node(MarkdownNodeTypeParagraph, nil, @[node(MarkdownNodeTypeText, @"English", nil)]);
+    MarkdownASTNode *arabic = node(MarkdownNodeTypeParagraph, nil, @[
+      node(MarkdownNodeTypeText, @"مرحبا بكم", nil), node(MarkdownNodeTypeSoftBreak, nil, nil),
+      node(MarkdownNodeTypeCode, nil, @[node(MarkdownNodeTypeText, @"many english code words", nil)])]);
+    MarkdownASTNode *chip = node(MarkdownNodeTypeLink, nil, @[node(MarkdownNodeTypeText, @"more english words here", nil)]);
+    chip.attributes[@"url"] = @"chip";
+    [arabic addChild:chip];
+    MarkdownASTNode *quote = node(MarkdownNodeTypeBlockquote, nil, @[english, arabic]);
+    MarkdownASTNode *left = node(MarkdownNodeTypeTableCell, nil, @[node(MarkdownNodeTypeText, @"Hello world", nil)]);
+    MarkdownASTNode *right = node(MarkdownNodeTypeTableCell, nil, @[node(MarkdownNodeTypeText, @"مرحبا بكم", nil)]);
+    MarkdownASTNode *table = node(MarkdownNodeTypeTable, nil, @[node(MarkdownNodeTypeTableRow, nil, @[left, right])]);
+    [quote addChild:table];
+    MarkdownASTNode *list = node(MarkdownNodeTypeUnorderedList, nil, @[
+      node(MarkdownNodeTypeListItem, nil, @[node(MarkdownNodeTypeText, @"English", nil)]),
+      node(MarkdownNodeTypeListItem, nil, @[node(MarkdownNodeTypeText, @"مرحبا بكم", nil)])]);
+    MarkdownASTNode *root = node(MarkdownNodeTypeDocument, nil, @[quote, list]);
+    ENRMAnnotateWordMajority(root, ^BOOL(NSString *url) { return [url isEqual:@"chip"]; });
+    for (MarkdownASTNode *item in @[quote, english, arabic, list, list.children[0], list.children[1]])
+      check([item.attributes[ENRMProseDirectionKey] isEqual:@"rtl"]);
+    check([left.attributes[ENRMProseDirectionKey] isEqual:@"ltr"]);
+    check([right.attributes[ENRMProseDirectionKey] isEqual:@"rtl"]);
+    check([table.attributes[ENRMProseDirectionKey] isEqual:@"ltr"]);
+    check([english.children[0].content isEqual:@"English"]);
+    [chip addChild:node(MarkdownNodeTypeLineBreak, nil, nil)];
+    ENRMAnnotateWordMajority(root, ^BOOL(NSString *url) { return [url isEqual:@"chip"]; });
+    check([quote.attributes[ENRMProseDirectionKey] isEqual:@"ltr"]);
+    NSString *source = @"\u200Freal \u2066code()\u2069 \u200F";
+    NSMutableAttributedString *selection = [[NSMutableAttributedString alloc] initWithString:source];
+    [selection addAttribute:ENRMDirectionControlKey value:@YES range:NSMakeRange(6, 1)];
+    [selection addAttribute:ENRMDirectionControlKey value:@YES range:NSMakeRange(13, 1)];
+    check([ENRMWithoutDirectionControls(selection).string isEqual:@"\u200Freal code() \u200F"]);
+    check([ENRMWithoutDirectionControls([selection attributedSubstringFromRange:NSMakeRange(6, 8)]).string isEqual:@"code()"]);
+    check([selection.string isEqual:source]);
+    puts("iOS: 11 word-direction cases and AST inheritance/code/chip/table/clipboard checks passed");
+  }
+}
