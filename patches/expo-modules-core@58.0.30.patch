+  /**
+   * onLaunch starts an Activity, which walks the window's view tree; launch() runs on the
+   * module's IO dispatcher, where that walk races the UI thread removing views (a menu closing)
+   * and throws a NullPointerException from dispatchCancelPendingInputEvents.
+   */
+  private fun launchOnMainThread(block: () -> Unit) {
+    if (Looper.myLooper() == Looper.getMainLooper()) {
+      block()
+      return
+    }
+    val launched = CountDownLatch(1)
+    var failure: Throwable? = null
+    Handler(Looper.getMainLooper()).post {
+      try {
+        block()
+      } catch (e: Throwable) {
+        failure = e
+      } finally {
+        launched.countDown()
+      }
+    }
+    launched.await()
+    failure?.let { throw it }
+  }
