+    AsyncFunction("loadImageAssetAsync") { (identifier: String, options: ImagePickerOptions) async throws -> ImagePickerResponse in
+      guard let fileSystem = self.appContext?.fileSystem else {
+        throw FileSystemModuleNotFoundException()
+      }
+      guard let asset = PHAsset.fetchAssets(withLocalIdentifiers: [identifier], options: nil).firstObject,
+            asset.mediaType == .image else {
+        throw FailedToReadImageException()
+      }
+      let inputOptions = PHContentEditingInputRequestOptions()
+      inputOptions.isNetworkAccessAllowed = options.shouldDownloadFromNetwork
+      let input = try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<PHContentEditingInput, Error>) in
+        asset.requestContentEditingInput(with: inputOptions) { input, _ in
+          guard let input else {
+            continuation.resume(throwing: FailedToReadImageException())
+            return
+          }
+          continuation.resume(returning: input)
+        }
+      }
+      guard let url = input.fullSizeImageURL, let provider = NSItemProvider(contentsOf: url) else {
+        throw FailedToReadImageException()
+      }
+      let handler = MediaHandler(fileSystem: fileSystem, options: options)
+      let result = try await handler.handleImage(itemProvider: provider, assetIdentifier: identifier)
+      return ImagePickerResponse(assets: [result], canceled: false)
+    }
