{
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["react"],
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "*.tsx"]
}
