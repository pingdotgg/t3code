{
  "name": "@t3tools/extension-sdk",
  "version": "1.0.0",
  "description": "SDK for trusted T3 Code host extensions",
  "homepage": "https://github.com/pingdotgg/t3code/blob/main/docs/extensions.md",
  "license": "MIT",
  "repository": {
    "type": "git",
