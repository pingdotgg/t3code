    "bundle": "onnx/english_2026-04",
    "license": "CC-BY-4.0",
    "baseModel": "kyutai/pocket-tts",
    "files": [
      "bundle.json",
      "text_conditioner.onnx",
      "flow_lm_main_int8.onnx",
      "flow_lm_flow.onnx",
      "mimi_decoder.onnx",
      "mimi_encoder.onnx",
      "tokenizer.model",
      "bos_before_voice.npy"
    ],
    "precision": "mixed (INT8 language model; FP32 flow network and Mimi decoder)"
  },
  "onnxRuntime": {
    "version": "1.23.2",
    "source": "https://github.com/microsoft/onnxruntime/releases",
