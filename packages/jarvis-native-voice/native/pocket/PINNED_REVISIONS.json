  },
  "sentencepiece": {
    "repository": "https://github.com/google/sentencepiece.git",
    "tag": "v0.2.1",
    "license": "Apache-2.0"
  },
  "voice": {
    "source": "https://huggingface.co/kyutai/tts-voices",
    "file": "alba-mackenna/casual.wav",
