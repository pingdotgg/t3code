{
  "runtime": {
    "repository": "https://github.com/VolgaGerm/PocketTTS.cpp",
    "commit": "e801e7d6c2692121a39e80ae525cb5265174a495",
    "license": "MIT",
    "notes": "Single-file C++ runtime. Built with the production edits in build-pocket-runtime.mjs, not the benchmark-only compatibility patch."
  },
  "models": {
    "repository": "https://huggingface.co/stephvax/pocket-tts-onnx",
