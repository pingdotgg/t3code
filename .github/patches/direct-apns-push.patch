+import { assert, describe, it } from "@effect/vitest";
+import {
+  EnvironmentId,
+  ProjectId,
+  ThreadId,
+  type OrchestrationV2DomainEvent,
+  type OrchestrationV2ThreadShell,
+  type PushDeviceRegistration,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Deferred from "effect/Deferred";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Ref from "effect/Ref";
+import * as Stream from "effect/Stream";
+import * as TestClock from "effect/testing/TestClock";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import * as ProjectService from "../project/ProjectService.ts";
+import * as DirectApnsClient from "./DirectApnsClient.ts";
+import * as DirectApnsDevices from "./DirectApnsDevices.ts";
+import * as DirectApnsNotifier from "./DirectApnsNotifier.ts";
+
+const NOW = "2026-09-04T12:00:00.000Z";
+const THREAD_ID = ThreadId.make("thread-1");
+const PROJECT_ID = ProjectId.make("project-1");
+
+// Only the fields the awareness projection and the notifier read.
+const shell = (overrides: Record<string, unknown>) =>
+  ({
+    id: THREAD_ID,
+    projectId: PROJECT_ID,
+    title: "Fix the bug",
+    modelSelection: { instanceId: "codex", model: "test-model" },
+    lineage: { rootThreadId: THREAD_ID, parentThreadId: null, relationshipToParent: null },
+    status: "running",
+    activityRunStatus: "running",
+    pendingRuntimeRequest: null,
+    pendingBackgroundTasks: [],
+    settledOverride: null,
+    archivedAt: null,
+    updatedAt: DateTime.makeUnsafe(NOW),
+    ...overrides,
+  }) as unknown as OrchestrationV2ThreadShell;
+
+const registration = (overrides: Partial<PushDeviceRegistration> = {}): PushDeviceRegistration => ({
+  deviceId: "iphone",
+  apnsToken: "a".repeat(64),
+  apsEnvironment: "sandbox",
+  bundleId: "com.example.t3code",
+  platform: "ios",
+  notificationsEnabled: true,
+  notifyOnApproval: true,
+  notifyOnInput: true,
+  notifyOnCompletion: true,
+  notifyOnFailure: true,
+  ...overrides,
+});
+
+const makeHarness = Effect.fnUntraced(function* (options: {
+  readonly configured?: boolean;
+  readonly domainEvents?: Stream.Stream<OrchestrationV2DomainEvent>;
+  readonly respond?: (
+    device: DirectApnsDevices.StoredPushDevice,
+  ) => DirectApnsClient.DirectApnsSendResult;
+}) {
+  const currentShell = yield* Ref.make<OrchestrationV2ThreadShell | null>(shell({}));
+  const reads: ThreadId[] = [];
+  const firstRead = yield* Deferred.make<void>();
+  const sent: Array<{ deviceId: string; title: string; body: string; phase: string }> = [];
+  const values = new Map<string, Uint8Array>();
+  const secrets = Layer.succeed(
+    ServerSecretStore.ServerSecretStore,
+    ServerSecretStore.ServerSecretStore.of({
+      get: (name) => Effect.sync(() => Option.fromUndefinedOr(values.get(name))),
+      set: (name, value) => Effect.sync(() => void values.set(name, value)),
+      create: (name, value) => Effect.sync(() => void values.set(name, value)),
+      remove: (name) => Effect.sync(() => void values.delete(name)),
+      getOrCreateRandom: () => Effect.die("unused"),
+    }),
+  );
+  const devicesLayer = DirectApnsDevices.layer.pipe(Layer.provide(secrets));
+  const layer = DirectApnsNotifier.layer.pipe(
+    Layer.provideMerge(devicesLayer),
+    Layer.provide(
+      Layer.succeed(
+        DirectApnsClient.DirectApnsClient,
+        DirectApnsClient.DirectApnsClient.of({
+          isConfigured: Effect.succeed(options.configured ?? true),
+          send: ({ device, notification }) =>
+            Effect.sync(() => {
+              sent.push({
+                deviceId: device.deviceId,
+                title: notification.title,
+                body: notification.body,
+                phase: notification.phase,
+              });
+              return options.respond?.(device) ?? { outcome: "sent" as const };
+            }),
+        }),
+      ),
+    ),
+    Layer.provide(
+      Layer.mock(ThreadManagement.ThreadManagementService)({
+        getThreadShell: (threadId) =>
+          Effect.sync(() => reads.push(threadId)).pipe(
+            Effect.andThen(Ref.get(currentShell)),
+            Effect.tap(() => Deferred.succeed(firstRead, undefined)),
+          ),
+        getShellSnapshot: () =>
+          Ref.get(currentShell).pipe(
+            Effect.map((current) => ({
+              schemaVersion: 2,
+              snapshotSequence: 1,
+              threads: current === null ? [] : [current],
+              archivedThreads: [],
+            })),
+          ) as never,
+        streamDomainEvents: options.domainEvents ?? Stream.empty,
+      }),
+    ),
+    Layer.provide(
+      Layer.mock(ProjectService.ProjectService)({
+        getById: () => Effect.succeed(Option.some({ id: PROJECT_ID, title: "Project" } as never)),
+        snapshot: Effect.succeed({ projects: [{ id: PROJECT_ID, title: "Project" }] } as never),
+      }),
+    ),
+    Layer.provide(
+      Layer.succeed(ServerEnvironment.ServerEnvironment, {
+        getEnvironmentId: Effect.succeed(EnvironmentId.make("env-1")),
+        getDescriptor: Effect.die("unused"),
+      } as never),
+    ),
+  );
+  return { layer, currentShell, sent, reads, firstRead };
+});
+
+describe("DirectApnsNotifier", () => {
+  it.effect("alerts every registered device on a transition, never on the first observation", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(Date.parse(NOW));
+      const harness = yield* makeHarness({});
+      yield* Effect.gen(function* () {
+        const notifier = yield* DirectApnsNotifier.DirectApnsNotifier;
+        const devices = yield* DirectApnsDevices.DirectApnsDevices;
+        yield* devices.register(registration());
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: "b".repeat(64) }));
+
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.deepStrictEqual(harness.sent, []);
+
+        yield* Ref.set(
+          harness.currentShell,
+          shell({ activityRunStatus: "completed", status: "completed" }),
+        );
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.deepStrictEqual(
+          harness.sent.map((push) => [push.deviceId, push.title, push.body, push.phase]).toSorted(),
+          [
+            ["ipad", "Fix the bug", "Done: Project", "completed"],
+            ["iphone", "Fix the bug", "Done: Project", "completed"],
+          ],
+        );
+
+        // Re-observing the same terminal state is not a new transition.
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.strictEqual(harness.sent.length, 2);
+      }).pipe(Effect.provide(harness.layer));
+    }),
+  );
+
+  it.effect("skips devices whose preferences exclude the transition", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(Date.parse(NOW));
+      const harness = yield* makeHarness({});
+      yield* Effect.gen(function* () {
+        const notifier = yield* DirectApnsNotifier.DirectApnsNotifier;
+        const devices = yield* DirectApnsDevices.DirectApnsDevices;
+        yield* devices.register(registration({ notifyOnCompletion: false }));
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: "b".repeat(64) }));
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        yield* Ref.set(
+          harness.currentShell,
+          shell({ activityRunStatus: "completed", status: "completed" }),
+        );
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.deepStrictEqual(
+          harness.sent.map((push) => push.deviceId),
+          ["ipad"],
+        );
+      }).pipe(Effect.provide(harness.layer));
+    }),
+  );
+
+  it.effect("deletes a token APNs rejects as dead and keeps the other devices", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(Date.parse(NOW));
+      const harness = yield* makeHarness({
+        respond: (device) =>
+          device.deviceId === "iphone"
+            ? { outcome: "rejected", status: 400, reason: "BadDeviceToken", removeToken: true }
+            : { outcome: "sent" },
+      });
+      yield* Effect.gen(function* () {
+        const notifier = yield* DirectApnsNotifier.DirectApnsNotifier;
+        const devices = yield* DirectApnsDevices.DirectApnsDevices;
+        yield* devices.register(registration());
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: "b".repeat(64) }));
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        yield* Ref.set(
+          harness.currentShell,
+          shell({ activityRunStatus: "failed", status: "failed" }),
+        );
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.deepStrictEqual(
+          (yield* devices.list).map((device) => device.deviceId),
+          ["ipad"],
+        );
+      }).pipe(Effect.provide(harness.layer));
+    }),
+  );
+
+  it.effect("does nothing, and reads nothing, while APNs credentials are not configured", () =>
+    Effect.gen(function* () {
+      yield* TestClock.setTime(Date.parse(NOW));
+      const harness = yield* makeHarness({ configured: false });
+      yield* Effect.gen(function* () {
+        const notifier = yield* DirectApnsNotifier.DirectApnsNotifier;
+        const devices = yield* DirectApnsDevices.DirectApnsDevices;
+        yield* devices.register(registration());
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        yield* Ref.set(
+          harness.currentShell,
+          shell({ activityRunStatus: "completed", status: "completed" }),
+        );
+        yield* notifier.observeThread(THREAD_ID);
+        yield* notifier.drain;
+        assert.deepStrictEqual(harness.sent, []);
+      }).pipe(Effect.provide(harness.layer));
+    }),
+  );
+
+  it.effect("reads a thread only for events that can change its phase", () =>
+    Effect.gen(function* () {
+      const event = (type: string, threadId: ThreadId) =>
+        ({ type, threadId, payload: {} }) as unknown as OrchestrationV2DomainEvent;
+      const harness = yield* makeHarness({
+        domainEvents: Stream.make(
+          event("message.updated", ThreadId.make("chatty")),
+          event("turn-item.updated", ThreadId.make("chatty")),
+          event("run.updated", THREAD_ID),
+        ),
+      });
+      yield* Effect.gen(function* () {
+        const notifier = yield* DirectApnsNotifier.DirectApnsNotifier;
+        yield* notifier.start();
+        yield* Deferred.await(harness.firstRead);
+        yield* notifier.drain;
+        assert.deepStrictEqual(harness.reads, [THREAD_ID]);
+      }).pipe(Effect.provide(harness.layer));
+    }),
+  );
+});
diff --git a/apps/server/src/relay/DirectApnsNotifier.ts b/apps/server/src/relay/DirectApnsNotifier.ts
new file mode 100644
index 0000000000..c90817d483
--- /dev/null
+++ b/apps/server/src/relay/DirectApnsNotifier.ts
@@ -0,0 +1,177 @@
+import type { OrchestrationV2DomainEvent, ThreadId } from "@t3tools/contracts";
+import { projectThreadAwarenessV2 } from "@t3tools/shared/agentAwareness";
+import { makeDrainableWorker } from "@t3tools/shared/DrainableWorker";
+import { turnItemUpdateCanEndBackgroundWork } from "@t3tools/shared/orchestrationV2PendingBackgroundWork";
+import * as Cause from "effect/Cause";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import type * as Scope from "effect/Scope";
+import * as Stream from "effect/Stream";
+
+import * as ServerEnvironment from "../environment/ServerEnvironment.ts";
+import * as ThreadManagement from "../orchestration-v2/ThreadManagementService.ts";
+import * as ProjectService from "../project/ProjectService.ts";
+import { forkParked } from "../serverActivation.ts";
+import * as DirectApnsClient from "./DirectApnsClient.ts";
+import * as DirectApnsDevices from "./DirectApnsDevices.ts";
+import { alertForTransition, makePhaseTracker, notificationForState } from "./directApnsPolicy.ts";
+
+const SEND_CONCURRENCY = 4;
+
+// Only these events can change a thread's awareness phase. Turn-item updates matter
+// when they end background work that was holding a completion back.
+const PHASE_EVENT_TYPES = new Set<string>([
+  "thread.created",
+  "thread.archived",
+  "thread.unarchived",
+  "thread.deleted",
+  "thread.settled",
+  "run.created",
+  "run.updated",
+  "runtime-request.updated",
+  "subagent.updated",
+  "provider-thread.updated",
+]);
+
+function affectsAwarenessPhase(event: OrchestrationV2DomainEvent): boolean {
+  if (PHASE_EVENT_TYPES.has(event.type)) return true;
+  const payload: unknown = "payload" in event ? event.payload : undefined;
+  return (
+    event.type === "turn-item.updated" &&
+    typeof payload === "object" &&
+    payload !== null &&
+    "type" in payload &&
+    "status" in payload &&
+    turnItemUpdateCanEndBackgroundWork(
+      payload as Parameters<typeof turnItemUpdateCanEndBackgroundWork>[0],
+    )
+  );
+}
+
+/**
+ * Sends alert pushes straight to APNs for threads on this environment, for
+ * forks whose bundle ID the official relay's APNs key cannot reach. It reads the
+ * same domain events and awareness projection as AgentAwarenessRelay but is
+ * independent of T3 Connect: no relay link is required.
+ */
+export class DirectApnsNotifier extends Context.Service<
+  DirectApnsNotifier,
+  {
+    readonly observeThread: (threadId: ThreadId) => Effect.Effect<void>;
+    readonly drain: Effect.Effect<void>;
+    readonly start: () => Effect.Effect<void, never, Scope.Scope>;
+  }
+>()("t3/relay/DirectApnsNotifier") {}
+
+const make = Effect.gen(function* () {
+  const serverEnvironment = yield* ServerEnvironment.ServerEnvironment;
+  const threads = yield* ThreadManagement.ThreadManagementService;
+  const projects = yield* ProjectService.ProjectService;
+  const devices = yield* DirectApnsDevices.DirectApnsDevices;
+  const client = yield* DirectApnsClient.DirectApnsClient;
+  const tracker = makePhaseTracker();
+
+  const process = Effect.fn("DirectApnsNotifier.process")(function* (threadId: ThreadId) {
+    if (!(yield* client.isConfigured)) {
+      yield* Effect.logDebug("direct APNs notifier idle; credentials not configured");
+      return;
+    }
+    const shell = yield* threads.getThreadShell(threadId);
+    if (shell === null || shell.archivedAt !== null) {
+      tracker.forget(threadId);
+      return;
+    }
+    const project = yield* projects.getById(shell.projectId);
+    if (Option.isNone(project)) return;
+    const state = projectThreadAwarenessV2({
+      environmentId: yield* serverEnvironment.getEnvironmentId,
+      project: project.value,
+      thread: shell,
+    });
+    const { previous } = tracker.observe(threadId, state);
+    if (state === null) return;
+    const nowMs = yield* Clock.currentTimeMillis;
+    const recipients = (yield* devices.list).filter((device) =>
+      alertForTransition({ previous, state, preferences: device, nowMs }),
+    );
+    if (recipients.length === 0) return;
+    const notification = notificationForState(state);
+    yield* Effect.forEach(
+      recipients,
+      (device) =>
+        client.send({ device, notification }).pipe(
+          Effect.flatMap((result) =>
+            result.outcome === "rejected" && result.removeToken
+              ? devices.removeRejectedToken({
+                  deviceId: device.deviceId,
+                  apnsToken: device.apnsToken,
+                })
+              : Effect.void,
+          ),
+        ),
+      { concurrency: SEND_CONCURRENCY, discard: true },
+    );
+  });
+
+  // A thread queued twice before its turn is processed is read once, from the latest state.
+  const queued = new Set<ThreadId>();
+  const worker = yield* makeDrainableWorker((threadId: ThreadId) =>
+    Effect.sync(() => queued.delete(threadId)).pipe(
+      Effect.andThen(process(threadId)),
+      // A failing push must never disturb the thread or the relay publish path.
+      Effect.catchCause((cause) =>
+        Cause.hasInterruptsOnly(cause)
+          ? Effect.void
+          : Effect.logWarning("direct APNs notification failed", {
+              threadId,
+              cause: Cause.pretty(cause),
+            }),
+      ),
+    ),
+  );
+  const enqueue = (threadId: ThreadId) =>
+    Effect.suspend(() => {
+      if (queued.has(threadId)) return Effect.void;
+      queued.add(threadId);
+      return worker.enqueue(threadId);
+    });
+
+  // Threads already waiting or finished at startup are the baseline, not news.
+  const seedBaseline = Effect.gen(function* () {
+    const [projectSnapshot, shellSnapshot] = yield* Effect.all([
+      projects.snapshot,
+      threads.getShellSnapshot(),
+    ]);
+    const environmentId = yield* serverEnvironment.getEnvironmentId;
+    const projectById = new Map(projectSnapshot.projects.map((project) => [project.id, project]));
+    for (const shell of shellSnapshot.threads) {
+      const project = projectById.get(shell.projectId);
+      if (!project || shell.archivedAt !== null) continue;
+      tracker.seed(shell.id, projectThreadAwarenessV2({ environmentId, project, thread: shell }));
+    }
+  });
+
+  return DirectApnsNotifier.of({
+    observeThread: enqueue,
+    drain: worker.drain,
+    start: Effect.fn("DirectApnsNotifier.start")(function* () {
+      yield* forkParked(
+        seedBaseline.pipe(
+          Effect.catchCause((cause) =>
+            Effect.logWarning("direct APNs baseline failed", { cause: Cause.pretty(cause) }),
+          ),
+        ),
+      );
+      yield* forkParked(
+        Stream.runForEach(threads.streamDomainEvents, (event) =>
+          affectsAwarenessPhase(event) ? enqueue(event.threadId) : Effect.void,
+        ),
+      );
+    }),
+  });
+});
+
+export const layer = Layer.effect(DirectApnsNotifier, make);
