diff --git a/apps/server/src/relay/DirectApnsClient.test.ts b/apps/server/src/relay/DirectApnsClient.test.ts
new file mode 100644
index 0000000000..db8bd9e99b
--- /dev/null
+++ b/apps/server/src/relay/DirectApnsClient.test.ts
@@ -0,0 +1,268 @@
+// @effect-diagnostics-next-line nodeBuiltinImport:off -- Generates a throwaway P-256 key for signing.
+import * as NodeCrypto from "node:crypto";
+import * as NodeHttp2 from "node:http2";
+
+import { assert, describe, it } from "@effect/vitest";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import * as DirectApnsClient from "./DirectApnsClient.ts";
+import type { StoredPushDevice } from "./DirectApnsDevices.ts";
+
+const { privateKey } = NodeCrypto.generateKeyPairSync("ec", { namedCurve: "prime256v1" });
+const PRIVATE_PEM = privateKey.export({ type: "pkcs8", format: "pem" }).toString();
+
+const device = (overrides: Partial<StoredPushDevice> = {}): StoredPushDevice => ({
+  deviceId: "iphone",
+  apnsToken: "ab".repeat(32),
+  apsEnvironment: "sandbox",
+  bundleId: "com.example.t3code",
+  platform: "ios",
+  notificationsEnabled: true,
+  notifyOnApproval: true,
+  notifyOnInput: true,
+  notifyOnCompletion: true,
+  notifyOnFailure: true,
+  ...overrides,
+});
+
+const notification = {
+  title: "Fix the bug",
+  body: "Needs approval: Project",
+  environmentId: "env-1",
+  threadId: "thread-1",
+  deepLink: "/threads/env-1/thread-1",
+  phase: "waiting_for_approval",
+  updatedAt: "2026-09-04T11:59:30.000Z",
+};
+
+const ENV = {
+  T3CODE_APNS_KEY_ID: "KEY1234567",
+  T3CODE_APNS_TEAM_ID: "TEAM123456",
+  T3CODE_APNS_PRIVATE_KEY_PATH: "/keys/AuthKey.p8",
+};
+
+const fileSystemWith = (files: Record<string, string>) =>
+  FileSystem.layerNoop({
+    readFileString: (path) =>
+      path in files ? Effect.succeed(files[path]!) : Effect.die(`unexpected read of ${path}`),
+  });
+
+const secretsWith = (values: Record<string, string> = {}) =>
+  Layer.succeed(
+    ServerSecretStore.ServerSecretStore,
+    ServerSecretStore.ServerSecretStore.of({
+      get: (name) =>
+        Effect.succeed(
+          name in values ? Option.some(new TextEncoder().encode(values[name]!)) : Option.none(),
+        ),
+      set: () => Effect.die("unused"),
+      create: () => Effect.die("unused"),
+      remove: () => Effect.die("unused"),
+      getOrCreateRandom: () => Effect.die("unused"),
+    }),
+  );
+
+const makeHarness = (options: {
+  readonly env?: Record<string, string>;
+  readonly secrets?: Record<string, string>;
+  readonly respond?: (
+    request: DirectApnsClient.ApnsHttp2Request,
+  ) => DirectApnsClient.ApnsHttp2Response;
+}) => {
+  const requests: DirectApnsClient.ApnsHttp2Request[] = [];
+  const transport = Layer.succeed(
+    DirectApnsClient.DirectApnsTransport,
+    DirectApnsClient.DirectApnsTransport.of({
+      post: (request) =>
+        Effect.sync(() => {
+          requests.push(request);
+          return options.respond?.(request) ?? { status: 200, body: "" };
+        }),
+    }),
+  );
+  const layer = DirectApnsClient.layer.pipe(
+    Layer.provide(transport),
+    Layer.provide(fileSystemWith({ "/keys/AuthKey.p8": PRIVATE_PEM })),
+    Layer.provide(secretsWith(options.secrets)),
+    Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnv({ env: options.env ?? ENV }))),
+  );
+  return { requests, layer };
+};
+
+const send = (input: Parameters<DirectApnsClient.DirectApnsClient["Service"]["send"]>[0]) =>
+  DirectApnsClient.DirectApnsClient.use((client) => client.send(input));
+
+describe("DirectApnsClient", () => {
+  it.effect("posts an alert push to the sandbox host with the APNs headers and payload", () => {
+    const harness = makeHarness({});
+    return Effect.gen(function* () {
+      const result = yield* send({ device: device(), notification });
+      assert.strictEqual(result.outcome, "sent");
+      const [request] = harness.requests;
+      assert.strictEqual(request?.origin, "https://api.sandbox.push.apple.com");
+      assert.strictEqual(request?.path, `/3/device/${"ab".repeat(32)}`);
+      assert.strictEqual(request?.headers["apns-push-type"], "alert");
+      assert.strictEqual(request?.headers["apns-topic"], "com.example.t3code");
+      assert.strictEqual(request?.headers["apns-priority"], "10");
+      assert.match(request?.headers.authorization ?? "", /^bearer [\w-]+\.[\w-]+\.[\w-]+$/);
+      assert.deepStrictEqual(JSON.parse(request?.body ?? ""), {
+        aps: {
+          alert: { title: "Fix the bug", body: "Needs approval: Project" },
+          sound: "default",
+          "thread-id": "env-1/thread-1",
+        },
+        body: {
+          environmentId: "env-1",
+          threadId: "thread-1",
+          deepLink: "/threads/env-1/thread-1",
+          phase: "waiting_for_approval",
+          updatedAt: "2026-09-04T11:59:30.000Z",
+        },
+      });
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("picks the APNs host per device token, not per server", () => {
+    const harness = makeHarness({});
+    return Effect.gen(function* () {
+      yield* send({ device: device({ apsEnvironment: "production" }), notification });
+      yield* send({ device: device({ apsEnvironment: "sandbox" }), notification });
+      assert.deepStrictEqual(
+        harness.requests.map((request) => request.origin),
+        ["https://api.push.apple.com", "https://api.sandbox.push.apple.com"],
+      );
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("reuses one provider token across pushes", () => {
+    const harness = makeHarness({});
+    return Effect.gen(function* () {
+      yield* send({ device: device(), notification });
+      yield* send({ device: device({ deviceId: "ipad" }), notification });
+      assert.strictEqual(
+        harness.requests[0]?.headers.authorization,
+        harness.requests[1]?.headers.authorization,
+      );
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("is a silent no-op that sends nothing when credentials are not configured", () => {
+    const harness = makeHarness({ env: {} });
+    return Effect.gen(function* () {
+      const client = yield* DirectApnsClient.DirectApnsClient;
+      assert.strictEqual(yield* client.isConfigured, false);
+      const result = yield* client.send({ device: device(), notification });
+      assert.strictEqual(result.outcome, "unconfigured");
+      assert.strictEqual(harness.requests.length, 0);
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("falls back to credentials in the secret store", () => {
+    const harness = makeHarness({
+      env: {},
+      secrets: {
+        "apns-key-id": "KEY1234567",
+        "apns-team-id": "TEAM123456",
+        "apns-private-key": PRIVATE_PEM,
+      },
+    });
+    return Effect.gen(function* () {
+      const result = yield* send({ device: device(), notification });
+      assert.strictEqual(result.outcome, "sent");
+      assert.strictEqual(harness.requests.length, 1);
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect.each([
+    [410, "Unregistered"],
+    [400, "BadDeviceToken"],
+    [400, "DeviceTokenNotForTopic"],
+  ] as const)("flags the token for removal on %s %s", ([status, reason]) => {
+    const harness = makeHarness({ respond: () => ({ status, body: JSON.stringify({ reason }) }) });
+    return Effect.gen(function* () {
+      const result = yield* send({ device: device(), notification });
+      assert.deepStrictEqual(result, { outcome: "rejected", status, reason, removeToken: true });
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("keeps the token after a transient rejection", () => {
+    const harness = makeHarness({
+      respond: () => ({ status: 429, body: JSON.stringify({ reason: "TooManyRequests" }) }),
+    });
+    return Effect.gen(function* () {
+      const result = yield* send({ device: device(), notification });
+      assert.deepStrictEqual(result, {
+        outcome: "rejected",
+        status: 429,
+        reason: "TooManyRequests",
+        removeToken: false,
+      });
+    }).pipe(Effect.provide(harness.layer));
+  });
+
+  it.effect("reports a transport failure instead of failing the caller", () => {
+    const layer = DirectApnsClient.layer.pipe(
+      Layer.provide(
+        Layer.succeed(
+          DirectApnsClient.DirectApnsTransport,
+          DirectApnsClient.DirectApnsTransport.of({
+            post: () =>
+              Effect.fail(new DirectApnsClient.DirectApnsTransportError({ cause: "boom" })),
+          }),
+        ),
+      ),
+      Layer.provide(fileSystemWith({ "/keys/AuthKey.p8": PRIVATE_PEM })),
+      Layer.provide(secretsWith()),
+      Layer.provide(ConfigProvider.layer(ConfigProvider.fromEnv({ env: ENV }))),
+    );
+    return Effect.gen(function* () {
+      const result = yield* send({ device: device(), notification });
+      assert.deepStrictEqual(result, { outcome: "error", removeToken: false });
+    }).pipe(Effect.provide(layer));
+  });
+});
+
+describe("node http2 transport", () => {
+  it.live("speaks HTTP/2 and returns the status and body", () =>
+    Effect.scoped(
+      Effect.gen(function* () {
+        const seen: Array<{ headers: NodeHttp2.IncomingHttpHeaders; body: string }> = [];
+        const server = NodeHttp2.createServer((request, response) => {
+          const chunks: Buffer[] = [];
+          request.on("data", (chunk: Buffer) => chunks.push(chunk));
+          request.on("end", () => {
+            seen.push({ headers: request.headers, body: Buffer.concat(chunks).toString("utf8") });
+            response.writeHead(400, { "content-type": "application/json" });
+            response.end(JSON.stringify({ reason: "BadDeviceToken" }));
+          });
+        });
+        yield* Effect.addFinalizer(() => Effect.sync(() => server.close()));
+        const port = yield* Effect.promise(
+          () =>
+            new Promise<number>((resolve) =>
+              server.listen(0, "127.0.0.1", () =>
+                resolve((server.address() as { port: number }).port),
+              ),
+            ),
+        );
+        const transport = yield* DirectApnsClient.makeNodeHttp2Transport;
+        const response = yield* transport.post({
+          origin: `http://127.0.0.1:${port}`,
+          path: "/3/device/abc",
+          headers: { "apns-topic": "com.example.t3code", authorization: "bearer x" },
+          body: '{"aps":{}}',
+        });
+        assert.deepStrictEqual(response, { status: 400, body: '{"reason":"BadDeviceToken"}' });
+        assert.strictEqual(seen[0]?.headers[":method"], "POST");
+        assert.strictEqual(seen[0]?.headers[":path"], "/3/device/abc");
+        assert.strictEqual(seen[0]?.headers["apns-topic"], "com.example.t3code");
+        assert.strictEqual(seen[0]?.body, '{"aps":{}}');
+      }),
+    ),
+  );
+});
diff --git a/apps/server/src/relay/DirectApnsClient.ts b/apps/server/src/relay/DirectApnsClient.ts
new file mode 100644
index 0000000000..bf13f8932e
--- /dev/null
+++ b/apps/server/src/relay/DirectApnsClient.ts
@@ -0,0 +1,297 @@
+// @effect-diagnostics nodeBuiltinImport:off -- APNs requires HTTP/2, which Effect's HttpClient and Node's fetch do not guarantee.
+import * as NodeHttp2 from "node:http2";
+
+import { makeApnsProviderTokenCache } from "@t3tools/shared/apnsProviderToken";
+import * as Clock from "effect/Clock";
+import * as Config from "effect/Config";
+import * as ConfigProvider from "effect/ConfigProvider";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import type { DirectApnsNotification } from "./directApnsPolicy.ts";
+import type { StoredPushDevice } from "./DirectApnsDevices.ts";
+
+const APNS_PRODUCTION_ORIGIN = "https://api.push.apple.com";
+const APNS_SANDBOX_ORIGIN = "https://api.sandbox.push.apple.com";
+const APNS_REQUEST_TIMEOUT = "10 seconds";
+
+// Credentials come from the environment, with the secret store as an
+// alternative for servers that cannot set env vars.
+const KEY_ID_ENV = "T3CODE_APNS_KEY_ID";
+const TEAM_ID_ENV = "T3CODE_APNS_TEAM_ID";
+const PRIVATE_KEY_PATH_ENV = "T3CODE_APNS_PRIVATE_KEY_PATH";
+const KEY_ID_SECRET = "apns-key-id";
+const TEAM_ID_SECRET = "apns-team-id";
+const PRIVATE_KEY_SECRET = "apns-private-key";
+
+const PERMANENT_TOKEN_REASONS = new Set([
+  "BadDeviceToken",
+  "DeviceTokenNotForTopic",
+  "Unregistered",
+]);
+
+export interface ApnsHttp2Request {
+  readonly origin: string;
+  readonly path: string;
+  readonly headers: Readonly<Record<string, string>>;
+  readonly body: string;
+}
+
+export interface ApnsHttp2Response {
+  readonly status: number;
+  readonly body: string;
+}
+
+export class DirectApnsTransportError extends Schema.TaggedError<DirectApnsTransportError>()(
+  "DirectApnsTransportError",
+  { cause: Schema.Defect() },
+) {
+  override get message(): string {
+    return "APNs request failed.";
+  }
+}
+
+export class DirectApnsTransport extends Context.Service<
+  DirectApnsTransport,
+  {
+    readonly post: (
+      request: ApnsHttp2Request,
+    ) => Effect.Effect<ApnsHttp2Response, DirectApnsTransportError>;
+  }
+>()("t3/relay/DirectApnsClient/DirectApnsTransport") {}
+
+export type DirectApnsSendResult =
+  | { readonly outcome: "sent" }
+  | { readonly outcome: "unconfigured" }
+  | {
+      readonly outcome: "rejected";
+      readonly status: number;
+      readonly reason: string | undefined;
+      /** The token is permanently dead and must not be tried again. */
+      readonly removeToken: boolean;
+    }
+  | { readonly outcome: "error"; readonly removeToken: false };
+
+export class DirectApnsClient extends Context.Service<
+  DirectApnsClient,
+  {
+    readonly isConfigured: Effect.Effect<boolean>;
+    readonly send: (input: {
+      readonly device: StoredPushDevice;
+      readonly notification: DirectApnsNotification;
+    }) => Effect.Effect<DirectApnsSendResult>;
+  }
+>()("t3/relay/DirectApnsClient") {}
+
+const decodeErrorBody = Schema.decodeUnknownOption(
+  Schema.fromJsonString(Schema.Struct({ reason: Schema.optional(Schema.String) })),
+);
+const encodeJson = Schema.encodeSync(Schema.fromJsonString(Schema.Unknown));
+
+const reasonFromBody = (body: string): string | undefined =>
+  Option.getOrUndefined(decodeErrorBody(body))?.reason;
+
+export const makeNodeHttp2Transport = Effect.gen(function* () {
+  const sessions = new Map<string, NodeHttp2.ClientHttp2Session>();
+  yield* Effect.addFinalizer(() =>
+    Effect.sync(() => {
+      for (const session of sessions.values()) session.close();
+      sessions.clear();
+    }),
+  );
+
+  // One long-lived session per APNs host: Apple asks providers to keep
+  // connections open rather than reconnecting for every push.
+  const sessionFor = (origin: string) => {
+    const existing = sessions.get(origin);
+    if (existing && !existing.closed && !existing.destroyed) return existing;
+    const session = NodeHttp2.connect(origin);
+    session.unref();
+    const forget = () => {
+      if (sessions.get(origin) === session) sessions.delete(origin);
+    };
+    // Request-level errors reach the caller through the stream; this only
+    // keeps a dead session from being reused.
+    session.on("error", forget);
+    session.on("close", forget);
+    session.on("goaway", () => {
+      forget();
+      session.close();
+    });
+    sessions.set(origin, session);
+    return session;
+  };
+
+  return DirectApnsTransport.of({
+    post: (request) =>
+      Effect.tryPromise({
+        try: (signal) =>
+          new Promise<ApnsHttp2Response>((resolve, reject) => {
+            const stream = sessionFor(request.origin).request({
+              ":method": "POST",
+              ":path": request.path,
+              ...request.headers,
+            });
+            const chunks: Buffer[] = [];
+            let status = 0;
+            signal.addEventListener("abort", () =>
+              stream.close(NodeHttp2.constants.NGHTTP2_CANCEL),
+            );
+            stream.on("response", (headers) => {
+              status = Number(headers[":status"] ?? 0);
+            });
+            stream.on("data", (chunk: Buffer) => chunks.push(chunk));
+            stream.on("end", () =>
+              resolve({ status, body: Buffer.concat(chunks).toString("utf8") }),
+            );
+            stream.on("error", reject);
+            stream.end(request.body);
+          }),
+        catch: (cause) => new DirectApnsTransportError({ cause }),
+      }).pipe(
+        Effect.timeoutOrElse({
+          duration: APNS_REQUEST_TIMEOUT,
+          orElse: () =>
+            Effect.fail(new DirectApnsTransportError({ cause: "APNs request timed out" })),
+        }),
+      ),
+  });
+});
+
+export const transportLayer = Layer.effect(DirectApnsTransport, makeNodeHttp2Transport);
+
+const make = Effect.gen(function* () {
+  const transport = yield* DirectApnsTransport;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const secrets = yield* ServerSecretStore.ServerSecretStore;
+  const configProvider = yield* ConfigProvider.ConfigProvider;
+  const providerTokens = makeApnsProviderTokenCache();
+
+  const readSecret = (name: string) =>
+    secrets.get(name).pipe(
+      Effect.map(Option.map((bytes) => new TextDecoder().decode(bytes).trim())),
+      Effect.orElseSucceed(() => Option.none<string>()),
+    );
+
+  const readConfig = (name: string) =>
+    Config.String(name).pipe(
+      Config.option,
+      // The send path runs outside the layer's context, so pin the provider it was built with.
+      Effect.provideService(ConfigProvider.ConfigProvider, configProvider),
+      Effect.map(Option.filter((value) => value.trim().length > 0)),
+      Effect.orElseSucceed(() => Option.none<string>()),
+    );
+
+  const readPrivateKey = Effect.gen(function* () {
+    const path = yield* readConfig(PRIVATE_KEY_PATH_ENV);
+    if (Option.isNone(path)) return yield* readSecret(PRIVATE_KEY_SECRET);
+    // An unreadable key file is a misconfiguration, never a reason to fail a thread.
+    return yield* fileSystem.readFileString(path.value).pipe(
+      Effect.map(Option.some),
+      Effect.tapError(() =>
+        Effect.logWarning("direct APNs key file could not be read", {
+          envVar: PRIVATE_KEY_PATH_ENV,
+        }),
+      ),
+      Effect.orElseSucceed(() => Option.none<string>()),
+    );
+  });
+
+  const readCredentials = Effect.gen(function* () {
+    const keyId = Option.orElse(yield* readConfig(KEY_ID_ENV), () => Option.none<string>());
+    const teamId = yield* readConfig(TEAM_ID_ENV);
+    const privateKey = yield* readPrivateKey;
+    return Option.all({
+      keyId: Option.isSome(keyId) ? keyId : yield* readSecret(KEY_ID_SECRET),
+      teamId: Option.isSome(teamId) ? teamId : yield* readSecret(TEAM_ID_SECRET),
+      privateKey,
+    });
+  });
+
+  const send: DirectApnsClient["Service"]["send"] = Effect.fn("DirectApnsClient.send")(function* ({
+    device,
+    notification,
+  }) {
+    const credentials = yield* readCredentials;
+    if (Option.isNone(credentials)) {
+      yield* Effect.logDebug("direct APNs push skipped; credentials not configured");
+      return { outcome: "unconfigured" } as const;
+    }
+    const nowSeconds = Math.floor((yield* Clock.currentTimeMillis) / 1_000);
+    const jwt = yield* Effect.try(() => providerTokens.getJwt(credentials.value, nowSeconds)).pipe(
+      Effect.option,
+    );
+    if (Option.isNone(jwt)) {
+      yield* Effect.logWarning("direct APNs provider token could not be signed; check the .p8 key");
+      return { outcome: "error", removeToken: false } as const;
+    }
+    const response = yield* transport
+      .post({
+        // The token's own environment decides the host: a dev build and a
+        // store build can both be registered with one server.
+        origin:
+          device.apsEnvironment === "production" ? APNS_PRODUCTION_ORIGIN : APNS_SANDBOX_ORIGIN,
+        path: `/3/device/${device.apnsToken}`,
+        headers: {
+          authorization: `bearer ${jwt.value}`,
+          "apns-push-type": "alert",
+          "apns-topic": device.bundleId,
+          "apns-priority": "10",
+          "content-type": "application/json",
+        },
+        body: encodeJson({
+          aps: {
+            alert: { title: notification.title, body: notification.body },
+            sound: "default",
+            "thread-id":
+              notification.threadId.length > 0
+                ? `${notification.environmentId}/${notification.threadId}`
+                : "t3-agent-alerts",
+          },
+          // Expo iOS exposes userInfo.body as notification.content.data.
+          body: {
+            environmentId: notification.environmentId,
+            threadId: notification.threadId,
+            deepLink: notification.deepLink,
+            phase: notification.phase,
+            updatedAt: notification.updatedAt,
+          },
+        }),
+      })
+      .pipe(Effect.option);
+    if (Option.isNone(response)) {
+      yield* Effect.logWarning("direct APNs push failed in transport", {
+        deviceId: device.deviceId,
+      });
+      return { outcome: "error", removeToken: false } as const;
+    }
+    const { status, body } = response.value;
+    if (status >= 200 && status < 300) return { outcome: "sent" } as const;
+    const reason = reasonFromBody(body);
+    yield* Effect.logWarning("direct APNs push rejected", {
+      deviceId: device.deviceId,
+      status,
+      reason,
+    });
+    return {
+      outcome: "rejected",
+      status,
+      reason,
+      removeToken:
+        status === 410 ||
+        (status === 400 && reason !== undefined && PERMANENT_TOKEN_REASONS.has(reason)),
+    } as const;
+  });
+
+  return DirectApnsClient.of({
+    isConfigured: readCredentials.pipe(Effect.map(Option.isSome)),
+    send,
+  });
+});
+
+export const layer = Layer.effect(DirectApnsClient, make);
diff --git a/apps/server/src/relay/DirectApnsDevices.test.ts b/apps/server/src/relay/DirectApnsDevices.test.ts
new file mode 100644
index 0000000000..376b64e6b3
--- /dev/null
+++ b/apps/server/src/relay/DirectApnsDevices.test.ts
@@ -0,0 +1,140 @@
+import { assert, describe, it } from "@effect/vitest";
+import type { PushDeviceRegistration } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import * as DirectApnsDevices from "./DirectApnsDevices.ts";
+
+const TOKEN_A = "a".repeat(64);
+const TOKEN_B = "b".repeat(64);
+const TOKEN_C = "c".repeat(64);
+
+const registration = (overrides: Partial<PushDeviceRegistration> = {}): PushDeviceRegistration => ({
+  deviceId: "iphone",
+  apnsToken: TOKEN_A,
+  apsEnvironment: "sandbox",
+  bundleId: "com.example.t3code",
+  platform: "ios",
+  notificationsEnabled: true,
+  notifyOnApproval: true,
+  notifyOnInput: true,
+  notifyOnCompletion: true,
+  notifyOnFailure: true,
+  ...overrides,
+});
+
+const makeSecrets = () => {
+  const values = new Map<string, Uint8Array>();
+  const layer = Layer.succeed(
+    ServerSecretStore.ServerSecretStore,
+    ServerSecretStore.ServerSecretStore.of({
+      get: (name) => Effect.sync(() => Option.fromUndefinedOr(values.get(name))),
+      set: (name, value) => Effect.sync(() => void values.set(name, value)),
+      create: (name, value) => Effect.sync(() => void values.set(name, value)),
+      remove: (name) => Effect.sync(() => void values.delete(name)),
+      getOrCreateRandom: () => Effect.die("unused"),
+    }),
+  );
+  return { values, layer };
+};
+
+const withDevices = <A, E>(
+  body: (devices: DirectApnsDevices.DirectApnsDevices["Service"]) => Effect.Effect<A, E>,
+  secrets = makeSecrets(),
+) =>
+  Effect.gen(function* () {
+    const devices = yield* DirectApnsDevices.DirectApnsDevices;
+    return yield* body(devices);
+  }).pipe(Effect.provide(DirectApnsDevices.layer.pipe(Layer.provide(secrets.layer))));
+
+describe("DirectApnsDevices", () => {
+  it.effect("keeps a record per device so an iPhone and an iPad both get alerts", () =>
+    withDevices((devices) =>
+      Effect.gen(function* () {
+        yield* devices.register(registration());
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: TOKEN_B }));
+        const listed = yield* devices.list;
+        assert.deepStrictEqual(listed.map((device) => device.deviceId).toSorted(), [
+          "ipad",
+          "iphone",
+        ]);
+      }),
+    ),
+  );
+
+  it.effect("replaces a device's record when its token rotates or environment changes", () =>
+    withDevices((devices) =>
+      Effect.gen(function* () {
+        yield* devices.register(registration());
+        yield* devices.register(
+          registration({
+            apnsToken: TOKEN_C,
+            apsEnvironment: "production",
+            notifyOnCompletion: false,
+          }),
+        );
+        const listed = yield* devices.list;
+        assert.strictEqual(listed.length, 1);
+        assert.strictEqual(listed[0]?.apnsToken, TOKEN_C);
+        assert.strictEqual(listed[0]?.apsEnvironment, "production");
+        assert.strictEqual(listed[0]?.notifyOnCompletion, false);
+      }),
+    ),
+  );
+
+  it.effect("persists across a restart", () => {
+    const secrets = makeSecrets();
+    return withDevices((devices) => devices.register(registration()), secrets).pipe(
+      Effect.andThen(
+        withDevices(
+          (devices) =>
+            devices.list.pipe(
+              Effect.tap((listed) =>
+                Effect.sync(() =>
+                  assert.deepStrictEqual(
+                    listed.map((d) => d.deviceId),
+                    ["iphone"],
+                  ),
+                ),
+              ),
+            ),
+          secrets,
+        ),
+      ),
+    );
+  });
+
+  it.effect("unregisters one device and leaves the others", () =>
+    withDevices((devices) =>
+      Effect.gen(function* () {
+        yield* devices.register(registration());
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: TOKEN_B }));
+        yield* devices.unregister("iphone");
+        assert.deepStrictEqual(
+          (yield* devices.list).map((device) => device.deviceId),
+          ["ipad"],
+        );
+      }),
+    ),
+  );
+
+  it.effect("removes a rejected token but not one the device has since rotated", () =>
+    withDevices((devices) =>
+      Effect.gen(function* () {
+        yield* devices.register(registration());
+        yield* devices.register(registration({ deviceId: "ipad", apnsToken: TOKEN_B }));
+        yield* devices.register(registration({ apnsToken: TOKEN_C }));
+        // A BadDeviceToken for iphone's old token arrives after it rotated.
+        yield* devices.removeRejectedToken({ deviceId: "iphone", apnsToken: TOKEN_A });
+        assert.strictEqual((yield* devices.list).length, 2);
+        yield* devices.removeRejectedToken({ deviceId: "iphone", apnsToken: TOKEN_C });
+        assert.deepStrictEqual(
+          (yield* devices.list).map((device) => device.deviceId),
+          ["ipad"],
+        );
+      }),
+    ),
+  );
+});
diff --git a/apps/server/src/relay/DirectApnsDevices.ts b/apps/server/src/relay/DirectApnsDevices.ts
new file mode 100644
index 0000000000..f68cd90bc2
--- /dev/null
+++ b/apps/server/src/relay/DirectApnsDevices.ts
@@ -0,0 +1,97 @@
+import { PushDeviceRegistration } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+
+export type StoredPushDevice = PushDeviceRegistration;
+
+// APNs device tokens are bearer-like identifiers for pushing to a phone, so
+// they live in the secret store (mode-600 files in a mode-700 directory)
+// rather than in settings.json or the database.
+const DEVICES_SECRET = "direct-apns-devices";
+
+const DevicesJson = Schema.fromJsonString(Schema.Array(PushDeviceRegistration));
+const decodeDevices = Schema.decodeUnknownEffect(DevicesJson);
+const encodeDevices = Schema.encodeEffect(DevicesJson);
+
+export class DirectApnsDevices extends Context.Service<
+  DirectApnsDevices,
+  {
+    readonly register: (
+      device: PushDeviceRegistration,
+    ) => Effect.Effect<void, ServerSecretStore.SecretStoreError>;
+    readonly unregister: (
+      deviceId: string,
+    ) => Effect.Effect<void, ServerSecretStore.SecretStoreError>;
+    readonly list: Effect.Effect<
+      ReadonlyArray<StoredPushDevice>,
+      ServerSecretStore.SecretStoreError
+    >;
+    /** Drops a token APNs rejected, unless the device has since registered a new one. */
+    readonly removeRejectedToken: (input: {
+      readonly deviceId: string;
+      readonly apnsToken: string;
+    }) => Effect.Effect<void, ServerSecretStore.SecretStoreError>;
+  }
+>()("t3/relay/DirectApnsDevices") {}
+
+const make = Effect.gen(function* () {
+  const secrets = yield* ServerSecretStore.ServerSecretStore;
+  // Registrations, unregistrations and APNs rejections all rewrite one file.
+  const lock = yield* Semaphore.make(1);
+
+  const read = secrets.get(DEVICES_SECRET).pipe(
+    Effect.flatMap(
+      Option.match({
+        onNone: () => Effect.succeed<ReadonlyArray<StoredPushDevice>>([]),
+        onSome: (bytes) =>
+          decodeDevices(new TextDecoder().decode(bytes)).pipe(
+            // A corrupt file must not block registering a fresh token.
+            Effect.catch(() => Effect.succeed<ReadonlyArray<StoredPushDevice>>([])),
+          ),
+      }),
+    ),
+  );
+
+  const modify = (
+    change: (devices: ReadonlyArray<StoredPushDevice>) => ReadonlyArray<StoredPushDevice>,
+  ) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const current = yield* read;
+        const next = change(current);
+        if (next.length === current.length && next.every((device, i) => device === current[i])) {
+          return;
+        }
+        const encoded = yield* encodeDevices(next).pipe(Effect.orDie);
+        yield* secrets.set(DEVICES_SECRET, new TextEncoder().encode(encoded));
+      }),
+    );
+
+  return DirectApnsDevices.of({
+    register: Effect.fn("DirectApnsDevices.register")(function* (device) {
+      yield* modify((devices) => [
+        ...devices.filter((existing) => existing.deviceId !== device.deviceId),
+        device,
+      ]);
+    }),
+    unregister: Effect.fn("DirectApnsDevices.unregister")(function* (deviceId) {
+      yield* modify((devices) => devices.filter((device) => device.deviceId !== deviceId));
+    }),
+    list: lock.withPermits(1)(read),
+    removeRejectedToken: Effect.fn("DirectApnsDevices.removeRejectedToken")(function* (input) {
+      yield* modify((devices) =>
+        devices.filter(
+          (device) => !(device.deviceId === input.deviceId && device.apnsToken === input.apnsToken),
+        ),
+      );
+    }),
+  });
+});
+
+export const layer = Layer.effect(DirectApnsDevices, make);
