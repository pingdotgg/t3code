// Writes icons.generated.ts: the superheroicons 24px solid glyphs the mobile mock draws, as SVG path
// markup. The mobile lab's mapping is apps/mobile/src/lab/icons/iconMap.ts; add a name here to use one.
//   node apps/web/scripts/mobile-lab/generate-icons.mts
import * as FS from "node:fs";
import * as OS from "node:os";
import * as Path from "node:path";

const solid = Path.join(OS.homedir(), "apps/superheroicons/consumers/conn/final/24/solid");
const NAMES = [
  "chevron-left",
  "chevron-down",
  "chevron-up",
  "chevron-right",
  "more-horizontal",
  "copy",
  "wrap-lines",
  "check",
  "pull-request",
  "merge",
  "circle-dashed",
  "clock",
  "agent",
  "thread",
  "threads",
  "filter",
  "search",
  "add",
  "stop",
  "trend-up",
  "trend-down",
  "close",
  "comment-text",
  "thinking",
  "users",
  "arrow-up",
  "compose",
  "settings",
  "checklist",
  "inbox",
  "home",
  "chart",
  "branch",
  "circle-dot",
  "check-circle",
  "error-circle",
  "folder",
  "file-text",
  "workflow",
  "pin",
  "laptop",
  "server",
  "cloud",
  "computer-mini",
] as const;

const icons: Record<string, string> = {};
for (const name of NAMES) {
  const svg = FS.readFileSync(Path.join(solid, `${name}.svg`), "utf8");
  icons[name] = svg
    .replace(/^[\s\S]*?<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .replace(/\s*\n\s*/g, "");
}
// Brand marks come from the desktop's Icons.tsx, as the mobile app uses the same artwork.
const brands = FS.readFileSync(
  Path.resolve(import.meta.dirname, "../../src/components/Icons.tsx"),
  "utf8",
);
const pathsOf = (name: string) => {
  const start = brands.indexOf(`export const ${name}: Icon`);
  const end = brands.indexOf("\n);", start);
  const block = brands.slice(start, end);
  return {
    viewBox: /viewBox="([^"]+)"/.exec(block)![1]!,
    paths: [...block.matchAll(/\sd="([^"]+)"/g)].map((match) => match[1]!),
  };
};

FS.writeFileSync(
  Path.join(import.meta.dirname, "../../src/lab/mobile/icons.generated.ts"),
  `// Generated by generate-icons.mts. Do not edit.\nexport const ICONS = ${JSON.stringify(icons, null, 2)} as const;\n\nexport const BRANDS = ${JSON.stringify({ claudeAgent: pathsOf("ClaudeAI"), codex: pathsOf("OpenAI") }, null, 2)} as const;\n\nexport type IconName = keyof typeof ICONS;\n`,
);
console.log(`${Object.keys(icons).length} icons`);
