// Writes theme.generated.css: the mobile app's colour tokens for the web mock, so the two cannot drift.
//   node apps/web/scripts/mobile-lab/generate-theme.mts     (run again after the mobile tokens change)
// Light is the `@variant light` block of apps/mobile/generated-uniwind-themes.css (stock t3-code).
// Dark Mono is built by the app's own createMobileThemeVariables from the palette lab.html seeds.
import * as FS from "node:fs";
import * as Path from "node:path";
import {
  createMobileThemeVariables,
  shellHighlightColor,
} from "../../../mobile/src/lib/mobileTheme.ts";

const here = import.meta.dirname;
const mobile = Path.resolve(here, "../../../mobile");
const css = FS.readFileSync(Path.join(mobile, "generated-uniwind-themes.css"), "utf8");

function variantBlock(name: string) {
  const start = css.indexOf(`@variant ${name} {`);
  if (start < 0) throw new Error(`No ${name} variant`);
  const end = css.indexOf("\n    }", start);
  return css
    .slice(start, end)
    .split("\n")
    .slice(1)
    .map((line) => line.trim())
    .filter((line) => line.startsWith("--"));
}

const html = FS.readFileSync(Path.join(here, "../../lab.html"), "utf8");
const seeded = /setItem\("t3code:themes:v1", JSON\.stringify\((\[.*?\])\)\);/s.exec(html)?.[1];
if (!seeded) throw new Error("lab.html seeds no theme");
const darkMono = (JSON.parse(seeded) as Array<{ id: string; colors: never }>).find(
  (theme) => theme.id === "dark-mono",
)!;

const toMap = (lines: string[]) =>
  new Map(
    lines.map((line) => [
      line.slice(0, line.indexOf(":")),
      line.slice(line.indexOf(":") + 1).trim(),
    ]),
  );

const dark = toMap(variantBlock("dark"));
for (const [key, value] of Object.entries(
  createMobileThemeVariables(darkMono.colors, "dark", shellHighlightColor(darkMono.colors, "dark")),
)) {
  dark.set(key, `${value};`);
}
const light = toMap(variantBlock("light"));

const render = (selector: string, map: Map<string, string>) =>
  `${selector} {\n${[...map].map(([key, value]) => `  ${key}: ${value}`).join("\n")}\n}\n`;

FS.writeFileSync(
  Path.join(here, "../../src/lab/mobile/theme.generated.css"),
  `/* Generated by generate-theme.mts. Do not edit. */\n${render('[data-mobile-theme="dark-mono"]', dark)}\n${render('[data-mobile-theme="light"]', light)}`,
);
console.log(`dark-mono: ${dark.size} tokens, light: ${light.size} tokens`);
