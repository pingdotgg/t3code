import { build } from "vite-plus";
import * as NodeURL from "node:url";
import { BUILT_IN_THEMES, T3_CHAT_THEME } from "@t3tools/shared/themePalettes";

const splash = (colors: typeof T3_CHAT_THEME.colors) => ({
  background: colors.canvas,
  foreground: colors.text,
  accent: colors.accent,
  chrome: colors.chrome,
});
const palettes = Object.fromEntries(
  BUILT_IN_THEMES.map((theme) => [
    theme.id,
    {
      [theme.appearance]: splash(theme.colors),
      ...Object.fromEntries(
        Object.entries(theme.variants ?? {}).map(([mode, colors]) => [mode, splash(colors)]),
      ),
    },
  ]),
);
const generated = `const { resolveThemeSelectionAppearance, themeSelectionStorage } = themeStorage;
// Generated by scripts/generate-theme-boot.mts.\nconst BUILT_IN_THEME_PALETTES = ${JSON.stringify(palettes)};\nconst BUILT_IN_THEME_MODES = Object.fromEntries(Object.entries(BUILT_IN_THEME_PALETTES).map(([id, palettes]) => [id, Object.keys(palettes)]));\n`;
let storageBundle: Promise<string> | undefined;
function bundleThemeStorage(): Promise<string> {
  return (storageBundle ??= build({
    configFile: false,
    logLevel: "silent",
    build: {
      write: false,
      minify: true,
      lib: {
        entry: NodeURL.fileURLToPath(new URL("./theme-boot-runtime.ts", import.meta.url)),
        name: "themeStorage",
        formats: ["iife"],
      },
    },
  }).then((result) => {
    const bundle = Array.isArray(result) ? result[0] : result;
    if (!bundle || !("output" in bundle)) throw new Error("Expected the theme storage bundle.");
    const chunk = bundle.output.find((output) => output.type === "chunk");
    if (!chunk) throw new Error("Missing theme storage bundle.");
    return chunk.code;
  }));
}
export async function renderThemeBootHtml(html: string): Promise<string> {
  const storage = await bundleThemeStorage();
  return html.replace(
    /\/\/ BEGIN GENERATED THEME DATA[\s\S]*?\/\/ END GENERATED THEME DATA/,
    () => `// BEGIN GENERATED THEME DATA\n${storage}\n${generated}// END GENERATED THEME DATA`,
  );
}
