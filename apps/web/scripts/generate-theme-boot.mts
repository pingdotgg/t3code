import * as NodeFS from "node:fs";
import {
  themeSelectionStorage,
  resolveThemeSelectionAppearance,
} from "../../../packages/shared/src/themeSelection.ts";
import {
  BUILT_IN_THEMES,
  T3_CHAT_THEME,
  RESERVED_THEME_IDS,
} from "../../../packages/shared/src/themePalettes.ts";

const splash = (colors: typeof T3_CHAT_THEME.colors) => ({
  background: colors.canvas,
  foreground: colors.text,
  accent: colors.accent,
  chrome: colors.chrome,
});
const palettes = Object.fromEntries(
  BUILT_IN_THEMES.map((theme) => [
    theme.id,
    {
      [theme.appearance]: splash(theme.colors),
      ...Object.fromEntries(
        Object.entries(theme.variants ?? {}).map(([mode, colors]) => [mode, splash(colors)]),
      ),
    },
  ]),
);
const generated = `const resolveThemeSelectionAppearance = ${resolveThemeSelectionAppearance.toString()};
const themeSelectionStorage = ${themeSelectionStorage.toString()};
// Generated by scripts/generate-theme-boot.mts.\nconst DEFAULT_THEME_PALETTES = ${JSON.stringify(palettes[T3_CHAT_THEME.id])};\nconst BUILT_IN_THEME_PALETTES = ${JSON.stringify(palettes)};\nconst BUILT_IN_THEME_MODES = Object.fromEntries(Object.entries(BUILT_IN_THEME_PALETTES).map(([id, palettes]) => [id, Object.keys(palettes)]));\nconst RESERVED_THEME_IDS = ${JSON.stringify([...RESERVED_THEME_IDS])};\n`;
const path = new URL("../index.html", import.meta.url);
const html = NodeFS.readFileSync(path, "utf8");
NodeFS.writeFileSync(
  path,
  html.replace(
    /\/\/ BEGIN GENERATED THEME DATA[\s\S]*?\/\/ END GENERATED THEME DATA/,
    `// BEGIN GENERATED THEME DATA\n${generated}// END GENERATED THEME DATA`,
  ),
);
