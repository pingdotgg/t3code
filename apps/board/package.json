{
  "name": "@agent-board/app",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "exports": {
    ".": "./dist-electron/electron/main.cjs",
    "./preload": "./dist-electron/electron/preload.cjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vp dev",
    "dev:windows": "node scripts/dev.mjs launch-windows.mjs",
    "build": "vp build && vp pack",
    "start": "node scripts/launch-electron.mjs",
    "start:windows": "node scripts/launch-windows.mjs",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run && node --test scripts/*.test.mjs",
    "check:boundary": "node scripts/check-engine-untouched.mjs",
    "standards": "node ../../standards/check-added-diagnostics.mjs",
    "standards:deps": "cd ../.. && depcruise --config standards/.dependency-cruiser.cjs --ignore-known standards/dependency-baseline.json apps packages"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "catalog:",
    "electron": "44.10.1",
    "lucide-react": "^0.564.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dependency-cruiser": "^18.8.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
