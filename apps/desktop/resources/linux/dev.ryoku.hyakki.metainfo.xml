  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Hyakki</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="dev.ryoku">
    <name>Hyakki contributors</name>
  </developer>
  <description>
