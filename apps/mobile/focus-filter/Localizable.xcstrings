    "Only connect to the chosen environments and silence notifications from the others.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only connect to the chosen environments and silence notifications from the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarse solo a los entornos elegidos y silenciar las notificaciones de los demás."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅连接所选环境，并静音其他环境的通知。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar apenas aos ambientes escolhidos e silenciar as notificações dos demais."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter uniquement aux environnements choisis et désactiver les notifications des autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit den ausgewählten Umgebungen verbinden und Mitteilungen der anderen stummschalten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した環境にのみ接続し、他の環境からの通知を消音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 환경에만 연결하고 다른 환경의 알림을 무음으로 설정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключаться только к выбранным окружениям и отключить уведомления от остальных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut endast till de valda miljöerna och tysta aviseringar från de andra."
          }
        }
      }
    },
