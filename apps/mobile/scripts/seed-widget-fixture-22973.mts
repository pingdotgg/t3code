// Seeds the Android subscription widget with a fixed fixture for the #22973
// before/after evidence. It temporarily patches the working tree so the real
// snapshot -> publishSubscriptionUsage -> widget.updateSnapshot path runs on
// fixture providers instead of connected environments. Nothing changes until
// it runs, and `revert` restores the tracked files from HEAD.
//
//   node scripts/seed-widget-fixture-22973.mts apply <fixture> [--anchor <iso>] [--before [ref]]
//   node scripts/seed-widget-fixture-22973.mts revert
//   node scripts/seed-widget-fixture-22973.mts list
//
// Fixture times are minutes from the anchor (default: now, rounded down to the
// minute). Reuse one anchor for a before/after pair so both render identical
// reset labels. `--before` swaps in subscriptionUsageSnapshot.ts from the
// merge-base so the same hook runs over the pre-fix code. Reload the app
// (Metro picks the change up) after each apply.
import * as NodeChildProcess from "node:child_process";
import * as NodeFS from "node:fs";
import * as NodePath from "node:path";
import * as NodeURL from "node:url";

const BEFORE_REF = "8d3b061121fe65669d5d43d011b48cd3027a4108";
const appRoot = NodePath.join(NodePath.dirname(NodeURL.fileURLToPath(import.meta.url)), "..");
const coordinator = NodePath.join(appRoot, "src/widgets/SubscriptionUsageCoordinator.tsx");
const snapshotModule = NodePath.join(appRoot, "src/widgets/subscriptionUsageSnapshot.ts");
const fixtureModule = NodePath.join(appRoot, "src/widgets/widgetFixture22973.ts");
const tracked = [coordinator, snapshotModule];

const codex = (
  checked: number,
  session: number,
  weekly: number,
  instance = "codex",
  email = "a@example.com",
) =>
  `prov("codex", ${JSON.stringify(instance)}, ${JSON.stringify(email)}, ${checked}, [W("primary", "session", "5 hours", 0, ${session}, 300), W("secondary", "weekly", "Weekly", 30, ${weekly}, 10080)])`;
const week = 7 * 1440;
const fixtures: Record<string, string[]> = {
  F1: [codex(0, 45, week)],
  F2: [codex(0, -15, week)],
  F3: [codex(0, -15, -1)],
  F4: [codex(0, 0, week)],
  F5: [codex(0, 5, week)],
  F6: [codex(-16, 45, week)],
  F7a: [
    codex(-5, 45, week, "codex-0", "a@example.com"),
    codex(0, -3, week, "codex-1", "b@example.com"),
  ],
  F7b: [
    codex(-5, -3, week, "codex-0", "a@example.com"),
    codex(0, 45, week, "codex-1", "b@example.com"),
  ],
  F8: [
    `prov("claudeAgent", "claude", "c@example.com", 0, [W("five_hour", "session", "Session", 10, -20, 300), W("seven_day", "weekly", "Weekly", 50, ${6 * 1440}, 10080), W("seven_day_claude_opus_4_7_extended_thinking", "weekly", "Weekly · Claude Opus 4.7 Extended Thinking Preview", 95, ${6 * 1440})])`,
  ],
  F9: [
    codex(0, -15, week),
    `prov("claudeAgent", "claude", "c@example.com", 0, [W("five_hour", "session", "Session", 10, 120, 300)])`,
  ],
};

const git = (...args: string[]) =>
  NodeChildProcess.execFileSync("git", args, { cwd: appRoot, encoding: "utf8" });

function revert() {
  git("checkout", "HEAD", "--", ...tracked);
  NodeFS.rmSync(fixtureModule, { force: true });
}

function apply(name: string, anchor: number, beforeRef: string | undefined) {
  const providers = fixtures[name];
  if (!providers)
    throw new Error(`Unknown fixture ${name}; known: ${Object.keys(fixtures).join(", ")}`);
  if (!NodeFS.existsSync(fixtureModule) && git("status", "--porcelain", "--", ...tracked).trim())
    throw new Error("Widget sources have uncommitted changes; commit or revert them first.");
  revert();
  if (beforeRef)
    NodeFS.writeFileSync(
      snapshotModule,
      git("show", `${beforeRef}:apps/mobile/src/widgets/subscriptionUsageSnapshot.ts`),
    );
  NodeFS.writeFileSync(
    fixtureModule,
    `// Generated by scripts/seed-widget-fixture-22973.mts; removed by its revert command.
const ANCHOR = ${anchor}; // ${new Date(anchor).toISOString()}
const iso = (minutes: number) => new Date(ANCHOR + minutes * 60_000).toISOString();
const W = (id: string, kind: string, label: string, usedPercent: number, reset: number, windowDurationMins?: number) => ({
  id, kind, label, usedPercent, resetsAt: iso(reset), ...(windowDurationMins ? { windowDurationMins } : {}),
});
const prov = (driver: string, instanceId: string, email: string, checked: number, windows: unknown[]) => ({
  instanceId, driver, enabled: true, installed: true, version: null, status: "ready",
  auth: { status: "authenticated", email }, checkedAt: iso(checked), models: [], slashCommands: [], skills: [],
  usageLimits: { checkedAt: iso(checked), windows },
});
export function widgetFixture22973<T>(): T {
  return new Map([["env", { entry: { target: { label: "Remote" } }, serverConfig: { providers: [
    ${providers.join(",\n    ")},
  ] } }]]) as T;
}
`,
  );
  const source = NodeFS.readFileSync(coordinator, "utf8");
  const read = "get(environmentPresentations.presentationsWithProvidersAtom),";
  if (!source.includes(read))
    throw new Error("SubscriptionUsageCoordinator.tsx no longer matches the hook");
  NodeFS.writeFileSync(
    coordinator,
    source
      .replace(read, `widgetFixture22973<Parameters<typeof buildSubscriptionUsageSnapshot>[0]>(),`)
      .replace(
        `import { createWidgetTheme } from "./widgetTheme";`,
        `import { createWidgetTheme } from "./widgetTheme";\nimport { widgetFixture22973 } from "./widgetFixture22973";`,
      ),
  );
  console.log(
    `Applied ${name} (${beforeRef ? `before: ${beforeRef.slice(0, 10)}` : "after: HEAD"}) anchored at ${new Date(anchor).toISOString()}`,
  );
}

const [command, name, ...rest] = process.argv.slice(2);
const flag = (key: string) => {
  const index = rest.indexOf(key);
  if (index === -1) return undefined;
  const value = rest[index + 1];
  return value && !value.startsWith("--") ? value : "";
};
if (command === "apply" && name) {
  const anchorFlag = flag("--anchor");
  const anchor = anchorFlag ? Date.parse(anchorFlag) : Math.floor(Date.now() / 60_000) * 60_000;
  if (!Number.isFinite(anchor)) throw new Error(`Invalid --anchor ${anchorFlag}`);
  const before = flag("--before");
  apply(name, anchor, before === undefined ? undefined : before || BEFORE_REF);
} else if (command === "revert") {
  revert();
  console.log("Reverted widget fixture hook");
} else if (command === "list") {
  console.log(Object.keys(fixtures).join("\n"));
} else {
  console.error(
    "Usage: seed-widget-fixture-22973.mts apply <fixture> [--anchor <iso>] [--before [ref]] | revert | list",
  );
  process.exit(1);
}
