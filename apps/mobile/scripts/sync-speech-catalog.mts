import * as NodeRuntime from "@effect/platform-node/NodeRuntime";
import * as NodeServices from "@effect/platform-node/NodeServices";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Path from "effect/Path";

import catalog from "../../server/src/speech/catalog.json" with { type: "json" };
import pod from "../modules/t3-voice-transcription/ios/vendor/TranscribeCpp.podspec.json" with { type: "json" };

const modelIds = [
  "handy-computer/parakeet-ultra-gguf",
  "handy-computer/whisper-small-gguf",
  "handy-computer/whisper-base-gguf",
];

export const swiftCatalogPath =
  "../modules/t3-voice-transcription/ios/DeviceSpeechCatalog.generated.swift";

export function renderIosSpeechCatalog() {
  if (catalog.engineVersion !== pod.version) {
    throw new Error("Review the iOS catalog for the installed transcribe.cpp version.");
  }
  const models = modelIds.map((id) => {
    const model = catalog.models.find((entry) => entry.id === id);
    if (!model?.supportsLanguageDetection) {
      throw new Error(`Review iOS batch transcription support for ${id}.`);
    }
    return `    DeviceSpeechModel(
      id: ${JSON.stringify(model.id)},
      name: ${JSON.stringify(model.name)},
      description: ${JSON.stringify(model.description)},
      languages: ${JSON.stringify(model.languages).replaceAll(",", ", ")},
      revision: ${JSON.stringify(model.revision)},
      filename: ${JSON.stringify(model.filename)},
      byteCount: ${model.size},
      sha256: ${JSON.stringify(model.sha256)})`;
  });

  return `// Generated by vp run speech:catalog:sync in apps/mobile.
enum DeviceSpeechCatalog {
  static let models = [
${models.join(",\n")},
  ]
}
`;
}

if (import.meta.main) {
  Effect.gen(function* () {
    const fs = yield* FileSystem.FileSystem;
    const path = yield* Path.Path;
    yield* fs.writeFileString(
      path.resolve(import.meta.dirname, swiftCatalogPath),
      renderIosSpeechCatalog(),
    );
  }).pipe(Effect.provide(NodeServices.layer), NodeRuntime.runMain);
}
