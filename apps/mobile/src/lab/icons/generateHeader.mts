// @effect-diagnostics nodeBuiltinImport:off - Lab-only Node build script.
// Renders the native header icons for the mobile lab: superheroicons as template PNGs (@2x/@3x).
//   node src/lab/icons/generateHeader.mts [assetsDir]
// Native header buttons take `{type: "image", source}` and tint it like an SF Symbol, so each concept
// is drawn black on transparent. Two variants for a side-by-side look:
//   solid16   the 16px solid set
//   outline24 the 24px outline set
//   solid24   the 24px solid set
//   solid20   the 20px solid set
// Writes header/<variant>/<concept>[@2x|@3x].png and headerIcons.generated.ts (static requires).
// Lab only: production never imports this folder. Switch variants with `lab.mts header-icons`.
import * as FS from "node:fs";
import * as Module from "node:module";
import * as Path from "node:path";
import * as URL from "node:url";
import { SF_EXTRA_TO_CONCEPT } from "./iconMap.ts";
import { SF_TO_CONCEPT } from "./iconSet.generated.ts";

const HERE = Path.dirname(URL.fileURLToPath(import.meta.url));
const REPO_ROOT = Path.resolve(HERE, "../../../../..");
const assets = process.argv[2] ?? "/Users/nckrtl/apps/superheroicons/consumers/conn/final";

// sharp is installed by pnpm for other packages; resolve it from the store.
const pnpm = Path.join(REPO_ROOT, "node_modules/.pnpm");
const sharpDir = FS.readdirSync(pnpm).find((name) => name.startsWith("sharp@"));
if (sharpDir === undefined) throw new Error("sharp not found in node_modules/.pnpm");
const sharp = Module.createRequire(import.meta.url)(
  Path.join(pnpm, sharpDir, "node_modules/sharp"),
) as (
  input: Buffer,
  options: { density: number },
) => {
  resize(width: number, height: number): ReturnType<SharpChain["resize"]>;
};
type SharpChain = {
  resize(width: number, height: number): SharpChain;
  extend(options: Record<string, unknown>): SharpChain;
  png(): SharpChain;
  toBuffer(): Promise<Buffer>;
};

// Logical (pt) size of the PNG canvas, and of the icon art inside it. The art box is not the
// glyph: the sets leave padding, so the art box is chosen to match the SF Symbols' optical size.
const CANVAS = 24;
const VARIANTS = {
  solid16: { folder: "16/solid", viewBox: 16, art: 22 },
  outline24: { folder: "24/outline", viewBox: 24, art: 24 },
  solid24: { folder: "24/solid", viewBox: 24, art: 24 },
  solid20: { folder: "20/solid", viewBox: 20, art: 23 },
} as const;
const SCALES = [1, 2, 3] as const;

const concepts = [
  ...new Set([...Object.values(SF_TO_CONCEPT), ...Object.values(SF_EXTRA_TO_CONCEPT)]),
].sort();

const out = Path.join(HERE, "header");
FS.rmSync(out, { recursive: true, force: true });
const lines: string[] = [];
for (const [variant, spec] of Object.entries(VARIANTS)) {
  FS.mkdirSync(Path.join(out, variant), { recursive: true });
  lines.push(`  ${variant}: {`);
  for (const concept of concepts) {
    const file = Path.join(assets, spec.folder, `${concept}.svg`);
    if (!FS.existsSync(file)) throw new Error(`${variant}: missing ${concept}`);
    const svg = FS.readFileSync(file, "utf8").replaceAll("currentColor", "#000");
    for (const scale of SCALES) {
      const art = Math.round(spec.art * scale);
      const canvas = CANVAS * scale;
      const pad = Math.floor((canvas - art) / 2);
      const png = await sharp(Buffer.from(svg), { density: (72 * art * 2) / spec.viewBox })
        .resize(art, art)
        .extend({
          top: pad,
          bottom: canvas - art - pad,
          left: pad,
          right: canvas - art - pad,
          background: { r: 0, g: 0, b: 0, alpha: 0 },
        })
        .png()
        .toBuffer();
      FS.writeFileSync(
        Path.join(out, variant, `${concept}${scale === 1 ? "" : `@${scale}x`}.png`),
        png,
      );
    }
    lines.push(`    ${JSON.stringify(concept)}: require("./header/${variant}/${concept}.png"),`);
  }
  lines.push("  },");
}

FS.writeFileSync(
  Path.join(HERE, "headerIcons.generated.ts"),
  `// @generated by generateHeader.mts. Do not edit.
// Lab only: template PNGs for the native header, per variant and concept.

export const HEADER_ICONS: Record<${Object.keys(VARIANTS)
    .map((v) => JSON.stringify(v))
    .join(" | ")}, Record<string, number>> = {
${lines.join("\n")}
};
`,
);
console.error(`${concepts.length} concepts x ${Object.keys(VARIANTS).length} variants`);
