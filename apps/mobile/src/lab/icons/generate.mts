// @effect-diagnostics nodeBuiltinImport:off - Lab-only Node build script.
// Regenerates the mobile lab's icon data from the superheroicons Conn assets (24px solid only).
//   node src/lab/icons/generate.mts [assetsDir]
// Writes iconSet.generated.ts (concept SVGs + manifest SF names) and tabler/Icon*.tsx (one stub per
// Tabler import, so Metro can alias each `@tabler/icons-react-native/IconX` to it).
// Default assetsDir: /Users/nckrtl/apps/superheroicons/consumers/conn/final
// The switch itself: CONN_ICON_LAB=1 makes metro.config.js alias expo-symbols and Tabler to this folder.
import * as FS from "node:fs";
import * as Path from "node:path";
import * as URL from "node:url";
import { TABLER_TO_CONCEPT, TABLER_UNMAPPED } from "./iconMap.ts";

const HERE = Path.dirname(URL.fileURLToPath(import.meta.url));
const assets = process.argv[2] ?? "/Users/nckrtl/apps/superheroicons/consumers/conn/final";
const manifest = JSON.parse(FS.readFileSync(Path.join(assets, "manifest.json"), "utf8")) as {
  readonly sf: Record<string, string>;
};

const dir = Path.join(assets, "24", "solid");
const concepts = FS.readdirSync(dir)
  .filter((file) => file.endsWith(".svg"))
  .map((file) => file.slice(0, -4))
  .sort();

const markup: string[] = [];
for (const id of concepts) {
  const svg = FS.readFileSync(Path.join(dir, `${id}.svg`), "utf8");
  if (!svg.includes('viewBox="0 0 24 24"')) throw new Error(`${id}: expected viewBox 0 0 24 24`);
  const body = svg
    .slice(svg.indexOf(">") + 1, svg.lastIndexOf("</svg>"))
    .replace(/\s*\n\s*/g, "")
    .trim();
  markup.push(
    `  ${JSON.stringify(id)}: ${JSON.stringify(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">${body}</svg>`)},`,
  );
}

for (const [name, concept] of Object.entries(manifest.sf)) {
  if (!concepts.includes(concept)) throw new Error(`SF ${name} maps to unknown concept ${concept}`);
}
for (const [name, concept] of Object.entries(TABLER_TO_CONCEPT)) {
  if (!concepts.includes(concept)) throw new Error(`${name} maps to unknown concept ${concept}`);
}

const sfLines = Object.keys(manifest.sf)
  .sort()
  .map((name) => `  ${JSON.stringify(name)}: ${JSON.stringify(manifest.sf[name])},`);

FS.writeFileSync(
  Path.join(HERE, "iconSet.generated.ts"),
  `// @generated by generate.mts from ${assets}. Do not edit.
// Lab only: see CONN_ICON_LAB in metro.config.js.

/** Full SVG per concept: the 24px solid variant, fill currentColor. */
export const CONCEPT_SVG: Record<string, string> = {
${markup.join("\n")}
};

/** SF Symbol name to concept, from the manifest. */
export const SF_TO_CONCEPT: Record<string, string> = {
${sfLines.join("\n")}
};
`,
);

// Tabler stubs: every name the app imports, found by scanning src.
const SRC = Path.resolve(HERE, "../..");
const names = new Set<string>();
const walk = (folder: string) => {
  for (const entry of FS.readdirSync(folder, { withFileTypes: true })) {
    const full = Path.join(folder, entry.name);
    if (entry.isDirectory()) {
      if (full !== HERE) walk(full);
    } else if (/\.(ts|tsx)$/.test(entry.name)) {
      for (const match of FS.readFileSync(full, "utf8").matchAll(
        /@tabler\/icons-react-native\/(Icon\w+)/g,
      )) {
        names.add(match[1]!);
      }
    }
  }
};
walk(SRC);

const stubDir = Path.join(HERE, "tabler");
FS.rmSync(stubDir, { recursive: true, force: true });
FS.mkdirSync(stubDir, { recursive: true });
const unmapped: string[] = [];
for (const name of [...names].sort()) {
  const concept = TABLER_TO_CONCEPT[name];
  if (concept === undefined) {
    unmapped.push(name);
    FS.writeFileSync(
      Path.join(stubDir, `${name}.tsx`),
      `// @generated by generate.mts. No concept for ${name}: the original draws.\nexport { default } from "@tabler/icons-react-native/${name}";\n`,
    );
  } else {
    FS.writeFileSync(
      Path.join(stubDir, `${name}.tsx`),
      `// @generated by generate.mts.\nimport { createTablerIcon } from "../LabIcon";\n\nexport default createTablerIcon(${JSON.stringify(concept)});\n`,
    );
  }
}
const stale = Object.keys(TABLER_TO_CONCEPT).filter((name) => !names.has(name));
console.log(
  `${concepts.length} concepts, ${Object.keys(manifest.sf).length} SF names, ${names.size} Tabler imports (${unmapped.length} unmapped: ${unmapped.join(", ") || "none"})`,
);
if (stale.length > 0) console.log(`Mapped but not imported: ${stale.join(", ")}`);
const declared = new Set(TABLER_UNMAPPED);
for (const name of unmapped) if (!declared.has(name)) console.log(`Add ${name} to TABLER_UNMAPPED`);
