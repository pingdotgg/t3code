#!/bin/sh
# t3 CLI shim, shipped with the T3 Code Claude plugin. Sessions spawned by a dev
# server have no installed `t3` on PATH, so T3 Code injects this shim's path as
# $T3_CLI. It resolves the CLI entry relative to itself: the monorepo source
# layout first, then the bundled dist layout.
dir="$(cd "$(dirname "$0")" && pwd)"
for entry in "$dir/../../src/bin.ts" "$dir/../../bin.mjs"; do
  if [ -f "$entry" ]; then
    exec node "$entry" "$@"
  fi
done
echo "t3 CLI entry point not found next to $dir" >&2
exit 127
