{
  "name": "t3",
  "version": "0.0.23",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build": "node scripts/cli.ts build",
    "build:bundle": "vp pack",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:parallel && pnpm run test:serial",
    "test:parallel": "vp test run --fileParallelism --maxWorkers=3 --exclude src/server.test.ts --exclude integration/directConnectSmoke.integration.test.ts",
    "test:process-reaper": "vp test run src/server.test.ts src/provider/Layers/ClaudeAdapter.test.ts src/provider/Layers/ProviderSessionDirectory.test.ts src/provider/Layers/ProviderSessionReaper.test.ts src/provider/Layers/CodexAdapter.test.ts",
    "test:serial": "vp test run src/server.test.ts --no-file-parallelism",
    "test:windows-smoke": "vp test run src/processRunner.test.ts src/pathExpansion.test.ts src/cloud/publicConfig.test.ts src/cloud/CliTokenManager.test.ts src/cloud/windowsService.test.ts src/auth/windowsSecretProtection.test.ts src/cli/installation.test.ts src/cli/connectSetup.test.ts --no-file-parallelism"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.111",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "@t3tools/client-runtime": "workspace:*",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "playwright": "^1.58.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
