{
  "name": "t3",
  "version": "0.0.42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run build:extensions && node --watch src/bin.ts",
    "build:bundle": "vp run build:extensions && vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "vp run build:extensions && tsc --noEmit",
    "test": "vp run build:extensions && vp test run",
    "build:extensions": "vp run --filter @t3tools/extension-runtime build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@napi-rs/keyring": "^1.3.0",
    "@opencode-ai/sdk": "^1.3.15",
    "diff": "8.0.3",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/extension-runtime": "workspace:*",
    "@t3tools/extension-sdk": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/ssh": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/yauzl": "^3.4.0",
    "ajv": "8.20.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
