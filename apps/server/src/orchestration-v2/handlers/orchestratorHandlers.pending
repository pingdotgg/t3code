      targetRunId: dispatchMode.targetRunId,
      messageId: command.messageId,
      text: dispatchText,
      ...(command.context ? { context: command.context } : {}),
      attachments: command.attachments,
      createdBy: command.createdBy,
      creationSource: command.creationSource,
