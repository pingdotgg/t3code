interface ExtraDeps {
  readonly isProviderNativeSubagentThread: (...args: any[]) => any;
  readonly latestExecutedRun: (...args: any[]) => any;
  readonly latestProviderTurnForAttempt: (...args: any[]) => any;
  readonly latestRootProviderFailure: (...args: any[]) => any;
  readonly modelSelectionsEqual: (...args: any[]) => any;
  readonly normalizeThreadPullRequestKey: (...args: any[]) => any;
  readonly notificationTurnItem: (...args: any[]) => any;
  readonly parseGoalCommand: (...args: any[]) => any;
  readonly runRanAfter: (...args: any[]) => any;
  readonly threadPullRequestKeysEqual: (...args: any[]) => any;
  readonly threadPullRequestsOf: (...args: any[]) => any;
  readonly usageLimitBlockedRun: (...args: any[]) => any;
}

export type OrchestratorHandlerDeps = ExtraDeps & Omit<
  CheckpointHandlerDeps
  & MakeLifecycleHandlersDeps
  & MakeQueueHandlersDeps
  & MakeMessageHandlersDeps
  & MakeDispatchHandlersDeps,
  "dispatchBackgroundWorkSettle" | "dispatchCheckpointRollback" | "dispatchCheckpointRollbackFail" | "dispatchCreatedThreadRecord" | "dispatchDelegatedTaskCompletionDeliveryResolution" | "dispatchDelegatedTaskRequest" | "dispatchDelegatedTaskWakePolicy" | "dispatchGuestShare" | "dispatchInterruptUnresponsive" | "dispatchLinkRequestRecord" | "dispatchMessage" | "dispatchNotificationAccepted" | "dispatchOnce" | "dispatchPreparedRunFail" | "dispatchPreparedRunProgress" | "dispatchPreparedRunRelease" | "dispatchPreparedRunRetry" | "dispatchProviderSessionDetach" | "dispatchPullRequestWatchSync" | "dispatchQueuedMessagePromoteToSteer" | "dispatchQueuedRunCancel" | "dispatchQueuedRunEdit" | "dispatchQueuedRunReorder" | "dispatchRemoteDelegatedTaskComplete" | "dispatchRemoteDelegatedTaskRequest" | "dispatchRemoteDelegatedTaskStop" | "dispatchRunInterrupt" | "dispatchRuntimeRequestDeliveryFail" | "dispatchRuntimeRequestRespond" | "dispatchSecretRequestRecord" | "dispatchSteerIntoRun" | "dispatchSubagentStop" | "dispatchThreadCreate" | "dispatchThreadFork" | "dispatchThreadMergeBack" | "dispatchThreadMutation" | "dispatchThreadProjectAdoptFolder" | "dispatchThreadStop" | "dispatchThreadUserInputDismiss" | "dispatchThreadVisit" | "dispatchWithReceiptEffect"
>;

