    <path fill="#000080" d="M8 7h15v10H8z" />
    <path fill="#51e5cf" d="M9 8h13v2H9zM9 11h5v4H9z" />
    <path fill="#fff" d="M16 11h5v1h-5zM16 14h4v1h-4z" />
    <path fill="#baff00" d="M21 20h2v1h-2z" />
  </>}
  {name === "disk" && <>
