---
import Layout from "../layouts/Layout.astro";

interface Props {
  readonly title: string;
  readonly description: string;
  readonly heading: string;
  readonly lede: string;
  readonly effectiveDate: string;
  readonly lastUpdated: string;
  readonly sections: ReadonlyArray<readonly [id: string, label: string]>;
}

const { title, description, heading, lede, effectiveDate, lastUpdated, sections } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="shell legal-page">
    <header>
      <h1 class="page-title">{heading}</h1>
      <p class="page-sub">{lede}</p>
      <p class="legal-meta">
        <span>Effective <time datetime={effectiveDate}>{effectiveDate}</time></span>
        <span>Updated <time datetime={lastUpdated}>{lastUpdated}</time></span>
        <a href="/legal">All legal documents</a>
      </p>
    </header>

    <details class="legal-toc">
      <summary>
        On this page
        <span class="legal-toc-mark" aria-hidden="true">+</span>
      </summary>
      <div data-panel>
        <ol>
          {sections.map(([id, label]) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ol>
      </div>
    </details>

    <article class="legal-copy">
      <slot />
    </article>
  </div>
</Layout>

<script>
  import { animateDetails } from "../lib/disclosure";

  const toc = document.querySelector<HTMLDetailsElement>(".legal-toc");
  if (toc) animateDetails(toc);
</script>

<style is:global>
  .legal-page {
    padding-top: 56px;
    padding-bottom: 152px;
  }

  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 16px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .legal-meta a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(163, 163, 163, 0.3);
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }

  .legal-meta a:hover {
    color: var(--fg);
  }

  .legal-toc {
    margin-top: 40px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .legal-toc summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    color: var(--fg);
    font-size: 15px;
    cursor: pointer;
    list-style: none;
  }

  .legal-toc summary::-webkit-details-marker {
    display: none;
  }

  .legal-toc-mark {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    transition: transform 0.2s ease;
  }

  .legal-toc[open]:not([data-closing]) .legal-toc-mark {
    transform: rotate(45deg);
  }

  .legal-toc ol {
    display: grid;
    gap: 6px;
    padding-bottom: 18px;
    list-style: none;
  }

  .legal-toc a {
    color: var(--fg-muted);
    font-size: 14px;
    transition: color 0.18s ease;
  }

  .legal-toc a:hover {
    color: var(--fg);
  }

  .legal-copy {
    margin-top: 56px;
  }

  .legal-copy section {
    scroll-margin-top: 32px;
  }

  .legal-copy section + section {
    margin-top: 56px;
  }

  .legal-copy h2 {
    margin-bottom: 14px;
    color: var(--fg);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .legal-copy h3 {
    margin: 24px 0 8px;
    color: var(--fg);
    font-size: 16px;
    font-weight: 500;
  }

  .legal-copy h4 {
    margin: 18px 0 6px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
  }

  .legal-copy p,
  .legal-copy li,
  .legal-copy address {
    color: var(--fg-muted);
    font-size: 15px;
    font-style: normal;
    line-height: 1.7;
  }

  .legal-copy p + p {
    margin-top: 14px;
  }

  .legal-copy strong {
    color: var(--fg);
    font-weight: 500;
  }

  .legal-copy ul,
  .legal-copy ol {
    display: grid;
    gap: 8px;
    margin: 14px 0;
    padding-left: 20px;
  }

  .legal-copy li::marker {
    color: var(--fg-faint);
  }

  .legal-copy .provider-list {
    gap: 14px;
  }

  .legal-copy a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(163, 163, 163, 0.3);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.18s ease;
  }

  .legal-copy a:hover {
    text-decoration-color: currentColor;
  }

  .legal-notice {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev);
    font-size: 13px !important;
  }

  .legal-copy address {
    margin-top: 14px;
  }

  .contact-link {
    display: inline-block;
    margin-top: 14px;
  }

  @media (max-width: 640px) {
    .legal-page {
      padding-top: 40px;
      padding-bottom: 104px;
    }
  }
</style>
