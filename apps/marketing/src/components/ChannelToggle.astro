---
interface Props {
  label: string;
  stable: string;
  nightly: string;
}

const { label, stable, nightly } = Astro.props;
---

<div class="channel-toggle" role="group" aria-label={label}>
  <button type="button" class="channel-name" data-channel-pick="stable" aria-pressed="true">{stable}</button>
  <button type="button" class="channel-switch" role="switch" aria-checked="false" aria-label={nightly} data-channel-switch>
    <span class="channel-knob" aria-hidden="true"></span>
  </button>
  <button type="button" class="channel-name" data-channel-pick="nightly" aria-pressed="false">{nightly}</button>
</div>

<script>
  import { onSiteChannel, setSiteChannel, siteChannel } from "../lib/channel";

  const picks = document.querySelectorAll<HTMLButtonElement>("[data-channel-pick]");
  const switches = document.querySelectorAll<HTMLButtonElement>("[data-channel-switch]");
  const sync = () => {
    for (const pick of picks) pick.setAttribute("aria-pressed", String(pick.dataset.channelPick === siteChannel()));
    for (const toggle of switches) toggle.setAttribute("aria-checked", String(siteChannel() === "nightly"));
  };
  for (const pick of picks) {
    pick.addEventListener("click", () => setSiteChannel(pick.dataset.channelPick === "nightly" ? "nightly" : "stable"));
  }
  for (const toggle of switches) {
    toggle.addEventListener("click", () => setSiteChannel(siteChannel() === "nightly" ? "stable" : "nightly"));
  }
  onSiteChannel(sync);
  sync();
</script>

<style>
  /* The look follows html[data-channel], which is set before first paint, so the knob never slides on load. */
  .channel-toggle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    /* The names carry their own padding, so the text lines up with what sits above and below. */
    margin: 0 -8px;
    font-family: var(--font-mono);
  }

  .channel-name {
    padding: 6px 8px;
    color: var(--fg-dim);
    font-family: inherit;
    font-size: 12px;
    text-transform: lowercase;
    transition: color 0.18s ease;
  }

  .channel-name:hover {
    color: var(--fg-muted);
  }

  :global(html:not([data-channel="nightly"])) .channel-name[data-channel-pick="stable"],
  :global(html[data-channel="nightly"]) .channel-name[data-channel-pick="nightly"] {
    color: var(--fg);
  }

  .channel-switch {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    transition: background 0.28s ease;
  }

  .channel-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: #fff;
    transition: transform 0.28s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  :global(html[data-channel="nightly"]) .channel-switch {
    background: oklch(0.571 0.21 264);
  }

  :global(html[data-channel="nightly"]) .channel-knob {
    transform: translateX(14px);
  }
</style>
