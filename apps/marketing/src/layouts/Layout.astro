---
import devAppIcon from "../assets/t3-dev-384.webp?url";
import nightlyAppIcon from "../assets/t3-nightly-384.webp?url";
import stableAppIcon from "../assets/t3-latest-384.webp?url";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  favicon?: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title = "T3 Code",
  description = "T3 Code — The open-source control plane for coding agents.",
  pageClass,
  favicon = stableAppIcon,
  socialImage = "/og-image.png",
  socialImageAlt = "T3 Code model picker shown in cinematic perspective",
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(socialImage, siteUrl);
---

<html lang="en" data-stage="latest">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="T3 Code" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      id="stage-favicon"
      rel="icon"
      href={favicon}
      sizes="any"
      data-stage-icon-latest={stableAppIcon}
      data-stage-icon-nightly={nightlyAppIcon}
      data-stage-icon-dev={devAppIcon}
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stage = localStorage.getItem("t3code:marketing-stage");
          if (stage === "latest" || stage === "nightly" || stage === "dev") {
            document.documentElement.dataset.stage = stage;
          }
        } catch {
          // Storage can be unavailable in privacy-restricted browsing contexts.
        }

        const preview = new URLSearchParams(window.location.search).get("platform-preview");
        if (preview) document.documentElement.dataset.stage = "latest";
        const userAgent = navigator.userAgent;
        let platform;
        if (preview && preview !== "auto") {
          platform = preview === "android" ? "android" : "ios";
        } else if (/Android/i.test(userAgent)) {
          platform = "android";
        } else if (
          /iPad|iPhone|iPod/i.test(userAgent) ||
          (/Mac/i.test(userAgent) && navigator.maxTouchPoints > 1)
        ) {
          platform = "ios";
        } else if (/Win/i.test(userAgent)) {
          platform = "win";
        } else if (/Mac/i.test(userAgent)) {
          platform = "mac";
        } else if (/Linux/i.test(userAgent)) {
          platform = "linux";
        }
        if (platform) document.documentElement.dataset.platform = platform;
      })();
    </script>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <div class="nav-blur" aria-hidden="true">
          <span class="nav-blur-layer nav-blur-layer--32"></span>
          <span class="nav-blur-layer nav-blur-layer--16"></span>
          <span class="nav-blur-layer nav-blur-layer--8"></span>
          <span class="nav-blur-layer nav-blur-layer--4"></span>
          <span class="nav-blur-layer nav-blur-layer--2"></span>
          <span class="nav-blur-layer nav-blur-layer--1"></span>
          <span class="nav-blur-layer nav-blur-layer--half"></span>
        </div>
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="T3 Code home">
            <svg
              class="nav-brand-mark"
              viewBox="15.5309 37 94.3941 56.96"
              aria-hidden="true"
            >
              <path
                d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z"
                fill="currentColor"
              />
            </svg>
            <span class="nav-brand-name">Code</span>
          </a>
          <div class="nav-right">
            <div class="nav-download">
              <button
                class="site-stage-trigger"
                type="button"
                aria-label="Release channel: Latest. Switch to Nightly"
                data-site-stage-trigger
              >
                <img src={stableAppIcon} alt="" width="16" height="16" data-site-stage-icon />
              </button>
              <a class="nav-link" href="/download">Download</a>
            </div>
            <a
              class="nav-stars"
              href={GITHUB_REPOSITORY_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="View T3 Code on GitHub"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.94 10.94 0 0 1 5.75 0c2.19-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-ambient" aria-hidden="true"></div>
        <div class="footer-inner">
          <nav class="footer-columns" aria-label="Footer navigation">
            <div class="footer-column">
              <p class="footer-column-title">Product</p>
              <a href="/download">Download</a>
              <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
              <a
                href={`${GITHUB_REPOSITORY_URL}/releases`}
                target="_blank"
                rel="noopener noreferrer">Releases</a
              >
            </div>
            <div class="footer-column">
              <p class="footer-column-title">Community</p>
              <a
                href="https://discord.gg/jn4EGJjrvv"
                target="_blank"
                rel="noopener noreferrer">Discord</a
              >
              <a
                href={`${GITHUB_REPOSITORY_URL}/issues`}
                target="_blank"
                rel="noopener noreferrer">Issues</a
              >
              <a
                href={`${GITHUB_REPOSITORY_URL}/fork`}
                target="_blank"
                rel="noopener noreferrer">Fork</a
              >
            </div>
            <div class="footer-column">
              <p class="footer-column-title">Legal</p>
              <a href="/terms-of-service">Terms</a>
              <a href="/privacy-policy">Privacy</a>
              <a href="/security-policy">Security</a>
            </div>
          </nav>

          <div class="footer-credit">
            <a href="/" class="footer-credit-brand" aria-label="T3 Code home">T3 Code</a>
            <span class="footer-credit-separator" aria-hidden="true"></span>
            <span>&copy; {new Date().getFullYear()} T3 Tools Inc</span>
            <span class="footer-credit-separator" aria-hidden="true"></span>
            <a
              href={`${GITHUB_REPOSITORY_URL}/blob/main/LICENSE`}
              target="_blank"
              rel="noopener noreferrer">MIT licensed</a
            >
            <span class="footer-credit-separator" aria-hidden="true"></span>
            <span>
              Landing page inspired by{" "}
              <a href="https://helium.computer" target="_blank" rel="noopener noreferrer"
                >Helium</a
              >
            </span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      type Stage = "latest" | "nightly" | "dev";

      const STORAGE_KEY = "t3code:marketing-stage";
      const stageLabels: Record<Stage, string> = {
        latest: "Latest",
        nightly: "Nightly",
        dev: "Dev",
      };
      const stageOrder: ReadonlyArray<Stage> = ["latest", "nightly", "dev"];

      function isStage(value: unknown): value is Stage {
        return value === "latest" || value === "nightly" || value === "dev";
      }

      function setSiteStage(stage: Stage, persist: boolean, notify: boolean) {
        document.documentElement.dataset.stage = stage;

        const favicon = document.getElementById("stage-favicon") as HTMLLinkElement | null;
        const faviconUrl = favicon?.dataset[
          `stageIcon${stage[0]?.toUpperCase()}${stage.slice(1)}`
        ];
        if (favicon && faviconUrl) favicon.href = faviconUrl;

        const nextStage = stageOrder[(stageOrder.indexOf(stage) + 1) % stageOrder.length] ?? "latest";
        for (const trigger of document.querySelectorAll<HTMLButtonElement>(
          "[data-site-stage-trigger]",
        )) {
          trigger.setAttribute(
            "aria-label",
            `Release channel: ${stageLabels[stage]}. Switch to ${stageLabels[nextStage]}`,
          );
          trigger.title = `${stageLabels[stage]} channel — click to switch`;
        }

        for (const icon of document.querySelectorAll<HTMLImageElement>("[data-site-stage-icon]")) {
          if (faviconUrl) icon.src = faviconUrl;
        }

        if (persist) {
          try {
            localStorage.setItem(STORAGE_KEY, stage);
          } catch {
            // The selected channel still applies for this page when storage is unavailable.
          }
        }

        if (notify) {
          document.dispatchEvent(
            new CustomEvent("t3-marketing-stage-change", { detail: { stage } }),
          );
        }
      }

      const trigger = document.querySelector<HTMLButtonElement>("[data-site-stage-trigger]");
      trigger?.addEventListener("click", () => {
        const currentStage = document.documentElement.dataset.stage;
        const currentIndex = isStage(currentStage) ? stageOrder.indexOf(currentStage) : 0;
        const nextStage = stageOrder[(currentIndex + 1) % stageOrder.length] ?? "latest";
        setSiteStage(nextStage, true, true);
      });

      document.addEventListener("t3-marketing-stage-request", (event) => {
        const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
        if (isStage(stage)) setSiteStage(stage, true, true);
      });

      const initialStage = document.documentElement.dataset.stage;
      setSiteStage(isStage(initialStage) ? initialStage : "latest", false, false);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000;
    --bg-elev: #0c0c0e;
    --bg-card: #111113;
    --fg: #fafafa;
    --fg-muted: #a1a1aa;
    --fg-dim: #71717a;
    --fg-faint: #52525b;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --accent-h: 250;
    --accent: oklch(0.68 0.17 var(--accent-h));
    --accent-dim: oklch(0.68 0.17 var(--accent-h) / 0.15);
    --ok: oklch(0.72 0.16 150);
    --warn: oklch(0.76 0.15 75);
    --button-bg: var(--fg);
    --button-fg: #09090b;
    --button-hover: #fff;
    --surface-subtle: rgba(255, 255, 255, 0.025);
    --surface-hover: rgba(255, 255, 255, 0.05);
    --tile-highlight: rgba(255, 255, 255, 0.015);
    --nav-scrim-start: rgba(0, 0, 0, 0.5);
    --nav-scrim-mid: rgba(0, 0, 0, 0.12);
    --noise-opacity: 0.035;
    --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    overscroll-behavior-y: none;
    scroll-behavior: smooth;
  }

  html[data-stage="nightly"] {
    --accent-h: 292;
  }

  html[data-stage="dev"] {
    --accent-h: 240;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #fafafa;
      --bg-elev: #fff;
      --bg-card: #f1f1f3;
      --fg: #18181b;
      --fg-muted: #52525b;
      --fg-dim: #71717a;
      --fg-faint: #a1a1aa;
      --border: rgba(24, 24, 27, 0.09);
      --border-strong: rgba(24, 24, 27, 0.16);
      --accent: oklch(0.56 0.19 var(--accent-h));
      --accent-dim: oklch(0.56 0.19 var(--accent-h) / 0.11);
      --ok: oklch(0.52 0.15 150);
      --warn: oklch(0.56 0.15 75);
      --button-bg: #18181b;
      --button-fg: #fff;
      --button-hover: #27272a;
      --surface-subtle: rgba(24, 24, 27, 0.025);
      --surface-hover: rgba(24, 24, 27, 0.055);
      --tile-highlight: rgba(255, 255, 255, 0.72);
      --nav-scrim-start: rgba(250, 250, 250, 0.82);
      --nav-scrim-mid: rgba(250, 250, 250, 0.34);
      --noise-opacity: 0.018;
    }

    html {
      color-scheme: light;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-feature-settings: "ss01", "ss02";
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overscroll-behavior-y: none;
    overflow-x: hidden;
    line-height: 1.5;
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: var(--noise-opacity);
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
    z-index: 9999;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
    font-weight: 500;
  }

  .display {
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    transition: transform 0.18s ease, background 0.18s ease,
      border-color 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--button-bg);
    color: var(--button-fg);
    font-weight: 600;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: var(--button-hover);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    color: var(--fg-muted);
    background: transparent;
  }

  .btn-ghost:hover {
    color: var(--fg);
    background: var(--surface-hover);
  }

  .btn-lg {
    padding: 14px 22px;
    font-size: 15px;
    border-radius: 10px;
  }

  .tile {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--tile-highlight), transparent);
    overflow: hidden;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    50% { opacity: 0.4; }
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  /* Layered backdrop filters create a progressive blur: strongest directly
     behind the navigation, then dissolving into the page without a hard edge. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    isolation: isolate;
    background: transparent;
  }

  .page.marketing-home .nav,
  .page.marketing-downloads .nav,
  .page.legal-simple-page .nav {
    position: fixed;
    right: 0;
    left: 0;
  }

  .nav-blur {
    position: absolute;
    inset: 0 0 -64px;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .nav-blur::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--nav-scrim-start),
      var(--nav-scrim-mid) 52%,
      transparent
    );
  }

  .nav-blur-layer {
    position: absolute;
    inset: 0;
  }

  .nav-blur-layer--32 {
    -webkit-backdrop-filter: blur(32px);
    backdrop-filter: blur(32px);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 12.5%, transparent 25%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 12.5%, transparent 25%);
  }

  .nav-blur-layer--16 {
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 12.5%, #000 25%, transparent 37.5%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 12.5%, #000 25%, transparent 37.5%);
  }

  .nav-blur-layer--8 {
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 12.5%, #000 25%, #000 37.5%, transparent 50%);
    mask-image: linear-gradient(to bottom, transparent 12.5%, #000 25%, #000 37.5%, transparent 50%);
  }

  .nav-blur-layer--4 {
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 25%, #000 37.5%, #000 50%, transparent 62.5%);
    mask-image: linear-gradient(to bottom, transparent 25%, #000 37.5%, #000 50%, transparent 62.5%);
  }

  .nav-blur-layer--2 {
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 37.5%, #000 50%, #000 62.5%, transparent 75%);
    mask-image: linear-gradient(to bottom, transparent 37.5%, #000 50%, #000 62.5%, transparent 75%);
  }

  .nav-blur-layer--1 {
    -webkit-backdrop-filter: blur(1px);
    backdrop-filter: blur(1px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 50%, #000 62.5%, #000 75%, transparent 87.5%);
    mask-image: linear-gradient(to bottom, transparent 50%, #000 62.5%, #000 75%, transparent 87.5%);
  }

  .nav-blur-layer--half {
    -webkit-backdrop-filter: blur(0.5px);
    backdrop-filter: blur(0.5px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 62.5%, #000 75%, #000 87.5%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 62.5%, #000 75%, #000 87.5%, transparent 100%);
  }

  .nav-inner {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .nav-brand:hover {
    color: var(--fg);
  }

  .nav-brand-mark {
    display: block;
    width: auto;
    height: 11px;
    flex-shrink: 0;
  }

  .nav-brand-name {
    color: var(--fg-muted);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .nav-brand:hover .nav-brand-name {
    color: var(--fg);
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 20px;
  }

  .nav-download {
    display: inline-flex;
    align-items: center;
