---
import { getImage } from "astro:assets";
import socialCard from "../assets/social-card.webp";
import "@fontsource-variable/inter";
import { CDN_ORIGIN, GITHUB_REPOSITORY_URL } from "../lib/site";
import { MARKETING_STATS } from "../lib/stats";
import { type JsonLd, jsonLdGraph, organizationJsonLd, websiteJsonLd } from "../lib/seo";
import { messagesFor } from "../i18n";
import {
  DEFAULT_LOCALE,
  fillTemplate,
  LOCALES,
  type Locale,
  localeInfo,
  type LocalizedPath,
  localizedHref,
} from "../i18n/locales";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  jsonLd?: ReadonlyArray<JsonLd>;
  noindex?: boolean;
  locale?: Locale;
  localizedPath?: LocalizedPath;
}

const { locale = DEFAULT_LOCALE, localizedPath } = Astro.props;
const t = messagesFor(locale).layout;
const {
  title = t.defaultTitle,
  description = t.defaultDescription,
  pageClass,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const currentLocale = localeInfo(locale);
const homeHref = localizedHref(locale, "/");
const downloadHref = localizedHref(locale, "/download");
const alternates = localizedPath
  ? LOCALES.map((entry) => ({
      hreflang: entry.code,
      href: new URL(localizedHref(entry.code, localizedPath), Astro.site).href,
    }))
  : [{ hreflang: DEFAULT_LOCALE, href: new URL(Astro.url.pathname, Astro.site).href }];
const defaultAlternate = alternates.find((entry) => entry.hreflang === DEFAULT_LOCALE)!;
const structuredData = jsonLdGraph([organizationJsonLd(), websiteJsonLd(), ...jsonLd]);

const socialImage = await getImage({
  src: socialCard,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
const socialImageAlt = t.socialImageAlt;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF9F5" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tix" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {!noindex && (
      <>
        {alternates.map((entry) => <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />)}
        <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
      </>
    )}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <header class="nav">
        <div class="nav-inner">
          <a href={homeHref} class="nav-brand" aria-label={t.homeLabel}>
            <span class="nav-brand-mark" aria-hidden="true">
              <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M14 2.5V25.5M2.5 14H25.5M5.87 5.87L22.13 22.13M22.13 5.87L5.87 22.13"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linecap="round"
                />
                <circle cx="14" cy="14" r="3.2" fill="#FAF9F5" stroke="currentColor" stroke-width="2" />
              </svg>
            </span>
            <span class="nav-brand-name">tix</span>
          </a>

          <nav class="nav-right" aria-label="Primary">
            <a href={downloadHref} class="nav-link">{t.download}</a>
            <a
              href={GITHUB_REPOSITORY_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-github"
              aria-label={fillTemplate(t.starsLabel, { stars: MARKETING_STATS.githubStars })}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
              </svg>
              <span>GitHub</span>
              {MARKETING_STATS.githubStars !== "0" && (
                <span class="nav-stars">{MARKETING_STATS.githubStars}</span>
              )}
            </a>

            {localizedPath && (
              <details class="locale-picker">
                <summary aria-label={t.language}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                  <span>{currentLocale.name}</span>
                </summary>
                <div class="locale-menu" role="menu">
                  {LOCALES.map((entry) => (
                    <a
                      href={localizedHref(entry.code, localizedPath)}
                      class:list={["locale-option", entry.code === locale && "is-active"]}
                      hreflang={entry.code}
                    >
                      {entry.name}
                    </a>
                  ))}
                </div>
              </details>
            )}
          </nav>
        </div>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="container footer-inner">
          <div class="footer-brand">
            <a href={homeHref} class="footer-logo">
              <span class="nav-brand-mark nav-brand-mark--sm" aria-hidden="true">
                <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path
                    d="M14 2.5V25.5M2.5 14H25.5M5.87 5.87L22.13 22.13M22.13 5.87L5.87 22.13"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                  />
                  <circle cx="14" cy="14" r="3.2" fill="#FAF9F5" stroke="currentColor" stroke-width="2" />
                </svg>
              </span>
              <span>tix</span>
            </a>
            <p class="footer-note">{t.mitLicensed} · Tailscale-first</p>
          </div>

          <div class="footer-links">
            <a href={downloadHref}>{t.download}</a>
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={CDN_ORIGIN} target="_blank" rel="noopener noreferrer">CDN</a>
            <a href="/privacy-policy">{t.privacy}</a>
            <a href="/terms-of-service">{t.terms}</a>
            <a href="/security-policy">{t.security}</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf9f5;
    --bg-soft: #f3efe6;
    --bg-card: #ffffff;
    --bg-ink: #1e1d1a;
    --fg: #191918;
    --fg-muted: #5c5852;
    --fg-dim: #857f76;
    --accent: #d97757;
    --accent-hover: #c46342;
    --accent-soft: #f6e7df;
    --border: #e6dfd3;
    --border-strong: #d4cbb9;
    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 24px;
    --font-serif: "Newsreader", "Iowan Old Style", "Georgia", "Songti SC", "Noto Serif CJK SC", serif;
    --font-sans: "Inter Variable", "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", sans-serif;
    --font-mono: ui-monospace, "SFMono-Regular", Menlo, Monaco, Consolas, monospace;
    --shadow-soft: 0 1px 2px rgba(25, 25, 24, 0.04), 0 10px 30px rgba(25, 25, 24, 0.05);
    --shadow-frame: 0 24px 60px rgba(25, 25, 24, 0.11), 0 2px 8px rgba(25, 25, 24, 0.05);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .main {
    flex: 1;
  }

  .container {
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .display {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.06;
    color: var(--fg);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: #9f4628;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.94rem;
    line-height: 1;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .btn-lg {
    padding: 13px 22px;
  }

  .btn-primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 1px 2px rgba(159, 70, 40, 0.25);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    background: var(--bg-card);
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .btn-ghost:hover {
    background: var(--bg-soft);
    border-color: #bfb5a3;
  }

  /* Header */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(250, 249, 245, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .nav-brand-mark {
    width: 24px;
    height: 24px;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-brand-mark--sm {
    width: 20px;
    height: 20px;
  }

  .nav-brand-name {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: 7px 12px;
    border-radius: 999px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--fg);
    background: var(--bg-soft);
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--fg);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 7px 13px;
    border-radius: 999px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .nav-github:hover {
    border-color: var(--border-strong);
    background: var(--bg-soft);
  }

  .nav-stars {
    color: var(--fg-muted);
    font-size: 0.8rem;
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }

  .locale-picker {
    position: relative;
  }

  .locale-picker summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    color: var(--fg-muted);
    padding: 7px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    cursor: pointer;
    user-select: none;
  }

  .locale-picker summary::-webkit-details-marker {
    display: none;
  }

  .locale-picker summary:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .locale-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 170px;
    padding: 6px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 50;
  }

  .locale-option {
    font-size: 0.86rem;
    color: var(--fg-muted);
    padding: 7px 10px;
    border-radius: 8px;
  }

  .locale-option:hover {
    background: var(--bg-soft);
    color: var(--fg);
  }

  .locale-option.is-active {
    background: var(--accent-soft);
    color: #9f4628;
    font-weight: 500;
  }

  /* Footer */
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 36px 0 48px;
    background: var(--bg);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .footer-note {
    margin: 0;
    font-size: 0.84rem;
    color: var(--fg-dim);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    font-size: 0.86rem;
    color: var(--fg-muted);
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 18px;
    }

    .nav-inner {
      padding: 12px 18px;
    }

    .locale-picker summary span {
      display: none;
    }
  }
</style>
