---
import { Font, getImage } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import socialCard from "../assets/social-card.webp";
import "@fontsource-variable/inter";
import { type JsonLd, jsonLdGraph, organizationJsonLd, websiteJsonLd } from "../lib/seo";
import { CHANNEL_STORAGE_KEY } from "../lib/channel";
import { detectPlatform } from "../lib/platform";
import { messagesFor } from "../i18n";
import {
  DEFAULT_LOCALE,
  LOCALES,
  type Locale,
  type LocalizedPath,
  localizedHref,
} from "../i18n/locales";

interface Props {
  title?: string;
  description?: string;
  /** Page-specific schema.org nodes. Organization and WebSite are always included. */
  jsonLd?: ReadonlyArray<JsonLd>;
  noindex?: boolean;
  locale?: Locale;
  /** Set when the page exists in every locale; enables the language picker and hreflang links. */
  localizedPath?: LocalizedPath;
  footer?: boolean;
}

const { locale = DEFAULT_LOCALE, localizedPath, footer = true } = Astro.props;
const t = messagesFor(locale).layout;
const {
  title = t.defaultTitle,
  description = t.defaultDescription,
  jsonLd = [],
  noindex = false,
} = Astro.props;
const lower = (value: string) => value.toLocaleLowerCase(locale);
// English-only pages still declare themselves, so every indexable page carries hreflang and x-default.
const alternates = localizedPath
  ? LOCALES.map((entry) => ({
      hreflang: entry.code,
      href: new URL(localizedHref(entry.code, localizedPath), Astro.site).href,
    }))
  : [{ hreflang: DEFAULT_LOCALE, href: new URL(Astro.url.pathname, Astro.site).href }];
const defaultAlternate = alternates.find((entry) => entry.hreflang === DEFAULT_LOCALE)!;
const structuredData = jsonLdGraph([organizationJsonLd(), websiteJsonLd(), ...jsonLd]);

// Link unfurlers require a 1200x630 JPG/PNG at an absolute URL.
const socialImage = await getImage({
  src: socialCard,
  width: 1200,
  height: 630,
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
const socialImageAlt = t.socialImageAlt;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Runs before first paint, so the saved channel and the visitor's platform never switch after load.
const restoreChannel = `try{(/[?&]channel=nightly/.test(location.search)||localStorage.getItem(${JSON.stringify(CHANNEL_STORAGE_KEY)})==="nightly")&&(document.documentElement.dataset.channel="nightly")}catch(e){}`;
const setPlatform = `(function(p){p&&(document.documentElement.dataset.platform=p.os)})((${detectPlatform})(navigator.userAgent,navigator.maxTouchPoints))`;
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="T3 Code" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@t3dotgg" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {!noindex && (
      <>
        {alternates.map((entry) => <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />)}
        <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
      </>
    )}
    <title>{title}</title>
    <Font cssVariable="--font-geist-mono" preload />
    <script is:inline type="application/ld+json" set:html={structuredData} />
    <script is:inline set:html={`${restoreChannel};${setPlatform}`} />
  </head>
  <body>
    <div class="page">
      <div class="shell">
        <SiteHeader locale={locale} localizedPath={localizedPath} />
      </div>

      <main class="main">
        <slot />
      </main>

      {footer && (
        <footer class="shell foot">
          <span>&copy; {new Date().getFullYear()} T3 Tools Inc</span>
          <a href="/terms-of-service">{lower(t.terms)}</a>
          <a href="/privacy-policy">{lower(t.privacy)}</a>
          <a href="/security-policy">{lower(t.security)}</a>
        </footer>
      )}
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #000;
    --bg-elev: #0a0a0a;
    --fg: #f5f5f5;
    --fg-muted: #a3a3a3;
    --fg-dim: #737373;
    --fg-faint: #525252;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --accent-h: 264;
    --accent: oklch(0.68 0.17 var(--accent-h));
    --ok: oklch(0.72 0.16 150);
    --warn: oklch(0.76 0.15 75);
    --font-sans: -apple-system, BlinkMacSystemFont, "Inter Variable", "Segoe UI", system-ui, sans-serif;
    --font-mono: var(--font-geist-mono), ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    overscroll-behavior: none;
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    overscroll-behavior: none;
    line-height: 1.5;
  }


  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  :root {
    --nightly-base: #03040c;
    --nightly-row: url("/nightly-sunrise.svg") 85% 76% / max(100%, 640px) auto no-repeat;
  }

  /* One column width for every page. */
  .shell {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .page-title {
    font-size: clamp(32px, 4.6vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .page-sub {
    max-width: 600px;
    margin-top: 12px;
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    transition: transform 0.18s ease, background 0.18s ease,
      border-color 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: oklch(0.571 0.21 264);
    color: #fff;
    font-weight: 600;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: oklch(0.62 0.2 264);
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .main {
    flex: 1;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding-top: 0;
    padding-bottom: calc(40px + env(safe-area-inset-bottom));
    font-size: 13px;
    color: var(--fg-dim);
  }

  .foot a {
    transition: color 0.18s ease;
  }

  .foot a:hover {
    color: var(--fg);
  }
</style>
