  @keyframes command-deck-separate {
    from {
      transform: translate3d(0, 0, 0) scale(0.9);
    }
    to {
      transform: translate3d(
          var(--plane-shift),
          calc(var(--plane-shift) * -0.22),
          var(--plane-depth)
        )
        scale(1);
    }
  }
  @keyframes command-core-arrive {
    from {
      opacity: 0;
      transform: translate3d(-50%, -50%, 0) scale(0.4);
    }
    to {
      opacity: 1;
      transform: translate3d(-50%, -50%, 154px) scale(1);
    }
  }
  @keyframes handoff-portal-open {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) perspective(900px) rotateX(72deg)
        rotateZ(-12deg) scale(0.45);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) perspective(900px) rotateX(72deg)
        rotateZ(-12deg) scale(1);
    }
  }
  @keyframes handoff-device-arrive {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
  @keyframes local-machine-land {
    from {
      opacity: 0;
      transform: translate(-50%, -36%) perspective(1100px) rotateX(58deg)
        rotateZ(-39deg) scale(0.76);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) perspective(1100px) rotateX(58deg)
        rotateZ(-39deg) scale(var(--machine-scale));
    }
  }
  @keyframes open-layer-materialize {
    from {
      clip-path: inset(0 100% 0 0);
      filter: blur(8px);
    }
    to {
      clip-path: inset(0);
      filter: blur(0);
    }
  }
  @keyframes ship-step-rise {
    from {
      filter: blur(8px);
      transform: translate(-50%, -18%) rotateZ(17deg) rotateX(-63deg)
        scale(0.46);
    }
    to {
      filter: blur(0);
      transform: translate(-50%, -50%) rotateZ(17deg) rotateX(-63deg) scale(1);
    }
  }

  .hero-lab {
    position: absolute;
    top: 88px;
    right: 20px;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    background: rgba(8, 8, 10, 0.7);
    backdrop-filter: blur(12px);
    opacity: 0.48;
    transition: opacity 0.18s ease;
  }

  .hero-lab:hover,
  .hero-lab:focus-within {
    opacity: 1;
  }

  .hero-lab > span {
    padding: 0 5px;
    color: rgba(255, 255, 255, 0.38);
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-lab button {
    display: grid;
    width: 25px;
    height: 25px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    color: rgba(255, 255, 255, 0.45);
    font-family: var(--font-mono);
    font-size: 10px;
    background: transparent;
    cursor: pointer;
    place-items: center;
  }

  .hero-lab button:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  .hero-lab button[aria-pressed="true"] {
    color: #09090a;
    background: var(--hero-concept-accent, #a98cff);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    width: 218px;
  }

  .mobile-download-links {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .mobile-download-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 1px 0;
    color: var(--fg-dim);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .mobile-download-links a:hover,
  .mobile-download-links a:focus-visible {
    color: var(--fg);
  }

  .mobile-download-links img {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
    filter: saturate(0.78) brightness(0.88);
    object-fit: contain;
    opacity: 0.76;
    transition:
      filter 0.18s ease,
      opacity 0.18s ease;
  }

  .mobile-download-links a:hover img,
  .mobile-download-links a:focus-visible img {
    filter: saturate(0.9) brightness(0.96);
    opacity: 0.92;
  }

  /* Download button, decorated with the app's real stage art per channel. */
  #download-btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    transition:
      transform 0.18s ease,
      background var(--channel-fade-duration) var(--channel-fade-easing),
      border-color 0.18s ease,
      color var(--channel-fade-duration) var(--channel-fade-easing);
  }

  #download-btn::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.2);
    content: "";
    pointer-events: none;
  }

  .btn-stage-art {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .btn-stage-art iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: blur(9px) saturate(0.9);
    pointer-events: none;
    transform: scale(1.18);
  }

  .hero[data-stage="nightly"] .btn-stage-art--nightly {
    opacity: 1;
  }
  .hero[data-stage="dev"] .btn-stage-art--dev {
    opacity: 1;
  }

  .hero[data-stage="nightly"] #download-btn,
  .hero[data-stage="dev"] #download-btn {
    color: #fff;
    background: #0a0a0c;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.55);
  }

  #download-btn > svg,
  #download-btn .btn-label {
    position: relative;
    z-index: 2;
  }

  /* Download channel picker. */
  .channel-picker {
    position: relative;
    width: 100%;
    min-height: 27px;
  }

  #cta-channel-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  #cta-channel-btn:hover {
    color: var(--fg);
  }

  #cta-channel-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 96px;
    padding: 4px 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    z-index: 20;
  }

  #cta-channel-menu button {
    display: block;
    width: 100%;
    padding: 5px 0;
    border: 0;
    background: transparent;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 400;
    cursor: pointer;
    text-align: left;
    transition: color 0.18s ease;
  }

  #cta-channel-menu button:hover {
    color: var(--fg);
  }

  #cta-channel-menu button[data-active="true"] {
    color: var(--fg);
  }

  /* Download button icons (platform-aware) */
  .dl-icon {
    display: none;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  :global([data-platform="mac"]) .dl-icon--apple,
  :global([data-platform="ios"]) .dl-icon--apple {
    display: block;
  }
  :global([data-platform="win"]) .dl-icon--windows {
    display: block;
  }
  :global([data-platform="linux"]) .dl-icon--linux {
    display: block;
  }
  :global(html:not([data-platform])) .dl-icon--apple {
    display: block;
  }

  /* The app always renders at a desktop viewport and scales down with its
     frame. That preserves the real desktop chrome and T3 Code wordmark even
     in the narrower side-by-side layouts. */
  .hero,
  .sec-showcase {
    --preview-fade-duration: 1400ms;
    --preview-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-preview {
    position: relative;
    z-index: 1;
  }

  .hero-demo-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1200 / 804;
    width: 100%;
    contain: layout paint;
    isolation: isolate;
    border-radius: 14px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 28px 64px -28px rgba(0, 0, 0, 0.75);
    filter: brightness(0) saturate(0);
    opacity: 1;
    transform-style: preserve-3d;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.5s ease,
      box-shadow 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, filter, transform;
  }

  .hero-demo-frame.is-ready {
    filter: brightness(1) saturate(1);
    opacity: 1;
    animation: preview-frame-reveal var(--preview-fade-duration)
      var(--preview-fade-easing) both;
  }

  @keyframes preview-frame-reveal {
    0%,
    14% {
      filter: brightness(0) saturate(0);
      opacity: 1;
    }
    100% {
      filter: brightness(1) saturate(1);
      opacity: 1;
    }
  }

  .hero-demo-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 1200px;
    height: 804px;
    border: 0;
    background: #000;
    transform-origin: top left;
  }

  /* 2: split stage, the original composition with more room for the app. */
  .hero--layout-2 .hero-inner {
    display: grid;
    grid-template-columns: minmax(340px, 390px) minmax(0, 1fr);
    gap: 44px;
    align-items: center;
    max-width: 1240px;
  }

  .hero--layout-2 {
    display: flex;
    min-height: 100svh;
    align-items: center;
    padding-block: 64px;
  }

  .hero--layout-2 .hero-copy {
    max-width: 390px;
  }

  .hero--layout-2 .hero-preview {
    width: 100%;
  }

  .hero[data-hero-variant="2"] .hero-inner {
    grid-template-columns: minmax(300px, 340px) minmax(0, 1fr);
    gap: 20px;
  }

  .hero[data-hero-variant="3"] .hero-inner {
    grid-template-columns: minmax(310px, 350px) minmax(0, 1fr);
    gap: 24px;
  }

  .hero[data-hero-variant="4"] .hero-inner {
    grid-template-columns: minmax(300px, 350px) minmax(0, 1fr);
    gap: 10px;
  }

  .hero[data-hero-variant="5"] .hero-inner {
    grid-template-columns: minmax(310px, 370px) minmax(0, 1fr);
    gap: 16px;
  }

  .hero[data-hero-variant="5"] .hero-copy {
    align-self: start;
    padding-top: 84px;
  }

  @media (min-width: 821px) {
    .hero[data-hero-variant="2"] .hero-copy {
      transform: translateY(-96px);
    }

    .hero[data-hero-variant="3"] .hero-copy {
      transform: translateY(104px);
    }

    .hero[data-hero-variant="5"] .hero-copy {
      transform: translateY(-112px);
    }
  }

  .hero[data-hero-variant="4"] .hero-lab {
    border-color: rgba(17, 17, 17, 0.13);
    background: rgba(233, 232, 227, 0.76);
  }

  .hero[data-hero-variant="4"] .hero-lab > span,
  .hero[data-hero-variant="4"] .hero-lab button {
    color: rgba(17, 17, 17, 0.48);
  }

  .hero[data-hero-variant="4"] .hero-lab button:hover {
    color: #111;
    background: rgba(17, 17, 17, 0.08);
  }

  :global(.page:has(#hero[data-hero-variant="4"]) .nav-inner) {
    filter: invert(1);
  }

  :global(.page:has(#hero[data-hero-variant="4"]) .nav-blur::after) {
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.66),
      rgba(255, 255, 255, 0.14) 52%,
      transparent
    );
  }

  /* Store-linked iPhone and iPad cards riding the hero's right edge. */
  .hero-mobile-store {
    position: absolute;
    right: 22px;
    bottom: 38px;
    width: 270px;
    height: 300px;
    z-index: 3;
    filter: brightness(0) saturate(0);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(16px, 12px, 0) scale(0.96);
    transition:
      opacity 0.48s ease,
      transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-mobile-store.is-loaded {
    filter: brightness(1) saturate(1);
  }

  .hero[data-hero-variant="2"] .hero-mobile-store.is-loaded {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
    animation: preview-frame-reveal var(--preview-fade-duration)
      var(--preview-fade-easing) both;
  }

  .hero-mobile-showcase {
    display: none;
  }

  .hero-device-card {
    position: absolute;
    display: block;
    overflow: hidden;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    background: #0a0a0c;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 255, 255, 0.08);
    text-decoration: none;
    transition:
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.18s ease,
      box-shadow 0.24s ease;
  }

  .hero-device-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  .hero-device-card span {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 5px 8px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: rgba(4, 4, 5, 0.76);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(12px);
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }

  .hero-device-card--tablet {
    top: 5px;
    right: 0;
    width: 202px;
    border-radius: 21px;
    transform: rotate(5deg);
  }

  .hero-device-card--phone {
    bottom: 0;
    left: 2px;
    width: 128px;
    border-radius: 23px;
    transform: rotate(-5deg);
  }

  .hero-mobile-store:hover .hero-device-card--tablet,
  .hero-mobile-store:focus-within .hero-device-card--tablet {
    transform: translate(9px, -8px) rotate(7deg);
  }

  .hero-mobile-store:hover .hero-device-card--phone,
  .hero-mobile-store:focus-within .hero-device-card--phone {
    transform: translate(-7px, -10px) rotate(-7deg);
  }

  .hero-device-card:hover,
  .hero-device-card:focus-visible {
    z-index: 4;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 30px 72px rgba(0, 0, 0, 0.56),
      inset 0 1px rgba(255, 255, 255, 0.12);
    outline: none;
  }

  .hero-device-card:hover span,
  .hero-device-card:focus-visible span {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Setup and remote control ──────────────────────────── */
  .sec-connect {
    border-top: 0;
    padding: 88px 0;
  }

  .connect-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.72fr);
    column-gap: 64px;
    align-items: end;
    margin-bottom: 44px;
  }

  .connect-heading .connect-kicker {
    grid-column: 1 / -1;
  }

  .connect-heading h2 {
    margin: 0;
    font-size: clamp(38px, 4.6vw, 58px);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .connect-heading > p:last-child {
    margin: 0;
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .connect-grid {
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .connect-steps {
    display: grid;
    gap: 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .connect-steps li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }

  .connect-steps li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .connect-step-number {
    display: grid;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 11px;
    background: rgba(255, 255, 255, 0.035);
  }

  .connect-steps h3 {
    margin: 2px 0 5px;
    font-size: 18px;
    font-weight: 550;
    letter-spacing: -0.02em;
  }

  .connect-steps p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .connect-surfaces {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 30px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .connect-surfaces strong {
    margin-right: 6px;
    color: var(--fg-muted);
    font-weight: 500;
  }

  .connect-surfaces span {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    line-height: 1;
  }

  /* ── Endorsements ─────────────────────────────────────── */
  .sec-endorsements {
    overflow: hidden;
    border-top: 0;
  }

  .endorsements-head {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .endorsements-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .endorsements-count {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .endorsements-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .endorsement-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .endorsement-carousel--mobile {
    display: none;
  }

  .endorsement-carousel::before,
  .endorsement-carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: max(48px, calc((100vw - 1240px) / 2 + 56px));
    pointer-events: none;
  }

  .endorsement-carousel::before {
    left: 0;
    background: linear-gradient(90deg, var(--bg), transparent);
  }

  .endorsement-carousel::after {
    right: 0;
    background: linear-gradient(270deg, var(--bg), transparent);
  }

  .endorsement-row {
    overflow: hidden;
  }

  .endorsement-track {
    width: max-content;
    display: flex;
    animation: endorsementMarquee 76s linear infinite;
    will-change: transform;
  }

  .endorsement-track-group {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }

  .endorsement-row.is-reverse .endorsement-track {
    animation-direction: reverse;
    animation-duration: 84s;
  }

  .endorsement-carousel:hover .endorsement-track,
  .endorsement-carousel:focus-within .endorsement-track {
    animation-play-state: paused;
  }

  .endorsement-card {
    position: relative;
    width: clamp(264px, 22vw, 308px);
    height: 132px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.012);
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .endorsement-card:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .endorsement-author {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .endorsement-author img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .endorsement-handle {
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .endorsement-card p {
    color: var(--fg);
    font-size: 13.5px;
    line-height: 1.4;
    letter-spacing: -0.003em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* ── Screenshot walkthroughs ───────────────────────────── */
  .sec-showcase {
    overflow: hidden;
    padding: 48px 0;
    border-top: 0;
  }

  .showcase-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .showcase-inner--image-left {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .showcase-inner--image-left .showcase-visual {
    order: -1;
    justify-self: start;
  }

  .showcase-inner--image-left .showcase-copy .section-head {
    align-items: flex-end;
    margin-left: auto;
    text-align: right;
  }

  .showcase-inner--image-left .showcase-copy .section-head p {
    margin-left: auto;
  }

  .showcase-inner--image-left .showcase-link {
    align-self: flex-end;
  }

  .showcase-copy .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: none;
    margin: 0;
    text-align: left;
  }

  .showcase-copy .section-head h2 {
    margin-bottom: 10px;
    font-size: clamp(32px, 3vw, 42px);
  }

  .showcase-copy .section-head p {
    max-width: none;
    margin: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 18px;
    color: var(--fg-dim);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .showcase-link:hover {
    color: var(--fg);
  }

  .showcase-link:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .showcase-link svg {
    flex: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 0.18s ease;
  }

  .showcase-link:hover svg {
    transform: translateX(2px);
  }

  @media (min-width: 961px) {
    .showcase-copy .section-head h2,
    .showcase-copy .section-head p {
      white-space: nowrap;
    }
  }

  .showcase-visual {
    width: 100%;
    min-width: 0;
    margin: 0;
    justify-self: end;
  }

  .showcase-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--showcase-ratio);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #080808;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 38px 100px -46px rgba(0, 0, 0, 0.95);
    contain: layout paint;
    isolation: isolate;
  }

  .showcase-panel {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    margin: 0;
  }

  .showcase-image {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-stage-art,
    #download-btn,
    .cta-card,
    .cta-card::before,
    .cta-stage-art,
    .cta-app-icon,
    .faq-chevron,
    .agent-plane,
    .command-core,
    .handoff-portal,
    .handoff-device,
    .hero-concept,
    .hero-demo-frame,
    .hero-mobile-store,
    .hero-scene,
    .hero-mobile-showcase,
    .hero-mobile-showcase__screen,
    .hero-mobile-showcase__dots button,
    .hero-device-card,
    .local-machine,
    .mobile-download-links a,
    .open-layer,
    .ship-step,
    .endorsement-track {
      animation: none;
      transition: none;
    }
  }

  /* ── Terminal ─────────────────────────────────────────── */
  .open-term {
    padding: 0;
    overflow: hidden;
  }
  .connect-term,
  .open-source-terminal {
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #080808;
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 38px 100px -46px rgba(0, 0, 0, 0.95);
  }
  .open-term-body {
    padding: 20px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--fg);
  }
  .open-term-body > div {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .open-term-body .prompt {
    color: var(--accent);
    margin-right: 8px;
  }
  .open-term-body .dim {
    color: var(--fg-dim);
  }
  .open-term-body .accent {
    color: var(--accent);
  }
  .open-term-body .cursor {
    display: flex;
    align-items: center;
  }
  .terminal-user {
    color: #a6e3a1;
  }
  .terminal-path {
    color: #89b4fa;
    margin-left: 6px;
  }
  .terminal-spacer {
    height: 8px;
    line-height: 0;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--fg);
    margin-left: 4px;
    animation: blink 1s steps(2) infinite;
  }

  /* ── Open source ──────────────────────────────────────── */
  .sec-open {
    border-top: 0;
  }

  .open-simple {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 64px;
    row-gap: 28px;
    text-align: left;
  }

  .open-simple-copy {
    align-self: end;
  }

  .open-simple-copy h2 {
    margin-bottom: 14px;
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .open-simple-copy p {
    color: var(--fg-muted);
    font-size: 18px;
  }

  .open-source-terminal {
    width: 100%;
    grid-column: 2;
    grid-row: 1 / span 2;
    text-align: left;
  }

  .open-simple-action {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    gap: 14px;
  }

  /* ── FAQ ──────────────────────────────────────────────── */
  .sec-faq {
    --faq-accent: rgba(255, 255, 255, 0.68);
    --faq-surface: rgba(255, 255, 255, 0.045);
    --faq-surface-active: rgba(255, 255, 255, 0.072);
    padding: 72px 0 88px;
    border-top: 0;
  }

  :global(html[data-stage="nightly"]) .sec-faq {
    --faq-accent: rgb(183, 174, 255);
    --faq-surface: rgba(139, 129, 255, 0.075);
    --faq-surface-active: rgba(139, 129, 255, 0.125);
  }

  :global(html[data-stage="dev"]) .sec-faq {
    --faq-accent: rgb(150, 201, 255);
    --faq-surface: rgba(105, 180, 255, 0.075);
    --faq-surface-active: rgba(105, 180, 255, 0.125);
  }

  .faq-shell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .faq-head {
    text-align: center;
  }

  .faq-head h2 {
    color: var(--fg-muted);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .faq-list {
    display: grid;
    gap: 6px;
    width: min(760px, 100%);
  }

  .faq-item {
    overflow: hidden;
    border-radius: 12px;
    background: var(--faq-surface);
    transition: background 0.18s ease;
  }

  .faq-item:hover,
  .faq-item[open] {
    background: var(--faq-surface-active);
  }

  .faq-item summary {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.82);
    cursor: pointer;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1.25;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
    transition: color 0.18s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::marker {
    content: "";
  }

  .faq-item summary:hover,
  .faq-item[open] summary {
    color: var(--fg);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--faq-accent);
    outline-offset: 2px;
  }

  .faq-chevron {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    color: var(--faq-accent);
  }

  .faq-chevron::before {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron::before {
    transform: translateY(2px) rotate(225deg);
  }

  .faq-answer {
    padding: 0 48px 18px 20px;
  }

  .faq-answer p {
    color: var(--fg-muted);
    font-size: 15.5px;
    line-height: 1.5;
  }

  .faq-answer a {
    color: var(--faq-accent);
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .faq-answer a:hover {
    color: var(--fg);
  }

  /* ── Final CTA ────────────────────────────────────────── */
  .sec-cta {
    text-align: center;
    padding: 72px 0 96px;
    border-top: 0;
  }

  .cta-card {
    --channel-fade-duration: 900ms;
    --channel-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: grid;
    min-height: 500px;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 24px;
    background:
      radial-gradient(
        circle at 50% 32%,
        rgba(255, 255, 255, 0.025),
        transparent 30%
      ),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 42px 120px -64px rgba(0, 0, 0, 0.86);
    isolation: isolate;
    transition:
      border-color var(--channel-fade-duration) var(--channel-fade-easing),
      box-shadow var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"] {
    border-color: rgba(139, 129, 255, 0.22);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.07),
      0 42px 120px -64px rgba(85, 59, 183, 0.72);
  }

  .cta-card[data-stage="dev"] {
    border-color: rgba(133, 187, 255, 0.28);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.1),
      0 42px 120px -64px rgba(34, 104, 218, 0.72);
  }

  .cta-card::before,
  .cta-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-card::before {
    z-index: 1;
    opacity: 0.045;
    background-image:
      radial-gradient(
        circle,
        rgba(219, 226, 255, 0.72) 0 1px,
        transparent 1.4px
      ),
      radial-gradient(
        circle,
        rgba(147, 166, 255, 0.46) 0 1px,
        transparent 1.5px
      ),
      radial-gradient(
        circle,
        rgba(255, 255, 255, 0.3) 0 0.7px,
        transparent 1.1px
      );
    background-position:
      18px 12px,
      62px 38px,
      11px 54px;
    background-size:
      89px 83px,
      137px 121px,
      61px 67px;
    -webkit-mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"]::before {
    opacity: 0.56;
    background-image: url("/nightly-stars.svg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .cta-card[data-stage="dev"]::before {
    opacity: 0.2;
  }

  .cta-card::after {
    z-index: 1;
    background:
      radial-gradient(
        circle at 0% 100%,
        rgba(255, 255, 255, 0.06),
        transparent 28%
      ),
      radial-gradient(
        circle at 100% 0%,
        rgba(255, 255, 255, 0.05),
        transparent 25%
      ),
      linear-gradient(
        115deg,
        transparent 32%,
        rgba(255, 255, 255, 0.022) 50%,
        transparent 68%
      );
  }

  .cta-card-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cta-stage-art {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="latest"] .cta-stage-art--latest,
  .cta-card[data-stage="nightly"] .cta-stage-art--nightly,
  .cta-card[data-stage="dev"] .cta-stage-art--dev {
    opacity: 1;
  }

  .cta-stage-art--latest {
    background:
      radial-gradient(
        circle at 50% 26%,
        rgba(255, 255, 255, 0.025),
        transparent 36%
      ),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
  }

  .cta-latest-ray {
    position: absolute;
    top: -52%;
    width: 18%;
    height: 142%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.018) 30%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.018) 70%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.65) 42%,
      transparent 88%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      rgba(0, 0, 0, 0.65) 42%,
      transparent 88%
    );
    transform-origin: top center;
  }

  .cta-latest-ray--one {
    left: 13%;
    transform: rotate(13deg);
  }

  .cta-latest-ray--two {
    left: 42%;
    width: 22%;
    opacity: 0.78;
    transform: rotate(1deg);
  }

  .cta-latest-ray--three {
    right: 10%;
    opacity: 0.62;
    transform: rotate(-14deg);
  }

  .cta-stage-art--nightly {
    background:
      radial-gradient(
        ellipse at 17% 74%,
        rgba(105, 119, 176, 0.2),
        transparent 42%
      ),
      radial-gradient(
        ellipse at 78% 18%,
        rgba(126, 99, 169, 0.18),
        transparent 39%
      ),
      radial-gradient(
        circle at 54% 58%,
        rgba(117, 107, 174, 0.12),
        transparent 33%
      ),
      linear-gradient(
        138deg,
        #0b162e 0%,
        #171a3c 42%,
        #251a42 73%,
        #2d1948 100%
      );
  }

  .cta-stage-art--nightly::before,
  .cta-stage-art--nightly::after {
    position: absolute;
    content: "";
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .cta-stage-art--nightly::before {
    z-index: 2;
    inset: -12%;
    background: url("/nightly-clouds-foreground.webp") center bottom / 145% auto
      no-repeat;
    filter: blur(14px) saturate(0.68);
    opacity: 0.62;
    transform: translateY(6%);
  }

  .cta-stage-art--nightly::after {
    z-index: 1;
    inset: -12%;
    background: url("/nightly-clouds.webp") center 56% / cover no-repeat;
    filter: blur(1.5px) saturate(0.82);
    opacity: 0.72;
    transform: scale(1.02);
  }

  .cta-stage-art--dev {
    opacity: 0;
    background:
      radial-gradient(
        circle at 50% 42%,
        rgba(125, 186, 255, 0.22),
        transparent 34%
      ),
      linear-gradient(180deg, #102a55 0%, #173d82 100%);
  }

  .cta-stage-art--dev::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(199, 225, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(199, 225, 255, 0.12) 1px, transparent 1px),
      linear-gradient(rgba(217, 234, 255, 0.2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(217, 234, 255, 0.2) 1px, transparent 1px);
    background-size:
      32px 32px,
      32px 32px,
      160px 160px,
      160px 160px;
    content: "";
    -webkit-mask-image: radial-gradient(
      ellipse at center,
      #000 24%,
      transparent 76%
    );
    mask-image: radial-gradient(ellipse at center, #000 24%, transparent 76%);
  }

  .cta-orbit {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    transition:
      border-color 500ms ease,
      opacity 500ms ease;
  }

  .cta-card[data-stage="nightly"] .cta-orbit {
    opacity: 0;
  }

  .cta-card[data-stage="latest"] .cta-orbit {
    opacity: 0;
  }

  .cta-card[data-stage="dev"] .cta-orbit {
    border-color: rgba(207, 230, 255, 0.2);
  }

  .cta-orbit--one {
    right: 11%;
    bottom: -34%;
    width: 420px;
    height: 240px;
    transform: rotate(-13deg);
  }

  .cta-orbit--two {
    top: -32%;
    left: 3%;
    width: 360px;
    height: 220px;
    transform: rotate(17deg);
  }

  .cta-inner {
    position: relative;
    z-index: 2;
    display: flex;
    max-width: 650px;
    align-items: center;
    flex-direction: column;
    padding: 68px 32px;
  }

  .cta-app-icon-stack {
    position: relative;
    width: 132px;
    height: 132px;
    margin-bottom: 20px;
  }

  .cta-app-icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 29px;
    opacity: 0;
    object-fit: contain;
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="latest"] .cta-app-icon--latest,
  .cta-card[data-stage="nightly"] .cta-app-icon--nightly,
  .cta-card[data-stage="dev"] .cta-app-icon--dev {
    opacity: 1;
  }

  .cta-title {
    color: #fff;
    font-size: clamp(34px, 4vw, 46px);
  }

  .cta-sub {
    color: rgba(218, 222, 239, 0.68);
    font-size: 18px;
    max-width: 530px;
    margin: 14px auto 28px;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cta-channel-picker {
    width: auto;
    min-height: 0;
  }

  #cta-channel-btn {
    height: 51px;
    padding: 0 15px;
    border: 0;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.76);
    background: rgba(0, 0, 0, 0.05);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
  }

  #cta-channel-btn:hover {
    color: #fff;
    background: rgba(0, 0, 0, 0.05);
  }

  #cta-channel-menu {
    right: 0;
    left: auto;
    min-width: 112px;
    padding: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(8, 9, 13, 0.94);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(16px);
  }

  #cta-channel-menu button {
    padding: 7px 9px;
    border-radius: 7px;
    animation: none;
  }

  #cta-channel-menu button:hover,
  #cta-channel-menu button[data-active="true"] {
    background: rgba(255, 255, 255, 0.08);
  }

  .cta-all-downloads {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .cta-all-downloads:hover {
    color: #fff;
  }

  @keyframes endorsementMarquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 960px) {
    .hero--layout-2 .hero-inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }

    .hero--layout-2 .hero-copy {
      max-width: 600px;
    }

    .hero--layout-2 .hero-preview {
      margin-top: 48px;
    }

    .connect-heading {
      grid-template-columns: 1fr;
      row-gap: 18px;
      align-items: start;
    }

    .connect-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .showcase-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 32px;
    }

    .showcase-inner--image-left {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .open-simple {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      row-gap: 32px;
      text-align: center;
    }
    .open-simple-copy,
    .open-simple-action {
      align-self: auto;
      justify-self: center;
    }
    .open-simple-action {
      align-items: center;
    }
    .open-source-terminal {
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (max-width: 820px) {
    section {
      padding: 64px 0;
    }
    .sec-showcase {
      padding: 40px 0;
    }
    .sec-faq {
      padding: 60px 0 72px;
    }
    .sec-cta {
      padding: 48px 0 64px;
    }
    .cta-card {
      min-height: 500px;
      border-radius: 20px;
    }
    .cta-stage-art--nightly::before {
      inset: -10%;
      background-position: center bottom;
      background-size: 175% auto;
      filter: blur(11px) saturate(0.68);
      opacity: 0.5;
      transform: translateY(4%);
    }
    .cta-inner {
      padding: 64px 24px;
    }
    .container {
      padding-left: 20px;
      padding-right: 20px;
    }
    .hero-preview,
    .hero-mobile-store {
      display: none;
    }
    .hero--layout-2 {
      --mobile-stack-offset: 24px;
      display: flex;
      min-height: 100svh;
      padding-block: 0;
      overflow: clip;
      isolation: isolate;
    }
    .hero--layout-2 .hero-inner {
      position: relative;
      z-index: 2;
      justify-content: center;
      height: 100svh;
      min-height: 100svh;
      overflow: visible;
    }
    .hero--layout-2 .hero-copy {
      z-index: 3;
      width: min(80vw, 320px);
      text-shadow:
        0 2px 24px #000,
        0 1px 8px #000;
    }
    .hero-title {
      max-width: 310px;
      margin-bottom: 16px;
      font-size: clamp(44px, 12vw, 58px);
      line-height: 0.96;
    }
    .hero[data-hero-variant="3"] .hero-title,
    .hero[data-hero-variant="4"] .hero-title {
      font-size: clamp(40px, 10.8vw, 50px);
    }
    .hero-lede {
      max-width: 255px;
      margin-bottom: 22px;
      color: rgba(255, 255, 255, 0.62);
      font-size: 13px;
      line-height: 1.5;
    }
    .hero--layout-2 .hero-actions {
      position: relative;
      z-index: 7;
      width: 205px;
      text-shadow: none;
    }
    .hero-scenes {
      inset: 0;
      z-index: 2;
      width: auto;
      aspect-ratio: auto;
