  }

  .hero--layout-2 .hero-preview {
    width: 100%;
  }

  .hero-mobile-showcase {
    display: none;
  }

  .sec-endorsements {
    border-top: 0;
  }

  /* ── Remote + mobile ──────────────────────────────────── */
  .sec-connect--priority {
    position: relative;
    z-index: 1;
    overflow: hidden;
    margin-top: -120px;
    padding: 88px 0 96px;
    border-top: 0;
  }

  .remote-shell {
    display: grid;
    grid-template-columns: minmax(380px, 0.88fr) minmax(500px, 1.12fr);
    gap: clamp(44px, 5vw, 72px);
    align-items: center;
  }

  .remote-copy h2 {
    margin: 0 0 14px;
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .remote-copy > p {
    max-width: 450px;
    color: var(--fg-muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .remote-actions {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
    margin-top: 30px;
  }

  .store-badges {
    display: flex;
    width: 100%;
    max-width: 330px;
    gap: 10px;
  }

  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1 1 0;
    height: 50px;
    padding: 5px 12px 5px 9px;
    color: #fff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.58);
    border-radius: 8px;
    background: #050505;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.8);
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }

  .store-badge:hover,
  .store-badge:focus-visible {
    border-color: rgba(255, 255, 255, 0.86);
    background: #111;
    transform: translateY(-1px);
  }

  .store-badge > img {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .store-badge-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1;
  }

  .store-badge-kicker {
    margin-bottom: 3px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.015em;
  }

  .store-badge-kicker--caps {
    text-transform: uppercase;
  }

  .store-badge-name {
    white-space: nowrap;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .remote-guide-link {
    padding: 8px 0;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .remote-guide-link:hover,
  .remote-guide-link:focus-visible {
    color: var(--fg);
  }

  .platform-preview {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 90;
    width: min(360px, calc(100vw - 36px));
    padding: 12px;
    color: #f5f5f5;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background: #101010;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.42);
  }

  .platform-preview[hidden] {
    display: none;
  }

  .platform-preview-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .platform-preview-head > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .platform-preview-head strong {
    font-size: 12px;
    font-weight: 600;
  }

  .platform-preview-head span {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.58);
    font-size: 11px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .platform-preview-head button,
  .platform-preview-options button {
    color: inherit;
    font: inherit;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.045);
    cursor: pointer;
    transition:
      color 0.16s ease,
      border-color 0.16s ease,
      background 0.16s ease;
  }

  .platform-preview-head button {
    display: grid;
    width: 25px;
    height: 25px;
    flex: 0 0 auto;
    padding: 0;
    place-items: center;
    font-size: 17px;
    line-height: 1;
    border-radius: 7px;
  }

  .platform-preview-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .platform-preview-options button {
    min-height: 32px;
    padding: 0 8px;
    font-size: 11px;
    font-weight: 500;
    border-radius: 8px;
  }

  .platform-preview-head button:hover,
  .platform-preview-head button:focus-visible,
  .platform-preview-options button:hover,
  .platform-preview-options button:focus-visible {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  .platform-preview-options button[data-active="true"] {
    color: #07120c;
    border-color: var(--accent);
    background: var(--accent);
  }

  /* Keep the active thread anchored on the right. The other iPhone captures
     trail behind it and soften as the sequence moves left. */
  .theme-screenshot {
    display: block;
    width: 100%;
  }

  .remote-visual {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 520px;
    isolation: isolate;
  }

  .remote-iphone {
    --phone-opacity: 1;
    --phone-scale: 1;
    --phone-delay: 0ms;
    position: relative;
    flex: 0 0 auto;
    overflow: hidden;
    aspect-ratio: 1320 / 2868;
    width: 248px;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 32px;
    box-shadow:
      0 36px 80px -30px rgba(0, 0, 0, 0.92),
      0 12px 28px -14px rgba(0, 0, 0, 0.58),
      inset 0 1px rgba(255, 255, 255, 0.12);
    opacity: var(--phone-opacity);
    transform: scale(var(--phone-scale));
  }

  .remote-iphone + .remote-iphone {
    margin-left: -154px;
  }

  .remote-iphone--far {
    --phone-opacity: 0.14;
    --phone-scale: 0.94;
    --phone-delay: 390ms;
    z-index: 1;
  }

  .remote-iphone--middle {
    --phone-opacity: 0.3;
    --phone-scale: 0.96;
    --phone-delay: 260ms;
    z-index: 2;
  }

  .remote-iphone--near {
    --phone-opacity: 0.58;
    --phone-scale: 0.98;
    --phone-delay: 130ms;
    z-index: 3;
  }

  .remote-iphone--main {
    z-index: 4;
  }

  .remote-iphone img {
    display: block;
    width: 100%;
    height: auto;
  }

  .remote-visual.is-reveal-ready .remote-iphone {
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--phone-delay),
      transform 850ms cubic-bezier(0.22, 1, 0.36, 1) var(--phone-delay);
  }

  .remote-visual.is-reveal-ready:not(.is-visible) .remote-iphone {
    opacity: 0;
    transform: translateX(42px) scale(var(--phone-scale));
  }

  /* ── Endorsements ─────────────────────────────────────── */
  .sec-endorsements {
    overflow: hidden;
  }

  .endorsements-head {
    max-width: 720px;
    margin-bottom: 56px;
  }

  .endorsements-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .endorsements-count {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .endorsements-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .endorsement-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(100%, 1240px);
    margin-inline: auto;
  }

  .endorsement-carousel--mobile {
    display: none;
  }

  .endorsement-carousel::before,
  .endorsement-carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 56px;
    pointer-events: none;
  }

  .endorsement-carousel::before {
    left: 0;
    background: linear-gradient(90deg, var(--bg), transparent);
  }

  .endorsement-carousel::after {
    right: 0;
    background: linear-gradient(270deg, var(--bg), transparent);
  }

  .endorsement-row {
    overflow: hidden;
  }

  .endorsement-track {
    width: max-content;
    display: flex;
    animation: endorsementMarquee 76s linear infinite;
    will-change: transform;
  }

  .endorsement-track-group {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }

  .endorsement-row.is-reverse .endorsement-track {
    animation-direction: reverse;
    animation-duration: 84s;
  }

  .endorsement-carousel:hover .endorsement-track,
  .endorsement-carousel:focus-within .endorsement-track {
    animation-play-state: paused;
  }

  .endorsement-card {
    position: relative;
    width: clamp(264px, 22vw, 308px);
    height: 132px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.012);
    transition:
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .endorsement-card:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .endorsement-author {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .endorsement-author img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .endorsement-handle {
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .endorsement-card p {
    color: var(--fg);
    font-size: 13.5px;
    line-height: 1.4;
    letter-spacing: -0.003em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-stage-art,
    #download-btn,
    .cta-card,
    .cta-card::before,
    .cta-stage-art,
    .cta-app-icon,
    .faq-chevron,
    .hero-demo-frame,
    .hero-mobile-showcase,
    .hero-mobile-showcase__screen,
    .hero-provider,
    .mobile-download-links a,
    .store-badge,
    .endorsement-track {
      animation: none;
      transition: none;
    }
  }

  /* ── FAQ ────────────────────────────────────────────────
     Clears leftover objections before the final download CTA:
     display title + hairline rows, not soft pill cards. */
  .sec-faq {
    --faq-accent: rgba(255, 255, 255, 0.42);
    --faq-rule: rgba(255, 255, 255, 0.08);
    padding: 72px 0 48px;
    border-top: 0;
  }

  :global(html[data-stage="nightly"]) .sec-faq {
    --faq-accent: rgba(183, 174, 255, 0.72);
  }

  :global(html[data-stage="dev"]) .sec-faq {
    --faq-accent: rgba(150, 201, 255, 0.72);
  }

  .faq-shell {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: min(720px, 100%);
    margin-inline: auto;
  }

  .faq-head h2 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.05;
  }

  .faq-list {
    display: grid;
    gap: 0;
    width: 100%;
    border-top: 1px solid var(--faq-rule);
  }

  .faq-item {
    border-bottom: 1px solid var(--faq-rule);
  }

  .faq-item summary {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: space-between;
    padding: 22px 2px;
    color: rgba(255, 255, 255, 0.88);
    cursor: pointer;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.3;
    list-style: none;
    user-select: none;
    -webkit-user-select: none;
    transition: color 0.18s ease;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::marker {
    content: "";
  }

  .faq-item summary:hover,
  .faq-item[open] summary {
    color: var(--fg);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--faq-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .faq-question {
    min-width: 0;
  }

  .faq-chevron {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    color: var(--faq-accent);
    transition: color 0.18s ease;
  }

  .faq-item summary:hover .faq-chevron,
  .faq-item[open] .faq-chevron {
    color: var(--fg-muted);
  }

  .faq-chevron::before {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-chevron::before {
    transform: translateY(2px) rotate(225deg);
  }

  .faq-answer {
    padding: 0 36px 22px 2px;
  }

  .faq-answer p {
    max-width: 58ch;
    color: var(--fg-muted);
    font-size: 15.5px;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  .faq-answer a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.28);
    text-underline-offset: 0.18em;
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  .faq-answer a:hover {
    text-decoration-color: rgba(255, 255, 255, 0.7);
  }

  :global(html[data-stage="nightly"]) .faq-answer a {
    text-decoration-color: rgba(183, 174, 255, 0.4);
  }

  :global(html[data-stage="nightly"]) .faq-answer a:hover {
    color: rgb(210, 205, 255);
    text-decoration-color: rgba(183, 174, 255, 0.85);
  }

  :global(html[data-stage="dev"]) .faq-answer a {
    text-decoration-color: rgba(150, 201, 255, 0.4);
  }

  :global(html[data-stage="dev"]) .faq-answer a:hover {
    color: rgb(186, 220, 255);
    text-decoration-color: rgba(150, 201, 255, 0.85);
  }

  /* ── Final CTA ────────────────────────────────────────── */
  .sec-cta {
    text-align: center;
    padding: 40px 0 96px;
    border-top: 0;
  }

  .cta-card {
    --channel-fade-duration: 900ms;
    --channel-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    display: grid;
    min-height: 500px;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 24px;
    background:
      radial-gradient(circle at 50% 32%, rgba(255, 255, 255, 0.025), transparent 30%),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.06),
      0 42px 120px -64px rgba(0, 0, 0, 0.86);
    isolation: isolate;
    transition:
      border-color var(--channel-fade-duration) var(--channel-fade-easing),
      box-shadow var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"] {
    border-color: rgba(139, 129, 255, 0.22);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.07),
      0 42px 120px -64px rgba(85, 59, 183, 0.72);
  }

  .cta-card[data-stage="dev"] {
    border-color: rgba(133, 187, 255, 0.28);
    box-shadow:
      inset 0 1px rgba(255, 255, 255, 0.1),
      0 42px 120px -64px rgba(34, 104, 218, 0.72);
  }

  .cta-card::before,
  .cta-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-card::before {
    z-index: 1;
    opacity: 0.045;
    background-image:
      radial-gradient(circle, rgba(219, 226, 255, 0.72) 0 1px, transparent 1.4px),
      radial-gradient(circle, rgba(147, 166, 255, 0.46) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(255, 255, 255, 0.3) 0 0.7px, transparent 1.1px);
    background-position:
      18px 12px,
      62px 38px,
      11px 54px;
    background-size:
      89px 83px,
      137px 121px,
      61px 67px;
    -webkit-mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    mask-image: linear-gradient(to bottom, #000, rgba(0, 0, 0, 0.64));
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="nightly"]::before {
    opacity: 0.56;
    background-image: url("/nightly-stars.svg");
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .cta-card[data-stage="dev"]::before {
    opacity: 0.2;
  }

  .cta-card::after {
    z-index: 1;
    background:
      radial-gradient(circle at 0% 100%, rgba(255, 255, 255, 0.06), transparent 28%),
      radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.05), transparent 25%),
      linear-gradient(115deg, transparent 32%, rgba(255, 255, 255, 0.022) 50%, transparent 68%);
  }

  .cta-card-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cta-stage-art {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="latest"] .cta-stage-art--latest,
  .cta-card[data-stage="nightly"] .cta-stage-art--nightly,
  .cta-card[data-stage="dev"] .cta-stage-art--dev {
    opacity: 1;
  }

  .cta-atmosphere {
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    pointer-events: none;
    -webkit-mask: url("/theme-atmosphere.webp") center bottom / cover no-repeat;
    mask: url("/theme-atmosphere.webp") center bottom / cover no-repeat;
    background: linear-gradient(
      105deg,
      rgba(255, 255, 255, 0.82),
      rgba(177, 185, 210, 0.34)
    );
    transition: opacity var(--channel-fade-duration) var(--channel-fade-easing);
  }

  .cta-card[data-stage="latest"] .cta-atmosphere {
    opacity: 0.32;
  }

  .cta-stage-art--latest {
    background:
      radial-gradient(circle at 50% 26%, rgba(255, 255, 255, 0.025), transparent 36%),
      linear-gradient(180deg, #030304 0%, #07080a 100%);
  }

  .cta-latest-ray {
    position: absolute;
    top: -52%;
    width: 18%;
    height: 142%;
    background: linear-gradient(
      to right,
      transparent,
      rgba(255, 255, 255, 0.018) 30%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(255, 255, 255, 0.018) 70%,
      transparent
    );
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.65) 42%, transparent 88%);
    mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.65) 42%, transparent 88%);
    transform-origin: top center;
  }

  .cta-latest-ray--one {
    left: 13%;
    transform: rotate(13deg);
  }

  .cta-latest-ray--two {
    left: 42%;
    width: 22%;
    opacity: 0.78;
    transform: rotate(1deg);
  }

  .cta-latest-ray--three {
    right: 10%;
    opacity: 0.62;
    transform: rotate(-14deg);
  }

  .cta-stage-art--nightly {
    background:
      radial-gradient(ellipse at 17% 74%, rgba(105, 119, 176, 0.2), transparent 42%),
      radial-gradient(ellipse at 78% 18%, rgba(126, 99, 169, 0.18), transparent 39%),
      radial-gradient(circle at 54% 58%, rgba(117, 107, 174, 0.12), transparent 33%),
      linear-gradient(138deg, #0b162e 0%, #171a3c 42%, #251a42 73%, #2d1948 100%);
  }

  .cta-stage-art--nightly::before,
  .cta-stage-art--nightly::after {
    position: absolute;
    content: "";
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .cta-stage-art--nightly::before {
    z-index: 2;
    inset: -12%;
    background: url("/nightly-clouds-foreground.webp") center bottom / 145% auto no-repeat;
    filter: blur(14px) saturate(0.68);
    opacity: 0.62;
    transform: translateY(6%);
  }

  .cta-stage-art--nightly::after {
    z-index: 1;
    inset: -12%;
    background: url("/nightly-clouds.webp") center 56% / cover no-repeat;
    filter: blur(1.5px) saturate(0.82);
    opacity: 0.72;
    transform: scale(1.02);
  }

  .cta-stage-art--dev {
    opacity: 0;
    background:
      radial-gradient(circle at 50% 42%, rgba(125, 186, 255, 0.22), transparent 34%),
      linear-gradient(180deg, #102a55 0%, #173d82 100%);
  }

  .cta-stage-art--dev::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(199, 225, 255, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(199, 225, 255, 0.12) 1px, transparent 1px),
      linear-gradient(rgba(217, 234, 255, 0.2) 1px, transparent 1px),
      linear-gradient(90deg, rgba(217, 234, 255, 0.2) 1px, transparent 1px);
    background-size:
      32px 32px,
