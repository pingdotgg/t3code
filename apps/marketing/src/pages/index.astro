268l.003.003c.208.199.305.53.391.876.085.4.154.78.409 1.066.486.527.645.906.636 1.14l.003-.007v.018l-.003-.012c-.015.262-.185.396-.498.595-.63.401-1.746.712-2.457 1.57-.618.737-1.37 1.14-2.036 1.191-.664.053-1.237-.2-1.574-.898l-.005-.003c-.21-.4-.12-1.025.056-1.69.176-.668.428-1.344.463-1.897.037-.714.076-1.335.195-1.814.12-.465.308-.797.641-.984l.045-.022zm-10.814.049h.01c.053 0 .105.005.157.014.376.055.706.333 1.023.752l.91 1.664.003.003c.243.533.754 1.064 1.189 1.637.434.598.77 1.131.729 1.57v.006c-.057.744-.48 1.148-1.125 1.294-.645.135-1.52.002-2.395-.464-.968-.536-2.118-.469-2.857-.602-.369-.066-.61-.2-.723-.4-.11-.2-.113-.602.123-1.23v-.004l.002-.003c.117-.334.03-.752-.027-1.118-.055-.401-.083-.71.043-.94.16-.334.396-.4.69-.533.294-.135.64-.202.915-.47h.002v-.002c.256-.268.445-.601.668-.838.19-.201.38-.336.663-.336zm7.159-9.074c-.435.201-.945.535-1.488.535-.542 0-.97-.267-1.28-.466-.154-.134-.28-.268-.373-.335-.164-.134-.144-.333-.074-.333.109.016.129.134.199.2.096.066.215.2.36.333.292.2.68.467 1.167.467.485 0 1.053-.267 1.398-.466.195-.135.445-.334.648-.467.156-.136.149-.267.279-.267.128.016.034.134-.147.332a8.097 8.097 0 01-.69.468zm-1.082-1.583V5.64c-.006-.02.013-.042.029-.05.074-.043.18-.027.26.004.063 0 .16.067.15.135-.006.049-.085.066-.135.066-.055 0-.092-.043-.141-.068-.052-.018-.146-.008-.163-.065zm-.551 0c-.02.058-.113.049-.166.066-.047.025-.086.068-.14.068-.05 0-.13-.02-.136-.068-.01-.066.088-.133.15-.133.08-.031.184-.047.259-.005.019.009.036.03.03.05v.02h.003z"/></svg>
          <img class="dl-icon dl-icon--store dl-icon--ios" src="/store-logos/apple.svg" alt="" />
          <img class="dl-icon dl-icon--store dl-icon--android" src="/store-logos/googleplay.svg" alt="" />
          <span class="btn-stage-art btn-stage-art--nightly" aria-hidden="true">
            <iframe
              src="/sidebar-demo/stage-art.html?variant=nightly"
              tabindex="-1"
              title=""
            ></iframe>
          </span>
          <span class="btn-stage-art btn-stage-art--dev" aria-hidden="true">
            <iframe
              src="/sidebar-demo/stage-art.html?variant=dev"
              tabindex="-1"
              title=""
            ></iframe>
          </span>
          <span class="btn-label" id="download-label">Download for macOS</span>
          <span class="store-badge-copy primary-store-label primary-store-label--ios">
            <span class="store-badge-kicker">Download on the</span>
            <span class="store-badge-name">App Store</span>
          </span>
          <span class="store-badge-copy primary-store-label primary-store-label--android">
            <span class="store-badge-kicker store-badge-kicker--caps">Get it on</span>
            <span class="store-badge-name">Google Play</span>
          </span>
        </a>
        <div class="mobile-download-links" aria-label="Download the T3 Code mobile app">
          <a href={IOS_APP_STORE_URL} target="_blank" rel="noreferrer">
            <img src="/store-logos/appstore.svg" alt="" width="16" height="16" />
            <span>App Store</span>
          </a>
          <a href={GOOGLE_PLAY_STORE_URL} target="_blank" rel="noreferrer">
            <img src="/store-logos/googleplay.svg" alt="" width="16" height="16" />
            <span>Google Play</span>
          </a>
        </div>
        </div>
      </div>

      <div class="hero-preview">
        <div class="hero-demo-frame">
          <iframe
            id="hero-demo"
            src="/sidebar-demo/demo.html"
            title="Interactive T3 Code demo: the real app UI running on sample data"
            loading="eager"
            allow="clipboard-write"
          ></iframe>
        </div>
      </div>

      <div class="hero-mobile-showcase" aria-hidden="true">
        <span class="hero-mobile-showcase__screen">
          <picture class="theme-screenshot">
            <source
              media="(prefers-color-scheme: light)"
              srcset="/mobile-states/threads-light.png"
            />
            <img
              src="/mobile-states/threads.png"
              alt=""
              decoding="async"
              width="1320"
              height="2868"
            />
          </picture>
        </span>
      </div>
    </div>
  </section>

  <!-- ── Remote + mobile ──────────────────────────────────────── -->
  <section id="connect" class="sec-connect sec-connect--priority">
    <div class="container remote-shell">
      <div class="remote-copy">
        <h2>Run it here.<br />Control it anywhere.</h2>
        <p>
          Pick up the same thread on the web, iPhone, iPad, or Android. Your
          projects and subscriptions stay on your machine.
        </p>

        <div class="remote-actions">
          <div class="store-badges" aria-label="Download T3 Code for mobile">
            <a
              class="store-badge"
              href={IOS_APP_STORE_URL}
              target="_blank"
              rel="noreferrer"
              aria-label="Download T3 Code on the App Store"
            >
              <img src="/store-logos/apple.svg" alt="" width="28" height="28" />
              <span class="store-badge-copy">
                <span class="store-badge-kicker">Download on the</span>
                <span class="store-badge-name">App Store</span>
              </span>
            </a>
            <a
              class="store-badge"
              href={GOOGLE_PLAY_STORE_URL}
              target="_blank"
              rel="noreferrer"
              aria-label="Get T3 Code on Google Play"
            >
              <img src="/store-logos/googleplay.svg" alt="" width="28" height="28" />
              <span class="store-badge-copy">
                <span class="store-badge-kicker store-badge-kicker--caps">Get it on</span>
                <span class="store-badge-name">Google Play</span>
              </span>
            </a>
          </div>
          <a
            class="remote-guide-link"
            href="https://github.com/pingdotgg/t3code/blob/main/docs/user/remote-access.md"
            target="_blank"
            rel="noopener noreferrer"
          >
            Remote access guide <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div
        class="remote-visual"
        role="img"
        aria-label="T3 Code agent threads, terminal, code review, and environments on iPhone"
      >
        <div class="remote-iphone remote-iphone--far">
          <picture class="theme-screenshot">
            <source
              media="(prefers-color-scheme: light)"
              srcset="/mobile-states/ios-environments-light.png"
            />
            <img
              src="/mobile-states/ios-environments.png"
              alt=""
              width="1320"
              height="2868"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="remote-iphone remote-iphone--middle">
          <picture class="theme-screenshot">
            <source
              media="(prefers-color-scheme: light)"
              srcset="/mobile-states/ios-review-light.png"
            />
            <img
              src="/mobile-states/ios-review.png"
              alt=""
              width="1320"
              height="2868"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="remote-iphone remote-iphone--near">
          <picture class="theme-screenshot">
            <source
              media="(prefers-color-scheme: light)"
              srcset="/mobile-states/ios-terminal-light.png"
            />
            <img
              src="/mobile-states/ios-terminal.png"
              alt=""
              width="1320"
              height="2868"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="remote-iphone remote-iphone--main">
          <picture class="theme-screenshot">
            <source
              media="(prefers-color-scheme: light)"
              srcset="/mobile-states/ios-thread-light.png"
            />
            <img
              src="/mobile-states/ios-thread.png"
              alt=""
              width="1320"
              height="2868"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Endorsements ─────────────────────────────────────────── -->
  <section id="endorsements" class="sec-endorsements" aria-labelledby="endorsements-title">
    <div class="container">
      <div class="endorsements-head">
        <h2 id="endorsements-title">Tolerated by over <span class="endorsements-count">{MARKETING_STATS.users}</span> devs</h2>
      </div>
    </div>

    <div class="endorsement-carousel endorsement-carousel--desktop" aria-label="Developer endorsements">
        {
          desktopEndorsementRows.map((row, rowIndex) => (
            <div class:list={["endorsement-row", rowIndex === 1 && "is-reverse"]}>
              <div class="endorsement-track">
                {[0, 1].map((groupIndex) => (
                  <div class="endorsement-track-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                    {row.map((tweet) => (
                      <a
                        class="endorsement-card"
                        href={tweet.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Read ${tweet.handle}'s post on X`}
                        tabindex={groupIndex === 1 ? "-1" : undefined}
                      >
                        <div class="endorsement-author">
                          <img
                            src={`/pfps/${tweet.handle}.webp`}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="endorsement-handle">@{tweet.handle}</div>
                        </div>
                        <p>{tweet.excerpt ?? tweet.content}</p>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
    </div>

    <div class="endorsement-carousel endorsement-carousel--mobile" aria-label="Developer endorsements">
        {
          mobileEndorsementRows.map((row, rowIndex) => (
            <div class:list={["endorsement-row", rowIndex === 1 && "is-reverse"]}>
              <div class="endorsement-track">
                {[0, 1].map((groupIndex) => (
                  <div class="endorsement-track-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                    {row.map((tweet) => (
                      <a
                        class="endorsement-card"
                        href={tweet.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Read ${tweet.handle}'s post on X`}
                        tabindex={groupIndex === 1 ? "-1" : undefined}
                      >
                        <div class="endorsement-author">
                          <img
                            src={`/pfps/${tweet.handle}.webp`}
                            alt=""
                            width="28"
                            height="28"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="endorsement-handle">@{tweet.handle}</div>
                        </div>
                        <p>{tweet.excerpt ?? tweet.content}</p>
                      </a>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section id="faq" class="sec-faq" aria-labelledby="faq-title">
