                  >Latest</button
                >
                <button type="button" data-stage="nightly">Nightly</button>
                <button type="button" data-stage="dev">Dev</button>
              </div>
            </div>
          </div>
          <a class="cta-all-downloads" href="/download">All downloads</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section id="faq" class="sec-faq" aria-labelledby="faq-title">
    <div class="container faq-shell">
      <div class="faq-head">
        <h2 id="faq-title">Questions, answered.</h2>
      </div>

      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="faq-item">
              <summary>
                <span>{faq.question}</span>
                <span class="faq-chevron" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p>
                  {faq.answer}{" "}
                  <a
                    href={faq.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {faq.link.label}
                    <span aria-hidden="true"> ↗</span>
                  </a>
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  import {
    fetchLatestRelease,
    fetchNightlyRelease,
    findReleaseAssetUrl,
    NIGHTLY_RELEASES_URL,
    RELEASES_URL,
    type ReleasePlatform,
  } from "../lib/releases";
  import { GOOGLE_PLAY_STORE_URL, IOS_APP_STORE_URL } from "../lib/site";

  // A demo iframe focuses its composer as it boots. On a hard refresh browsers
  // can restore that nested focus and scroll the marketing page to a cutout.
  let finishReloadScrollReset: (() => void) | null = null;
  if (
    performance.getEntriesByType("navigation")[0] instanceof
      PerformanceNavigationTiming &&
    (
      performance.getEntriesByType(
        "navigation",
      )[0] as PerformanceNavigationTiming
    ).type === "reload"
  ) {
    const previousScrollRestoration = history.scrollRestoration;
    history.scrollRestoration = "manual";
    window.scrollTo(0, 0);
    let finished = false;
    finishReloadScrollReset = () => {
      if (finished) return;
      finished = true;
      requestAnimationFrame(() => {
        window.scrollTo(0, 0);
        history.scrollRestoration = previousScrollRestoration;
      });
    };
    const scheduleReloadScrollFallback = () => {
      window.setTimeout(() => finishReloadScrollReset?.(), 1_500);
    };
    if (document.readyState === "complete") {
      scheduleReloadScrollFallback();
    } else {
      window.addEventListener("load", scheduleReloadScrollFallback, {
        once: true,
      });
    }
  }

  type DesktopPlatform = ReleasePlatform & { label: string };
  type MobilePlatform = {
    os: "android" | "ios";
    label: string;
    downloadUrl: string;
  };
  type Platform = DesktopPlatform | MobilePlatform;

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) {
      return {
        os: "android",
        label: "Get it on Google Play",
        downloadUrl: GOOGLE_PLAY_STORE_URL,
      };
    }
    if (
      /iPad|iPhone|iPod/i.test(ua) ||
      (/Mac/i.test(ua) && navigator.maxTouchPoints > 1)
    ) {
      return {
        os: "ios",
        label: "Get it on App Store",
        downloadUrl: IOS_APP_STORE_URL,
      };
    }
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Hero channel switcher: Latest downloads the release, Nightly downloads the
  // nightly build, Dev turns the button into a copy-repo-link action. Nightly
  // and Dev also restyle the button with the app's real stage art and switch
  // the embedded demo to the matching channel build.
  type Stage = "latest" | "nightly" | "dev";

  const REPO_URL = "https://github.com/pingdotgg/t3code";

  function isStage(value: unknown): value is Stage {
    return value === "latest" || value === "nightly" || value === "dev";
  }

  const initialStage = document.documentElement.dataset.stage;
  let currentStage: Stage = isStage(initialStage) ? initialStage : "latest";
  type DownloadStage = Exclude<Stage, "dev">;
  const downloadUrlByStage: Record<DownloadStage, string> = {
    latest: RELEASES_URL,
    nightly: NIGHTLY_RELEASES_URL,
  };
  const downloadRequestByStage: Partial<Record<DownloadStage, Promise<void>>> =
    {};
  let detectedPlatform: Platform | null = null;
  let downloadLabel = "Download for macOS";

  function stageLabel(stage: Stage) {
    return stage === "latest"
      ? "Latest"
      : stage === "nightly"
        ? "Nightly"
        : "Dev";
  }

  function syncDemoStage(demo: HTMLIFrameElement | null, stage: Stage) {
    demo?.contentWindow?.postMessage(
      { type: "t3-demo-stage", stage, transitionDurationMs: 900 },
      "*",
    );
  }

  type HeroVariant = "1" | "2" | "3" | "4" | "5";

  function isHeroVariant(value: unknown): value is HeroVariant {
    return (
      value === "1" ||
      value === "2" ||
      value === "3" ||
      value === "4" ||
      value === "5"
    );
  }

  function initHeroLab() {
    const hero = document.getElementById("hero");
    const demo = document.getElementById(
      "hero-demo",
    ) as HTMLIFrameElement | null;
    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-hero-variant-button]",
      ),
    );
    const concepts = Array.from(
      document.querySelectorAll<HTMLElement>("[data-hero-concept]"),
    );
    if (!hero || !demo || buttons.length === 0) return;

    const applyHeroVariant = (variant: HeroVariant, updateUrl: boolean) => {
      const activeButton = buttons.find(
        (button) => button.dataset.heroVariantButton === variant,
      );
      if (!activeButton) return;

      hero.dataset.heroVariant = variant;
      document.documentElement.dataset.heroVariant = variant;
      concepts.forEach((concept) => {
        concept.hidden = concept.dataset.heroConcept !== variant;
      });
      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.heroVariantButton === variant),
        );
      });

      const demoPath = activeButton.dataset.demoPath;
      if (demoPath && demo.getAttribute("src") !== demoPath) {
        demo.setAttribute("src", demoPath);
      }

      if (!updateUrl) return;
      const url = new URL(window.location.href);
      url.searchParams.set("hero", variant);
      history.replaceState(history.state, "", url);
    };

    const requestedVariant = new URLSearchParams(window.location.search).get(
      "hero",
    );
    applyHeroVariant(
      isHeroVariant(requestedVariant) ? requestedVariant : "1",
      false,
    );
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const variant = button.dataset.heroVariantButton;
        if (isHeroVariant(variant)) applyHeroVariant(variant, true);
      });
    });
  }

  function updateDownloadAction(
    button: HTMLAnchorElement | null,
    label: HTMLElement | null,
    stage: Stage,
  ) {
    if (!button || !label) return;
    if (stage === "dev") {
      button.href = "#";
      label.textContent = "Copy repo link";
      return;
    }
    button.href = downloadUrlByStage[stage];
    label.textContent = downloadLabel;
  }

  function applyStage(stage: Stage) {
    currentStage = stage;
    const hero = document.getElementById("hero");
    const ctaCard = document.getElementById("cta-card");
    const ctaIcon = document.getElementById("cta-app-icon");
    const demo = document.getElementById(
      "hero-demo",
    ) as HTMLIFrameElement | null;

    document.documentElement.dataset.stage = stage;
    if (hero) hero.dataset.stage = stage;
    if (ctaCard) {
      ctaCard.dataset.stage = stage;
      ctaIcon?.setAttribute(
        "aria-label",
        `T3 Code ${stageLabel(stage)} app icon`,
      );
    }

    for (const label of document.querySelectorAll<HTMLElement>(
      "#cta-channel-label",
    )) {
      label.textContent = stageLabel(stage);
    }
    for (const item of document.querySelectorAll<HTMLButtonElement>(
      "#cta-channel-menu button",
    )) {
      item.dataset.active = String(item.dataset.stage === stage);
    }

    // Live channel switch: the demo listens for this message and makes its
    // mock server report the stage's version without reloading the iframe.
    syncDemoStage(demo, stage);

    updateDownloadAction(
      document.getElementById("download-btn") as HTMLAnchorElement | null,
      document.getElementById("download-label"),
      stage,
    );
    updateDownloadAction(
      document.getElementById("cta-download-btn") as HTMLAnchorElement | null,
      document.getElementById("cta-download-label"),
      stage,
    );
  }

  function ensureDownloadUrl(stage: DownloadStage): Promise<void> {
    const existingRequest = downloadRequestByStage[stage];
    if (existingRequest) return existingRequest;

    const platform = detectedPlatform;
    if (platform && "downloadUrl" in platform) {
      downloadUrlByStage[stage] = platform.downloadUrl;
      const request = Promise.resolve();
      downloadRequestByStage[stage] = request;
      return request;
    }

    const fallbackUrl =
      platform?.os === "mac"
        ? "/download"
        : stage === "nightly"
          ? NIGHTLY_RELEASES_URL
          : RELEASES_URL;
    downloadUrlByStage[stage] = fallbackUrl;
    if (platform?.os === "mac") {
      const request = Promise.resolve();
      downloadRequestByStage[stage] = request;
      return request;
    }

    const request = (async () => {
      try {
        const release = await (stage === "nightly"
          ? fetchNightlyRelease()
          : fetchLatestRelease());
        downloadUrlByStage[stage] = platform
          ? (findReleaseAssetUrl(release.assets ?? [], platform) ?? fallbackUrl)
          : release.html_url;
      } catch {
        downloadUrlByStage[stage] = fallbackUrl;
      }
      if (currentStage === stage) applyStage(stage);
    })();
    downloadRequestByStage[stage] = request;
    return request;
  }

  function bindChannelPicker(buttonId: string, menuId: string) {
    const channelBtn = document.getElementById(buttonId);
    const menu = document.getElementById(menuId);
    if (!channelBtn || !menu) return;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      channelBtn.setAttribute("aria-expanded", String(open));
    };
    channelBtn.addEventListener("click", () =>
      setOpen(menu.hasAttribute("hidden")),
    );
    document.addEventListener("click", (event) => {
      if (
        !menu.hidden &&
        event.target instanceof Node &&
        !menu.contains(event.target) &&
        !channelBtn.contains(event.target)
      ) {
        setOpen(false);
      }
    });
    for (const item of menu.querySelectorAll<HTMLButtonElement>(
      "button[data-stage]",
    )) {
      item.addEventListener("click", () => {
        const stage = item.dataset.stage;
        if (!isStage(stage)) return;
        document.dispatchEvent(
          new CustomEvent("t3-marketing-stage-request", { detail: { stage } }),
        );
        setOpen(false);
      });
    }
  }

  function bindDevCopy(buttonId: string, labelId: string) {
    const button = document.getElementById(
      buttonId,
    ) as HTMLAnchorElement | null;
    const label = document.getElementById(labelId);
    button?.addEventListener("click", async (event) => {
      if (currentStage !== "dev") return;
      event.preventDefault();
      const command = `git clone ${REPO_URL}.git`;
      try {
        if (!navigator.clipboard) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(command);
        if (label) label.textContent = "Copied. Go build.";
        setTimeout(() => {
          if (currentStage === "dev" && label)
            label.textContent = "Copy repo link";
        }, 1600);
      } catch {
        window.prompt("Copy this command:", command);
        if (label) label.textContent = "Copy manually";
      }
    });
  }

  function initChannelPickers() {
    bindChannelPicker("cta-channel-btn", "cta-channel-menu");
    bindDevCopy("download-btn", "download-label");
    bindDevCopy("cta-download-btn", "cta-download-label");
  }

  function init() {
    detectedPlatform = detectPlatform();
    if (detectedPlatform) {
      document.documentElement.dataset.platform = detectedPlatform.os;
      downloadLabel = detectedPlatform.label;
      if ("downloadUrl" in detectedPlatform) {
        downloadUrlByStage.latest = detectedPlatform.downloadUrl;
        downloadUrlByStage.nightly = detectedPlatform.downloadUrl;
      } else if (detectedPlatform.os === "mac") {
        downloadUrlByStage.latest = "/download";
        downloadUrlByStage.nightly = "/download";
      }
    }
    applyStage(currentStage);
    if (currentStage !== "dev") void ensureDownloadUrl(currentStage);
  }

  function initMobileHeroShowcase() {
    const showcase = document.querySelector<HTMLElement>(
      ".hero-mobile-showcase",
    );
    const pager = showcase?.querySelector<HTMLElement>(
      ".hero-mobile-showcase__pager",
    );
    if (!showcase || !pager) return;

    let hasLoaded = false;
    let activePage = -1;
    let pagerFrame: number | null = null;
    const mobileHeroQuery = window.matchMedia("(max-width: 820px)");
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const screens = Array.from(
      showcase.querySelectorAll<HTMLElement>(".hero-mobile-showcase__screen"),
    );
    const pageButtons = Array.from(
      showcase.querySelectorAll<HTMLButtonElement>(
        ".hero-mobile-showcase__dots button",
      ),
    );

    const setActivePage = (nextPage: number) => {
      const clampedPage = Math.max(0, Math.min(screens.length - 1, nextPage));
      if (clampedPage === activePage) return;
      activePage = clampedPage;
      showcase.dataset.activePage = String(activePage);
      screens.forEach((screen, index) => {
        screen.classList.toggle("is-visible", index <= activePage);
        screen.classList.toggle("is-current", index === activePage);
      });
      pageButtons.forEach((button, index) => {
        if (index === activePage) {
          button.setAttribute("aria-current", "page");
        } else {
          button.removeAttribute("aria-current");
        }
      });
    };

    const updatePageFromPager = () => {
      pagerFrame = null;
      if (!mobileHeroQuery.matches || pager.clientWidth === 0) return;
      setActivePage(Math.round(pager.scrollLeft / pager.clientWidth));
    };

    const schedulePagerUpdate = () => {
      if (pagerFrame !== null) return;
      pagerFrame = requestAnimationFrame(updatePageFromPager);
    };

    const loadImages = () => {
      if (hasLoaded || !mobileHeroQuery.matches) return;
      hasLoaded = true;

      const mobilePlatform =
        detectedPlatform?.os === "android" ? "android" : "ios";
      showcase.dataset.mobilePlatform = mobilePlatform;

      const images = Array.from(
        showcase.querySelectorAll<HTMLImageElement>("img"),
      );
      for (const image of images) {
        const source =
          mobilePlatform === "android"
            ? image.dataset.androidSrc
            : image.dataset.iosSrc;
        if (!source) continue;
        image.src = source;
        image.width = mobilePlatform === "android" ? 1080 : 1320;
        image.height = mobilePlatform === "android" ? 1920 : 2868;
      }

      void Promise.all(
        images.map((image) => image.decode().catch(() => undefined)),
      ).then(() => {
        setActivePage(0);
        showcase.classList.add("is-loaded");
      });
    };

    pager.addEventListener("scroll", schedulePagerUpdate, { passive: true });
    pageButtons.forEach((button, index) => {
      button.addEventListener("click", () => {
        pager.scrollTo({
          left: index * pager.clientWidth,
          behavior: reducedMotionQuery.matches ? "instant" : "smooth",
        });
      });
    });

    loadImages();
    mobileHeroQuery.addEventListener("change", () => {
      loadImages();
      if (mobileHeroQuery.matches) setActivePage(0);
    });
  }

  initHeroLab();
  initChannelPickers();
  document.addEventListener("t3-marketing-stage-change", (event) => {
    const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
    if (!isStage(stage)) return;
    applyStage(stage);
    if (stage !== "dev") void ensureDownloadUrl(stage);
  });
  init();
  initMobileHeroShowcase();

  const heroDemoFrame = document.querySelector<HTMLElement>(".hero-demo-frame");
  const heroDemoIframe =
    heroDemoFrame?.querySelector<HTMLIFrameElement>("iframe");
  const heroMobileStore =
    document.querySelector<HTMLElement>(".hero-mobile-store");
  const heroMobileImages = heroMobileStore
    ? Array.from(heroMobileStore.querySelectorAll<HTMLImageElement>("img"))
    : [];
  if (heroDemoFrame && heroDemoIframe) {
    let demoReadyTimer: number | undefined;
    let heroRevealFallbackTimer: number | undefined;
    let demoReadyStartedAt = performance.now();
    let heroDemoIsReady = false;
    let heroRevealStarted = false;
    const heroMobileImagesReady = () =>
      heroMobileImages.every(
        (image) => image.complete && image.naturalWidth > 0,
      );
    // Hidden store must not block the desktop demo reveal on narrow viewports,
    // but is-loaded still waits for real image completion so a later resize
    // into the visible range does not flash grayscale-off empty cards.
    let heroMobileStoreIsReady =
      !heroMobileStore ||
      heroMobileImagesReady() ||
      getComputedStyle(heroMobileStore).display === "none";

    const applyHeroDemoScale = () => {
      heroDemoIframe.style.transform = `scale(${heroDemoFrame.clientWidth / 1200})`;
    };
    const applyHeroMobileStoreLoaded = () => {
      if (!heroMobileStore || !heroMobileImagesReady()) return;
      heroMobileStore.classList.add("is-loaded");
    };
    const revealHeroPreviewsTogether = (allowPhoneFallback = false) => {
      if (
        heroRevealStarted ||
        !heroDemoIsReady ||
        (!heroMobileStoreIsReady && !allowPhoneFallback)
      ) {
        return;
      }
      heroRevealStarted = true;
      window.clearTimeout(heroRevealFallbackTimer);
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          heroDemoFrame.classList.add("is-ready");
          applyHeroMobileStoreLoaded();
        });
      });
    };
    const markHeroMobileStoreReady = () => {
      if (!heroMobileImagesReady()) return;
      heroMobileStoreIsReady = true;
      if (heroRevealStarted) {
        applyHeroMobileStoreLoaded();
      } else {
        revealHeroPreviewsTogether();
      }
    };
    // Always wire loads when images are incomplete, including while the store
    // is display:none. Lazy images often only start after the container is
    // shown; those late loads still need to flip is-loaded.
    if (heroMobileStore && !heroMobileImagesReady()) {
      heroMobileImages
        .filter((image) => !image.complete || image.naturalWidth === 0)
        .forEach((image) =>
          image.addEventListener("load", markHeroMobileStoreReady, {
            once: true,
          }),
        );
    }
    const revealHeroDemoWhenReady = () => {
      window.clearTimeout(demoReadyTimer);
      window.clearTimeout(heroRevealFallbackTimer);
      demoReadyStartedAt = performance.now();
      heroDemoIsReady = false;
      heroRevealStarted = false;
      heroDemoFrame.classList.remove("is-ready");
      heroMobileStore?.classList.remove("is-loaded");

      const checkDemoReady = () => {
        let appIsReady = false;
        try {
          appIsReady =
            heroDemoIframe.contentDocument?.body?.textContent?.includes(
              "All projects",
            ) ?? false;
        } catch {
          // The bundled demo is same-origin in production. Keep the timeout
          // fallback for unusual preview hosts that isolate iframe origins.
        }

        if (appIsReady || performance.now() - demoReadyStartedAt > 15_000) {
          heroDemoIsReady = true;
          finishReloadScrollReset?.();
          revealHeroPreviewsTogether();
          heroRevealFallbackTimer = window.setTimeout(
            () => revealHeroPreviewsTogether(true),
            500,
          );
          return;
        }
        demoReadyTimer = window.setTimeout(checkDemoReady, 100);
      };

      checkDemoReady();
    };
    const forwardDemoWheelToPage = () => {
      const demoWindow = heroDemoIframe.contentWindow;
      if (!demoWindow) return;
      demoWindow.addEventListener(
        "wheel",
        (event) => {
          if (event.ctrlKey || event.deltaY === 0) return;
          event.preventDefault();
          event.stopImmediatePropagation();
          const multiplier =
            event.deltaMode === WheelEvent.DOM_DELTA_LINE
              ? 16
              : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
                ? window.innerHeight
                : 1;
          window.scrollBy({
            top: event.deltaY * multiplier,
            left: 0,
            behavior: "instant",
          });
        },
        { capture: true, passive: false },
      );
    };
    applyHeroDemoScale();
    forwardDemoWheelToPage();
    revealHeroDemoWhenReady();
    const finishReloadScrollAfterDemoFocus = () => finishReloadScrollReset?.();
    heroDemoIframe.contentWindow?.addEventListener(
      "focus",
      finishReloadScrollAfterDemoFocus,
      {
        once: true,
      },
    );
    heroDemoIframe.addEventListener("load", () => {
      forwardDemoWheelToPage();
      revealHeroDemoWhenReady();
      syncDemoStage(heroDemoIframe, currentStage);
      heroDemoIframe.contentWindow?.addEventListener(
        "focus",
        finishReloadScrollAfterDemoFocus,
        {
          once: true,
        },
      );
      if (document.activeElement === heroDemoIframe) {
        finishReloadScrollAfterDemoFocus();
      }
    });
    new ResizeObserver(applyHeroDemoScale).observe(heroDemoFrame);
  }
</script>

<style>
  /* ── Section base ─────────────────────────────────────────── */
  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg-muted);
    font-size: 15px;
  }

  .checklist li svg {
    color: var(--ok);
    flex-shrink: 0;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    --channel-fade-duration: 900ms;
    --channel-fade-easing: cubic-bezier(0.22, 1, 0.36, 1);
    padding: 96px 0 72px;
    position: relative;
    overflow: hidden;
    border-top: 0;
  }

  .hero-inner {
    position: relative;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .connect-kicker {
    margin: 0 0 12px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0 0 20px;
    max-width: 390px;
    font-size: clamp(58px, 5.6vw, 82px);
    font-weight: 500;
    letter-spacing: -0.066em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
  }

  .hero-lede {
    max-width: 340px;
    margin: 0 0 28px;
    color: rgba(255, 255, 255, 0.56);
    font-size: 15px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-concept {
    animation: hero-copy-reveal 0.56s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-copy-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero {
    --hero-concept-accent: #d0ccff;
    transition:
      color 0.72s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero[data-hero-variant="2"] {
    --hero-concept-accent: #b7edf1;
  }
  .hero[data-hero-variant="3"] {
    --hero-concept-accent: #f2d7a7;
  }
  .hero[data-hero-variant="4"] {
    --hero-concept-accent: #111;
    color: #111;
