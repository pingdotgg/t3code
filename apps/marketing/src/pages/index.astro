<script>
  import {
    fetchLatestRelease,
    fetchNightlyRelease,
    findReleaseAssetUrl,
    NIGHTLY_RELEASES_URL,
    RELEASES_URL,
    type ReleasePlatform,
  } from "../lib/releases";
  import { GOOGLE_PLAY_STORE_URL, IOS_APP_STORE_URL } from "../lib/site";

  // A demo iframe focuses its composer as it boots. On a hard refresh browsers
  // can restore that nested focus and scroll the marketing page to a cutout.
  let finishReloadScrollReset: (() => void) | null = null;
  if (
    performance.getEntriesByType("navigation")[0] instanceof PerformanceNavigationTiming &&
    (performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming).type === "reload"
  ) {
    const previousScrollRestoration = history.scrollRestoration;
    history.scrollRestoration = "manual";
    window.scrollTo(0, 0);
    let finished = false;
    finishReloadScrollReset = () => {
      if (finished) return;
      finished = true;
      requestAnimationFrame(() => {
        window.scrollTo(0, 0);
        history.scrollRestoration = previousScrollRestoration;
      });
    };
    const scheduleReloadScrollFallback = () => {
      window.setTimeout(() => finishReloadScrollReset?.(), 1_500);
    };
    if (document.readyState === "complete") {
      scheduleReloadScrollFallback();
    } else {
      window.addEventListener("load", scheduleReloadScrollFallback, { once: true });
    }
  }

  type DesktopPlatform = ReleasePlatform & { label: string };
  type MobilePlatform = {
    os: "android" | "ios";
    label: string;
    downloadUrl: string;
  };
  type Platform = DesktopPlatform | MobilePlatform;

  function mobilePlatform(os: MobilePlatform["os"]): MobilePlatform {
    return os === "android"
      ? {
          os,
          label: "Get it on Google Play",
          downloadUrl: GOOGLE_PLAY_STORE_URL,
        }
      : {
          os,
          label: "Download on the App Store",
          downloadUrl: IOS_APP_STORE_URL,
        };
  }

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) return mobilePlatform("android");
    if (
      /iPad|iPhone|iPod/i.test(ua) ||
      (/Mac/i.test(ua) && navigator.maxTouchPoints > 1)
    ) {
      return mobilePlatform("ios");
    }
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Hero channel switcher: Latest downloads the release, Nightly downloads the
  // nightly build, Dev turns the button into a copy-repo-link action. Nightly
  // and Dev also restyle the button with the app's real stage art and switch
  // the embedded demo to the matching channel build.
  type Stage = "latest" | "nightly" | "dev";

  const REPO_URL = "https://github.com/pingdotgg/t3code";

  function isStage(value: unknown): value is Stage {
    return value === "latest" || value === "nightly" || value === "dev";
  }

  const initialStage = document.documentElement.dataset.stage;
  let currentStage: Stage = isStage(initialStage) ? initialStage : "latest";
  type DownloadStage = Exclude<Stage, "dev">;
  const downloadUrlByStage: Record<DownloadStage, string> = {
    latest: RELEASES_URL,
    nightly: NIGHTLY_RELEASES_URL,
  };
  const downloadRequestByStage: Partial<Record<DownloadStage, Promise<void>>> = {};
  let detectedPlatform: Platform | null = null;
  let downloadLabel = "Download for macOS";
  let platformConfigurationVersion = 0;

  function stageLabel(stage: Stage) {
    return stage === "latest" ? "Latest" : stage === "nightly" ? "Nightly" : "Dev";
  }

  function syncDemoStage(demo: HTMLIFrameElement | null, stage: Stage) {
    demo?.contentWindow?.postMessage(
      { type: "t3-demo-stage", stage, transitionDurationMs: 900 },
      "*",
    );
  }

  function updateDownloadAction(
    button: HTMLAnchorElement | null,
    label: HTMLElement | null,
    stage: Stage,
  ) {
    if (!button || !label) return;
    if (stage === "dev") {
      button.href = "#";
      label.textContent = "Copy repo link";
      return;
    }
    button.href = downloadUrlByStage[stage];
    label.textContent = downloadLabel;
  }

  function applyStage(stage: Stage) {
    currentStage = stage;
    const hero = document.getElementById("hero");
    const ctaCard = document.getElementById("cta-card");
    const ctaIcon = document.getElementById("cta-app-icon");
    const demo = document.getElementById("hero-demo") as HTMLIFrameElement | null;

    document.documentElement.dataset.stage = stage;
    if (hero) hero.dataset.stage = stage;
    if (ctaCard) {
      ctaCard.dataset.stage = stage;
      ctaIcon?.setAttribute("aria-label", `T3 Code ${stageLabel(stage)} app icon`);
    }

    for (const label of document.querySelectorAll<HTMLElement>("#cta-channel-label")) {
      label.textContent = stageLabel(stage);
    }
    for (const item of document.querySelectorAll<HTMLButtonElement>(
      "#cta-channel-menu button",
    )) {
      item.dataset.active = String(item.dataset.stage === stage);
    }

    // Live channel switch: the demo listens for this message and makes its
    // mock server report the stage's version without reloading the iframe.
    syncDemoStage(demo, stage);

    updateDownloadAction(
      document.getElementById("download-btn") as HTMLAnchorElement | null,
      document.getElementById("download-label"),
      stage,
    );
    updateDownloadAction(
      document.getElementById("cta-download-btn") as HTMLAnchorElement | null,
      document.getElementById("cta-download-label"),
      stage,
    );
  }

  function ensureDownloadUrl(stage: DownloadStage): Promise<void> {
    const existingRequest = downloadRequestByStage[stage];
    if (existingRequest) return existingRequest;

    const configurationVersion = platformConfigurationVersion;
    const platform = detectedPlatform;
    if (platform && "downloadUrl" in platform) {
      downloadUrlByStage[stage] = platform.downloadUrl;
      const request = Promise.resolve();
      downloadRequestByStage[stage] = request;
      return request;
    }

    const fallbackUrl =
      platform?.os === "mac"
        ? "/download"
        : stage === "nightly"
          ? NIGHTLY_RELEASES_URL
          : RELEASES_URL;
    downloadUrlByStage[stage] = fallbackUrl;
    if (platform?.os === "mac") {
      const request = Promise.resolve();
      downloadRequestByStage[stage] = request;
      return request;
    }

    const request = (async () => {
      let resolvedUrl = fallbackUrl;
      try {
        const release = await (stage === "nightly"
          ? fetchNightlyRelease()
          : fetchLatestRelease());
        resolvedUrl = platform
          ? findReleaseAssetUrl(release.assets ?? [], platform) ?? fallbackUrl
          : release.html_url;
      } catch {}
      if (configurationVersion !== platformConfigurationVersion) return;
      downloadUrlByStage[stage] = resolvedUrl;
      if (currentStage === stage) applyStage(stage);
    })();
    downloadRequestByStage[stage] = request;
    return request;
  }

  function bindChannelPicker(buttonId: string, menuId: string) {
    const channelBtn = document.getElementById(buttonId);
    const menu = document.getElementById(menuId);
    if (!channelBtn || !menu) return;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      channelBtn.setAttribute("aria-expanded", String(open));
    };
    channelBtn.addEventListener("click", () => setOpen(menu.hasAttribute("hidden")));
    document.addEventListener("click", (event) => {
      if (!menu.hidden && event.target instanceof Node && !menu.contains(event.target) && !channelBtn.contains(event.target)) {
        setOpen(false);
      }
    });
    for (const item of menu.querySelectorAll<HTMLButtonElement>("button[data-stage]")) {
      item.addEventListener("click", () => {
        const stage = item.dataset.stage;
        if (!isStage(stage)) return;
        document.dispatchEvent(
          new CustomEvent("t3-marketing-stage-request", { detail: { stage } }),
        );
        setOpen(false);
      });
    }
  }

  function bindDevCopy(buttonId: string, labelId: string) {
    const button = document.getElementById(buttonId) as HTMLAnchorElement | null;
    const label = document.getElementById(labelId);
    button?.addEventListener("click", async (event) => {
      if (currentStage !== "dev") return;
      event.preventDefault();
      const command = `git clone ${REPO_URL}.git`;
      try {
        if (!navigator.clipboard) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(command);
        if (label) label.textContent = "Copied. Go build.";
        setTimeout(() => {
          if (currentStage === "dev" && label) label.textContent = "Copy repo link";
        }, 1600);
      } catch {
        window.prompt("Copy this command:", command);
        if (label) label.textContent = "Copy manually";
      }
    });
  }

  function initChannelPickers() {
    bindChannelPicker("cta-channel-btn", "cta-channel-menu");
    bindDevCopy("download-btn", "download-label");
    bindDevCopy("cta-download-btn", "cta-download-label");
  }

  function configurePlatform(platform: Platform | null) {
    platformConfigurationVersion += 1;
    detectedPlatform = platform;
    downloadLabel = platform?.label ?? "Download for macOS";

    downloadUrlByStage.latest = RELEASES_URL;
    downloadUrlByStage.nightly = NIGHTLY_RELEASES_URL;
    delete downloadRequestByStage.latest;
    delete downloadRequestByStage.nightly;

    if (platform) {
      document.documentElement.dataset.platform = platform.os;
      if ("downloadUrl" in platform) {
        downloadUrlByStage.latest = platform.downloadUrl;
        downloadUrlByStage.nightly = platform.downloadUrl;
      } else if (platform.os === "mac") {
        downloadUrlByStage.latest = "/download";
        downloadUrlByStage.nightly = "/download";
      }
    } else {
      delete document.documentElement.dataset.platform;
    }

    applyStage(currentStage);
    if (currentStage !== "dev") void ensureDownloadUrl(currentStage);
  }

  type PlatformPreview = "auto" | "iphone" | "ipad" | "ipados" | "android";
  const PLATFORM_PREVIEW_PARAM = "platform-preview";

  function isPlatformPreview(value: unknown): value is PlatformPreview {
    return (
      value === "auto" ||
      value === "iphone" ||
      value === "ipad" ||
      value === "ipados" ||
      value === "android"
    );
  }

  function platformForPreview(preview: PlatformPreview): Platform | null {
    if (preview === "auto") return detectPlatform();
    return mobilePlatform(preview === "android" ? "android" : "ios");
  }

  function initPlatformPreview() {
    const url = new URL(window.location.href);
    const requestedPreview = url.searchParams.get(PLATFORM_PREVIEW_PARAM);
    if (requestedPreview === null) {
      configurePlatform(detectPlatform());
      return;
    }

    const panel = document.getElementById("platform-preview");
    const status = document.getElementById("platform-preview-status");
    const closeButton = document.getElementById("platform-preview-close");
    if (!panel || !status || !closeButton) {
      configurePlatform(detectPlatform());
      return;
    }

    const buttons = Array.from(
      panel.querySelectorAll<HTMLButtonElement>("button[data-platform-preview]"),
    );
    const statusByPreview: Record<Exclude<PlatformPreview, "auto">, string> = {
      iphone: "iPhone → App Store",
      ipad: "iPad → App Store",
      ipados: "iPadOS UA → App Store",
      android: "Android → Google Play",
    };

    const setPreview = (preview: PlatformPreview) => {
      if (currentStage === "dev") {
        document.dispatchEvent(
          new CustomEvent("t3-marketing-stage-request", { detail: { stage: "latest" } }),
        );
      }
      const platform = platformForPreview(preview);
      configurePlatform(platform);
      status.textContent =
        preview === "auto"
          ? `Auto → ${platform?.label ?? "macOS fallback"}`
          : statusByPreview[preview];

      for (const button of buttons) {
        const active = button.dataset.platformPreview === preview;
        button.dataset.active = String(active);
        button.setAttribute("aria-pressed", String(active));
      }

      url.searchParams.set(PLATFORM_PREVIEW_PARAM, preview);
      window.history.replaceState(window.history.state, "", url);
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        const preview = button.dataset.platformPreview;
        if (isPlatformPreview(preview)) setPreview(preview);
      });
    }

    closeButton.addEventListener("click", () => {
      panel.hidden = true;
      url.searchParams.delete(PLATFORM_PREVIEW_PARAM);
      window.history.replaceState(window.history.state, "", url);
      configurePlatform(detectPlatform());
    });

    panel.hidden = false;
    setPreview(isPlatformPreview(requestedPreview) ? requestedPreview : "iphone");
  }

  function initHeroProviderSwitch() {
    const providers = Array.from(
      document.querySelectorAll<HTMLElement>(".hero-provider"),
    );
    const providerLabel = document.querySelector<HTMLElement>(
      ".hero-provider__label",
    );
    const lightScheme = window.matchMedia("(prefers-color-scheme: light)");

    const providerColor = (provider: HTMLElement) =>
      lightScheme.matches
        ? provider.dataset.providerColorLight
        : provider.dataset.providerColor;

    const syncProviderColor = () => {
      const activeProvider =
        providers.find((provider) => provider.classList.contains("is-active")) ?? providers[0];
      const color = activeProvider ? providerColor(activeProvider) : undefined;
      if (color) providerLabel?.style.setProperty("--provider-color", color);
    };

    syncProviderColor();
    lightScheme.addEventListener("change", syncProviderColor);

    if (
      providers.length < 2 ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) return;

    let activeIndex = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      const outgoingProvider = providers[activeIndex];
      activeIndex = (activeIndex + 1) % providers.length;
      const incomingProvider = providers[activeIndex];
      if (!outgoingProvider || !incomingProvider) return;

      incomingProvider.classList.add("is-resetting");
      incomingProvider.classList.remove("is-leaving", "is-active");
      void incomingProvider.offsetHeight;
      incomingProvider.classList.remove("is-resetting");

      outgoingProvider.classList.remove("is-active");
      outgoingProvider.classList.add("is-leaving");
      incomingProvider.classList.add("is-active");
      const incomingColor = providerColor(incomingProvider);
      if (incomingColor) {
        providerLabel?.style.setProperty("--provider-color", incomingColor);
      }
    }, 1800);
  }

  initChannelPickers();
  document.addEventListener("t3-marketing-stage-change", (event) => {
    const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
    if (!isStage(stage)) return;
    applyStage(stage);
    if (stage !== "dev") void ensureDownloadUrl(stage);
  });
  initPlatformPreview();
  initHeroProviderSwitch();

  const remoteVisual = document.querySelector<HTMLElement>(".remote-visual");
  if (
    remoteVisual &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    remoteVisual.classList.add("is-reveal-ready");
    const remoteVisualObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        remoteVisual.classList.add("is-visible");
        remoteVisualObserver.disconnect();
      },
      { threshold: 0.24 },
    );
    remoteVisualObserver.observe(remoteVisual);
  }

  const heroDemoFrame = document.querySelector<HTMLElement>(".hero-demo-frame");
  const heroDemoIframe = heroDemoFrame?.querySelector<HTMLIFrameElement>("iframe");
  if (heroDemoFrame && heroDemoIframe) {
    let demoReadyTimer: number | undefined;
    let demoReadyStartedAt = performance.now();
    let demoWheelWindow: Window | null = null;
    let demoWheelHandler: ((event: WheelEvent) => void) | null = null;

    const applyHeroDemoScale = () => {
      heroDemoIframe.style.transform = `scale(${heroDemoFrame.clientWidth / 1200})`;
    };
    const revealHeroDemoWhenReady = () => {
      window.clearTimeout(demoReadyTimer);
      demoReadyStartedAt = performance.now();
      heroDemoFrame.classList.remove("is-ready");

      const checkDemoReady = () => {
        let appIsReady = false;
        try {
          appIsReady =
            heroDemoIframe.contentDocument?.body?.textContent?.includes("All projects") ?? false;
        } catch {
          // The bundled demo is same-origin in production. Keep the timeout
          // fallback for unusual preview hosts that isolate iframe origins.
        }

        if (appIsReady || performance.now() - demoReadyStartedAt > 15_000) {
          finishReloadScrollReset?.();
          requestAnimationFrame(() => {
            requestAnimationFrame(() => heroDemoFrame.classList.add("is-ready"));
          });
          return;
        }
        demoReadyTimer = window.setTimeout(checkDemoReady, 100);
      };

      checkDemoReady();
    };
    const forwardDemoWheelToPage = () => {
      if (demoWheelWindow && demoWheelHandler) {
        demoWheelWindow.removeEventListener("wheel", demoWheelHandler, { capture: true });
      }

      const demoWindow = heroDemoIframe.contentWindow;
      if (!demoWindow) return;
      demoWheelWindow = demoWindow;
      demoWheelHandler = (event) => {
        if (event.ctrlKey || event.deltaY === 0) return;

        const scrollingElement = document.scrollingElement;
        if (!scrollingElement) return;

        event.preventDefault();
        event.stopImmediatePropagation();
        const multiplier =
          event.deltaMode === WheelEvent.DOM_DELTA_LINE
            ? 16
            : event.deltaMode === WheelEvent.DOM_DELTA_PAGE
              ? window.innerHeight
              : 1;

        // Assigning scrollTop directly keeps trackpad direction changes
        // immediate even though the page uses smooth scrolling for links.
        scrollingElement.scrollTop += event.deltaY * multiplier;
      };
      demoWindow.addEventListener("wheel", demoWheelHandler, {
        capture: true,
        passive: false,
      });
    };
    applyHeroDemoScale();
    forwardDemoWheelToPage();
    revealHeroDemoWhenReady();
    const finishReloadScrollAfterDemoFocus = () => finishReloadScrollReset?.();
    heroDemoIframe.contentWindow?.addEventListener("focus", finishReloadScrollAfterDemoFocus, {
      once: true,
    });
    heroDemoIframe.addEventListener("load", () => {
      forwardDemoWheelToPage();
      revealHeroDemoWhenReady();
      syncDemoStage(heroDemoIframe, currentStage);
      heroDemoIframe.contentWindow?.addEventListener("focus", finishReloadScrollAfterDemoFocus, {
        once: true,
      });
      if (document.activeElement === heroDemoIframe) {
        finishReloadScrollAfterDemoFocus();
      }
    });
    new ResizeObserver(applyHeroDemoScale).observe(heroDemoFrame);
  }

</script>

