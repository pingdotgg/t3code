  <!-- ── Setup and remote control ─────────────────────────────── -->
  <section id="connect" class="sec-connect">
    <div class="container">
      <div class="connect-heading">
        <p class="connect-kicker">From installed to in control</p>
        <h2>Start local. Pick up anywhere.</h2>
        <p>
