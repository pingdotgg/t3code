---
import Layout from "../../layouts/Layout.astro";
import { CDN_ORIGIN, GITHUB_REPOSITORY_URL } from "../../lib/site";
import { breadcrumbJsonLd, softwareJsonLd } from "../../lib/seo";
import {
  fetchLatestReleaseAtBuild,
  pickAssetByPattern,
  RELEASES_URL,
} from "../../lib/releases";
import { messagesFor } from "../../i18n";
import {
  DEFAULT_LOCALE,
  localeStaticPaths,
  type Locale,
  localizedHref,
} from "../../i18n/locales";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const t = messagesFor(locale);
const d = t.download;
const isZh = locale === "zh-Hans";

const latestRelease = await fetchLatestReleaseAtBuild();
const latestTag = latestRelease?.tag_name ?? "latest";
const releasePageUrl = latestRelease?.html_url ?? RELEASES_URL;
const assets = latestRelease?.assets ?? [];

const winAsset = pickAssetByPattern(assets, ["-x64.exe", ".exe"]);
const linuxAppImage = pickAssetByPattern(assets, ["x86_64.AppImage", ".AppImage"]);
const linuxTarball = pickAssetByPattern(assets, ["linux-x64.tar.gz", ".tar.gz"]);
const androidApk = pickAssetByPattern(assets, [".apk"]);
const androidSha = pickAssetByPattern(assets, [".apk.sha256"]);
const macArmAsset = pickAssetByPattern(assets, ["arm64.dmg", ".dmg"]);
const macX64Asset = pickAssetByPattern(assets, ["x64.dmg"]);

const downloadableAssets = assets.filter(
  (asset) =>
    !asset.name.endsWith(".yml") &&
    !asset.name.endsWith(".blockmap"),
);

const copy = {
  eyebrow: isZh
    ? `最新版本 ${latestTag} · cdn.penglei.dev 加速`
    : `Latest release ${latestTag} · Accelerated by cdn.penglei.dev`,
  heading: isZh ? "下载 tix" : "Download tix",
  lead: isZh
    ? "所有下载链接自动指向最新发布的安装包文件，经由 Cloudflare CDN 加速分发。客户端默认关闭遥测，优先通过 Tailscale 直连。"
    : "Every download link points straight to the newest release artifacts via Cloudflare CDN. Telemetry is off by default and Tailscale direct connection comes first.",
  winTitle: "Windows",
  winSub: isZh ? "Windows 10 / 11 (x64 安装包)" : "Windows 10 / 11 (x64 Installer)",
  winBtn: isZh ? "下载 Windows 安装包" : "Download Windows (.exe)",
  linuxTitle: "Linux",
  linuxSub: isZh ? "桌面端 AppImage 与命令行压缩包" : "Desktop AppImage & CLI tarball",
  linuxBtn: isZh ? "下载 AppImage (x86_64)" : "Download AppImage",
  linuxCliBtn: isZh ? "下载 CLI (.tar.gz)" : "Download CLI (.tar.gz)",
  androidTitle: "Android",
  androidSub: isZh ? "独立签名 APK，支持扫码直连 Tailscale" : "Direct APK with Tailscale QR pairing",
  androidBtn: isZh ? "下载 Android APK" : "Download Android (.apk)",
  androidSha: "SHA-256",
  macTitle: "macOS",
  macSub: isZh ? "Apple Silicon / Intel 桌面端与 CLI" : "Apple Silicon / Intel desktop & CLI",
  macBtn: macArmAsset
    ? (isZh ? "下载 macOS (.dmg)" : "Download macOS (.dmg)")
    : (isZh ? "查看 GitHub Releases" : "View GitHub Releases"),
  macPendingNote: isZh
    ? "当前版本暂未上传 .dmg，可先使用下方终端脚本安装 CLI，或在 GitHub Releases 查看最新构建。"
    : "No .dmg asset in this release yet. Install the CLI below or check GitHub Releases for upcoming macOS builds.",
  cliHeading: isZh ? "终端一键安装" : "Install from your terminal",
  cliSub: isZh
    ? "安装后运行 tix pair --tailscale 即可自动生成 Tailscale 配对地址与二维码。"
    : "After installing, run tix pair --tailscale to generate a Tailscale pairing link and QR code.",
  filesHeading: isZh ? "当前版本全部直链文件" : "All files in the latest release",
  viewOnGithub: isZh ? "在 GitHub 查看发行说明 →" : "View release notes on GitHub →",
};
---

<Layout
  title={d.title}
  description={d.description}
  locale={locale}
  localizedPath="/download"
  jsonLd={[
    softwareJsonLd(d.description),
    breadcrumbJsonLd([
      { name: "tix", path: localizedHref(locale, "/") },
      { name: d.breadcrumb, path: localizedHref(locale, "/download") },
    ]),
  ]}
>
  <section class="dl-hero">
    <div class="container">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span data-release-meta>{copy.eyebrow}</span>
      </div>
      <h1 class="display dl-title">{copy.heading}</h1>
      <p class="dl-lead">{copy.lead}</p>
    </div>
  </section>

  <section class="dl-section">
    <div class="container">
      <div class="dl-grid">
        <article class="dl-card">
          <div class="dl-card-head">
            <h2 class="display dl-card-title">{copy.winTitle}</h2>
            <span class="dl-badge" data-asset-name="win">{winAsset?.name ?? "x64.exe"}</span>
          </div>
          <p class="dl-card-sub">{copy.winSub}</p>
          <div class="dl-card-actions">
            <a
              href={winAsset?.browser_download_url ?? releasePageUrl}
              class="btn-primary"
              data-asset-link="win"
            >
              {copy.winBtn}
            </a>
          </div>
        </article>

        <article class="dl-card">
          <div class="dl-card-head">
            <h2 class="display dl-card-title">{copy.linuxTitle}</h2>
            <span class="dl-badge" data-asset-name="linux">{linuxAppImage?.name ?? "AppImage"}</span>
          </div>
          <p class="dl-card-sub">{copy.linuxSub}</p>
          <div class="dl-card-actions">
            <a
              href={linuxAppImage?.browser_download_url ?? releasePageUrl}
              class="btn-primary"
              data-asset-link="linux"
            >
              {copy.linuxBtn}
            </a>
            <a
              href={linuxTarball?.browser_download_url ?? releasePageUrl}
              class="btn-secondary"
              data-asset-link="linux-tar"
            >
              {copy.linuxCliBtn}
            </a>
          </div>
        </article>

        <article class="dl-card">
          <div class="dl-card-head">
            <h2 class="display dl-card-title">{copy.androidTitle}</h2>
            <span class="dl-badge" data-asset-name="android">{androidApk?.name ?? ".apk"}</span>
          </div>
          <p class="dl-card-sub">{copy.androidSub}</p>
          <div class="dl-card-actions">
            <a
              href={androidApk?.browser_download_url ?? releasePageUrl}
              class="btn-primary"
              data-asset-link="android"
            >
              {copy.androidBtn}
            </a>
            {androidSha && (
              <a
                href={androidSha.browser_download_url}
                class="btn-secondary"
                data-asset-link="android-sha"
              >
                {copy.androidSha}
              </a>
            )}
          </div>
        </article>

        <article class="dl-card">
          <div class="dl-card-head">
            <h2 class="display dl-card-title">{copy.macTitle}</h2>
            <span class="dl-badge" data-asset-name="mac">{macArmAsset?.name ?? "macOS"}</span>
          </div>
          <p class="dl-card-sub">{copy.macSub}</p>
          <div class="dl-card-actions">
            <a
              href={macArmAsset?.browser_download_url ?? releasePageUrl}
              class={macArmAsset ? "btn-primary" : "btn-secondary"}
              data-asset-link="mac"
            >
              {copy.macBtn}
            </a>
            {macX64Asset && (
              <a
                href={macX64Asset.browser_download_url}
                class="btn-secondary"
                data-asset-link="mac-x64"
              >
                Intel (x64)
              </a>
            )}
          </div>
          {!macArmAsset && <p class="dl-note">{copy.macPendingNote}</p>}
        </article>
      </div>
    </div>
  </section>

  <section class="dl-section dl-section--sand">
    <div class="container">
      <div class="cli-grid">
        <div>
          <h2 class="display cli-title">{copy.cliHeading}</h2>
          <p class="cli-sub">{copy.cliSub}</p>
        </div>

        <div class="cli-blocks">
          <div class="cli-block">
            <div class="cli-block-head">
              <span>macOS / Linux</span>
              <button type="button" class="copy-btn" data-copy={`curl -fsSL ${CDN_ORIGIN}/install.sh | sh`}>
                Copy
              </button>
            </div>
            <pre><code>curl -fsSL {CDN_ORIGIN}/install.sh | sh</code></pre>
          </div>

          <div class="cli-block">
            <div class="cli-block-head">
              <span>Windows (PowerShell)</span>
              <button type="button" class="copy-btn" data-copy={`irm ${CDN_ORIGIN}/install.ps1 | iex`}>
                Copy
              </button>
            </div>
            <pre><code>irm {CDN_ORIGIN}/install.ps1 | iex</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="dl-section">
    <div class="container">
      <div class="files-head">
        <h2 class="display files-title">
          {copy.filesHeading} <span class="files-tag" data-release-tag>{latestTag}</span>
        </h2>
        <a href={releasePageUrl} target="_blank" rel="noopener noreferrer" class="files-link" data-release-page>
          {copy.viewOnGithub}
        </a>
      </div>

      <div class="files-list" data-files-list>
        {downloadableAssets.map((asset) => (
          <a href={asset.browser_download_url} class="file-row">
            <span class="file-name">{asset.name}</span>
            <span class="file-cta">cdn.penglei.dev ↓</span>
          </a>
        ))}
      </div>

      <p class="files-footer">
        <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          github.com/penouc/tix
        </a>
      </p>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, pickAssetByPattern } from "../../lib/releases";

  fetchLatestRelease("stable")
    .then((release) => {
      if (!release?.assets?.length) return;

      document.querySelectorAll<HTMLElement>("[data-release-tag]").forEach((el) => {
        el.textContent = release.tag_name;
      });
      document.querySelectorAll<HTMLAnchorElement>("[data-release-page]").forEach((el) => {
        el.href = release.html_url;
      });

      const mappings: Array<[string, string[]]> = [
        ["win", ["-x64.exe", ".exe"]],
        ["linux", ["x86_64.AppImage", ".AppImage"]],
        ["linux-tar", ["linux-x64.tar.gz", ".tar.gz"]],
        ["android", [".apk"]],
        ["android-sha", [".apk.sha256"]],
        ["mac", ["arm64.dmg", ".dmg"]],
        ["mac-x64", ["x64.dmg"]],
      ];

      for (const [key, suffixes] of mappings) {
        const asset = pickAssetByPattern(release.assets, suffixes);
        if (!asset) continue;
        document.querySelectorAll<HTMLAnchorElement>(`[data-asset-link="${key}"]`).forEach((link) => {
          link.href = asset.browser_download_url;
        });
        document.querySelectorAll<HTMLElement>(`[data-asset-name="${key}"]`).forEach((badge) => {
          badge.textContent = asset.name;
        });
      }

      const listEl = document.querySelector<HTMLElement>("[data-files-list]");
      if (listEl) {
        const visible = release.assets.filter(
          (asset) => !asset.name.endsWith(".yml") && !asset.name.endsWith(".blockmap"),
        );
        if (visible.length > 0) {
          listEl.replaceChildren(
            ...visible.map((asset) => {
              const link = document.createElement("a");
              link.href = asset.browser_download_url;
              link.className = "file-row";
              const nameSpan = document.createElement("span");
              nameSpan.className = "file-name";
              nameSpan.textContent = asset.name;
              const ctaSpan = document.createElement("span");
              ctaSpan.className = "file-cta";
              ctaSpan.textContent = "cdn.penglei.dev ↓";
              link.append(nameSpan, ctaSpan);
              return link;
            }),
          );
        }
      }
    })
    .catch(() => {});

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const prev = button.textContent;
        button.textContent = "Copied";
        setTimeout(() => {
          button.textContent = prev;
        }, 1600);
      } catch {}
    });
  });
</script>

<style>
  .dl-hero {
    padding: 64px 0 36px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.84rem;
    font-weight: 500;
    margin-bottom: 18px;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .dl-title {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .dl-lead {
    margin: 16px 0 0;
    max-width: 640px;
    font-size: 1.04rem;
    color: var(--fg-muted);
  }

  .dl-section {
    padding: 36px 0 64px;
  }

  .dl-section--sand {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 56px 0;
  }

  .dl-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .dl-card {
    padding: 28px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-direction: column;
  }

  .dl-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dl-card-title {
    margin: 0;
    font-size: 1.65rem;
    line-height: 1.15;
  }

  .dl-badge {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 4px 10px;
    border-radius: 999px;
  }

  .dl-card-sub {
    margin: 10px 0 22px;
    font-size: 0.94rem;
    color: var(--fg-muted);
  }

  .dl-card-actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dl-note {
    margin: 14px 0 0;
    font-size: 0.84rem;
    color: var(--fg-dim);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--bg-ink);
    color: #faf9f5;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.15s ease;
  }

  .btn-primary:hover {
    background: #2f2d29;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .btn-secondary:hover {
    border-color: var(--border-strong);
    background: var(--bg-soft);
  }

  .cli-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 32px;
    align-items: start;
  }

  .cli-title {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .cli-sub {
    margin: 12px 0 0;
    color: var(--fg-muted);
    font-size: 0.96rem;
  }

  .cli-blocks {
    display: grid;
    gap: 14px;
  }

  .cli-block {
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
  }

  .cli-block-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-weight: 500;
  }

  .cli-block pre {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    overflow-x: auto;
  }

  .copy-btn {
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--fg);
    border-radius: 999px;
    padding: 3px 11px;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .files-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .files-title {
    margin: 0;
    font-size: 1.7rem;
  }

  .files-tag {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent);
    margin-left: 8px;
  }

  .files-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
  }

  .files-list {
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
    overflow: hidden;
  }

  .files-list :global(.file-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.12s ease;
  }

  .files-list :global(.file-row:last-child) {
    border-bottom: none;
  }

  .files-list :global(.file-row:hover) {
    background: var(--bg-soft);
  }

  .files-list :global(.file-name) {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--fg);
    word-break: break-all;
  }

  .files-list :global(.file-cta) {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .files-footer {
    margin: 18px 0 0;
    font-size: 0.84rem;
    color: var(--fg-dim);
  }

  @media (max-width: 820px) {
    .dl-grid,
    .cli-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
