---
import PlatformIcons from "../../components/PlatformIcons.astro";
import Layout from "../../layouts/Layout.astro";
import { ANDROID_PLAY_STORE_URL, IOS_APP_STORE_URL, MARKETING_STATS } from "../../lib/site";
import { RELEASES_URL } from "../../lib/releases";
import { tweets } from "../../lib/tweets";
import { softwareJsonLd } from "../../lib/seo";
import { messagesFor } from "../../i18n";
import { fillTemplate, localeStaticPaths, templateParts } from "../../i18n/locales";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const messages = messagesFor(locale);
const t = messages.home;
const users = new Intl.NumberFormat(locale).format(Number(MARKETING_STATS.users.replaceAll(",", "")));

const platforms = [
  { id: "mac", label: "macOS", download: t.downloadForMac },
  { id: "win", label: "Windows", download: t.downloadForWindows },
  { id: "linux", label: "Linux", download: t.downloadForLinux },
] as const;

const FEATURED = ["DavidKPiano", "QuinnyPig", "dhh", "MichaelArnaldi", "tannerlinsley", "RhysSullivan"];
const VOICES_PAGE = 6;
const voices = [
  ...FEATURED.map((handle) => tweets.find((tweet) => tweet.handle === handle)!),
  ...tweets.filter((tweet) => !FEATURED.includes(tweet.handle)),
];
---

<Layout
  title={t.title}
  description={t.description}
  jsonLd={[softwareJsonLd()]}
  locale={locale}
  localizedPath="/"
>
  <div class="shell">
    <section class="intro">
      <h1 class="page-title">{t.headline}</h1>
      <p class="page-sub">{t.subline}</p>

      <div class="install" data-channel="stable">
        <div class="install-bar">
          <div class="install-tabs" role="tablist" aria-label={t.installLabel}>
            {platforms.map((platform, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${platform.id}`}
                aria-controls={`panel-${platform.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                data-tab={platform.id}
              >
                <PlatformIcons platform={platform.id} />
                {platform.label}
              </button>
            ))}
            <button
              type="button"
              role="tab"
              id="tab-terminal"
              aria-controls="panel-terminal"
              aria-selected="false"
              data-tab="terminal"
            >
              <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7l5 5-5 5M12 18h7"/></svg>
              {t.terminal}
            </button>
          </div>
          <div class="channel" role="group" aria-label={t.channelLabel}>
            <button type="button" data-channel-pick="stable" aria-pressed="true">{t.stable}</button>
            <button type="button" data-channel-pick="nightly" aria-pressed="false">{t.nightly}</button>
          </div>
        </div>

        {platforms.map((platform, index) => (
          <div class="install-panel" role="tabpanel" id={`panel-${platform.id}`} aria-labelledby={`tab-${platform.id}`} hidden={index !== 0}>
            <a class="install-row" href={RELEASES_URL} data-download={platform.id}>
              <PlatformIcons platform={platform.id} />
              <span class="install-text">{platform.download}</span>
              <span class="install-action">{t.downloadAction} ↓</span>
            </a>
          </div>
        ))}
        <div class="install-panel" role="tabpanel" id="panel-terminal" aria-labelledby="tab-terminal" hidden>
          <button class="install-row" type="button" data-copy="npx t3@latest">
            <span class="install-glyph" aria-hidden="true">$</span>
            <span class="install-text" data-command>npx t3@latest</span>
            <span class="install-action" data-copy-label data-idle={t.copyAction} data-done={t.copied}>{t.copyAction}</span>
          </button>
        </div>
      </div>

      <p class="intro-phone">
        {t.alsoOn}
        <a href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer"><PlatformIcons platform="mac" />iOS</a>
        <a href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
          <svg class="tab-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 9.48l1.84-3.18a.38.38 0 00-.66-.38l-1.86 3.22a11.4 11.4 0 00-9.84 0L5.22 5.92a.38.38 0 00-.66.38L6.4 9.48A10.8 10.8 0 001 18h22a10.8 10.8 0 00-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z"/></svg>
          Android
        </a>
      </p>
    </section>

    <section class="block" aria-labelledby="voices-label">
      <h2 class="section-title" id="voices-label">{t.voicesLabel}</h2>
      <p class="page-sub">
        {templateParts(t.endorsementsTitle).map((part) =>
          typeof part === "string" ? part : <strong>{users}</strong>,
        )}
      </p>
      <ul class="voices" data-voices>
        {voices.map((voice, index) => (
          <li hidden={index >= VOICES_PAGE}>
            <blockquote>“{voice.excerpt ?? voice.content}”</blockquote>
            <a href={voice.link} target="_blank" rel="noopener noreferrer" aria-label={fillTemplate(t.readPost, { handle: voice.handle })}>
              <img src={`/pfps/${voice.handle}.webp`} alt="" width="16" height="16" loading="lazy" decoding="async" />
              @{voice.handle}
            </a>
          </li>
        ))}
      </ul>
      <button type="button" class="voices-more" data-voices-more data-page={VOICES_PAGE}>{t.showMore}</button>
    </section>

    <section class="block block--last" aria-labelledby="faq-label">
      <h2 class="section-title" id="faq-label">{t.faqLabel}</h2>
      <div class="faq faq-list">
        {t.faqs.map((item) => (
          <details>
            <summary>
              {item.question}
              <span class="faq-mark" aria-hidden="true">+</span>
            </summary>
            <div data-panel>
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>

<script>
  import { onSiteChannel, setSiteChannel, siteChannel } from "../../lib/channel";
  import { animateDetails } from "../../lib/disclosure";
  import {
    fetchLatestRelease,
    NIGHTLY_RELEASES_URL,
    RELEASES_URL,
    type ReleaseAsset,
    type ReleaseChannel,
  } from "../../lib/releases";

  type Platform = "mac" | "win" | "linux";

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return "win";
    if (/Mac/i.test(ua)) return "mac";
    if (/Linux/i.test(ua)) return "linux";
    return null;
  }

  // Browser architecture hints are unreliable; serve arm64 and let Intel users choose on /download.
  const ASSET_SUFFIX: Record<Platform, string> = {
    win: "-x64.exe",
    mac: "-arm64.dmg",
    linux: "-x86_64.AppImage",
  };

  const platform = detectPlatform();
  const install = document.querySelector<HTMLElement>(".install");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];

  function selectTab(id: string) {
    for (const tab of tabs) {
      const selected = tab.dataset.tab === id;
      tab.setAttribute("aria-selected", String(selected));
      const panel = document.getElementById(`panel-${tab.dataset.tab}`);
      if (panel) panel.hidden = !selected;
    }
  }

  for (const tab of tabs) {
    tab.addEventListener("click", () => selectTab(tab.dataset.tab ?? "mac"));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      const step = event.key === "ArrowRight" ? 1 : -1;
      const next = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
      selectTab(next.dataset.tab ?? "mac");
      next.focus();
    });
  }

  let activeChannel: ReleaseChannel = "stable";

  async function loadChannel(channel: ReleaseChannel) {
    activeChannel = channel;
    if (install) install.dataset.channel = channel;
    const command = channel === "stable" ? "npx t3@latest" : "npx t3@nightly";
    const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
    if (copy) copy.dataset.copy = command;
    const commandText = document.querySelector("[data-command]");
    if (commandText) commandText.textContent = command;

    let assets: ReleaseAsset[] = [];
    try {
      assets = (await fetchLatestRelease(channel)).assets ?? [];
    } catch {}
    if (channel !== activeChannel) return;

    for (const row of document.querySelectorAll<HTMLAnchorElement>("[data-download]")) {
      const asset = assets.find((entry) => entry.name.endsWith(ASSET_SUFFIX[row.dataset.download as Platform]));
      row.href = asset?.browser_download_url ?? (channel === "stable" ? RELEASES_URL : NIGHTLY_RELEASES_URL);
    }
  }

  const channelPicks = document.querySelectorAll<HTMLButtonElement>("[data-channel-pick]");
  function showChannel(channel: ReleaseChannel) {
    for (const button of channelPicks) button.setAttribute("aria-pressed", String(button.dataset.channelPick === channel));
    loadChannel(channel);
  }
  for (const button of channelPicks) {
    button.addEventListener("click", () => setSiteChannel(button.dataset.channelPick as ReleaseChannel));
  }
  onSiteChannel(showChannel);

  if (platform) {
    document.documentElement.dataset.platform = platform;
    selectTab(platform);
  }
  showChannel(siteChannel());

  for (const details of document.querySelectorAll<HTMLDetailsElement>(".faq details")) {
    animateDetails(details);
  }

  const moreVoices = document.querySelector<HTMLButtonElement>("[data-voices-more]");
  moreVoices?.addEventListener("click", () => {
    const hidden = [...document.querySelectorAll<HTMLElement>("[data-voices] > li[hidden]")];
    for (const item of hidden.slice(0, Number(moreVoices.dataset.page))) item.hidden = false;
    if (hidden.length <= Number(moreVoices.dataset.page)) moreVoices.hidden = true;
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      const label = button.querySelector<HTMLElement>("[data-copy-label]");
      button.dataset.state = "copied";
      if (label) label.textContent = label.dataset.done ?? "";
      setTimeout(() => {
        delete button.dataset.state;
        if (label) label.textContent = label.dataset.idle ?? "";
      }, 1600);
    });
  }

</script>

<style>
  /* Intro */

  .intro {
    padding-top: 56px;
  }

  .install {
    --install-bg: oklch(0.571 0.21 264 / 0.14);
    --install-fg: var(--fg);
    --install-dim: var(--fg-dim);
    max-width: 640px;
    margin-top: 36px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Nightly wears the nightly app's sky. */
  .install[data-channel="nightly"] {
    --install-bg: var(--nightly-base);
    --install-fg: #e4eaff;
    --install-dim: rgba(228, 234, 255, 0.55);
  }

  .install-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
  }

  .install-tabs {
    display: flex;
    gap: 2px;
  }

  .install-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: 6px 6px 0 0;
    color: var(--fg-dim);
    font-family: inherit;
    font-size: 12px;
    transition: color 0.18s ease, background 0.25s ease;
  }

  .install-tabs button:hover {
    color: var(--fg-muted);
  }

  .install-tabs button[aria-selected="true"] {
    color: var(--install-fg);
    background: var(--install-bg);
  }

  .install-tabs :global(.dl-icon),
  .tab-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  .channel {
    display: flex;
    margin-bottom: 6px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 7px;
  }

  .channel button {
    padding: 3px 9px;
    border-radius: 5px;
    color: var(--fg-dim);
    font-family: inherit;
    font-size: 11px;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .channel button:hover {
    color: var(--fg-muted);
  }

  .channel button[aria-pressed="true"] {
    color: var(--fg);
    background: rgba(255, 255, 255, 0.08);
  }

  .channel button[data-channel-pick="nightly"][aria-pressed="true"] {
    color: #fff;
    background: linear-gradient(90deg, #4ea4ff, #696fea 55%, #a85bea);
  }

  .install-row {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 15px 16px;
    border-radius: 0 8px 8px 8px;
    background: var(--install-bg);
    color: var(--install-fg);
    font-family: inherit;
    font-size: inherit;
    text-align: left;
    transition: background 0.25s ease, filter 0.18s ease;
  }

  .install-row:hover {
    background: oklch(0.571 0.21 264 / 0.22);
  }

  .install[data-channel="nightly"] .install-row,
  .install[data-channel="nightly"] .install-row:hover {
    background: var(--nightly-row), var(--install-bg);
  }

  .install[data-channel="nightly"] .install-row:hover {
    filter: brightness(1.15);
  }

  .install-glyph {
    color: oklch(0.72 0.13 264);
  }

  .install-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .install-text {
    flex: 1;
  }

  .install-action {
    color: var(--install-dim);
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .install-row:hover .install-action {
    color: var(--install-fg);
  }

  .install-row[data-state="copied"] .install-action {
    color: var(--ok);
  }

  .intro-phone {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 16px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .intro-phone a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-muted);
    transition: color 0.18s ease;
  }

  .intro-phone :global(.dl-icon) {
    width: 12px;
    height: 12px;
  }

  .intro-phone a:hover {
    color: var(--fg);
  }

  /* Sections */

  .block {
    padding-top: 96px;
  }

  .block--last {
    padding-bottom: 152px;
  }

  .section-title + .page-sub {
    margin-top: 10px;
  }

  .page-sub strong {
    color: var(--fg);
    font-weight: 500;
  }

  /* Voices */

  .voices {
    display: grid;
    gap: 28px;
    margin-top: 32px;
    list-style: none;
  }

  .voices li[hidden] {
    display: none;
  }

  .voices blockquote {
    color: var(--fg);
    font-size: 17px;
    letter-spacing: -0.01em;
    line-height: 1.5;
    white-space: pre-line;
    text-wrap: pretty;
  }

  .voices a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--fg-dim);
    font-size: 13px;
    transition: color 0.18s ease;
  }

  .voices a:hover {
    color: var(--fg);
  }

  .voices img {
    width: 16px;
    height: 16px;
    border-radius: 999px;
  }

  .voices-more {
    margin-top: 32px;
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .voices-more:hover {
    color: var(--fg);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .voices-more[hidden] {
    display: none;
  }

  .faq {
    max-width: 720px;
    margin-top: 32px;
  }

  .faq-list {
    border-top: 1px solid var(--border);
  }

  .faq details {
    border-bottom: 1px solid var(--border);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    color: var(--fg);
    font-size: 15px;
    cursor: pointer;
    list-style: none;
    transition: color 0.18s ease;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary:hover {
    color: #fff;
  }

  .faq-mark {
    color: var(--fg-dim);
    font-family: var(--font-mono);
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .faq details[open]:not([data-closing]) .faq-mark {
    transform: rotate(45deg);
  }

  .faq details p {
    max-width: 56ch;
    padding-bottom: 18px;
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .intro {
      padding-top: 40px;
    }

    .install-bar {
      flex-direction: column-reverse;
      align-items: flex-start;
    }

    .install-tabs {
      width: 100%;
    }

    .install-tabs button {
      flex: 1 1 0;
      min-width: 0;
      justify-content: center;
      gap: 5px;
      padding: 8px 4px;
      font-size: 11px;
    }

    .block {
      padding-top: 72px;
    }

    .block--last {
      padding-bottom: 104px;
    }
  }

  @media (max-width: 380px) {
    .install-tabs :global(.dl-icon.dl-icon--fixed),
    .install-tabs .tab-icon {
      display: none;
    }
  }
</style>
