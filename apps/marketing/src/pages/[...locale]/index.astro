---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import appDesktop from "../../assets/app-desktop.webp";
import { CDN_ORIGIN, GITHUB_REPOSITORY_URL } from "../../lib/site";
import { softwareJsonLd } from "../../lib/seo";
import {
  fetchLatestReleaseAtBuild,
  pickAsset,
  RELEASES_URL,
} from "../../lib/releases";
import { messagesFor } from "../../i18n";
import {
  DEFAULT_LOCALE,
  localeStaticPaths,
  type Locale,
  localizedHref,
} from "../../i18n/locales";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale: Locale = Astro.props.locale ?? DEFAULT_LOCALE;
const t = messagesFor(locale);
const h = t.home;
const downloadHref = localizedHref(locale, "/download");

const latestRelease = await fetchLatestReleaseAtBuild();
const latestTag = latestRelease?.tag_name ?? "latest";
const assets = latestRelease?.assets ?? [];

const macUrl = pickAsset(assets, { os: "mac" }) ?? downloadHref;
const winUrl = pickAsset(assets, { os: "win" }) ?? downloadHref;
const linuxUrl = pickAsset(assets, { os: "linux" }) ?? downloadHref;
const androidUrl = pickAsset(assets, { os: "android" }) ?? downloadHref;

const isZh = locale === "zh-Hans";
const copy = {
  eyebrow: isZh
    ? `Tailscale 直连优先 · 零遥测 · ${latestTag}`
    : `Tailscale-first · Zero telemetry · ${latestTag}`,
  heroLead: isZh
    ? "在一个安静、克制的界面里编排 Claude Code、Codex、Antigravity、Cursor 与 OpenCode。默认通过你的 Tailscale 网络直连，不依赖云中继，也不收集遥测。"
    : "Orchestrate Claude Code, Codex, Antigravity, Cursor, and OpenCode from one calm workspace. Direct over your Tailscale network by default, with no cloud relay and no telemetry.",
  primaryCtaFallback: isZh ? "下载最新版本" : "Download latest",
  allDownloads: isZh ? "全部平台与安装包" : "All downloads",
  quickInstallLabel: isZh ? "一条命令启动并生成 Tailscale 配对码" : "Install & pair over Tailscale in one step",
  pillarsTitle: isZh ? "为本地与私有网络而设计" : "Built for local machines and private tailnets",
  pillars: isZh
    ? [
        {
          kicker: "Tailscale 直连",
          title: "自动发现 *.ts.net 与 100.x 地址",
          body: "运行 tix pair --tailscale 即可自动识别 MagicDNS 与 Tailscale IP，手机扫码直连桌面端，无需公网暴露或云端中继。",
        },
        {
          kicker: "自带订阅",
          title: "统一调度你已有的编码智能体",
          body: "直接接入 Claude Code、Codex、Antigravity、OpenCode、Cursor 与 Grok。不转售 token，不设额外额度，随时在同一线程切换模型。",
        },
        {
          kicker: "零遥测 · 开源",
          title: "默认关闭全部客户端遥测与上报",
          body: "无默认分析事件、无强制账号登录、MIT 协议开源。你可以自由查看源码、定制界面或自行构建分发。",
        },
      ]
    : [
        {
          kicker: "Tailscale-first",
          title: "Automatic *.ts.net & tailnet discovery",
          body: "Run tix pair --tailscale to detect MagicDNS and 100.x addresses automatically. Scan a QR code from your phone with zero cloud relay.",
        },
        {
          kicker: "Bring your own sub",
          title: "One calm surface for every agent",
          body: "Connect Claude Code, Codex, Antigravity, OpenCode, Cursor, and Grok using the subscriptions you already pay for. Switch models mid-thread.",
        },
        {
          kicker: "Zero telemetry",
          title: "Private by default, MIT open source",
          body: "Client telemetry and crash reporting stay off by default. No mandatory cloud sign-in. Inspect, fork, or self-host the entire stack.",
        },
      ],
  directHeading: isZh ? "最新安装包直链（CDN 加速）" : "Direct latest downloads via CDN",
  directSub: isZh
    ? "所有安装包均自动同步 GitHub Releases 最新版本，经由 cdn.penglei.dev 加速分发。"
    : "Every download button resolves straight to the newest GitHub Release asset, served through cdn.penglei.dev.",
  workflowKicker: isZh ? "Git 与远程协作" : "Git & remote workflow",
  workflowTitle: h.gitTitle,
  workflowBody: h.gitBody,
  workflowPoints: h.gitPoints,
  ctaTitle: isZh ? "用更安静的方式驾驭你的编码智能体。" : "A calmer workspace for your coding agents.",
  ctaSub: isZh
    ? "下载桌面端、移动端 APK，或在服务器运行 CLI，几分钟内通过 Tailscale 连上你的开发环境。"
    : "Download the desktop app, Android APK, or server CLI and connect your machines over Tailscale in minutes.",
};
---

<Layout
  title={h.title}
  description={h.description}
  locale={locale}
  localizedPath="/"
  jsonLd={[softwareJsonLd(h.description)]}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span data-release-badge>{copy.eyebrow}</span>
      </div>

      <h1 class="display hero-title">
        {h.heroTitle.map((line, index) => (
          <>
            {line}
            {index < h.heroTitle.length - 1 && <br />}
          </>
        ))}
      </h1>

      <p class="hero-lead">{copy.heroLead}</p>

      <div class="hero-actions">
        <a
          href={downloadHref}
          class="btn-primary"
          data-hero-download
          data-label-default={copy.primaryCtaFallback}
          data-label-mac={h.downloadForMac}
          data-label-win={h.downloadForWindows}
          data-label-linux={h.downloadForLinux}
          data-label-android={h.downloadForAndroid}
          data-url-mac={macUrl}
          data-url-win={winUrl}
          data-url-linux={linuxUrl}
          data-url-android={androidUrl}
        >
          <span data-hero-download-label>{copy.primaryCtaFallback}</span>
          <span class="btn-tag" data-release-tag>{latestTag}</span>
        </a>
        <a href={downloadHref} class="btn-secondary">{copy.allDownloads}</a>
      </div>

      <div class="platform-strip" aria-label={copy.directHeading}>
        <a href={winUrl} class="platform-pill" data-platform-link="win">Windows (.exe)</a>
        <a href={linuxUrl} class="platform-pill" data-platform-link="linux">Linux (AppImage)</a>
        <a href={androidUrl} class="platform-pill" data-platform-link="android">Android (.apk)</a>
        <a href={macUrl} class="platform-pill" data-platform-link="mac">macOS</a>
      </div>

      <div class="terminal-card">
        <div class="terminal-head">
          <span class="terminal-label">{copy.quickInstallLabel}</span>
          <button type="button" class="copy-btn" data-copy={`curl -fsSL ${CDN_ORIGIN}/install.sh | sh`}>
            Copy
          </button>
        </div>
        <pre class="terminal-code"><code>curl -fsSL {CDN_ORIGIN}/install.sh | sh
tix pair --tailscale</code></pre>
      </div>
    </div>
  </section>

  <section class="showcase">
    <div class="container">
      <div class="showcase-frame">
        <Image
          src={appDesktop}
          alt={h.screenshotAlt}
          widths={[800, 1280, 1800]}
          sizes="(max-width: 1080px) 100vw, 1032px"
          loading="eager"
          class="showcase-img"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="display section-title">{copy.pillarsTitle}</h2>
      </div>
      <div class="pillars-grid">
        {copy.pillars.map((item) => (
          <article class="pillar-card">
            <span class="pillar-kicker">{item.kicker}</span>
            <h3 class="display pillar-title">{item.title}</h3>
            <p class="pillar-body">{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sand">
    <div class="container workflow-grid">
      <div class="workflow-copy">
        <span class="pillar-kicker">{copy.workflowKicker}</span>
        <h2 class="display section-title">{copy.workflowTitle}</h2>
        <p class="workflow-body">{copy.workflowBody}</p>
        <ul class="check-list">
          {copy.workflowPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>

      <div class="workflow-card" aria-label={h.gitVisualLabel}>
        <div class="wf-row wf-row--top">
          <span class="wf-pill wf-pill--ok">Tailscale Direct</span>
          <code class="wf-host">macbook.tailnet.ts.net</code>
        </div>
        <div class="wf-divider"></div>
        <div class="wf-meta">
          <span class="wf-branch">feat/tailscale-first-connection</span>
          <span class="wf-commits">{h.prCommits}</span>
        </div>
        <div class="wf-diff">
          <div class="wf-diff-line wf-diff-add">+ Auto-detect MagicDNS &amp; 100.64.0.0/10</div>
          <div class="wf-diff-line wf-diff-add">+ QR pairing straight to local tix server</div>
          <div class="wf-diff-line wf-diff-del">- Mandatory cloud relay &amp; default telemetry</div>
        </div>
        <div class="wf-actions">
          <span class="wf-btn wf-btn--ghost">{h.viewDiff}</span>
          <span class="wf-btn wf-btn--accent">{h.openPullRequest}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-card">
        <h2 class="display cta-title">{copy.ctaTitle}</h2>
        <p class="cta-sub">{copy.ctaSub}</p>
        <div class="cta-actions">
          <a href={downloadHref} class="btn-primary">{copy.allDownloads}</a>
          <a
            href={GITHUB_REPOSITORY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            {h.browseSource}
          </a>
          <a
            href={RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-link"
          >
            GitHub Releases →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { detectPlatform } from "../../lib/platform";
  import { fetchLatestRelease, pickAsset } from "../../lib/releases";

  const platform = detectPlatform(navigator.userAgent, navigator.maxTouchPoints ?? 0);
  const heroBtn = document.querySelector<HTMLAnchorElement>("[data-hero-download]");
  const heroLabel = document.querySelector<HTMLElement>("[data-hero-download-label]");

  function applyHeroPlatform(os: string | undefined, urlOverride?: string | null) {
    if (!heroBtn || !heroLabel || !os) return;
    const labelMap: Record<string, string | undefined> = {
      mac: heroBtn.dataset.labelMac,
      win: heroBtn.dataset.labelWin,
      linux: heroBtn.dataset.labelLinux,
      android: heroBtn.dataset.labelAndroid,
    };
    const urlMap: Record<string, string | undefined> = {
      mac: heroBtn.dataset.urlMac,
      win: heroBtn.dataset.urlWin,
      linux: heroBtn.dataset.urlLinux,
      android: heroBtn.dataset.urlAndroid,
    };
    if (labelMap[os]) heroLabel.textContent = labelMap[os]!;
    const resolved = urlOverride ?? urlMap[os];
    if (resolved) heroBtn.href = resolved;
  }

  applyHeroPlatform(platform?.os);

  fetchLatestRelease("stable")
    .then((release) => {
      if (!release?.assets?.length) return;
      document.querySelectorAll<HTMLElement>("[data-release-tag]").forEach((el) => {
        el.textContent = release.tag_name;
      });
      for (const os of ["mac", "win", "linux", "android"] as const) {
        const assetUrl = pickAsset(release.assets, { os });
        if (!assetUrl) continue;
        document
          .querySelectorAll<HTMLAnchorElement>(`[data-platform-link="${os}"]`)
          .forEach((link) => {
            link.href = assetUrl;
          });
        if (platform?.os === os) {
          applyHeroPlatform(os, assetUrl);
        }
      }
    })
    .catch(() => {});

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const prev = button.textContent;
        button.textContent = "Copied";
        setTimeout(() => {
          button.textContent = prev;
        }, 1600);
      } catch {}
    });
  });
</script>

<style>
  .hero {
    padding: 72px 0 44px;
  }

  .hero-inner {
    max-width: 780px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.84rem;
    font-weight: 500;
    margin-bottom: 24px;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .hero-lead {
    margin: 22px 0 0;
    max-width: 620px;
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .hero-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--bg-ink);
    color: #faf9f5;
    font-size: 0.94rem;
    font-weight: 500;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: #2e2c28;
    transform: translateY(-1px);
  }

  .btn-tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(250, 249, 245, 0.14);
    color: #f3d9cd;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--bg-card);
    color: var(--fg);
    border: 1px solid var(--border);
    font-size: 0.94rem;
    font-weight: 500;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-secondary:hover {
    border-color: var(--border-strong);
    background: var(--bg-soft);
  }

  .btn-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--accent);
    padding: 8px 10px;
  }

  .btn-link:hover {
    color: var(--accent-hover);
  }

  .platform-strip {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .platform-pill {
    font-size: 0.82rem;
    color: var(--fg-muted);
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.75);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .platform-pill:hover {
    border-color: var(--accent);
    color: var(--fg);
  }

  .terminal-card {
    margin-top: 32px;
    width: 100%;
    max-width: 560px;
    text-align: left;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }

  .terminal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }

  .terminal-label {
    font-size: 0.8rem;
    color: var(--fg-muted);
    font-weight: 500;
  }

  .copy-btn {
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
    color: var(--fg);
    border-radius: 999px;
    padding: 3px 11px;
    font-size: 0.76rem;
    font-weight: 500;
    cursor: pointer;
  }

  .copy-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .terminal-code {
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--fg);
    overflow-x: auto;
  }

  .showcase {
    padding: 12px 0 64px;
  }

  .showcase-frame {
    padding: 14px;
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-frame);
  }

  .showcase-img {
    width: 100%;
    border-radius: calc(var(--radius-lg) - 10px);
    border: 1px solid rgba(25, 25, 24, 0.08);
  }

  .section {
    padding: 72px 0;
  }

  .section-sand {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    max-width: 640px;
    margin-bottom: 36px;
  }

  .section-title {
    margin: 0;
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .pillar-card {
    padding: 28px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
  }

  .pillar-kicker {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .pillar-title {
    margin: 0 0 12px;
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .pillar-body {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--fg-muted);
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 44px;
    align-items: center;
  }

  .workflow-body {
    margin: 16px 0 0;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--fg-muted);
  }

  .check-list {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .check-list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.94rem;
    color: var(--fg);
  }

  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .workflow-card {
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--bg-card);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
  }

  .wf-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wf-pill {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .wf-pill--ok {
    background: var(--accent-soft);
    color: #9f4628;
  }

  .wf-host {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-muted);
  }

  .wf-divider {
    height: 1px;
    background: var(--border);
    margin: 16px 0;
  }

  .wf-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .wf-branch {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--fg);
  }

  .wf-commits {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }

  .wf-diff {
    border-radius: var(--radius-sm);
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .wf-diff-add {
    color: #2c6e49;
  }

  .wf-diff-del {
    color: #a63d2d;
  }

  .wf-actions {
    margin-top: 16px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }

  .wf-btn {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 999px;
  }

  .wf-btn--ghost {
    border: 1px solid var(--border);
    color: var(--fg-muted);
  }

  .wf-btn--accent {
    background: var(--accent);
    color: #fff;
  }

  .cta-card {
    padding: 52px 36px;
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    text-align: center;
  }

  .cta-title {
    margin: 0;
    font-size: clamp(1.9rem, 3.5vw, 2.7rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .cta-sub {
    margin: 14px auto 0;
    max-width: 560px;
    font-size: 1rem;
    color: var(--fg-muted);
  }

  .cta-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 900px) {
    .pillars-grid,
    .workflow-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 48px 0 32px;
    }

    .cta-card {
      padding: 36px 22px;
    }
  }
</style>
