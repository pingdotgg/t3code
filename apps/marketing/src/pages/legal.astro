---
import Layout from "../layouts/Layout.astro";

const documents = [
  {
    title: "Privacy Policy",
    description: "How T3 Code handles information, connected services, and your privacy choices.",
    href: "/privacy-policy",
  },
  {
    title: "Terms of Service",
    description: "The terms that govern your use of T3 Code and T3 Tools-operated services.",
    href: "/terms-of-service",
  },
  {
    title: "Security Policy",
    description: "Our security practices, responsible disclosure process, and shared responsibilities.",
    href: "/security-policy",
  },
] as const;
---

<Layout
  title="Legal | T3 Code"
  description="Privacy, terms, and security documents for T3 Code."
>
  <div class="shell legal-index">
    <header class="legal-index-hero">
      <h1 class="page-title">Legal</h1>
      <p class="page-sub">Policies and terms for T3 Code, collected in one place.</p>
    </header>

    <nav class="document-list" aria-label="Legal documents">
      {documents.map((document) => (
        <a href={document.href} class="document-card">
          <span class="document-copy">
            <strong>{document.title}</strong>
            <span>{document.description}</span>
          </span>
          <span class="document-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>
  </div>
</Layout>

<style>
  .legal-index {
    padding-top: 56px;
    padding-bottom: 152px;
  }

  .document-list {
    display: grid;
    margin-top: 40px;
    border-top: 1px solid var(--border);
  }

  .document-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .document-copy {
    display: grid;
    gap: 4px;
  }

  .document-copy strong {
    color: var(--fg);
    font-size: 15px;
    font-weight: 500;
    transition: color 0.18s ease;
  }

  .document-copy span {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .document-arrow {
    color: var(--fg-dim);
    transition: color 0.18s ease;
  }

  .document-card:hover .document-arrow,
  .document-card:hover strong {
    color: #fff;
  }

  @media (max-width: 640px) {
    .legal-index {
      padding-top: 40px;
      padding-bottom: 104px;
    }
  }
</style>
