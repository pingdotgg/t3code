        <h2 class="platform-name">Linux</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="x86_64.AppImage" href={RELEASES_URL}>
          <span class="card-arch">x86_64</span>
          <span class="card-format">AppImage</span>
        </a>
      </div>
    </section>

    <!-- Mobile -->
    <section class="platform-section">
      <div class="platform-header">
        <svg
          class="platform-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="14" height="20" x="5" y="2" rx="2"></rect>
          <path d="M12 18h.01"></path>
        </svg>
        <h2 class="platform-name">Mobile</h2>
      </div>
      <div class="download-cards">
        <a
          class="download-card"
          href={IOS_APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="card-arch">iPhone and iPad</span>
          <span class="card-format">App Store <span aria-hidden="true">&#8599;</span></span>
        </a>
        <a
          class="download-card"
          href={GOOGLE_PLAY_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="card-arch">Android phones and tablets</span>
          <span class="card-format">Google Play <span aria-hidden="true">&#8599;</span></span>
        </a>
      </div>
    </section>
  </div>

  <p class="releases-link">
    Looking for another build? Check the{" "}
    <a id="releases-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
      GitHub releases page<span aria-hidden="true"> &#8599;</span>
    </a>
  </p>
  </div>
</Layout>

<script>
  import {
    fetchLatestRelease,
    fetchNightlyRelease,
    findReleaseAssetUrl,
    NIGHTLY_RELEASES_URL,
    RELEASES_URL,
    type Release,
    type ReleasePlatform,
  } from "../lib/releases";
  import { GITHUB_REPOSITORY_URL } from "../lib/site";

  type Stage = "latest" | "nightly" | "dev";

  function isStage(value: unknown): value is Stage {
    return value === "latest" || value === "nightly" || value === "dev";
  }

  const versionLabel = document.getElementById("version-label");
  const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement | null;
  const releasesLink = document.getElementById("releases-link") as HTMLAnchorElement | null;
  const devSource = document.getElementById("dev-source");
  const desktopSections = document.querySelectorAll<HTMLElement>("[data-desktop-platform]");
  const desktopCards =
    document.querySelectorAll<HTMLAnchorElement>(".download-card[data-asset]");
  let releaseRequest = 0;

  function platformForAsset(suffix: string): ReleasePlatform | null {
    if (suffix === "arm64.dmg") return { os: "mac", arch: "arm64" };
    if (suffix === "x64.dmg") return { os: "mac", arch: "x64" };
    if (suffix === "x64.exe") return { os: "win", arch: "x64" };
    if (suffix === "x86_64.AppImage") return { os: "linux", arch: "x64" };
    return null;
  }

  function setDesktopCards(release: Release | null, fallbackUrl: string) {
    desktopCards.forEach((card) => {
      const suffix = card.dataset.asset;
      const platform = suffix ? platformForAsset(suffix) : null;
      card.href =
        release && platform
          ? findReleaseAssetUrl(release.assets, platform) ?? fallbackUrl
          : fallbackUrl;
    });
  }

  function updateStageControls(stage: Stage) {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-download-stage]")) {
      button.setAttribute("aria-pressed", String(button.dataset.downloadStage === stage));
    }
  }

  async function applyStage(stage: Stage) {
    const request = ++releaseRequest;
    updateStageControls(stage);
    const isDev = stage === "dev";
    devSource?.toggleAttribute("hidden", !isDev);
    desktopSections.forEach((section) => section.toggleAttribute("hidden", isDev));

    if (isDev) {
      if (versionLabel) versionLabel.textContent = "Dev tracks the current source on GitHub.";
      if (changelogLink) changelogLink.style.display = "none";
      if (releasesLink) releasesLink.href = GITHUB_REPOSITORY_URL;
      return;
    }

    const isNightly = stage === "nightly";
    const fallbackUrl = isNightly ? NIGHTLY_RELEASES_URL : RELEASES_URL;
    if (versionLabel) {
      versionLabel.textContent = `Loading ${isNightly ? "nightly" : "latest"} desktop release…`;
    }
    if (changelogLink) changelogLink.style.display = "none";
    if (releasesLink) releasesLink.href = fallbackUrl;
    setDesktopCards(null, fallbackUrl);

    try {
      const release = await (isNightly ? fetchNightlyRelease() : fetchLatestRelease());
      if (request !== releaseRequest) return;

      if (versionLabel) {
        versionLabel.textContent = `${isNightly ? "Nightly" : "Latest"} desktop release (${release.tag_name})`;
      }
      if (changelogLink) {
        changelogLink.href = release.html_url;
        changelogLink.style.display = "";
      }
      setDesktopCards(release, fallbackUrl);
    } catch {
      if (request !== releaseRequest) return;
      if (versionLabel) {
        versionLabel.textContent = `Could not load the ${isNightly ? "nightly" : "latest"} release.`;
      }
      setDesktopCards(null, fallbackUrl);
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-download-stage]")) {
    button.addEventListener("click", () => {
      const stage = button.dataset.downloadStage;
      if (!isStage(stage)) return;
      document.dispatchEvent(
        new CustomEvent("t3-marketing-stage-request", { detail: { stage } }),
      );
    });
  }

  document.addEventListener("t3-marketing-stage-change", (event) => {
    const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
    if (isStage(stage)) void applyStage(stage);
  });

  const copyButton = document.getElementById("copy-clone-command");
  copyButton?.addEventListener("click", () => {
    void navigator.clipboard
      .writeText(`git clone ${GITHUB_REPOSITORY_URL}.git`)
      .then(() => {
        copyButton.textContent = "Copied";
        window.setTimeout(() => {
          copyButton.textContent = "Copy command";
        }, 1600);
      })
      .catch(() => {
        copyButton.textContent = "Copy failed";
      });
  });

  const initialStage = document.documentElement.dataset.stage;
  void applyStage(isStage(initialStage) ? initialStage : "latest");
</script>

<style>
  .download-page {
    position: relative;
    isolation: isolate;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: calc(8vh + 60px) 1.5rem 4rem;
    overflow: hidden;
  }

  .download-page > :not(.stage-sky) {
    position: relative;
    z-index: 1;
  }

  /* ── Heading ── */

  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: center;
    margin-bottom: 0.75rem;
    opacity: 0;
    animation: fade-in 1s ease-out forwards;
  }

  .intro {
    max-width: 520px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    text-align: center;
    opacity: 0;
    animation: fade-in 1s ease-out 0.05s forwards;
  }

  .download-stage-picker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin: 2rem 0 1.3rem;
    opacity: 0;
    animation: fade-in 1s ease-out 0.1s forwards;
  }

  .download-stage-picker button {
    position: relative;
    padding: 5px 1px 9px;
    color: var(--fg-dim);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    transition:
      color 0.18s ease,
      opacity 0.18s ease;
  }

  .download-stage-picker button::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    border-radius: 999px;
    background: currentColor;
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.22s ease,
      transform 0.22s ease;
  }

  .download-stage-picker button:hover {
    color: var(--fg-muted);
  }

  .download-stage-picker button[aria-pressed="true"] {
    color: var(--fg);
  }

  .download-stage-picker button[aria-pressed="true"]::after {
    opacity: 0.8;
    transform: scaleX(1);
  }

  .subheading {
    font-size: 0.9rem;
    color: var(--fg-dim);
    min-height: 1.35rem;
    margin-bottom: 2.75rem;
    opacity: 0;
    animation: fade-in 1s ease-out 0.15s forwards;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .changelog-link {
    color: var(--fg-muted);
    font-size: 0.8rem;
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .changelog-link:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Platforms ── */

  .platforms {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    opacity: 0;
    animation: fade-in 1s ease-out 0.2s forwards;
  }

  .platform-section {
    display: grid;
