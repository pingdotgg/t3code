          <h2 class="platform-name">Linux</h2>
        </div>
        <div class="download-cards">
          <a class="download-card" data-asset="x86_64.AppImage" href={RELEASES_URL}>
            <span class="card-icon">
              <Image class="card-icon--stable" src={iconStable} width={28} height={28} loading="lazy" {...imageProps} />
              <Image class="card-icon--nightly" src={iconNightly} width={28} height={28} loading="lazy" {...imageProps} />
            </span>
            <span class="card-text">
              <span class="card-arch">x86_64</span>
              <span class="card-format">AppImage</span>
            </span>
          </a>
        </div>
      </section>

      <!-- Mobile. Stable only, there is no nightly mobile build. -->
      <section class="platform-section platform-section--mobile" data-rise style="--d:420ms">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M11 18.5h2"/></svg>
          <h2 class="platform-name">Mobile</h2>
        </div>
        <div class="download-cards">
          <a class="download-card" href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="card-text">
              <span class="card-arch">iPhone &amp; iPad</span>
              <span class="card-format">App Store</span>
            </span>
          </a>
          <a class="download-card" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
            <span class="card-text">
              <span class="card-arch">Android</span>
              <span class="card-format">Google Play</span>
            </span>
          </a>
        </div>
      </section>

      <section class="platform-section platform-section--cli" data-rise style="--d:420ms">
        <div class="platform-header">
          <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7l5 5-5 5M12 17h7"/></svg>
          <h2 class="platform-name">Terminal</h2>
        </div>
        <code class="cli-line">npx t3@nightly</code>
      </section>
    </div>

    <p class="releases-link" data-rise style="--d:480ms">
      All builds are on the{" "}
      <a id="releases-page-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
        GitHub releases page<span aria-hidden="true"> &#8599;</span>
      </a>
    </p>
  </div>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, NIGHTLY_RELEASES_URL, type ReleaseChannel } from "../lib/releases";

  const page = document.getElementById("download-page")!;
  const versionLabel = document.getElementById("version-label")!;
  const changelogLink = document.getElementById("changelog-link") as HTMLAnchorElement;
  const releasesPageLink = document.getElementById("releases-page-link") as HTMLAnchorElement;
  const tabs = page.querySelectorAll<HTMLButtonElement>(".channel-toggle button");
  // Only release-asset links; mobile store cards have no data-asset and keep their href.
  const cards = page.querySelectorAll<HTMLAnchorElement>("a[data-asset]");

  function readChannel(): ReleaseChannel {
    return new URLSearchParams(location.search).get("channel") === "nightly" ? "nightly" : "stable";
  }

  function relativeAge(iso: string): string {
    const minutes = Math.max(1, Math.round((Date.now() - Date.parse(iso)) / 60_000));
    if (minutes < 60) return `${minutes} minutes ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 48) return `${hours} hours ago`;
    return `${Math.round(hours / 24)} days ago`;
  }

  async function load(channel: ReleaseChannel) {
    const fallback = channel === "nightly" ? NIGHTLY_RELEASES_URL : RELEASES_URL;
    page.dataset.channel = channel;
    tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.channel === channel)));
    releasesPageLink.href = fallback;
    changelogLink.href = fallback;
    versionLabel.textContent = "\u00a0";
    cards.forEach((card) => {
      card.href = fallback;
    });

    try {
      const release = await fetchLatestRelease(channel);
      // A toggle click while the fetch was in flight wins; drop the stale result.
      if (page.dataset.channel !== channel) return;

      // Stable shows its version. Nightly shows how fresh the build is; the tag is noise.
      versionLabel.textContent =
        channel === "nightly"
          ? `Built ${relativeAge(release.published_at)}`
          : release.tag_name;
      if (release.html_url) changelogLink.href = release.html_url;
      cards.forEach((card) => {
        const match = (release.assets ?? []).find((a) => a.name.endsWith(`-${card.dataset.asset}`));
        card.href = match?.browser_download_url ?? fallback;
      });
    } catch {
      if (page.dataset.channel === channel) versionLabel.textContent = "Releases";
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const channel = tab.dataset.channel as ReleaseChannel;
      const url = new URL(location.href);
      if (channel === "nightly") url.searchParams.set("channel", "nightly");
      else url.searchParams.delete("channel");
      history.replaceState(null, "", url);
      load(channel);
    });
  });

  load(readChannel());
</script>

<style>
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.5rem 4rem;
  }

  /* ── Header ── */

  .download-head {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9vh 1.5rem 2.5rem;
    margin-bottom: 2rem;
  }

  /* Sky: the nightly DMG backdrop, masked so it dissolves into the page instead of ending at a line. */
  .sky {
    position: absolute;
    top: -80px;
    bottom: 0;
    /* Break out of the page padding so the sky spans the full viewport width. */
    left: 50%;
    width: 100vw;
    margin-left: -50vw;
    z-index: -1;
    background: url("/nightly-sky.svg") center / cover no-repeat;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s ease, transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }

  .download-page[data-channel="nightly"] .sky {
    opacity: 1;
    transform: none;
  }

  .head-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .head-icon {
    position: relative;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  /* Both channel icons stay mounted and cross-fade, so the title never moves. */
  .head-icon img,
  .card-icon img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.45s ease;
  }

  .head-icon--nightly,
  .card-icon--nightly {
    opacity: 0;
  }

  .download-page[data-channel="nightly"] .head-icon--stable,
  .download-page[data-channel="nightly"] .card-icon--stable {
    opacity: 0;
  }

  .download-page[data-channel="nightly"] .head-icon--nightly,
  .download-page[data-channel="nightly"] .card-icon--nightly {
    opacity: 1;
  }

  .heading {
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  /* ── Channel toggle ── */

  .channel-toggle {
    position: relative;
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 3px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.45s ease, background 0.45s ease;
  }

  .download-page[data-channel="nightly"] .channel-toggle {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(7, 21, 47, 0.5);
  }

  /* The thumb slides between the two tabs; both tabs are the same width. */
  .channel-thumb {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc(50% - 3px);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), background 0.45s ease;
  }

  .download-page[data-channel="nightly"] .channel-thumb {
    transform: translateX(100%);
    background: rgba(255, 255, 255, 0.16);
  }

  .channel-toggle button {
    position: relative;
    width: 5.5rem;
    padding: 7px 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .channel-toggle button:hover,
  .channel-toggle button[aria-selected="true"] {
    color: var(--fg);
  }

  .channel-toggle button[aria-selected="true"] {
    font-weight: 500;
  }

  .head-meta {
    margin-top: 1rem;
    font-size: 0.8rem;
    min-height: 1.2em;
  }

  .changelog-link {
    color: var(--fg-dim);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .changelog-link:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .download-page[data-channel="nightly"] .changelog-link {
    color: #b9bdff;
  }

  /* ── Platforms ── */

  .platforms {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .platform-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
