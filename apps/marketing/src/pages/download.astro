---
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import {
  GITHUB_REPOSITORY_URL,
  GOOGLE_PLAY_STORE_URL,
  IOS_APP_STORE_URL,
} from "../lib/site";
import "../styles/stage-sky.css";
---

<Layout
  title="Download — T3 Code"
  description="Download T3 Code for iPhone, iPad, Android, macOS, Windows, or Linux."
  pageClass="marketing-downloads"
>
  <div class="download-page">
  <div class="stage-sky" aria-hidden="true">
    <span class="stage-sky__ray stage-sky__ray--1"></span>
    <span class="stage-sky__ray stage-sky__ray--2"></span>
    <span class="stage-sky__ray stage-sky__ray--3"></span>
    <span class="stage-sky__ray stage-sky__ray--4"></span>
    <span class="stage-sky__ray stage-sky__ray--5"></span>
    <span class="stage-sky__cloud stage-sky__cloud--1"></span>
    <span class="stage-sky__cloud stage-sky__cloud--2"></span>
  </div>
  <h1 class="heading">Download T3 Code</h1>
  <p class="intro">Pick a desktop release channel. Mobile apps use the current store release.</p>
  <div class="download-stage-picker" aria-label="Desktop release channel">
    <button type="button" data-download-stage="latest" aria-pressed="true">
      <span>Latest</span>
    </button>
    <button type="button" data-download-stage="nightly" aria-pressed="false">
      <span>Nightly</span>
    </button>
    <button type="button" data-download-stage="dev" aria-pressed="false">
      <span>Dev</span>
    </button>
  </div>
  <p class="subheading">
    <span id="version-label">Loading latest desktop release&hellip;</span>
    <a id="changelog-link" class="changelog-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none">View changelog<span aria-hidden="true"> &#8599;</span></a>
  </p>

  <div class="platforms" id="platforms">
    <section class="platform-section dev-source" id="dev-source" hidden>
      <div class="platform-header">
        <svg
          class="platform-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m8 9-4 3 4 3"></path>
          <path d="m16 9 4 3-4 3"></path>
          <path d="m14 5-4 14"></path>
        </svg>
        <h2 class="platform-name">Build from source</h2>
      </div>
      <div class="source-card">
        <div>
          <strong>Run the current development code</strong>
          <p>Clone the repository and follow the contributor setup. Dev does not publish desktop binaries.</p>
          <code>git clone https://github.com/pingdotgg/t3code.git</code>
        </div>
        <div class="source-actions">
          <button type="button" id="copy-clone-command">Copy command</button>
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer"
            >Open GitHub <span aria-hidden="true">&#8599;</span></a
          >
        </div>
      </div>
    </section>

    <!-- macOS -->
    <section class="platform-section" data-desktop-platform>
      <div class="platform-header">
        <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
        <h2 class="platform-name">macOS</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="arm64.dmg" href={RELEASES_URL}>
          <span class="card-arch">Apple Silicon (arm64)</span>
          <span class="card-format">.dmg</span>
        </a>
        <a class="download-card" data-asset="x64.dmg" href={RELEASES_URL}>
          <span class="card-arch">Intel (x64)</span>
          <span class="card-format">.dmg</span>
        </a>
      </div>
    </section>

    <!-- Windows -->
    <section class="platform-section" data-desktop-platform>
      <div class="platform-header">
        <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88" aria-hidden="true"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg>
        <h2 class="platform-name">Windows</h2>
      </div>
      <div class="download-cards">
        <a class="download-card" data-asset="x64.exe" href={RELEASES_URL}>
          <span class="card-arch">Windows 10, 11</span>
          <span class="card-format">.exe</span>
        </a>
      </div>
    </section>

    <!-- Linux -->
    <section class="platform-section" data-desktop-platform>
      <div class="platform-header">
        <svg class="platform-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.