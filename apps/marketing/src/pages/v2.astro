---
import stableAppIcon from "../assets/t3-latest-384.webp?url";
import Layout from "../layouts/Layout.astro";
import {
  GOOGLE_PLAY_STORE_URL,
  IOS_APP_STORE_URL,
  MARKETING_STATS,
} from "../lib/site";
import { tweets } from "../lib/tweets";

const surfaces = [
  { id: "desk", label: "at your desk", image: null },
  { id: "phone", label: "from your phone", image: "/mobile-states/ios-thread.png" },
  { id: "tablet", label: "on your tablet too", image: "/mobile-states/ipad-threads.png" },
] as const;

const endorsementRows = [
  tweets.filter((_, index) => index % 2 === 0),
  tweets.filter((_, index) => index % 2 === 1),
];
---

<Layout
  title="T3 Code — Version 2"
  description="One open control plane for the coding agents you already pay for."
  pageClass="marketing-home marketing-home-v2"
  favicon={stableAppIcon}
  homeVersion="v2"
>
  <section class="v2-hero">
    <div class="v2-shell">
      <header class="v2-hero-card">
        <div class="v2-hero-message">
          <h1>Bring the agents.<br />Keep the control.</h1>
          <p class="v2-lede">
            Run Claude, Cursor, Codex, Grok, and OpenCode in one fast workspace—using the
            subscriptions you already have.
          </p>
        </div>
        <div class="v2-actions">
          <div class="v2-download-row">
            <a class="btn btn-primary btn-lg" href="/download" data-v2-download>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="M16.67 13.71c.02 2.25 1.97 3 1.99 3.01-.02.05-.31 1.07-1.03 2.12-.62.91-1.28 1.82-2.31 1.84-1 .02-1.32-.6-2.47-.6-1.16 0-1.51.58-2.46.62-1 .04-1.75-.99-2.38-1.9-1.29-1.86-2.27-5.25-.95-7.54a3.69 3.69 0 0 1 3.13-1.9c.98-.02 1.9.66 2.48.66.57 0 1.65-.82 2.79-.7.47.02 1.8.19 2.65 1.44-.07.04-1.59.93-1.57 2.95ZM14.72 8.1c.52-.63.87-1.51.77-2.39-.75.03-1.66.5-2.2 1.13-.48.55-.9 1.45-.79 2.31.84.07 1.7-.43 2.22-1.05Z" />
              </svg>
              <span data-v2-download-label>Download for macOS</span>
            </a>
            <div class="v2-channel-picker">
              <button type="button" aria-haspopup="true" aria-expanded="false" data-v2-channel-trigger>
                <span data-v2-channel-label>Latest</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
              <div class="v2-channel-menu" hidden data-v2-channel-menu>
                <button type="button" data-stage="latest" data-active="true">Latest</button>
                <button type="button" data-stage="nightly">Nightly</button>
                <button type="button" data-stage="dev">Dev</button>
              </div>
            </div>
          </div>
          <a class="btn btn-ghost" href="https://github.com/pingdotgg/t3code">View source</a>
        </div>
      </header>
    </div>
  </section>

  <section class="v2-system" aria-labelledby="v2-system-title">
    <div class="v2-shell">
      <div class="v2-section-heading">
        <h2 id="v2-system-title">The workspace follows the work.</h2>
      </div>

      <div class="v2-system-grid">
        <article class="v2-system-copy">
          <div class="v2-surface-tabs" role="tablist" aria-label="Product surfaces">
            {surfaces.map((surface, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`v2-panel-${surface.id}`}
                id={`v2-tab-${surface.id}`}
                data-v2-surface={surface.id}
              >
                {surface.label}
              </button>
            ))}
          </div>
          <div class="v2-system-message">
            <p>Enable T3 Connect and use T3 Code from anywhere.</p>
            <code><span>$</span> npx t3</code>
          </div>
        </article>

        <div class="v2-surface-panels">
          {surfaces.map((surface, index) => (
            <div
              class:list={["v2-surface-panel", index === 0 && "is-active"]}
              id={`v2-panel-${surface.id}`}
              role="tabpanel"
              aria-labelledby={`v2-tab-${surface.id}`}
              data-v2-panel={surface.id}
              hidden={index !== 0}
            >
              {surface.id === "desk" ? (
                <iframe
                  src="/sidebar-demo/demo.html"
                  title="Interactive T3 Code desktop demo"
                  loading="lazy"
                  allow="clipboard-write"
                />
              ) : (
                <img src={surface.image} alt={`T3 Code ${surface.label.toLowerCase()} view`} loading="lazy" />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="v2-connect" aria-labelledby="v2-connect-title">
    <div class="v2-shell v2-connect-grid">
      <header>
        <h2 id="v2-connect-title"><span>T3</span> Connect</h2>
        <p>Pair once. Control the same live threads from the web, iPhone, iPad, or Android.</p>
        <code>npx t3 pair</code>
        <div class="v2-store-links">
          <a href={IOS_APP_STORE_URL} target="_blank" rel="noreferrer">
            <img src="/store-logos/appstore.svg" alt="" width="20" height="20" />App Store
          </a>
          <a href={GOOGLE_PLAY_STORE_URL} target="_blank" rel="noreferrer">
            <img src="/store-logos/googleplay.svg" alt="" width="20" height="20" />Google Play
          </a>
        </div>
      </header>
      <div class="v2-connect-visual" aria-hidden="true">
        <div class="v2-connect-desktop">
          <img src="/demo-states/review-diff-crop.png" alt="" loading="lazy" />
        </div>
        <div class="v2-connect-phone">
          <img src="/mobile-states/ios-review.png" alt="" loading="lazy" />
        </div>
        <span class="v2-connect-line"></span>
        <span class="v2-connect-badge">connected</span>
      </div>
    </div>
  </section>

  <section class="v2-endorsements" aria-labelledby="v2-endorsements-title">
    <div class="v2-shell v2-endorsements-heading">
      <h2 id="v2-endorsements-title">
        Tolerated by over <strong>{MARKETING_STATS.users}</strong> devs
      </h2>
    </div>
    <div class="v2-shell v2-endorsement-carousel" aria-label="Developer endorsements">
      {endorsementRows.map((row, rowIndex) => (
        <div class:list={["v2-endorsement-row", rowIndex === 1 && "is-reverse"]}>
          <div class="v2-endorsement-track">
            {[0, 1].map((groupIndex) => (
              <div class="v2-endorsement-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                {row.map((tweet) => (
                  <a
                    class="v2-endorsement-card"
                    href={tweet.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Read ${tweet.handle}'s post on X`}
                    tabindex={groupIndex === 1 ? "-1" : undefined}
                  >
                    <div>
                      <img
                        src={`/pfps/${tweet.handle}.webp`}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>@{tweet.handle}</span>
                    </div>
                    <p>{tweet.excerpt ?? tweet.content}</p>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    type Stage = "latest" | "nightly" | "dev";

    const stageNames: Record<Stage, string> = {
      latest: "Latest",
      nightly: "Nightly",
      dev: "Dev",
    };
    const downloadButton = document.querySelector<HTMLAnchorElement>("[data-v2-download]");
    const downloadLabel = document.querySelector<HTMLElement>("[data-v2-download-label]");
    const channelTrigger = document.querySelector<HTMLButtonElement>("[data-v2-channel-trigger]");
    const channelLabel = document.querySelector<HTMLElement>("[data-v2-channel-label]");
    const channelMenu = document.querySelector<HTMLElement>("[data-v2-channel-menu]");
    const channelOptions = channelMenu?.querySelectorAll<HTMLButtonElement>("button[data-stage]") ?? [];

    const isStage = (value: unknown): value is Stage =>
      value === "latest" || value === "nightly" || value === "dev";
    const platformLabel = /Win/i.test(navigator.userAgent)
      ? "Download for Windows"
      : /Linux/i.test(navigator.userAgent)
        ? "Download for Linux"
        : "Download for macOS";
    const initialStage = document.documentElement.dataset.stage;
    let selectedStage: Stage = isStage(initialStage) ? initialStage : "latest";

    const applyDownloadStage = (stage: Stage) => {
      selectedStage = stage;
      if (channelLabel) channelLabel.textContent = stageNames[stage];
      if (downloadLabel) downloadLabel.textContent = stage === "dev" ? "Copy repo link" : platformLabel;
      if (downloadButton) downloadButton.href = stage === "dev" ? "#" : "/download";
      for (const option of channelOptions) {
        option.dataset.active = String(option.dataset.stage === stage);
      }
    };

    const setChannelOpen = (open: boolean) => {
      if (!channelMenu || !channelTrigger) return;
      channelMenu.hidden = !open;
      channelTrigger.setAttribute("aria-expanded", String(open));
    };

    channelTrigger?.addEventListener("click", () =>
      setChannelOpen(channelMenu?.hasAttribute("hidden") ?? false),
    );
    for (const option of channelOptions) {
      option.addEventListener("click", () => {
        const stage = option.dataset.stage;
        if (!isStage(stage)) return;
        document.dispatchEvent(new CustomEvent("t3-marketing-stage-request", { detail: { stage } }));
        applyDownloadStage(stage);
        setChannelOpen(false);
      });
    }
    document.addEventListener("click", (event) => {
      if (
        channelMenu &&
        channelTrigger &&
        !channelMenu.hidden &&
        event.target instanceof Node &&
        !channelMenu.contains(event.target) &&
        !channelTrigger.contains(event.target)
      ) {
        setChannelOpen(false);
      }
    });
    document.addEventListener("t3-marketing-stage-change", (event) => {
      const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
      if (isStage(stage)) applyDownloadStage(stage);
    });
    downloadButton?.addEventListener("click", async (event) => {
      if (selectedStage !== "dev") return;
      event.preventDefault();
      const command = "git clone https://github.com/pingdotgg/t3code.git";
      try {
        await navigator.clipboard.writeText(command);
        if (downloadLabel) downloadLabel.textContent = "Copied. Go build.";
        window.setTimeout(() => {
          if (selectedStage === "dev" && downloadLabel) downloadLabel.textContent = "Copy repo link";
        }, 1600);
      } catch {
        window.prompt("Copy this command:", command);
      }
    });
    applyDownloadStage(selectedStage);

    const surfaceTabs = document.querySelectorAll<HTMLButtonElement>("[data-v2-surface]");
    const surfacePanels = document.querySelectorAll<HTMLElement>("[data-v2-panel]");

    for (const tab of surfaceTabs) {
      tab.addEventListener("click", () => {
        const next = tab.dataset.v2Surface;
        for (const item of surfaceTabs) {
          item.setAttribute("aria-selected", String(item === tab));
        }
        for (const panel of surfacePanels) {
          const active = panel.dataset.v2Panel === next;
          panel.hidden = !active;
          panel.classList.toggle("is-active", active);
        }
      });
    }
  </script>
</Layout>

<style>
  :global(.marketing-home-v2) {
    background: #030303;
  }

  .v2-shell {
    width: min(100% - 48px, 1240px);
    margin-inline: auto;
  }

  .v2-hero {
    padding: 150px 0 96px;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .v2-hero-card {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 610px;
    border: 1px solid var(--border-strong);
    background: #070708;
  }

  .v2-hero-card h1,
  .v2-section-heading h2,
  .v2-connect h2 {
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .v2-hero-message {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(290px, 0.65fr);
  }

  .v2-hero-card h1 {
    align-self: end;
    padding: 58px 42px;
    font-size: clamp(64px, 7.6vw, 112px);
  }

  .v2-lede {
    display: flex;
    align-items: flex-end;
    padding: 58px 36px;
    border-left: 1px solid var(--border);
    color: #8f8f98;
    font-size: 16px;
    line-height: 1.6;
  }

  .v2-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 22px 24px;
    border-top: 1px solid var(--border);
  }

  .v2-download-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .v2-download-row .btn-primary svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  .v2-channel-picker {
    position: relative;
  }

  .v2-channel-picker > button {
    height: 51px;
    min-width: 94px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 15px;
    border: 0;
    border-radius: 10px;
    color: #aaaab2;
    background: rgba(0, 0, 0, 0.05);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12);
    font-size: 13px;
    font-weight: 500;
    backdrop-filter: blur(18px);
  }

  .v2-channel-picker > button svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .v2-channel-menu {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    z-index: 10;
    min-width: 112px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: rgba(8, 8, 10, 0.96);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(18px);
  }

  .v2-channel-menu button {
    width: 100%;
    padding: 7px 9px;
    border-radius: 6px;
    color: #777780;
    font-size: 12px;
    text-align: left;
  }

  .v2-channel-menu button:hover,
  .v2-channel-menu button[data-active="true"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }

  .v2-system,
  .v2-connect {
    padding: 150px 0;
    border-bottom: 1px solid var(--border);
  }

  .v2-section-heading {
    margin-bottom: 70px;
  }

  .v2-section-heading h2 {
    max-width: 820px;
    font-size: clamp(46px, 6vw, 88px);
  }

  .v2-system-grid {
    display: grid;
    grid-template-columns: 0.66fr 1.34fr;
    min-height: 640px;
    border: 1px solid var(--border);
  }

  .v2-system-copy {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
  }

  .v2-surface-tabs {
    display: grid;
  }

  .v2-surface-tabs button {
    min-height: 72px;
    padding: 0 28px;
    border-bottom: 1px solid var(--border);
    color: #66666f;
    text-align: left;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .v2-surface-tabs button:hover,
  .v2-surface-tabs button[aria-selected="true"] {
    color: #fff;
    background: #0c0c0e;
  }

  .v2-surface-tabs button[data-v2-surface="tablet"] {
    font-weight: 600;
  }

  .v2-system-message {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 30px;
    padding: 34px 28px;
  }

  .v2-system-message p {
    max-width: 390px;
    color: #8c8c95;
    font-size: 16px;
    line-height: 1.6;
  }

  .v2-system-message code,
  .v2-connect header > code {
    width: fit-content;
    padding: 10px 13px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    color: #d8d8dc;
    background: #0a0a0c;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .v2-system-message code span {
    color: #66666e;
  }

  .v2-surface-panels {
    position: relative;
    min-width: 0;
    background: #08080a;
    overflow: hidden;
  }

  .v2-surface-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 14px;
  }

  .v2-surface-panel[hidden] {
    display: none;
  }

  .v2-surface-panel iframe {
    width: 100%;
    height: 100%;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: #09090b;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.6);
  }

  .v2-surface-panel img {
    max-width: 100%;
    max-height: 530px;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.6);
  }

  .v2-surface-panel[data-v2-panel="phone"] img {
    max-width: 285px;
    max-height: 530px;
  }

  .v2-surface-panel[data-v2-panel="tablet"] img {
    max-width: 84%;
    max-height: 510px;
  }

  .v2-connect-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    align-items: center;
    gap: 80px;
    min-height: 650px;
  }

  .v2-connect h2 {
    font-size: clamp(62px, 8vw, 124px);
  }

  .v2-connect h2 span {
    font-weight: 700;
  }

  .v2-connect header > p {
    max-width: 480px;
    margin: 28px 0;
    color: #898991;
    font-size: 17px;
    line-height: 1.6;
  }

  .v2-store-links {
    display: flex;
    gap: 22px;
    margin-top: 30px;
  }

  .v2-store-links a {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #777780;
    font-size: 13px;
    transition: color 0.18s ease;
  }

  .v2-store-links a:hover {
    color: #fff;
  }

  .v2-connect-visual {
    position: relative;
    min-height: 590px;
  }

  .v2-connect-desktop {
    position: absolute;
    top: 0;
    right: 0;
    width: 88%;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    overflow: hidden;
  }

  .v2-connect-phone {
    position: absolute;
    right: 4%;
    bottom: 0;
    width: 25%;
    padding: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 28px;
    background: #08080a;
    transform: rotate(3deg);
  }

  .v2-connect-desktop img,
  .v2-connect-phone img {
    width: 100%;
  }

  .v2-connect-phone img {
    border-radius: 20px;
  }

  .v2-connect-line {
    position: absolute;
    right: 25%;
    bottom: 21%;
    width: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #7f6cff);
    transform: rotate(-13deg);
    transform-origin: right;
  }

  .v2-connect-badge {
    position: absolute;
    right: 27%;
    bottom: 25%;
    padding: 7px 10px;
    border: 1px solid rgba(126, 111, 255, 0.35);
    border-radius: 999px;
    color: #a89cff;
    background: #0b0a10;
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .v2-endorsements {
    padding: 150px 0;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .v2-endorsements-heading {
    margin-bottom: 56px;
  }

  .v2-endorsements-heading h2 {
    max-width: 720px;
    font-size: clamp(38px, 4vw, 58px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .v2-endorsements-heading strong {
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .v2-endorsement-carousel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .v2-endorsement-carousel::before,
  .v2-endorsement-carousel::after {
    content: "";
    position: absolute;
    inset-block: 0;
    z-index: 2;
    width: 56px;
    pointer-events: none;
  }

  .v2-endorsement-carousel::before {
    left: 0;
    background: linear-gradient(90deg, #030303, transparent);
  }

  .v2-endorsement-carousel::after {
    right: 0;
    background: linear-gradient(270deg, #030303, transparent);
  }

  .v2-endorsement-row {
    overflow: hidden;
  }

  .v2-endorsement-track {
    display: flex;
    width: max-content;
    animation: v2EndorsementMarquee 76s linear infinite;
    will-change: transform;
  }

  .v2-endorsement-row.is-reverse .v2-endorsement-track {
    animation-direction: reverse;
    animation-duration: 84s;
  }

  .v2-endorsement-carousel:hover .v2-endorsement-track,
  .v2-endorsement-carousel:focus-within .v2-endorsement-track {
    animation-play-state: paused;
  }

  .v2-endorsement-group {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }

  .v2-endorsement-card {
    display: flex;
    width: clamp(264px, 22vw, 308px);
    height: 132px;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.012);
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .v2-endorsement-card:hover {
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .v2-endorsement-card > div {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 8px;
  }

  .v2-endorsement-card img {
    width: 28px;
    height: 28px;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
  }

  .v2-endorsement-card span {
    overflow: hidden;
    color: #85858d;
    font-size: 13px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .v2-endorsement-card p {
    display: -webkit-box;
    overflow: hidden;
    color: #d7d7dc;
    font-size: 14px;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @keyframes v2EndorsementMarquee {
    to {
      transform: translateX(-50%);
    }
