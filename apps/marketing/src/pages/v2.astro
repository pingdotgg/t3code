---
import stableAppIcon from "../assets/t3-latest-384.webp?url";
import Layout from "../layouts/Layout.astro";
import {
  GOOGLE_PLAY_STORE_URL,
  IOS_APP_STORE_URL,
  MARKETING_STATS,
} from "../lib/site";
import { tweets } from "../lib/tweets";

const surfaces = [
  { id: "desk", label: "at your desk", image: null },
  { id: "phone", label: "from your phone", image: "/mobile-states/ios-thread.png" },
  { id: "tablet", label: "on your tablet too", image: "/mobile-states/ipad-threads.png" },
] as const;

const heroRotatorProviders = [
  { name: "Claude", icon: "/harnesses/claude-ai-icon.svg", accent: "#d97757" },
  { name: "Cursor", icon: "/harnesses/cursor_light.svg", accent: "#e4e4e7" },
  { name: "Codex", icon: "/harnesses/openai_dark.svg", accent: "#21b791" },
  { name: "Grok", icon: "/harnesses/grok-dark.svg", accent: "#ffffff" },
] as const;

const endorsementRows = [
  tweets.filter((_, index) => index % 2 === 0),
  tweets.filter((_, index) => index % 2 === 1),
];
---

<Layout
  title="T3 Code"
  description="One open control plane for the coding agents you already pay for."
  pageClass="marketing-home marketing-home-v2"
  favicon={stableAppIcon}
>
  <section class="v2-hero">
    <div class="v2-shell">
      <header class="v2-hero-card">
        <div class="v2-hero-primary">
          <h1 aria-label="Bring your Claude, Cursor, Codex, or Grok. Rest is on us.">
            <span class="v2-hero-provider-line">
              <span>Bring your</span>
              <span class="v2-hero-rotator" aria-hidden="true">
                {heroRotatorProviders.map((provider, providerIndex) => (
                  <span
                    class="v2-hero-rotator-item"
                    style={`--rotator-index: ${providerIndex}; --rotator-accent: ${provider.accent}; --rotator-icon: url("${provider.icon}")`}
                  >
                    <i aria-hidden="true" />
                    <span>{provider.name}</span>
                  </span>
                ))}
              </span>
            </span>
            <span>Rest is on us.</span>
          </h1>
          <p class="v2-hero-description">
            We don't sell subs. You bring your own subs and use it in the best AI coding experience
            there is.
          </p>
          <div class="v2-actions">
            <div class="v2-download-row">
              <div class="v2-download-button-wrap">
                <iframe
                  class="v2-download-art"
                  aria-hidden="true"
                  tabindex="-1"
                  title=""
                  hidden
                  data-v2-download-art
                ></iframe>
                <a class="btn btn-primary btn-lg" href="/download" data-v2-download>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d="M16.67 13.71c.02 2.25 1.97 3 1.99 3.01-.02.05-.31 1.07-1.03 2.12-.62.91-1.28 1.82-2.31 1.84-1 .02-1.32-.6-2.47-.6-1.16 0-1.51.58-2.46.62-1 .04-1.75-.99-2.38-1.9-1.29-1.86-2.27-5.25-.95-7.54a3.69 3.69 0 0 1 3.13-1.9c.98-.02 1.9.66 2.48.66.57 0 1.65-.82 2.79-.7.47.02 1.8.19 2.65 1.44-.07.04-1.59.93-1.57 2.95ZM14.72 8.1c.52-.63.87-1.51.77-2.39-.75.03-1.66.5-2.2 1.13-.48.55-.9 1.45-.79 2.31.84.07 1.7-.43 2.22-1.05Z" />
                  </svg>
                  <span data-v2-download-label>Download for macOS</span>
                </a>
              </div>
              <div class="v2-channel-picker">
                <button type="button" aria-haspopup="true" aria-expanded="false" data-v2-channel-trigger>
                  <span data-v2-channel-label>Latest</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <div class="v2-channel-menu" hidden data-v2-channel-menu>
                  <button type="button" data-stage="latest" data-active="true">Latest</button>
                  <button type="button" data-stage="nightly">Nightly</button>
                  <button type="button" data-stage="dev">Dev</button>
                </div>
              </div>
            </div>
            <div class="v2-store-links">
              <a href={IOS_APP_STORE_URL} target="_blank" rel="noreferrer">
                <img src="/store-logos/appstore.svg" alt="" width="20" height="20" />App Store
              </a>
              <a href={GOOGLE_PLAY_STORE_URL} target="_blank" rel="noreferrer">
                <img src="/store-logos/googleplay.svg" alt="" width="20" height="20" />Google Play
              </a>
            </div>
          </div>
        </div>

        <div class="v2-model-lab">
          <div class="v2-model-panel">
            <iframe
              src="/sidebar-demo/model-picker.html"
              title="Interactive T3 Code model picker"
              loading="eager"
            />
          </div>
        </div>
      </header>
    </div>
  </section>

  <section class="v2-system" aria-labelledby="v2-system-title">
    <div class="v2-shell">
      <div class="v2-section-heading">
        <h2 id="v2-system-title">Use it anywhere</h2>
      </div>

      <div class="v2-system-grid">
        <article class="v2-system-copy">
          <div class="v2-surface-tabs" role="tablist" aria-label="Product surfaces">
            {surfaces.map((surface, index) => (
              <button
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`v2-panel-${surface.id}`}
                id={`v2-tab-${surface.id}`}
                data-v2-surface={surface.id}
              >
                {surface.label}
              </button>
            ))}
          </div>
          <div class="v2-system-message">
            <p>Enable T3 Connect and use T3 Code from anywhere.</p>
            <code><span>$</span> npx t3 pair</code>
          </div>
        </article>

        <div class="v2-surface-panels">
          {surfaces.map((surface, index) => (
            <div
              class:list={["v2-surface-panel", index === 0 && "is-active"]}
              id={`v2-panel-${surface.id}`}
              role="tabpanel"
              aria-labelledby={`v2-tab-${surface.id}`}
              data-v2-panel={surface.id}
              hidden={index !== 0}
            >
              {surface.id === "desk" ? (
                <iframe
                  src="/sidebar-demo/demo.html"
                  title="Interactive T3 Code desktop demo"
                  loading="lazy"
                  allow="clipboard-write"
                />
              ) : (
                <>
                  {surface.id === "phone" ? (
                    <div class="v2-phone-pair">
                      <a
                        class="v2-phone-device"
                        href={IOS_APP_STORE_URL}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="Get T3 Code on the App Store"
                      >
                        <img
                          src="/mobile-states/ios-review.png"
                          alt="Reviewing changes in T3 Code on iPhone"
                          loading="lazy"
                        />
                        <span class="v2-device-store-link">
                          <img src="/store-logos/appstore.svg" alt="" width="18" height="18" />
                          Get it on App Store <span aria-hidden="true">↗</span>
                        </span>
                      </a>
                      <a
                        class="v2-phone-device"
                        href={GOOGLE_PLAY_STORE_URL}
                        target="_blank"
                        rel="noreferrer"
                        aria-label="Get T3 Code on Google Play"
                      >
                        <img
                          src="/mobile-states/android-review.png"
                          alt="Reviewing changes in T3 Code on Android"
                          loading="lazy"
                        />
                        <span class="v2-device-store-link">
                          <img src="/store-logos/googleplay.svg" alt="" width="18" height="18" />
                          Get it on Google Play <span aria-hidden="true">↗</span>
                        </span>
                      </a>
                    </div>
                  ) : (
                    <img
                      src={surface.image}
                      alt={`T3 Code ${surface.label.toLowerCase()} view`}
                      loading="lazy"
                    />
                  )}
                  {surface.id === "tablet" && (
                    <a
                      class="v2-surface-store-link"
                      href={IOS_APP_STORE_URL}
                      target="_blank"
                      rel="noreferrer"
                    >
                      Open iPad app <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="v2-connect" aria-labelledby="v2-connect-title">
    <div class="v2-shell v2-connect-grid">
      <header>
        <h2 id="v2-connect-title" aria-label="T3 Connect">
          <svg viewBox="15.5309 37 94.3941 56.96" aria-hidden="true">
            <path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z" />
          </svg>
          <span>Connect</span>
        </h2>
        <p>Pair once. Control the same live threads from the web, iPhone, iPad, or Android.</p>
        <code>npx t3 pair</code>
      </header>
      <div class="v2-connect-visual">
        <div class="v2-connect-screens">
          <div class="v2-connect-desktop">
            <iframe
              src="/sidebar-demo/demo.html#/demo-mac-studio/thread-connect"
              title="The same T3 Code thread on desktop"
              loading="lazy"
              allow="clipboard-write"
            ></iframe>
          </div>
          <div class="v2-connect-phone">
            <img
              src="/mobile-states/ios-thread.png"
              alt="The same T3 Code thread on iPhone"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="v2-endorsements" aria-labelledby="v2-endorsements-title">
    <div class="v2-shell v2-endorsements-heading">
      <h2 id="v2-endorsements-title">
        Tolerated by over <strong>{MARKETING_STATS.users}</strong> devs
      </h2>
    </div>
    <div class="v2-shell v2-endorsement-carousel" aria-label="Developer endorsements">
      {endorsementRows.map((row, rowIndex) => (
        <div class:list={["v2-endorsement-row", rowIndex === 1 && "is-reverse"]}>
          <div class="v2-endorsement-track">
            {[0, 1].map((groupIndex) => (
              <div class="v2-endorsement-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                {row.map((tweet) => (
                  <a
                    class="v2-endorsement-card"
                    href={tweet.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Read ${tweet.handle}'s post on X`}
                    tabindex={groupIndex === 1 ? "-1" : undefined}
                  >
                    <div>
                      <img
                        src={`/pfps/${tweet.handle}.webp`}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>@{tweet.handle}</span>
                    </div>
                    <p>{tweet.excerpt ?? tweet.content}</p>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    type Stage = "latest" | "nightly" | "dev";

    const stageNames: Record<Stage, string> = {
      latest: "Latest",
      nightly: "Nightly",
      dev: "Dev",
    };
    const downloadButton = document.querySelector<HTMLAnchorElement>("[data-v2-download]");
    const downloadArt = document.querySelector<HTMLIFrameElement>("[data-v2-download-art]");
    const downloadLabel = document.querySelector<HTMLElement>("[data-v2-download-label]");
    const channelTrigger = document.querySelector<HTMLButtonElement>("[data-v2-channel-trigger]");
    const channelLabel = document.querySelector<HTMLElement>("[data-v2-channel-label]");
    const channelMenu = document.querySelector<HTMLElement>("[data-v2-channel-menu]");
    const channelOptions = channelMenu?.querySelectorAll<HTMLButtonElement>("button[data-stage]") ?? [];

    const isStage = (value: unknown): value is Stage =>
      value === "latest" || value === "nightly" || value === "dev";
    const platformLabel = /Win/i.test(navigator.userAgent)
      ? "Download for Windows"
      : /Linux/i.test(navigator.userAgent)
        ? "Download for Linux"
        : "Download for macOS";
    const initialStage = document.documentElement.dataset.stage;
    let selectedStage: Stage = isStage(initialStage) ? initialStage : "latest";

    const applyDownloadStage = (stage: Stage) => {
      selectedStage = stage;
      if (channelLabel) channelLabel.textContent = stageNames[stage];
      if (downloadLabel) downloadLabel.textContent = stage === "dev" ? "Copy repo link" : platformLabel;
      if (downloadButton) downloadButton.href = stage === "dev" ? "#" : "/download";
      if (downloadArt) {
        downloadArt.hidden = stage === "latest";
        if (stage !== "latest") {
          const nextSource = `/sidebar-demo/stage-art.html?variant=${stage}`;
          if (!downloadArt.src.endsWith(nextSource)) downloadArt.src = nextSource;
        }
      }
      for (const option of channelOptions) {
        option.dataset.active = String(option.dataset.stage === stage);
      }
    };

    const setChannelOpen = (open: boolean) => {
      if (!channelMenu || !channelTrigger) return;
      channelMenu.hidden = !open;
      channelTrigger.setAttribute("aria-expanded", String(open));
    };

    channelTrigger?.addEventListener("click", () =>
      setChannelOpen(channelMenu?.hasAttribute("hidden") ?? false),
    );
    for (const option of channelOptions) {
      option.addEventListener("click", () => {
        const stage = option.dataset.stage;
        if (!isStage(stage)) return;
        document.dispatchEvent(new CustomEvent("t3-marketing-stage-request", { detail: { stage } }));
        applyDownloadStage(stage);
        setChannelOpen(false);
      });
    }
    document.addEventListener("click", (event) => {
      if (
        channelMenu &&
        channelTrigger &&
        !channelMenu.hidden &&
        event.target instanceof Node &&
        !channelMenu.contains(event.target) &&
        !channelTrigger.contains(event.target)
      ) {
        setChannelOpen(false);
      }
    });
    document.addEventListener("t3-marketing-stage-change", (event) => {
      const stage = (event as CustomEvent<{ stage?: unknown }>).detail?.stage;
      if (isStage(stage)) applyDownloadStage(stage);
    });
    downloadButton?.addEventListener("click", async (event) => {
      if (selectedStage !== "dev") return;
      event.preventDefault();
      const command = "git clone https://github.com/pingdotgg/t3code.git";
      try {
        await navigator.clipboard.writeText(command);
        if (downloadLabel) downloadLabel.textContent = "Copied. Go build.";
        window.setTimeout(() => {
          if (selectedStage === "dev" && downloadLabel) downloadLabel.textContent = "Copy repo link";
        }, 1600);
      } catch {
        window.prompt("Copy this command:", command);
      }
    });
    applyDownloadStage(selectedStage);

    const surfaceTabs = document.querySelectorAll<HTMLButtonElement>("[data-v2-surface]");
    const surfacePanels = document.querySelectorAll<HTMLElement>("[data-v2-panel]");

    for (const tab of surfaceTabs) {
      tab.addEventListener("click", () => {
        const next = tab.dataset.v2Surface;
        for (const item of surfaceTabs) {
          item.setAttribute("aria-selected", String(item === tab));
        }
        for (const panel of surfacePanels) {
          const active = panel.dataset.v2Panel === next;
          panel.hidden = !active;
          panel.classList.toggle("is-active", active);
        }
      });
    }
  </script>
</Layout>

<style>
  :global(.marketing-home-v2) {
    background: #030303;
  }

  .v2-shell {
    width: min(100% - 48px, 1240px);
    margin-inline: auto;
  }

  .v2-hero {
    padding: 110px 0 54px;
    overflow: hidden;
  }

  .v2-hero-card {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
    min-height: clamp(460px, 58svh, 560px);
  }

  .v2-section-heading h2,
  .v2-connect h2 {
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .v2-hero-primary {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 64px 0;
  }

  .v2-hero-card h1 {
    max-width: 760px;
    font-size: clamp(52px, 5.25vw, 76px);
    font-weight: 500;
    letter-spacing: -0.047em;
    line-height: 0.98;
  }

  .v2-hero-card h1 > span {
    display: block;
  }

  .v2-hero-description {
    max-width: 560px;
    margin-top: 24px;
    color: #8c8c95;
    font-size: 16px;
    line-height: 1.55;
  }

  .v2-hero-provider-line {
    display: flex !important;
    align-items: baseline;
    gap: 0.18em;
    white-space: nowrap;
  }

  .v2-hero-rotator {
    display: inline-grid !important;
    width: 4.15em;
    height: 1.08em;
    align-items: baseline;
    overflow: hidden;
  }

  .v2-hero-rotator-item {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    color: var(--rotator-accent, currentColor);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(105%);
    animation: v2HeroRotator 12s calc((var(--rotator-index) * 3s) - 0.48s) infinite both;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .v2-hero-rotator-item i {
    width: 0.74em;
    height: 0.74em;
    flex: 0 0 auto;
    background: currentColor;
    mask: var(--rotator-icon) center / contain no-repeat;
    -webkit-mask: var(--rotator-icon) center / contain no-repeat;
    transform: translateY(0.04em);
  }

  @keyframes v2HeroRotator {
    0% {
      opacity: 0;
      transform: translateY(105%);
    }

    4%,
    25% {
      opacity: 1;
      transform: translateY(0);
    }

    29%,
    100% {
      opacity: 0;
      transform: translateY(-105%);
    }
  }

  .v2-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 28px;
  }

  .v2-download-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .v2-download-button-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
  }

  .v2-download-button-wrap .btn-primary {
    position: relative;
    z-index: 1;
    min-height: 56px;
    padding-inline: 22px;
    font-size: 15px;
  }

  .v2-download-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  .v2-download-art[hidden] {
    display: none;
  }

  .v2-download-row .btn-primary svg {
    width: 16px;
    height: 16px;
    flex: 0 0 auto;
  }

  :global(html[data-stage="nightly"]) .v2-download-row .btn-primary {
    color: #fff;
    background: rgba(42, 27, 89, 0.28);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.22), 0 12px 34px rgba(81, 53, 168, 0.24);
  }

  :global(html[data-stage="nightly"]) .v2-download-row .btn-primary:hover {
    background: rgba(70, 43, 139, 0.24);
  }

  :global(html[data-stage="dev"]) .v2-download-row .btn-primary {
    color: #fff;
    background: rgba(16, 68, 155, 0.25);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.18), 0 12px 34px rgba(37, 86, 189, 0.24);
  }

  :global(html[data-stage="dev"]) .v2-download-row .btn-primary:hover {
    background: rgba(26, 82, 181, 0.2);
  }

  .v2-channel-picker {
    position: relative;
  }

  .v2-channel-picker > button {
    height: 56px;
    min-width: 100px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 15px;
    border: 0;
    border-radius: 10px;
    color: #aaaab2;
    background: rgba(0, 0, 0, 0.05);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12);
    font-size: 14px;
    font-weight: 500;
    backdrop-filter: blur(18px);
  }

  .v2-channel-picker > button svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .v2-channel-menu {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    z-index: 10;
    min-width: 112px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: rgba(8, 8, 10, 0.96);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(18px);
  }

  .v2-channel-menu button {
    width: 100%;
    padding: 7px 9px;
    border-radius: 6px;
    color: #777780;
    font-size: 12px;
    text-align: left;
  }

  .v2-channel-menu button:hover,
  .v2-channel-menu button[data-active="true"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }

  .v2-model-lab {
    position: relative;
    display: grid;
    min-width: 0;
    padding: 24px 0 24px 28px;
    overflow: hidden;
  }

  .v2-model-panel {
    display: grid;
    min-height: 0;
    place-items: center;
  }

  .v2-model-panel iframe {
    width: 100%;
    height: 100%;
    max-height: 390px;
    border: 0;
    background: transparent;
    transform: none;
  }

  .v2-system {
    padding: 150px 0;
  }

  .v2-connect {
    padding: 52px 0 48px;
  }

  .v2-section-heading {
    margin-bottom: 70px;
  }

  .v2-section-heading h2 {
    max-width: 820px;
    font-size: clamp(46px, 6vw, 88px);
  }

  .v2-system-grid {
    display: grid;
    width: 100%;
    grid-template-columns: 0.66fr 1.34fr;
    min-height: 640px;
    border: 1px solid var(--border);
  }

  .v2-system-copy {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
  }

  .v2-surface-tabs {
    display: grid;
  }

  .v2-surface-tabs button {
