---
import { getCollection, render } from "astro:content";
import LibraryPage from "../../../components/library/LibraryPage.astro";
import type { ClusterId } from "../../../lib/library";

export async function getStaticPaths() {
  const pages = await getCollection("library", (entry) => entry.id.split("/").length === 2 && !entry.id.endsWith("/index"));
  return pages.map((entry) => {
    const [cluster, slug] = entry.id.split("/");
    return { params: { cluster, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<LibraryPage cluster={Astro.params.cluster as ClusterId} slug={Astro.params.slug} data={entry.data} headings={headings}>
  <Content />
</LibraryPage>
