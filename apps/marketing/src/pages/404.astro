---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | T3 Code" description="This page does not exist on t3.codes." noindex>
  <section class="shell not-found">
    <p class="code">404</p>
    <h1 class="page-title">This page does not exist.</h1>
    <p class="page-sub">
      t3.codes is the only official T3 Code website. Download builds from this site, GitHub releases,
      or the app stores.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/download">Download T3 Code</a>
      <a class="home-link" href="/">Home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding-top: 56px;
    padding-bottom: 152px;
  }

  .code {
    color: oklch(0.72 0.13 264);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
  }

  .home-link {
    color: var(--fg-muted);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: rgba(163, 163, 163, 0.3);
    text-underline-offset: 3px;
    transition: color 0.18s ease;
  }

  .home-link:hover {
    color: var(--fg);
  }
</style>
