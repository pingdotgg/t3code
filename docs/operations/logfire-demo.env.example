# Copy to .env.local and replace the Logfire project write token.
T3CODE_OTLP_TRACES_URL=https://logfire-us.pydantic.dev/v1/traces
T3CODE_OTLP_HEADERS="Authorization=<write token>"
T3CODE_OTLP_SERVICE_NAME=t3-logfire-demo
T3CODE_OTLP_EXPORT_INTERVAL_MS=1000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
T3CODE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD=true
