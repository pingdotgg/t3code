# ==============================================================================
# KBCode White-Label Fork — Environment Configuration Example
# Copy this file to `.env` (or `.env.local`) and fill in only the sections you use.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Remote Access: Self-Hosted Relay & Clerk Auth (Optional — leave blank for
#    zero-cost `--lan` / `kbcode pair` / Tailscale direct connections)
# ------------------------------------------------------------------------------
# Public HTTPS URL of your self-hosted relay worker (aliases T3CODE_RELAY_URL)
RELAY_PUBLIC_URL=
# Optional hosted web app origin (defaults to https://app.t3.codes)
HOSTED_APP_URL=
# Clerk Free-tier keys (aliases T3CODE_CLERK_PUBLISHABLE_KEY / VITE_CLERK_PUBLISHABLE_KEY)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk JWT template name configured for relay auth (e.g. t3-relay)
CLERK_JWT_TEMPLATE=
# Public client ID of the Clerk OAuth application used by the CLI (required; cloud sign-in stays
# disabled without it). Redirect URI: http://127.0.0.1:34338/callback
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# Clerk Frontend API host used as the mobile passkey relying party. Defaults to upstream's
# clerk.t3.codes, so set it to your own instance (e.g. <slug>.clerk.accounts.dev) before building.
KBCODE_CLERK_RELYING_PARTY=
# Optional Tailscale auth key for unattended headless/sandbox tailnet joins
TAILSCALE_AUTHKEY=
# Optional bootstrap token for pre-pairing headless/sandbox KBCode servers
T3_CONNECT_BOOTSTRAP_TOKEN=

# ------------------------------------------------------------------------------
# 2. $0 iOS Build & Webhook Push Notification Fallback (ntfy.sh / Telegram)
#    Triggers on agent approval/input pauses, turn completion/failure (when no
#    client is viewing the thread), and cloud sandbox idle/ceiling alerts.
# ------------------------------------------------------------------------------
# Personal Apple ID sideloading (Xcode + SideStore/AltStore, $0/yr):
# T3CODE_IOS_PERSONAL_TEAM=1
# T3CODE_IOS_PERSONAL_TEAM_BUNDLE_ID=com.kbcode.app

# Option A: ntfy (https://ntfy.sh or self-hosted)
NTFY_TOPIC_URL=
NTFY_AUTH_TOKEN=

# Option B: Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deep-link URL scheme embedded in notifications (defaults to kbcode)
NOTIFICATION_DEEP_LINK_SCHEME=kbcode

# ------------------------------------------------------------------------------
# 3. Prime Agent (`PrimeIntellect-ai/prime-agent`) & Provider API Keys
# ------------------------------------------------------------------------------
PRIME_API_KEY=
# Recursive RLM depth (default: 2; set 0 to disable recursive rlm.spawn)
RLM_MAX_DEPTH=2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. Multi-Cloud Sandbox Orchestrator (CodeSandbox, Upstash Box, Vercel Sandbox)
# ------------------------------------------------------------------------------
# Auto-stop idle sandboxes after N minutes with zero active runs (default: 8)
SANDBOX_IDLE_TIMEOUT_MINUTES=8

# CodeSandbox SDK (`@codesandbox/sdk`)
CODESANDBOX_API_KEY=
SANDBOX_DEFAULT_SNAPSHOT_CODESANDBOX=

# Upstash Box (`@upstash/box`)
UPSTASH_BOX_API_KEY=
SANDBOX_DEFAULT_SNAPSHOT_UPSTASH=

# Vercel Sandbox (`@vercel/sandbox`) — OIDC token or explicit token + team/project
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
SANDBOX_DEFAULT_SNAPSHOT_VERCEL=
