# The SDK's platform packages each bundle a claude binary; T3 removes them too
# (pnpm-workspace.yaml overrides). The helper runs the claude found on PATH.
omit=optional
# Peer packages (@anthropic-ai/sdk, @modelcontextprotocol/sdk, zod) are not
# imported by sdk.mjs; the helper does not need them.
legacy-peer-deps=true
save-exact=true
