{
  "name": "t3mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/runtime",
    "packages/protocol"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace @t3mobile/mobile",
    "dev:runtime": "npm run start --workspace @t3mobile/runtime",
    "typecheck:runtime": "npm run typecheck --workspace @t3mobile/runtime",
    "typecheck:mobile": "npm run typecheck --workspace @t3mobile/mobile",
    "test": "npm run test --workspace @t3mobile/runtime",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "patch-package": "^8.0.1"
  }
}
