{
  "name": "@t3tools/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:marketing": "vp run --filter @t3tools/marketing dev",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "dev:stop": "node scripts/dev-runner.ts stop",
    "start": "vp run --filter t3 start",
    "start:desktop": "vp run --filter @t3tools/desktop start",
    "start:marketing": "vp run --filter @t3tools/marketing preview",
    "start:mock-update-server": "node scripts/mock-update-server.ts",
    "build": "pnpm --filter @t3tools/web build && pnpm --filter t3 build",
    "build:marketing": "vp run --filter @t3tools/marketing build",
    "build:desktop": "vp run --filter @t3tools/web --filter @t3tools/desktop build && pnpm --filter t3 build",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "tc": "vp run -r --concurrency-limit 2 typecheck",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "vp run -r test",
    "test:windows-smoke": "pnpm -r --filter=!t3 --if-present run test && pnpm --filter t3 run test:windows-smoke",
    "test:desktop-smoke": "vp run --filter @t3tools/desktop smoke-test",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis",
    "dist:desktop:win:arm64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch arm64",
    "dist:desktop:win:x64": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "install:t3:dev": "bash scripts/install-t3-dev.sh",
    "install:t3:cli": "node scripts/install-t3-cli.ts",
    "install:t3:alpha": "bash scripts/install-t3-alpha.sh",
    "install:t3:official": "bash scripts/install-t3-official.sh",
    "ios:update": "pnpm --filter @t3tools/mobile ios:update",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:cli-smoke": "node scripts/cli-package-smoke.ts",
    "release:connect-smoke": "node apps/server/integration/connect-release-smoke.ts && vp test run packages/client-runtime/src/connection/supervisor.test.ts apps/mobile/src/state/thread-outbox.test.ts apps/mobile/src/connection/environment-owned-data-cleanup.test.ts apps/mobile/src/features/settings/environmentDiscoveryPresentation.test.ts --no-file-parallelism",
    "test:direct-connect-smoke": "pnpm --filter t3 exec playwright install chromium && pnpm --filter @t3tools/web build && vp test run apps/server/integration/directConnectSmoke.integration.test.ts apps/server/integration/selfTestCapture.test.ts apps/server/integration/selfTestCapture.integration.test.ts --no-file-parallelism",
    "test:desktop-connect": "vp test run apps/server/integration/desktopConnect.integration.test.ts --no-file-parallelism",
    "test:self": "node scripts/self-test.ts",
    "pr:media": "node scripts/pr-media.ts",
    "clean": "node scripts/clean.ts",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "^1.63.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
