# Copy to .env and fill in. Nothing here is a secret except POSTGRES_PASSWORD.

# Public HTTPS origin clients use to reach the relay, served by Caddy.
RELAY_PUBLIC_ORIGIN=https://relay.example.com
# Host name Caddy serves and obtains a certificate for.
RELAY_DOMAIN=relay.example.com

# Your OpenID Connect issuer, exactly as its discovery document reports it
# (including any path prefix, without a trailing slash unless the issuer has one).
OIDC_ISSUER=https://sso.example.com/realms/t3
# The OAuth client id of the T3 Code apps. Clients send their ID token, whose `aud` is that id.
OIDC_AUDIENCE=t3-code

# Environments you expose yourself (no tunnel): "public" brokers internet-reachable HTTPS
# addresses, "private" also LAN/Tailscale addresses, "off" refuses them.
RELAY_MANUAL_ENDPOINTS=public

# Optional: carry environments with no public address through the relay itself. Each one gets
# the host this pattern names, with `*` replaced by a per-environment key. Needs wildcard DNS
# and a wildcard certificate at your proxy (see README). Leave empty to turn it off.
# RELAY_CHANNEL_HOST=t3-*.example.com

POSTGRES_PASSWORD=change-me

# Optional: host ports, when 80 and 443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
