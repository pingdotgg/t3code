{
  "name": "@alchemy.run/monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/alchemy"
  },
  "type": "module",
  "scripts": {
    "audit:service": "node scripts/audit-service.ts",
    "bench:containers": "cd benchmark/container && bun run bench",
    "build": "pnpm -r --filter \"{./packages/*}...\" run build:package && pnpm --filter ./website build && tsrs -b && bun lint:providers",
    "build:cloudflare-packages": "pnpm --filter @alchemy.run/cloudflare-test-tools build",
    "build:packages": "pnpm -r --filter \"{./packages/*}...\" run build:package",
    "build:pkg": "pnpm -r --filter alchemy... --filter @alchemy.run/better-auth... --filter @alchemy.run/git... --filter @alchemy.run/drizzle... --filter @alchemy.run/acme... --filter @alchemy.run/axiom... --filter @alchemy.run/doppler... --filter @alchemy.run/infisical... --filter @alchemy.run/turso... --filter @alchemy.run/planetscale... --filter @alchemy.run/neon... --filter @alchemy.run/prisma... --filter @alchemy.run/hetzner... --filter @alchemy.run/railway... --filter @alchemy.run/fly... --filter @alchemy.run/github... --filter @alchemy.run/stripe... --filter @alchemy.run/cloudflare... --filter @alchemy.run/gcp... --filter @alchemy.run/aws... --filter @alchemy.run/domain... --filter @alchemy.run/kubernetes... --filter @alchemy.run/docker... --filter @alchemy.run/redis... --filter @alchemy.run/sql... --filter @alchemy.run/cloudflare-runtime... --filter @alchemy.run/frontend-frameworks... --filter @alchemy.run/node-utils... --filter @alchemy.run/pkg... run build:package",
    "clean": "git clean -fqdx -e .env",
    "clean:shallow": "rm -rf alchemy/*.tgz && tsrs -b --clean",
    "clear:state": "pnpm -C stacks alchemy state unsafe nuke --config ./src/nuke.ts",
    "deploy:github": "doppler run -c prod --project alchemy-v2 -- pnpm -C stacks alchemy deploy ./src/github.ts --profile admin",
    "deploy:otel": "doppler run -c dev --project alchemy-v2 -- pnpm -C stacks alchemy deploy ./src/otel.ts",
    "deploy:otel:prod": "bun deploy:otel --profile prod --stage prod",
    "deploy:website": "cd ./website && bun run build:reference && bun alchemy deploy",
    "deploy:website:prod": "bun deploy:website --stage prod --profile prod",
    "destroy:github": "doppler run -c dev --project alchemy-v2 -- pnpm -C stacks alchemy destroy ./src/github.ts --profile admin",
    "destroy:otel": "doppler run -c dev --project alchemy-v2 -- pnpm -C stacks alchemy destroy ./src/otel.ts --profile admin",
    "destroy:otel:prod": "bun destroy:otel --profile prod --stage prod",
    "destroy:website": "cd ./website && bun alchemy destroy",
    "destroy:website:prod": "bun destroy:website --stage prod --profile prod",
    "dev": "tsrs -b -w & pnpm --filter alchemy dev",
    "dev:website": "cd ./website && bun astro dev",
    "docs:build": "pnpm --dir website docs:build",
    "docs:check-jsdoc": "node ./scripts/fix-api-jsdocs.ts --check",
    "exports:check": "node scripts/sync-exports.ts --check",
    "exports:sync": "node scripts/sync-exports.ts",
    "docs:check": "pnpm --dir website docs:check",
    "docs:fix-jsdoc": "node ./scripts/fix-api-jsdocs.ts",
    "docs:gen": "node ./scripts/generate-api-reference.ts",
    "floci:build": "docker build -t floci:dev -f submodules/floci/docker/Dockerfile submodules/floci",
    "floci:build:native": "docker build -t floci:dev -f submodules/floci/docker/Dockerfile.native submodules/floci",
    "floci:dev": "cd submodules/floci && ./mvnw quarkus:dev",
    "install:clean": "rm -rf node_modules examples/**/node_modules alchemy/node_modules && pnpm install",
    "lint:providers": "node scripts/lint-providers.ts",
    "logs:otel": "doppler run -c dev --project alchemy-v2 -- pnpm -C stacks alchemy logs ./src/otel.ts",
    "logs:otel:prod": "bun logs:otel --profile prod --stage prod",
    "nuke": "bash scripts/nuke.sh",
    "nuke:local": "bash scripts/nuke-local.sh",
    "ensure:built": "node scripts/ensure-built.ts",
    "test": "pnpm ensure:built && cd ./packages/alchemy && bun alchemy-test",
    "test:integration": "pnpm ensure:built && cd ./packages/integration-tests && bun alchemy-test",
    "tsc": "tsrs",
    "typecheck": "pnpm ensure:built && tsrs -b && pnpm -C packages/frontend-frameworks exec tsrs --noEmit -p tsconfig.test.json",
    "test:aws:floci": "node scripts/test-aws-floci.ts",
    "test:cloudflare-packages": "pnpm ensure:built && pnpm -r --filter @alchemy.run/cloudflare-runtime --filter @alchemy.run/frontend-frameworks --filter \"./packages/frontend-frameworks/fixtures/*\" run test",
    "test:cross-version": "bun run test/cross-version-test/run.ts",
    "test:dev": "cd ./examples/dev-stress && bun test",
    "test:examples": "node scripts/test-examples.ts",
    "typecheck:cloudflare-packages": "pnpm ensure:built && pnpm -r --filter @alchemy.run/cloudflare-runtime --filter @alchemy.run/frontend-frameworks run typecheck",
    "validate:publish-packages": "node scripts/validate-publish-packages.ts",
    "prepare:hooks": "husky",
    "prepare:patch": "effect-tsgo patch --oxlint --no-typescript",
    "prepare": "pnpm prepare:hooks && pnpm prepare:patch && pnpm ensure:built",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts"
  },
  "devDependencies": {
    "@alchemy.run/pkg": "workspace:*",
    "@alchemy.run/test": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rolldown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.13",
        "onFail": "warn"
      },
      {
        "name": "node",
        "version": "24",
        "onFail": "warn"
      }
    ]
  },
  "packageManager": "pnpm@12.15.0"
}
