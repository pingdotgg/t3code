{
  "name": "alchemy",
  "version": "2.0.0-beta.85",
  "description": "Infrastructure as Effects for TypeScript.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "alchemy": "./bin/cli.js"
  },
  "files": [
    "bin",
    "!bin/register-dev-mode.js",
    "lib",
    "src",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./Auth": "./src/Auth/index.ts",
    "./Alchemist": "./src/Alchemist/index.ts",
    "./Command": "./src/Command/index.ts",
    "./Bundle": "./src/Bundle/index.ts",
    "./Cli": "./src/Cli/index.ts",
    "./DNS": "./src/DNS/index.ts",
    "./Runtime/Bootstrap": "./src/Runtime/Bootstrap.ts",
    "./Runtime/ManagedHttpShutdown": "./src/Runtime/ManagedHttpShutdown.ts",
    "./Secrets": "./src/Secrets/index.ts",
    "./State": "./src/State/index.ts",
    "./Util": "./src/Util/index.ts",
    "./bin/alchemy.js": "./bin/alchemy.js",
    "./bin/exec.js": "./bin/exec.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./Auth": {
        "types": "./lib/Auth/index.d.ts",
        "bun": "./src/Auth/index.ts",
        "default": "./lib/Auth/index.js"
      },
      "./Alchemist": {
        "types": "./lib/Alchemist/index.d.ts",
        "bun": "./src/Alchemist/index.ts",
        "default": "./lib/Alchemist/index.js"
      },
      "./Command": {
        "types": "./lib/Command/index.d.ts",
        "bun": "./src/Command/index.ts",
        "default": "./lib/Command/index.js"
      },
      "./Bundle": {
        "types": "./lib/Bundle/index.d.ts",
        "bun": "./src/Bundle/index.ts",
        "default": "./lib/Bundle/index.js"
      },
      "./Cli": {
        "types": "./lib/Cli/index.d.ts",
        "bun": "./src/Cli/index.ts",
        "default": "./lib/Cli/index.js"
      },
      "./DNS": {
        "types": "./lib/DNS/index.d.ts",
        "bun": "./src/DNS/index.ts",
        "default": "./lib/DNS/index.js"
      },
      "./Runtime/Bootstrap": {
        "types": "./src/Runtime/Bootstrap.ts",
        "bun": "./src/Runtime/Bootstrap.ts",
        "default": "./src/Runtime/Bootstrap.ts"
      },
      "./Runtime/ManagedHttpShutdown": {
        "types": "./src/Runtime/ManagedHttpShutdown.ts",
        "bun": "./src/Runtime/ManagedHttpShutdown.ts",
        "default": "./src/Runtime/ManagedHttpShutdown.ts"
      },
      "./Secrets": {
        "types": "./lib/Secrets/index.d.ts",
        "bun": "./src/Secrets/index.ts",
        "default": "./lib/Secrets/index.js"
      },
      "./State": {
        "types": "./lib/State/index.d.ts",
        "bun": "./src/State/index.ts",
        "default": "./lib/State/index.js"
      },
      "./Util": {
        "types": "./lib/Util/index.d.ts",
        "bun": "./src/Util/index.ts",
        "default": "./lib/Util/index.js"
      },
      "./bin/alchemy.js": "./bin/alchemy.js",
      "./bin/exec.js": "./bin/exec.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "clear:state": "cd ../../ && bun clear:state",
    "pretest": "pnpm -w ensure:built",
    "test": "alchemy-test",
    "nuke": "cd ../../ && bun nuke"
  },
  "dependencies": {
    "@alchemy.run/node-utils": "workspace:*",
    "@alchemy.run/sigil": "catalog:",
    "capnweb": "catalog:",
    "fflate": "catalog:",
    "pathe": "catalog:",
    "picomatch": "catalog:",
    "rolldown": "catalog:",
    "tinyglobby": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@oxc-project/types": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "astro": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "next": "catalog:",
    "nuxt": "catalog:",
    "react": "catalog:",
    "react-devtools-core": "catalog:",
    "solid-js": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "wrangler": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/frontend-frameworks": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "vite": "catalog:frontend-peer",
    "ws": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/frontend-frameworks": {
      "optional": true
    },
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
