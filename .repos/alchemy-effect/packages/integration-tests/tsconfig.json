{
  "extends": "../../tsconfig.base.json",
  "include": [
    "package.json",
    "test",
    // JSON modules imported by fixtures (plain `include: ["test"]` only
    // sweeps .ts files).
    "test/Cloudflare/Workers/fixtures/prisma-orm/generated/contract.json",
    "test/Prisma/ORM/fixtures/client/generated/contract.json",
    "test/Prisma/ORM/fixtures/psl/generated/contract.json",
    "test/Prisma/ORM/fixtures/variants/generated/contract.json"
  ],
  "exclude": [
    // Prisma migration packages are self-emitting Node scripts whose
    // snapshot imports (`../../snapshots/<hash>/contract`) are extensionless
    // and only resolve under Prisma's own toolchain — not this project.
    "test/Cloudflare/Workers/fixtures/prisma-orm/migrations",
    // Executed by the prisma CLI (which resolves its own toolchain types);
    // its inferred config type is not portable from this project.
    "test/Cloudflare/Workers/fixtures/prisma-orm/prisma.config.ts",
    "test/Prisma/ORM/fixtures/client/migrations",
    "test/Prisma/ORM/fixtures/client/prisma.config.ts",
    "test/Prisma/ORM/fixtures/psl/prisma.config.ts",
    "test/Prisma/ORM/fixtures/psl/migrations",
    "test/Prisma/ORM/fixtures/variants/prisma.config.ts",
    "test/Prisma/ORM/fixtures/variants/migrations",
    // Resolves its `@playground/*` packages only once the test installs
    // them into the cloned fixture's `node_modules`.
    "test/Cloudflare/Website/vite-module-resolution-fixture",
    // The plugin's playground sources, typed against workers-types globals.
    "test/Cloudflare/Website/vite-node-compat-fixture",
    // Imports the Prisma client the test generates into the cloned fixture.
    "test/Cloudflare/Website/vite-prisma-fixture",
    // Imports the route types `react-router typegen` generates.
    "test/Cloudflare/Website/vite-react-router-fixture",
    // C3 templates, typed by their own tsconfigs and `wrangler types`.
    "test/Cloudflare/Website/vite-react-template-fixture",
    "test/Cloudflare/Website/vite-vue-template-fixture",
    "test/Cloudflare/Website/vite-tanstack-start-template-fixture",
    "test/Cloudflare/Website/vite-redwood-template-fixture",
    "test/Cloudflare/Website/vite-vike-template-fixture",
    // Nuxt fixtures: server routes use nitro's auto-imported globals, which
    // only type-check against the `.nuxt/` types a nuxt build generates.
    "test/Cloudflare/Website/fixtures/nuxt-app",
    "test/Cloudflare/Website/fixtures/nuxt-spa-app",
    // Octane fixtures use octane's JSX runtime.
    "test/Cloudflare/Website/fixtures/octane-app",
    "test/Cloudflare/Website/fixtures/octane-spa-app",
    // Nuxt fixtures: server routes use nitro's auto-imported globals
    // (`defineEventHandler`), which only type-check against the `.nuxt/`
    // types a nuxt build generates.
    "test/AWS/Website/fixtures/nuxt-app",
    // Octane fixture: `.tsx` components use octane's JSX runtime, not
    // the react-jsx runtime this package compiles with.
    "test/AWS/Website/fixtures/octane-app",
    // SolidStart fixture: `.tsx` components use solid-js's JSX runtime,
    // which conflicts with this package's default `@opentui/solid`
    // jsxImportSource.
    "test/AWS/Website/fixtures/solidstart-app",
    // TanStack Start fixture: `src/routeTree.gen.ts` is generated by the
    // router plugin at build/dev time (gitignored), so the route modules
    // have nothing to resolve until a build has run.
    "test/AWS/Website/fixtures/tanstack-start-app",
    // React Router fixture: route modules resolve their prop types from the
    // `.react-router/types` typegen output (gitignored) that a build or dev
    // run produces, and the `.tsx` files use React's JSX runtime rather than
    // this package's default `@opentui/solid` jsxImportSource.
    "test/AWS/Website/fixtures/react-router-app",
    // Foldkit mode overlays are copied over a clone of the SSR fixture;
    // their imports resolve only inside that clone.
    "test/Website/fixtures/foldkit-modes"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "outDir": "./lib",
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    // Never emits; fixture Workers import their siblings relatively so the
    // bundler resolves them without tsconfig paths.
    "rewriteRelativeImportExtensions": false
  },
  "references": [
    { "path": "../alchemy/tsconfig.json" },
    { "path": "../sql/tsconfig.json" },
    { "path": "../redis/tsconfig.json" },
    { "path": "../docker/tsconfig.json" },
    { "path": "../kubernetes/tsconfig.json" },
    { "path": "../domain/tsconfig.json" },
    { "path": "../aws/tsconfig.json" },
    { "path": "../gcp/tsconfig.json" },
    { "path": "../alchemy-test/tsconfig.json" },
    { "path": "../git/tsconfig.json" },
    { "path": "../acme/tsconfig.json" },
    { "path": "../drizzle/tsconfig.json" },
    { "path": "../axiom/tsconfig.json" },
    { "path": "../turso/tsconfig.json" },
    { "path": "../planetscale/tsconfig.json" },
    { "path": "../neon/tsconfig.json" },
    { "path": "../prisma/tsconfig.json" },
    { "path": "../hetzner/tsconfig.json" },
    { "path": "../railway/tsconfig.json" },
    { "path": "../fly/tsconfig.json" },
    { "path": "../github/tsconfig.json" },
    { "path": "../stripe/tsconfig.json" },
    { "path": "../cloudflare/tsconfig.json" }
  ]
}
