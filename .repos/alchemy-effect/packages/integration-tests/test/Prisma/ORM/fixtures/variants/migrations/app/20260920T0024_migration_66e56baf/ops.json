  {
    "id": "foreignKey.features.features_id_fkey",
    "label": "Add foreign key \"features_id_fkey\" on \"features\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "features_id_fkey",
        "table": "features"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"features_id_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": ["features_id_fkey", "public", "\"public\".\"features\""]
      }
    ],
    "execute": [
      {
        "description": "add FK \"features_id_fkey\"",
        "sql": "ALTER TABLE \"public\".\"features\"\nADD CONSTRAINT \"features_id_fkey\"\nFOREIGN KEY (\"id\")\nREFERENCES \"public\".\"tasks\" (\"id\")\nON DELETE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"features_id_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": ["features_id_fkey", "public", "\"public\".\"features\""]
      }
    ]
