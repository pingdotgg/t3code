---
import { env } from "cloudflare:workers";

// On-demand SSR: rendered inside the Worker on every request, reading a
// plain-text env binding server-side.
const marker = (env as Record<string, unknown>).TEST_MARKER ?? "no-marker";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Astro Fixture</title>
  </head>
  <body>
    <h1>Astro Fixture</h1>
    <p id="mode">on-demand</p>
    <p id="marker">{marker}</p>
    <p><a href="/about/">about</a></p>
  </body>
</html>
