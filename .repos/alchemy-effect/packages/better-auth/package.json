    "directory": "packages/better-auth"
  },
  "files": [
    "lib",
    "src",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "alchemy-test"
  },
