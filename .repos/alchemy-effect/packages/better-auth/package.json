{
  "name": "@alchemy.run/better-auth",
  "version": "2.0.0-beta.85",
  "description": "Better Auth integration for Alchemy.",
  "keywords": [
    "alchemy",
    "better-auth",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
