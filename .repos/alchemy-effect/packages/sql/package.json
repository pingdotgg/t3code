{
  "name": "@alchemy.run/sql",
  "version": "2.0.0-beta.85",
  "description": "Postgres and MySQL clients, SQL migrations, and the Postgres state store for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "migrations",
    "mysql",
    "postgres",
    "sql"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/sql"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./Migrations": "./src/Migrations/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./Migrations": {
        "types": "./lib/Migrations/index.d.ts",
        "bun": "./src/Migrations/index.ts",
        "default": "./lib/Migrations/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "devDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-libsql": "catalog:",
    "@effect/sql-mysql2": "catalog:",
    "@effect/sql-pg": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "mysql2": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/sql-libsql": {
      "optional": true
    },
    "@effect/sql-mysql2": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
