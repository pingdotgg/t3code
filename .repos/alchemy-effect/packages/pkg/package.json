{
  "name": "@alchemy.run/pkg",
  "version": "2.0.0-beta.85",
  "description": "Preview package registry for pull requests: a Cloudflare Worker verified by GitHub Actions runs, plus the pkg CLI that packs and publishes workspace packages.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "preview-packages",
    "pull-request"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/pkg"
  },
  "bin": {
    "pkg": "./src/cli/bin.ts"
  },
  "files": [
    "dist",
    "migrations",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Registry": "./src/Registry.ts",
    "./Manifest": "./src/Manifest.ts",
    "./Protocol": "./src/Protocol.ts"
  },
  "publishConfig": {
    "bin": {
      "pkg": "./dist/cli/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./dist/index.js"
      },
      "./Registry": {
        "types": "./dist/Registry.d.ts",
        "bun": "./src/Registry.ts",
        "worker": "./src/Registry.ts",
        "default": "./dist/Registry.js"
      },
      "./Manifest": {
        "types": "./dist/Manifest.d.ts",
        "bun": "./src/Manifest.ts",
        "worker": "./src/Manifest.ts",
        "default": "./dist/Manifest.js"
      },
      "./Protocol": {
        "types": "./dist/Protocol.d.ts",
        "bun": "./src/Protocol.ts",
        "worker": "./src/Protocol.ts",
        "default": "./dist/Protocol.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@distilled.cloud/github": "workspace:*",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "modern-tar": "^0.8.4"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  }
}
