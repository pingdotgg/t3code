      "path": "../alchemy/tsconfig.json"
    },
    { "path": "../redis/tsconfig.json" },
    { "path": "../docker/tsconfig.json" },
    { "path": "../kubernetes/tsconfig.json" },
    {
      "path": "../../submodules/distilled/packages/aws/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/aws4signer/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/core/tsconfig.json"
    },
    {
      "path": "../../submodules/distilled/packages/gcp/tsconfig.json"
    }
  ]
}
