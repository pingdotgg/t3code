{
  "extends": "../../tsconfig.cloudflare.json",
  "include": ["src/**/*.ts", "src/internal/workers-shared/shared/testdata/*.json"],
  "exclude": [
    "src/core/test/**",
    "src/rolldown/test/**",
    "src/**/fixtures/**",
    "src/core/scripts/**"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsconfig.tsbuildinfo",
    "outDir": ".cache/types",
    "rootDir": "src",
    "emitDeclarationOnly": true,
    "types": ["bun", "@cloudflare/workers-types/experimental", "@cloudflare/vitest-plugin/types"]
  }
}
