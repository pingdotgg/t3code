{
  "name": "@alchemy.run/cloudflare-runtime",
  "version": "2.0.0-beta.76",
  "description": "Cloudflare Workers local runtime and build plugins for Alchemy.",
  "homepage": "https://alchemy.run",
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "infrastructure-as-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/cloudflare-runtime"
  },
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && bun ../../scripts/copy-package-files.ts cloudflare-runtime",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:rolldown": "vitest run --project rolldown",
    "test:core": "vitest run --project core",
    "test:vite": "vitest run --project vite",
    "test:workers-shared": "vitest run --project 'workers-shared-*'",
    "test:workflows-shared": "vitest run --project workflows-shared",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alchemy.run/node-utils": "workspace:*",
    "@cloudflare/unenv-preset": "catalog:cloudflare-runtime",
    "@puppeteer/browsers": "catalog:cloudflare-runtime",
    "capnp-es": "catalog:cloudflare-runtime",
    "magic-string": "catalog:cloudflare-runtime",
    "sharp": "catalog:cloudflare-runtime",
    "unenv": "catalog:cloudflare-runtime",
    "workerd": "catalog:cloudflare-runtime",
    "yauzl": "catalog:cloudflare-runtime"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare-runtime",
    "@cloudflare/vitest-pool-workers": "catalog:cloudflare-runtime",
    "@effect/platform-bun": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@types/http-cache-semantics": "catalog:cloudflare-runtime",
    "@types/node": "catalog:tooling",
    "@types/ws": "catalog:cloudflare-runtime",
    "capnweb": "catalog:cloudflare-runtime",
    "http-cache-semantics": "catalog:cloudflare-runtime",
    "heap-js": "catalog:cloudflare-runtime",
    "itty-time": "catalog:cloudflare-runtime",
    "mime": "catalog:cloudflare-runtime",
    "mysql2": "catalog:cloudflare-runtime",
    "postal-mime": "catalog:cloudflare-runtime",
    "rolldown": "catalog:build",
    "tsdown": "catalog:build",
    "toucan-js": "catalog:cloudflare-runtime",
    "vite": "catalog:build",
    "vitest": "catalog:testing",
    "ws": "catalog:cloudflare-runtime"
  },
  "peerDependencies": {
    "@distilled.cloud/cloudflare": "workspace:*",
    "@effect/platform-bun": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect",
    "rolldown": "catalog:build",
    "vite": "catalog:cloudflare-runtime"
  },
