      const box = root!.getBoundingClientRect();
      const src = fileLines.find((l) => l.dataset.id === id)!.getBoundingClientRect();
      // Measure where the new entry will land by laying out the next state
      // and putting the old one back in the same tick, so it never paints.
      const next = new Set(loaded).add(id);
      const view = root!.querySelector<HTMLElement>(".lz-memview")!;
      const prevScroll = view.scrollTop;
      paintLeft(next, true, id);
      const landing = $("left").querySelector<HTMLElement>(`[data-id="${id}"]`) ?? ($("left") as HTMLElement);
      const land = { top: landing.offsetTop, left: landing.offsetLeft, w: landing.offsetWidth, h: landing.offsetHeight };
      const keep = Math.max(0, land.top - view.clientHeight / 2 + land.h / 2);
      paintLeft(loaded, true);
      view.scrollTop = prevScroll;
      // Bring the landing spot into view (old content still showing), then aim at it.
      if (Math.abs(view.scrollTop - keep) >= 4) {
