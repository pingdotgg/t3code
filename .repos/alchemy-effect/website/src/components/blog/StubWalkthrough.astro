    "Effect.gen(function* () {",
    "  yield* fly.getMachine({ id })",
    "  yield* fly.listMachines({ app })",
    "  yield* fly.getMachine({ id })",
    "})",
  ]

  // Chunks the loader can read. Sizes are the real byte counts from the trace.
