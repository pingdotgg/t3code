      const to = horiz
        ? { x: mt.left + (mt.width * before) / FILE, y: mt.top, w: (mt.width * chunk.bytes) / FILE, h: mt.height }
        : { x: mt.left, y: mt.bottom - (mt.height * (before + chunk.bytes)) / FILE, w: mt.width, h: (mt.height * chunk.bytes) / FILE };

