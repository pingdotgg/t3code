---
/**
 * `<StubWalkthrough />` — how distilled's lazy service stubs load an
 * operation. Left: what is in memory, starting from the stub. Right: the
 * full module on disk, scrolled to whatever the loader reads. Byte counts
 * come from a traced run of fly-io's `machines` service on Node 24
 * (distilled 6ff867b87). The code is simplified.
 *
 * One instance per page: element ids are prefixed `lz-`.
 */
---

<figure class="lz not-content" id="lz" tabindex="0" aria-label="Step-through of a lazy service stub loading fly-io's machines service">
  <div class="lz-narr" id="lz-narr" aria-live="polite"></div>
  <div class="lz-grid" id="lz-grid">
    <section class="lz-pane">
      <div class="lz-hd"><b>Your program</b></div>
      <div class="lz-view lz-progview"><div class="lz-code" id="lz-prog"></div></div>
      <div class="lz-status" id="lz-status"></div>
      <div class="lz-hd"><b>In memory</b> · what it has loaded</div>
      <div class="lz-view lz-memview"><div class="lz-code" id="lz-left"></div></div>
    </section>
    <div class="lz-meters" aria-hidden="true">
      <div class="lz-meter">
        <div class="lz-track" id="lz-memtrack"><div class="lz-fill lz-mem" id="lz-memfill"></div></div>
        <span class="lz-mlabel">in memory</span>
        <span class="lz-mval" id="lz-memval">0 B</span>
      </div>
      <div class="lz-meter">
        <div class="lz-track" id="lz-disktrack"><div class="lz-fill lz-disk"></div></div>
        <span class="lz-mlabel">on disk</span>
        <span class="lz-mval">63.2<br />KB</span>
      </div>
    </div>
    <section class="lz-pane">
      <div class="lz-hd"><b>On disk</b> · the full module, by byte offset</div>
      <div class="lz-view lz-file" id="lz-fileview"><div class="lz-code" id="lz-right"></div></div>
    </section>
  </div>
  <div class="lz-bar">
    <button type="button" id="lz-prev">◀ Back</button>
    <div class="lz-dots" id="lz-dots"></div>
    <label class="lz-truth" title="Show the stub, the slices and the index exactly as they ship, minified">
      <input type="checkbox" id="lz-real" />
      <span><b>I can handle the truth</b></span>
    </label>
    <button type="button" class="lz-primary" id="lz-next">Next ▶</button>
  </div>
</figure>

<style is:global>
  .lz {
    --lz-op: var(--alc-info);
    --lz-sh: var(--alc-terracotta);
    --lz-ix: var(--alc-warn);
    --lz-st: var(--alc-accent);
    --lz-fg: var(--alc-fg-1);
    --lz-mut: var(--alc-fg-4);
    --lz-bg: var(--alc-bg-elev-1);
    --lz-panel: var(--alc-bg-elev-2);
    --lz-bd: var(--alc-hairline-2);
    --lz-bd2: var(--alc-hairline-3);
    --lz-lh: 17px;
    position: relative;
    margin: 2rem 0;
    overflow: hidden;
    font: 14px/1.5 var(--alc-font-sans);
    color: var(--lz-fg);
    background: var(--lz-bg);
    border: 1px solid var(--lz-bd);
    border-radius: 12px;
  }
  .lz:focus-visible {
    outline: 2px solid var(--alc-accent);
    outline-offset: 2px;
  }
  .lz * {
    box-sizing: border-box;
  }
  .lz code {
    font-family: var(--alc-font-mono);
    font-size: 0.9em;
  }
  .lz-hd {
    margin-bottom: 5px;
    font-size: 11.5px;
    color: var(--lz-mut);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lz-hd b {
    color: var(--lz-fg);
  }

  .lz-narr {
    min-height: 5.4rem;
    padding: 13px 16px 10px;
    background: var(--lz-panel);
    border-bottom: 1px solid var(--lz-bd);
  }
  .lz-step {
    font: 600 11px var(--alc-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lz-mut);
  }
  .lz-ttl {
    display: block;
    margin: 1px 0 3px;
    font-size: 16px;
    font-weight: 700;
  }
  .lz-narr p {
    margin: 0;
    color: var(--alc-fg-2);
  }
  .lz-in {
    animation: lzin 0.35s ease both;
  }
  @keyframes lzin {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }


  /* code lines */
  .lz-code {
    font: 11px/var(--lz-lh) var(--alc-font-mono);
    font-variant-ligatures: none;
  }
  .lz-ln {
    display: flex;
    height: var(--lz-lh);
    padding-right: 6px;
    white-space: pre;
    overflow: hidden;
    color: var(--lz-mut);
    border-left: 3px solid transparent;
    transition:
      background 0.4s,
      color 0.4s,
      border-color 0.4s,
      opacity 0.4s;
  }
  .lz-bytes .lz-ln .no {
    width: 3.6em;
    font-weight: 600;
    opacity: 0.85;
  }
  .lz-ln .no.hit,
  .lz mark.lz-off {
    padding: 0 2px;
    color: var(--lz-bg);
    background: var(--lz-ix);
    border-radius: 2px;
    opacity: 1;
  }
  .lz-ln .no {
    flex: none;
    width: 2.1em;
    padding-right: 0.5em;
    text-align: right;
    opacity: 0.5;
  }
  .lz-ln .tx {
    padding-left: 5px;
  }
  .lz-ln.c {
    font-style: italic;
  }
  .lz-ln .tag {
    margin-left: auto;
    padding: 0 8px;
    font-weight: 600;
    font-style: normal;
    color: var(--alc-accent-text);
  }
  .lz-ln .tag.wait {
    color: var(--lz-ix);
  }
  .lz-ln.phase {
    color: var(--lz-fg);
    font-weight: 600;
  }
  .lz-ln.now {
    color: var(--lz-fg);
    background: color-mix(in srgb, var(--alc-accent) 18%, transparent);
    border-left-color: var(--alc-accent);
  }
  .lz-ln.read {
    color: var(--lz-fg);
    background: color-mix(in srgb, var(--c) 28%, transparent);
    border-left-color: var(--c);
  }
  .lz-ln.mem {
    color: var(--lz-fg);
    background: color-mix(in srgb, var(--c) 9%, transparent);
    border-left-color: color-mix(in srgb, var(--c) 55%, transparent);
  }
  .lz-ln.never {
    opacity: 0.4;
  }
  .lz-ln.pending {
    opacity: 0;
    transition: none;
  }
  .lz-slice {
    position: absolute;
    z-index: 1;
    left: -2px;
    right: -2px;
    min-height: 3px;
    background: var(--c);
    border-radius: 1px;
    opacity: 0.55;
    transition: opacity 0.4s;
  }
  .lz-slice.hot {
    opacity: 1;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent);
  }
  .lz-segfly {
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    background: var(--c);
    border-radius: 2px;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 40%, transparent);
    pointer-events: none;
  }
  .lz-ln.fresh {
    animation: lzfresh 1.2s ease both;
  }
  @keyframes lzfresh {
    from {
      background: color-mix(in srgb, var(--c) 45%, transparent);
    }
  }
  .lz-ln.look {
    color: var(--lz-fg);
    background: color-mix(in srgb, var(--lz-ix) 18%, transparent);
    border-left-color: var(--lz-ix);
  }
  .lz mark.lz-tok {
    padding: 0 1px;
    font-weight: 700;
    color: var(--lz-bg);
    background: var(--lz-ix);
    border-radius: 2px;
    animation: lzin 0.3s ease both;
  }
  .lz-ln.off {
    opacity: 0.45;
  }

  .lz-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 60px minmax(0, 1fr);
    gap: 8px;
    padding: 12px 12px 12px 10px;
  }
  .lz-pane {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lz-status {
    height: 22px;
    margin: 3px 0 6px;
    padding-left: 4px;
    font: 600 11px/22px var(--alc-font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--alc-accent-text);
  }
  .lz-status.wait {
    color: var(--lz-ix);
  }
  .lz-progview {
    height: auto !important;
  }
  .lz-view {
    position: relative;
    height: calc(15 * var(--lz-lh) + 8px);
    padding: 4px 0;
    overflow: hidden;
    background: var(--lz-panel);
    border: 1px solid var(--lz-bd);
    border-radius: 8px;
  }
  .lz-file .lz-code {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lz-file {
    flex: 1;
    height: auto;
    min-height: 200px;
  }
  /* out of flow, so the right pane matches the left column's height */
  .lz-file .lz-code {
    position: absolute;
    top: 4px;
    right: 0;
    left: 0;
  }
  .lz-memview {
    height: calc(13 * var(--lz-lh) + 8px);
  }
  .lz-file::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 18px;
    content: "";
    background: linear-gradient(transparent, var(--lz-panel));
  }

  /* meters */
  .lz-meters {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding-top: 22px;
  }
  .lz-meter .lz-track {
    flex: 1;
  }
  .lz-meter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 28px;
  }
  .lz-track {
    position: relative;
    width: 14px;
    background: color-mix(in srgb, var(--lz-mut) 14%, transparent);
    border-radius: 3px;
  }
  .lz-fill {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: var(--pct, 0%);
    border-radius: 3px;
    transition: height 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lz-disk {
    --pct: 100%;
    background: var(--lz-bd2);
  }
  /* No growth animation: the slice that flies over from the disk bar fills it. */
  .lz-mem {
    transition: none !important;
    display: flex;
    flex-direction: column-reverse;
    overflow: hidden;
  }
  .lz-mem i {
    flex: var(--b) 0 0;
    background: var(--c);
    border-top: 1px solid var(--lz-bg);
  }
  .lz-mem i.new {
    animation: lzseg 1s ease;
  }
  @keyframes lzseg {
    from {
      filter: brightness(1.6);
    }
  }
  .lz-mlabel {
    font-size: 10px;
    line-height: 1.15;
    text-align: center;
    color: var(--lz-mut);
  }
  .lz-mval {
    font: 600 10px var(--alc-font-mono);
    white-space: nowrap;
  }
  .lz-plus {
    position: absolute;
    left: 10px;
    z-index: 4;
    font: 700 11px var(--alc-font-mono);
    white-space: nowrap;
    color: var(--lz-st);
    pointer-events: none;
    animation: lzplus 1.4s ease forwards;
  }
  @keyframes lzplus {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-16px);
    }
  }

  /* the bytes travelling from disk to memory */
  .lz-chip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    padding: 1px 8px;
    font: 700 11px var(--alc-font-mono);
    white-space: nowrap;
    color: var(--lz-bg);
    background: var(--c);
    border-radius: 999px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }

  .lz-truth {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-size: 12.5px;
    white-space: nowrap;
    color: var(--lz-mut);
    cursor: pointer;
  }
  .lz-truth input {
    accent-color: var(--alc-accent);
    transform: translateY(1px);
  }
  .lz-truth b {
    color: var(--lz-fg);
  }
  .lz-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-top: 1px solid var(--lz-bd);
  }
  .lz button {
    all: unset;
    cursor: pointer;
    padding: 4px 13px;
    font-size: 13px;
    font-weight: 600;
    color: var(--lz-fg);
    background: var(--lz-bg);
    border: 1px solid var(--lz-bd2);
    border-radius: 7px;
  }
  .lz button:focus-visible {
    outline: 2px solid var(--alc-accent);
  }
  .lz button.lz-primary {
    color: var(--lz-bg);
    background: var(--lz-fg);
    border-color: var(--lz-fg);
  }
  .lz button:disabled {
    cursor: default;
    opacity: 0.4;
  }
  .lz-bar {
    flex-wrap: wrap;
  }
  @media (max-width: 620px) {
    .lz-truth {
      order: 5;
      flex-basis: 100%;
      justify-content: center;
    }
  }
  .lz-dots {
    display: flex;
    flex: 1;
    justify-content: center;
    gap: 5px;
  }
  .lz-dot {
    width: 18px;
    height: 5px;
    cursor: pointer;
    background: var(--lz-bd);
    border-radius: 3px;
  }
  .lz-dot.past {
    background: var(--lz-bd2);
  }
  .lz-dot.now {
    background: var(--lz-fg);
  }

  /* Narrow screens: stack memory, meters, disk. */
  @media (max-width: 620px) {
    .lz-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lz-meters {
      flex-direction: column;
      gap: 4px;
      padding-top: 0;
    }
    .lz-meter {
      flex-direction: row;
      width: auto;
      gap: 8px;
    }
    .lz-track {
      order: 2;
      flex: 1;
      width: auto;
      height: 12px;
    }
    .lz-mem {
      flex-direction: row;
    }
    .lz-mem i {
      border-top: 0;
      border-right: 1px solid var(--lz-bg);
    }
    .lz-slice {
      top: -2px !important;
      bottom: -2px;
      left: auto;
      right: auto;
      min-width: 3px;
    }
    .lz-fill {
      top: 0;
      right: auto;
      width: var(--pct, 0%);
      height: auto;
      transition-property: width;
    }
    .lz-mlabel {
      order: 1;
      width: 5em;
      text-align: left;
    }
    .lz-mval {
      order: 3;
      width: 4.5em;
      text-align: right;
    }
    .lz-mval br {
      display: none;
    }
    .lz-plus {
      top: -14px !important;
      left: auto !important;
      right: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lz * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

