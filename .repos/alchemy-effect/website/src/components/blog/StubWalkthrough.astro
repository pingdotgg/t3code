      for (let i = 0; i < n; i++) {
        const st = STEPS[i]!;
        if (st.stub && !stub) ((stub = true), (mem += STUB));
        for (const r of st.reads ?? []) if (!loaded.has(r)) (loaded.add(r), (mem += CHUNK[r]!.bytes));
      }
      return { loaded, stub, mem };
    }

    async function go(n: number) {
      const me = ++run;
      const forward = n === cur + 1;
      cur = Math.max(0, Math.min(STEPS.length - 1, n));
      const st = STEPS[cur]!;
      root!.querySelectorAll(".lz-chip").forEach((c) => c.remove());

      $("narr").innerHTML =
        `<div class="lz-in">` +
        `<strong class="lz-ttl">${st.t}</strong><p>${st.p}</p></div>`;
      $("dots")
        .querySelectorAll(".lz-dot")
        .forEach((d, i) => {
          d.classList.toggle("now", i === cur);
          d.classList.toggle("past", i < cur);
        });
      ($("prev") as HTMLButtonElement).disabled = cur === 0;
      ($("next") as HTMLButtonElement).disabled = cur === STEPS.length - 1;
      paintProg(st.at, forward ? "" : (st.done ?? ""));

      // Jumping (back, or by dot): show the finished state of this step.
      const s = forward ? stateBefore(cur) : stateBefore(cur + 1);
      const stub = forward ? s.stub || !!st.stub : s.stub;
      paintLeft(s.loaded, forward ? s.stub : stub);
      paintRight(s.loaded, undefined, !!st.end);
      setMem(forward ? s.stub : stub, s.loaded);
      paintDisk(s.loaded);
      const lastRead = [...(st.reads ?? [])].pop();
      scrollTo(lastRead);
      if (!forward) {
        return;
      }

      if (st.stub) {
        await wait(400);
        if (me !== run) return;
        paintLeft(s.loaded, true);
        setMem(true, s.loaded, "stub");
        plus(STUB);
        s.mem += STUB;
      }
      for (const id of st.reads ?? []) {
        paintProg(st.at, `paused: loading ${label(id)}`, true);
        if (id !== "index") {
          // The loader finds the entry's row in the index first…
          paintLeft(s.loaded, true, undefined, id);
          void showInMemory($("left").querySelector(".lz-ln.look") ?? $("left").querySelector("mark"));
          await wait(900);
          if (me !== run) return;
        }
        // …which says where its bytes are in the file on disk.
        scrollTo(id);
        paintRight(s.loaded, id, false);
        const gutter = real ? undefined : fileLines.find((l) => l.dataset.id === id)?.querySelector(".no");
        gutter?.classList.add("hit");
        await wait(1000);
        gutter?.classList.remove("hit");
        if (me !== run) return;
        await fly(id, s.loaded, me);
        if (me !== run) return;
        s.loaded.add(id);
        s.mem += CHUNK[id]!.bytes;
        paintRight(s.loaded, undefined, false);
        await wait(500);
        if (me !== run) return;
      }
      if (st.reuse) {
        // Already in memory: point at the copy we have, and leave the disk alone.
        await wait(600);
        if (me !== run) return;
        paintLeft(s.loaded, true, undefined, st.reuse, "listMachines");
        const el = $("left").querySelector<HTMLElement>(`[data-id="${st.reuse}"]`);
        el?.classList.add("fresh");
        void showInMemory(el);
        paintProg(st.at, `${label(st.reuse)}: already in memory, 0 B read`, false);
        await wait(1600);
        if (me !== run) return;
      }
      if (st.done || (st.reads && !st.done)) paintProg(st.at, st.done ?? "", false);
      if (st.end) scrollTo(undefined);
    }

    $("dots").innerHTML = STEPS.map((s, i) => `<i class="lz-dot" data-i="${i}" title="${s.t}"></i>`).join("");
    $("dots")
      .querySelectorAll<HTMLElement>(".lz-dot")
      .forEach((d) => (d.onclick = () => void go(Number(d.dataset.i))));
    ($("real") as HTMLInputElement).onchange = (e) => {
      real = (e.target as HTMLInputElement).checked;
      renderRight();
      // Replay the current step in the new view.
      const at = cur;
      cur = at - 1;
      void go(at);
    };
    $("next").onclick = () => void go(cur + 1);
    $("prev").onclick = () => void go(cur - 1);
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") void go(cur + 1);
      if (e.key === "ArrowLeft") void go(cur - 1);
    });
    void go(0);
  }
</script>
