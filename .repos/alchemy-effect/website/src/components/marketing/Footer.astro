---
import Logo from "./Logo.astro";
import { CONTRIBUTORS } from "../../data/contributors";

interface FooterLink {
  label: string;
  href: string;
}
interface FooterCol {
  h: string;
  links: FooterLink[];
}

const cols: FooterCol[] = [
  {
    h: "Product",
    links: [
      { label: "Docs", href: "/getting-started" },
      { label: "Tutorial", href: "/cloudflare/tutorial/part-1" },
      { label: "Compare", href: "/compare" },
      { label: "Effect", href: "https://effect.website" },
      // todo(sam): create an /examples landing page (or sidebar entry)
      // and re-enable: { label: "Examples", href: "/examples" }
      // todo(sam): create /providers/index.md that lists every provider
      // (Starlight currently autogenerates the sidebar from the
      // providers/ folder but there's no overview page to link to).
      // Re-enable: { label: "Providers", href: "/providers" }
      // todo(sam): wire a /changelog page that mirrors the GitHub
      // releases / CHANGELOG.md (either fetch at build time or add a
      // generator that drops a markdown file under content/docs).
      // Re-enable: { label: "Changelog", href: "/changelog" }
    ],
  },
  {
    h: "Community",
    links: [
      { label: "Discord", href: "/discord" },
      { label: "GitHub", href: "https://github.com/alchemy-run/alchemy" },
      { label: "X / Twitter", href: "/twitter" },
      { label: "Blog", href: "/blog" },
      { label: "Privacy", href: "/privacy" },
    ],
  },
  // todo(sam): /compare covers SST, Pulumi, and Terraform on one page.
  // Split into per-tool pages (and add CDK) to re-enable this column.
  // {
  //   h: "Compare",
  //   links: [
  //     { label: "vs Pulumi",    href: "/compare/pulumi" },
  //     { label: "vs SST",       href: "/compare/sst" },
  //     { label: "vs Terraform", href: "/compare/terraform" },
  //     { label: "vs CDK",       href: "/compare/cdk" },
  //   ],
  // },
];

// Community contributors, most commits first: a few faces, then the rest
// as a count linking to GitHub's contributors graph.
const SHOWN = 8;
const faces = CONTRIBUTORS.slice(0, SHOWN);
const rest = CONTRIBUTORS.length - faces.length;
const graph =
  "https://github.com/alchemy-run/alchemy/graphs/contributors?all=1";
---

<footer class="alc-footer">
  <div class="alc-footer__grid" style={`--footer-cols:${cols.length}`}>
    <div>
      <Logo />
      <p class="alc-footer__tag">
        Infrastructure as Effects. A single, type-safe TypeScript program for your cloud.
      </p>
      <div class="alc-footer__copy">Apache-2.0 · © 2026 Functionless, Inc.</div>
      <div class="alc-footer__people">
        <ul class="alc-footer__faces" aria-label="Contributors">
          {faces.map((c) => (
            <li>
              <a
                href={`https://github.com/${c.login}`}
                title={`@${c.login} · ${c.commits} commits`}
              >
                <img
                  src={`https://github.com/${c.login}.png?size=64`}
                  alt={`@${c.login}`}
                  width="28"
                  height="28"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          ))}
        </ul>
        {rest > 0 && (
          <a class="alc-footer__more" href={graph} aria-label={`${rest} more contributors on GitHub`}>
            +{rest}
          </a>
        )}
      </div>
    </div>
    {cols.map((col) => (
      <div>
        <div class="alc-footer__heading">{col.h}</div>
        <ul class="alc-footer__list">
          {col.links.map((l) => (
            <li><a href={l.href} class="alc-footer__link">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</footer>

<style>
  .alc-footer {
    padding: 40px 32px;
    border-top: 1px solid var(--alc-hairline);
    background: var(--alc-bg-nav);
  }
  .alc-footer__grid {
    max-width: 1152px;
    margin: 0 auto;
    display: grid;
    /* Brand on the left, link columns sized to their content and pinned to
       the right edge, so the footer spans the same width as the page. */
    grid-template-columns: minmax(0, 1fr) repeat(var(--footer-cols), max-content);
    column-gap: clamp(48px, 8vw, 120px);
    row-gap: 40px;
  }
  @media (max-width: 880px) {
    .alc-footer__grid {
      grid-template-columns: repeat(var(--footer-cols), minmax(0, 1fr));
      gap: 28px 24px;
    }
    .alc-footer__grid > :first-child {
      grid-column: 1 / -1;
      max-width: 520px;
    }
  }
  @media (max-width: 640px) {
    .alc-footer { padding: 32px 20px; }
    .alc-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px 20px;
    }
  }
  @media (max-width: 380px) {
    .alc-footer__grid { grid-template-columns: 1fr; }
  }
  .alc-footer__tag {
    max-width: 380px;
    font-family: var(--alc-font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--alc-fg-3);
    margin: 14px 0 0;
  }
  .alc-footer__copy {
    margin-top: 16px;
    font-family: var(--alc-font-mono);
    font-size: 11px;
    color: var(--alc-fg-4);
  }
  .alc-footer__people {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .alc-footer__faces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }
  .alc-footer__faces li + li {
    margin-left: -12px;
  }
  .alc-footer__faces a {
    position: relative;
    display: block;
    border-radius: 50%;
    transition: transform 160ms ease;
  }
  .alc-footer__faces a:hover,
  .alc-footer__faces a:focus-visible {
    z-index: 1;
    transform: translateY(-2px);
  }
  .alc-footer__faces a:focus-visible {
    outline: 2px solid var(--alc-accent);
    outline-offset: 2px;
  }
  .alc-footer__faces img {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    /* A ring in the footer color separates the overlapping faces. */
    box-shadow: 0 0 0 2px var(--alc-bg-nav);
    background: var(--alc-hairline);
  }
  .alc-footer__more {
    font-family: var(--alc-font-mono);
    font-size: 13px;
    color: var(--alc-accent-deep);
    text-decoration: none;
  }
  .alc-footer__more:hover {
    text-decoration: underline;
  }
  .alc-footer__heading {
    font-family: var(--alc-font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--alc-fg-4);
    margin-bottom: 12px;
  }
  .alc-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .alc-footer__link {
    text-decoration: none;
    color: var(--alc-fg-2);
    font-size: 13px;
  }
  .alc-footer__link:hover {
    color: var(--alc-accent-deep);
  }
</style>
