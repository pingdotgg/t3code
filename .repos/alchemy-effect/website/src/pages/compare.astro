---
import Marketing from "../layouts/Marketing.astro";
import Button from "../components/marketing/Button.astro";
import AlchemicalDivider from "../components/marketing/AlchemicalDivider.astro";
import Yantra from "../brand/Yantra.astro";
import TestLoop from "../components/compare/TestLoop.astro";
import OneLine from "../components/compare/OneLine.astro";

const TOOLS = ["Alchemy", "SST", "Pulumi", "Terraform", "AWS CDK"] as const;

// One row per dimension; the first cell is Alchemy.
const ROWS: {
    label: string;
    cells: [string, string, string, string, string];
}[] = [
    {
        label: "Language",
        cells: [
            "TypeScript + Effect",
            "TypeScript",
            "TypeScript, Python, Go, C#, Java",
            "HCL",
            "TypeScript, Python, Java, C#, Go",
        ],
    },
    {
        label: "Built on",
        cells: [
            "Pure TypeScript, end to end",
            "Pulumi, mostly bridged Terraform providers",
            "A Go engine, many providers bridged from Terraform",
            "A Go engine and Go provider plugins",
            "CloudFormation, a managed engine inside AWS",
        ],
    },
    {
        label: "App code in the same program",
        cells: ["Yes, as typed Effects and Layers", "No", "No", "No", "No"],
    },
    {
        label: "Permissions",
        cells: [
            "Derived from the bindings your code uses",
            "Granted by link",
            "Unenforced",
            "Unenforced",
            "Granted by grant\u2060*\u2060() calls",
        ],
    },
    {
        label: "Runs locally",
        cells: [
            "Emulated on your machine",
            "No, it deploys to the cloud",
            "No",
            "No",
            "No",
        ],
    },
    {
        label: "Tests against real infrastructure",
        cells: [
            "Deploy, assert, destroy from bun test or Vitest",
            "No",
            "No",
            "No",
            "No",
        ],
    },
];

// ---------- engine: what sits between your code and the cloud ----------
type Layer = { name: string; sub: string };
const ENGINES: {
    tool: string;
    file: string;
    layers: Layer[];
    note: string;
    ours?: boolean;
}[] = [
    {
        tool: "Alchemy",
        file: "alchemy.run.ts",
        ours: true,
        note: "1 runtime · TypeScript",
        layers: [{ name: "Alchemy", sub: "TypeScript + Effect" }],
    },
    {
        tool: "SST",
        file: "sst.config.ts",
        note: "3 layers · TypeScript → Go",
        layers: [
            { name: "SST", sub: "Go CLI" },
            { name: "Pulumi engine", sub: "Go" },
            { name: "Terraform provider", sub: "Go, through a bridge" },
        ],
    },
    {
        tool: "Pulumi",
        file: "index.ts",
        note: "2 layers · gRPC between them",
        layers: [
            { name: "Pulumi engine", sub: "Go" },
            {
                name: "Provider plugin",
                sub: "often a bridged Terraform provider",
            },
        ],
    },
    {
        tool: "Terraform",
        file: "main.tf",
        note: "2 layers · HCL → Go",
        layers: [
            { name: "Terraform core", sub: "Go" },
            { name: "Provider plugin", sub: "Go" },
        ],
    },
];
// Nested boxes, outermost first (built as HTML because Astro templates
// can't recurse inline). All strings are constants above.
const nest = (layers: Layer[]): string =>
    layers.reduceRight(
        (inner, l, i) =>
            `<div class="dg-layer" style="--depth:${i}"><span class="dg-layer__name">${l.name}<small>${l.sub}</small></span>${inner}</div>`,
        "",
    );

// ---------- local dev: where one request goes ----------
// Each trace is a request's path, one hop per node, on one of two lanes.
// Every hop across the network line is marked; Alchemy's never leaves the
// machine.
// `hold` pauses the dot on that hop for that many seconds and shows a
// progress bar on its box (e.g. a deploy the request has to wait for).
// Lanes: "m" your machine, "c" cloud, "b" on the network boundary (a step
// that runs locally but pushes to the cloud, like a deploy).
// `key` identifies the same box across Alchemy's dev modes so it can animate.
type Hop = {
    label: string;
    lane: "m" | "c" | "b";
    hold?: number;
    key?: string;
};
const TRACE_H = 170;
const NET_Y_ = 85;
const LANE_Y = { m: 46, c: 124, b: NET_Y_ };
const NET_Y = NET_Y_;
const STEP = 128;
const X0 = 70;
type DevMode = {
    id: string;
    headline: string;
    sub: string;
    hops: Hop[];
};
// Alchemy's row is interactive: drag Lambda or DynamoDB across the network
// line (`remote()` in `alchemy dev`). Both in the cloud means every edit is a
// deploy. Boxes are matched across modes by `key`.
const ALCHEMY_MODES: DevMode[] = [
    {
        id: "local",
        headline: "0 round trips",
        sub: "Runs offline. Edits reload in place.",
        hops: [
            { label: "browser", lane: "m", key: "src" },
            { label: "Lambda · Docker", lane: "m", key: "fn" },
            { label: "DynamoDB · floci", lane: "m", key: "db" },
        ],
    },
    {
        id: "remote-data",
        headline: "1 round trip",
        sub: "remote() puts DynamoDB in the real cloud. Your Lambda still runs locally.",
        hops: [
            { label: "browser", lane: "m", key: "src" },
            { label: "Lambda · Docker", lane: "m", key: "fn" },
            { label: "DynamoDB", lane: "c", key: "db" },
        ],
    },
    {
        id: "remote-fn",
        headline: "2 round trips",
        sub: "remote() deploys the Lambda for real. It still reads and writes your local DynamoDB.",
        hops: [
            { label: "browser", lane: "m", key: "src" },
            { label: "Lambda", lane: "c", key: "fn" },
            { label: "DynamoDB · floci", lane: "m", key: "db" },
        ],
    },
    {
        id: "deploy",
        headline: "Deploy each edit",
        sub: "With the whole stack in remote(), dev redeploys it for real as you edit.",
        hops: [
            { label: "edit", lane: "m", key: "src" },
            // Half the Terraform row's hold: no engine or provider plugins to start.
            { label: "deploy", lane: "b", hold: 2.4, key: "deploy" },
            { label: "Lambda", lane: "c", key: "fn" },
            { label: "DynamoDB", lane: "c", key: "db" },
        ],
    },
];
const TRACES: {
    tool: string;
    ours?: boolean;
    headline: string;
    sub: string;
    hops: Hop[];
    modes?: DevMode[];
}[] = [
    { tool: "Alchemy", ours: true, ...ALCHEMY_MODES[0]!, modes: ALCHEMY_MODES },
    {
        tool: "SST",
        headline: "3 round trips",
        sub: "Per request, through a deployed stage. Needs a connection.",
        hops: [
            { label: "browser", lane: "m" },
            { label: "API Gateway", lane: "c" },
            { label: "Lambda stub", lane: "c" },
            { label: "your code", lane: "m" },
            { label: "DynamoDB", lane: "c" },
        ],
    },
    {
        tool: "Pulumi & Terraform",
        headline: "Deploy first",
        sub: "No local runtime. Every change is a redeploy.",
        hops: [
            { label: "edit", lane: "m" },
            { label: "deploy", lane: "b", hold: 4.8 },
            { label: "Lambda", lane: "c" },
            { label: "DynamoDB", lane: "c" },
        ],
    },
];
const SPAN = 520;
const traceGeom = (hops: Hop[], opts: { fullSpan?: boolean } = {}) => {
    // Short traces spread out; long ones use the default step. Alchemy's
    // modes always span the full width so their paths share start and end.
    const step = opts.fullSpan
        ? SPAN / Math.max(1, hops.length - 1)
        : Math.max(STEP, Math.min(190, SPAN / Math.max(1, hops.length - 1)));
    const pts = hops.map((h, i) => ({
        ...h,
        x: X0 + i * step,
        y: LANE_Y[h.lane],
        w: Math.max(h.label.length * 6.9 + 24, h.hold ? 96 : 0),
    }));
    const segs = pts.slice(1).map((b, i) => {
        const a = pts[i]!;
        return a.lane === b.lane
            ? `M ${a.x} ${a.y} L ${b.x} ${b.y}`
            : `M ${a.x} ${a.y} C ${a.x + step / 2} ${a.y}, ${b.x - step / 2} ${b.y}, ${b.x} ${b.y}`;
    });
    const crosses = (a: Hop, b: Hop) =>
        a.lane !== b.lane && a.lane !== "b" && b.lane !== "b";
    const crossings = pts
        .slice(1)
        .flatMap((b, i) =>
            crosses(pts[i]!, b) ? [{ x: (pts[i]!.x + b.x) / 2, y: NET_Y }] : [],
        );

    // Motion timing for the traveling dot: constant speed, except it slows
    // to a crawl for CROSS_WINDOW px either side of each network crossing.
    const bezierLength = (a: (typeof pts)[number], b: (typeof pts)[number]) => {
        const p = [
            [a.x, a.y],
            [a.x + step / 2, a.y],
            [b.x - step / 2, b.y],
            [b.x, b.y],
        ] as const;
        let len = 0;
        let prev = p[0];
        for (let k = 1; k <= 32; k++) {
            const t = k / 32,
                u = 1 - t;
            const q = [0, 1].map(
                (d) =>
                    u * u * u * p[0][d]! +
                    3 * u * u * t * p[1][d]! +
                    3 * u * t * t * p[2][d]! +
                    t * t * t * p[3][d]!,
            ) as [number, number];
            len += Math.hypot(q[0] - prev[0], q[1] - prev[1]);
            prev = q;
        }
        return len;
    };
    let total = 0;
    const crossAt: number[] = [];
    const nodeAt = [0];
    pts.slice(1).forEach((b, i) => {
        const a = pts[i]!;
        const len =
            a.lane === b.lane
                ? Math.hypot(b.x - a.x, b.y - a.y)
                : bezierLength(a, b);
        // Lane changes are symmetric, so the crossing is at half their length.
        if (crosses(a, b)) crossAt.push(total + len / 2);
        total += len;
        nodeAt.push(total);
    });
    const CROSS_WINDOW = 16;
    const SLOW = 6;
    const SPEED = 170; // px/s away from crossings
    // Breakpoints along the path, each with how the dot covers the span that
    // ends there: "slow" through a crossing, "hold" (zero distance) at a hop.
    type Mark = { at: number; kind: "move" | "slow" | "hold"; secs?: number };
    const marks: Mark[] = [
        ...crossAt.flatMap((d): Mark[] => [
            { at: d - CROSS_WINDOW, kind: "move" },
            { at: d + CROSS_WINDOW, kind: "slow" },
        ]),
        ...pts.flatMap((p, i): Mark[] =>
            p.hold
                ? [
                      { at: nodeAt[i]!, kind: "move" },
                      { at: nodeAt[i]!, kind: "hold", secs: p.hold },
                  ]
                : [],
        ),
        { at: total, kind: "move" },
    ].sort((a, b) => a.at - b.at || (a.kind === "hold" ? 1 : -1));
    const points = [0];
    const times = [0];
    const holds: { hop: number; start: number; secs: number }[] = [];
    for (const m of marks) {
        const prevAt = points[points.length - 1]!;
        const prevT = times[times.length - 1]!;
        const dt =
            m.kind === "hold"
                ? m.secs!
                : ((m.at - prevAt) / SPEED) * (m.kind === "slow" ? SLOW : 1);
        if (m.kind === "hold") {
            holds.push({
                hop: nodeAt.indexOf(m.at),
                start: prevT,
                secs: m.secs!,
            });
        }
        points.push(m.at);
        times.push(prevT + dt);
    }
    const dur = times[times.length - 1]!;
    const motion = {
        dur: `${dur.toFixed(2)}s`,
        keyPoints: points.map((m) => (m / total).toFixed(4)).join(";"),
        keyTimes: times.map((t) => (t / dur).toFixed(4)).join(";"),
    };
    // A progress bar on each held hop fills while the dot waits there, stays
    // full until the loop restarts, then resets.
    const bars = holds.map((h) => ({
        hop: h.hop,
        values: "0;0;1;1",
        keyTimes: [0, h.start / dur, (h.start + h.secs) / dur, 1]
            .map((t) => t.toFixed(4))
            .join(";"),
    }));
    return { pts, path: segs.join(" "), crossings, motion, bars };
};
const laneName = (l: Hop["lane"]) =>
    l === "m"
        ? "your machine"
        : l === "c"
          ? "cloud"
          : "on the network boundary";
const traceLabel = (tool: string, hops: Hop[], crossings: number) =>
    `${tool}: ${hops.map((h) => `${h.label} (${laneName(h.lane)})`).join(", then ")}. ${crossings} crossings of the network.`;
// Everything the client script needs to redraw Alchemy's row per mode.
// Every mode has a box for every slot; a slot a mode doesn't use becomes a
// hidden "ghost" sitting on that mode's path, so it can grow out of it.
const ALCHEMY_SLOTS = ["src", "deploy", "fn", "db"];
type Slot = {
    x: number;
    y: number;
    w: number;
    label: string;
    shown: boolean;
    bar: string | null;
};
const ALCHEMY_MODE_DATA = ALCHEMY_MODES.map((m) => {
    const g = traceGeom(m.hops, { fullSpan: true });
    const shown = ALCHEMY_SLOTS.map((key) => {
        const i = m.hops.findIndex((h) => h.key === key);
        if (i < 0) return null;
        const p = g.pts[i]!;
        const bar = g.bars.find((b) => b.hop === i);
        return {
            x: p.x,
            y: p.y,
            w: p.w,
            label: p.label,
            shown: true,
            bar: bar?.keyTimes ?? null,
        };
    });
    const slots: Slot[] = shown.map((s, i) => {
        if (s) return s;
        const prev = shown.slice(0, i).reverse().find(Boolean)!;
        const next = shown.slice(i + 1).find(Boolean)!;
        // The midpoint of a symmetric curve between its neighbors.
        return {
            x: (prev.x + next.x) / 2,
            y: (prev.y + next.y) / 2,
            w: 24,
            label: "",
            shown: false,
            bar: null,
        };
    });
    // The route as one cubic per slot gap (same count in every mode), so a
    // mode switch can morph control points instead of re-deriving curves. A
    // hidden slot splits its neighbors' curve exactly at t = 0.5, which keeps
    // the drawn shape identical to the mode's real path.
    type Cubic = number[]; // x0 y0 c1x c1y c2x c2y x1 y1
    const cubic = (a: Slot, b: Slot): Cubic => {
        const h = (b.x - a.x) / 2;
        return [a.x, a.y, a.x + h, a.y, b.x - h, b.y, b.x, b.y];
    };
    const split = ([x0, y0, ax, ay, bx, by, x1, y1]: Cubic): [Cubic, Cubic] => {
        const mid = (p: number, q: number) => (p + q) / 2;
        const [m1x, m1y] = [mid(x0, ax), mid(y0, ay)];
        const [m2x, m2y] = [mid(ax, bx), mid(ay, by)];
        const [m3x, m3y] = [mid(bx, x1), mid(by, y1)];
        const [n1x, n1y] = [mid(m1x, m2x), mid(m1y, m2y)];
        const [n2x, n2y] = [mid(m2x, m3x), mid(m2y, m3y)];
        const [px, py] = [mid(n1x, n2x), mid(n1y, n2y)];
        return [
            [x0, y0, m1x, m1y, n1x, n1y, px, py],
            [px, py, n2x, n2y, m3x, m3y, x1, y1],
        ];
    };
    const segs: Cubic[] = [];
    for (let i = 0; i < slots.length - 1;) {
        const a = slots[i]!;
        const b = slots[i + 1]!;
        if (b.shown) {
            segs.push(cubic(a, b));
            i += 1;
        } else {
            segs.push(...split(cubic(a, slots[i + 2]!)));
            i += 2;
        }
    }
    return {
        headline: m.headline,
        sub: m.sub,
        local: m.hops.every((h) => h.lane === "m"),
        lanes: Object.fromEntries(
            m.hops.flatMap((h) => (h.key ? [[h.key, h.lane]] : [])),
        ),
        aria: traceLabel("Alchemy", m.hops, g.crossings.length),
        path: g.path,
        segs: segs.map((c) => c.map((n) => +n.toFixed(2))),
        crossings: g.crossings,
        motion: g.motion,
        slots,
    };
});

---

<Marketing
    title="Alchemy vs SST, Pulumi & Terraform"
    description="How Alchemy compares to SST, Pulumi, and Terraform: pure TypeScript and Effect instead of wrapped Go engines, infrastructure and app code in one type-checked program, true local emulation, and deploy-test-destroy loops built for agents."
>
    <!-- ───────────────── HERO ───────────────── -->
    <section class="cmp-hero cmp-pat-1">
        <div class="cmp-container">
            <Yantra class="cmp-hero__mark" size={40} />
            <p class="cmp-eyebrow">Compare</p>
            <h1 class="cmp-hero__title" data-copy>
                Alchemy vs existing IaC solutions
            </h1>
            <p class="cmp-hero__lede" data-copy>
                Most existing IaC solutions wrap terraform or are managed services in some way. Alchemy ships its own IaC engine in TypeScript, opening the door for more fully integrated features: <a href="#testing">testing</a>, <a href="#engine">engine</a>, <a href="#bindings">bindings</a>, <a href="#permissions">permissions</a>, and <a href="#local">local dev</a>.
            </p>
        </div>
    </section>

    <!-- ───────────────── AT A GLANCE ───────────────── -->
    <section class="cmp-section cmp-pat-2" aria-labelledby="glance">
        <div class="cmp-container">
            <h2 class="cmp-h2" id="glance" data-copy>
                At a glance
            </h2>
            <div
                class="cmp-table-wrap"
                tabindex="0"
                role="region"
                aria-label="Comparison table"
            >
                <table class="cmp-table">
                    <thead>
                        <tr>
                            <td></td>
                            {TOOLS.map((t, i) => (
                                <th
                                    scope="col"
                                    class:list={[i === 0 && "is-ours"]}
                                >
                                    {i === 0 ? <Yantra size={18} /> : null}
                                    {t}
                                </th>
                            ))}
                        </tr>
                    </thead>
                    <tbody>
                        {ROWS.map((row) => (
                            <tr>
                                <th scope="row">{row.label}</th>
                                {row.cells.map((c, i) => (
                                    <td
                                        class:list={[
                                            i === 0 && "is-ours",
                                            (c.startsWith("No") ||
                                                c === "Unenforced") &&
                                                "is-no",
                                        ]}
                                    >
                                        {c}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <AlchemicalDivider variant="triangle" class="cmp-divider" />

    <!-- ───────────────── TESTING ───────────────── -->
    <section
        class="cmp-section cmp-pat-1"
        id="testing"
        aria-labelledby="testing-h"
    >
        <div class="cmp-container">
            <h2 class="cmp-h2" id="testing-h" data-copy>
                A complete iteration loop for agents
            </h2>
            <p class="cmp-lede" data-copy>
                Alchemy Test deploys a real stack, runs tests on that deployment, then tears it down all from the test runner you already use. All agent's have to do to test against real infrastructure is make a code change, then run a test file; this keeps the loop extremely tight and lets ai agents move fast without breaking. Our <a href="https://github.com/alchemy-run/alchemy/tree/main/examples/cloudflare-preview-benchmark"> preview benchmark </a> takes 17 seconds for 1 full loop, <strong>no competitor even has a full loop</strong>.
            </p>
            <TestLoop />
        </div>
    </section>

    <AlchemicalDivider variant="square" class="cmp-divider" />

    <!-- ───────────────── ENGINE ───────────────── -->
    <section
        class="cmp-section cmp-pat-3"
        id="engine"
        aria-labelledby="engine-h"
    >
        <div class="cmp-container">
            <h2 class="cmp-h2" id="engine-h" data-copy>
                Its own engine, not a wrapper
            </h2>
            <p class="cmp-lede" data-copy>
                Every competitor has a core and providers have to talk to that
                core over a bridge, in some cases even 2. Alchemy just imports
                providers as typescript and runs them directly, this means
                alchemy can just deploy resources instead of waiting on events.
            </p>
            <div class="dg-engine">
                {ENGINES.map((e) => (
                    <figure
                        class:list={["dg-engine__tool", e.ours && "is-ours"]}
                    >
                        <figcaption>{e.tool}</figcaption>
                        <span class="dg-pill">{e.file}</span>
                        <span class="dg-down" aria-hidden="true" />
                        <div class="dg-nest" set:html={nest(e.layers)} />
                        <span class="dg-down" aria-hidden="true" />
                        <span class="dg-pill dg-pill--cloud">Cloud API</span>
                        <p class="dg-note">{e.note}</p>
                    </figure>
                ))}
            </div>
        </div>
    </section>

    <AlchemicalDivider variant="pentagon" class="cmp-divider" />

    <!-- ───────────────── BINDINGS ───────────────── -->
    <section
        class="cmp-section cmp-pat-4"
        id="bindings"
        aria-labelledby="bindings-h"
    >
        <div class="cmp-container">
            <h2 class="cmp-h2" id="bindings-h" data-copy>
                One line does three jobs
            </h2>
            <p class="cmp-lede" data-copy>
                To read a table, a function needs three things that usually
                live in three different places: a permission, the table's
                name, and a client. In Alchemy the function's code asks for
                the capability, and that one line produces all three: its
                statement in the IAM policy, the table's name, and a typed
                client.
            </p>
            <OneLine />
        </div>
    </section>

    <AlchemicalDivider variant="hexagon" class="cmp-divider" />

    <!-- ───────────────── PERMISSIONS ───────────────── -->
    <section
        class="cmp-section cmp-pat-5"
        id="permissions"
        aria-labelledby="permissions-h"
    >
        <div class="cmp-container">
            <h2 class="cmp-h2" id="permissions-h" data-copy>
                Principle of least privilege
            </h2>
            <p class="cmp-lede" data-copy>
                In Alchemy permission policies are created from your code. This allows least privilege security policies to be inferred on the type level. SST provides link to automate common policy usecases, but are one size fits all, not lease privilege. Pulumi &amp; terraform offer no enforcement, so you have to manually maintain permission policies yourself.
            </p>
            <div class="dg-perm">
                {[
                    {
                        tool: "Alchemy",
                        ours: true,
                        needed: 42,
                        granted: 42,
                        dashed: false,
                        code: "DynamoDB.GetItem(table)",
                        grant: "dynamodb:GetItem on table",
                        verdict: "Exact",
                    },
                    {
                        tool: "SST",
                        needed: 42,
                        granted: 60,
                        dashed: false,
                        code: "link: [table]",
                        grant: "dynamodb:* on table",
                        verdict: "Close",
                    },
                    {
                        tool: "Pulumi & Terraform",
                        needed: 42,
                        granted: 78,
                        dashed: true,
                        code: "a policy you write",
                        grant: "often dynamodb:* on *",
                        verdict: "Unenforced",
                    },
                ].map((d) => (
                    <figure class:list={["dg-perm__tool", d.ours && "is-ours"]}>
                        <figcaption>{d.tool}</figcaption>
                        <svg
                            viewBox="0 0 180 180"
                            class="dg-perm__rings"
                            role="img"
                            aria-label={`${d.tool}: grants ${d.grant}`}
                        >
                            <circle
                                class:list={[
                                    "dg-perm__granted",
