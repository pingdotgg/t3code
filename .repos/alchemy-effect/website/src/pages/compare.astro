<script>
    // SVG (SMIL) animations don't follow CSS, so reduced motion has to stop
    // them here: every diagram freezes on its first frame. Also re-applied
    // if the setting changes while the page is open.
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const syncSvgMotion = () => {
        for (const svg of document.querySelectorAll<SVGSVGElement>("svg")) {
            if (!svg.querySelector("animate, animateMotion, animateTransform")) continue;
            if (motion.matches) {
                svg.pauseAnimations();
                svg.setCurrentTime(0);
            } else {
                svg.unpauseAnimations();
            }
        }
    };
    syncSvgMotion();
    motion.addEventListener("change", syncSvgMotion);
</script>

<script>
    // Alchemy's draggable row in "True emulation". On a switch the
    // boxes glide to their new spots and the dotted route bends with them
    // (redrawn every frame from the live box positions); boxes a mode doesn't
    // use shrink into the line. Then the new route, crossings, and dot land.
    type Slot = {
        x: number;
        y: number;
        w: number;
        label: string;
        shown: boolean;
        bar: string | null;
    };
    type ModeData = {
        headline: string;
        sub: string;
        local: boolean;
        lanes: Record<string, "m" | "c" | "b">;
        aria: string;
        path: string;
        segs: number[][];
        crossings: { x: number; y: number }[];
        motion: { dur: string; keyPoints: string; keyTimes: string };
        slots: Slot[];
    };
    const MOVE_MS = 520;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const draw = (segs: number[][]) =>
        segs
            .map(
                ([x0, y0, ax, ay, bx, by, x1, y1]) =>
                    `M ${x0} ${y0} C ${ax} ${ay}, ${bx} ${by}, ${x1} ${y1}`,
            )
            .join(" ");

    for (const fig of document.querySelectorAll<HTMLElement>(
        "figure[data-modes]",
    )) {
        const modes = JSON.parse(fig.dataset.modes!) as ModeData[];
        const svg = fig.querySelector("svg")!;
        const path = svg.querySelector<SVGPathElement>(".dg-trace__path")!;
        const crosses = svg.querySelector<SVGGElement>("[data-crosses]")!;
        const dotAnim = svg.querySelector<SVGAnimationElement>(
            "[data-dot] animateMotion",
        )!;
        const barAnim = svg.querySelector<SVGAnimationElement>("[data-bar]");
        const done = svg.querySelector<SVGTextElement>("[data-done]");
        const headline = fig.querySelector<HTMLElement>("[data-headline]")!;
        const sub = fig.querySelector<HTMLElement>("[data-sub]")!;
        const boxes = [...svg.querySelectorAll<SVGGElement>("[data-hop]")];
        // Cloned so new crossings keep the page's scoped styles.
        const crossTemplate = svg.querySelector<SVGCircleElement>(
            "[data-cross-template]",
        )!;
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let current = modes[0]!;
        let frame = 0;

        const place = (g: SVGGElement, s: Slot, x = s.x, y = s.y) => {
            g.style.transform = `translate(${x}px, ${y}px)`;
            const rect = g.querySelector("rect")!;
            rect.setAttribute("x", String(-s.w / 2));
            rect.setAttribute("width", String(s.w));
        };

        const land = (m: ModeData) => {
            path.setAttribute("d", m.path);
            crosses.replaceChildren(
                ...m.crossings.map((c) => {
                    const el = crossTemplate.cloneNode() as SVGCircleElement;
                    el.removeAttribute("data-cross-template");
                    el.removeAttribute("hidden");
                    el.setAttribute("cx", String(c.x));
                    el.setAttribute("cy", String(c.y));
                    return el;
                }),
            );
            dotAnim.setAttribute("dur", m.motion.dur);
            dotAnim.setAttribute("keyPoints", m.motion.keyPoints);
            dotAnim.setAttribute("keyTimes", m.motion.keyTimes);
            const bar = m.slots.find((s) => s.bar)?.bar;
            if (barAnim && bar) {
                barAnim.setAttribute("dur", m.motion.dur);
                barAnim.setAttribute("keyTimes", bar);
            }
            dotAnim.beginElement();
            barAnim?.beginElement();
            fig.classList.remove("is-switching");
        };

        // The route between the current box positions: one cubic per slot gap,
        // split in half across a hidden slot (mirrors the server-side build).
        type Cubic = number[];
        const cubic = (a: Slot, b: Slot): Cubic => {
            const h = (b.x - a.x) / 2;
            return [a.x, a.y, a.x + h, a.y, b.x - h, b.y, b.x, b.y];
        };
        const split = ([x0, y0, ax, ay, bx, by, x1, y1]: Cubic): Cubic[] => {
            const mid = (p: number, q: number) => (p + q) / 2;
            const [m1x, m1y, m2x, m2y, m3x, m3y] = [
                mid(x0!, ax!), mid(y0!, ay!), mid(ax!, bx!),
                mid(ay!, by!), mid(bx!, x1!), mid(by!, y1!),
            ];
            const [n1x, n1y, n2x, n2y] = [
                mid(m1x, m2x), mid(m1y, m2y), mid(m2x, m3x), mid(m2y, m3y),
            ];
            const [px, py] = [mid(n1x, n2x), mid(n1y, n2y)];
            return [
                [x0!, y0!, m1x, m1y, n1x, n1y, px, py],
                [px, py, n2x, n2y, m3x, m3y, x1!, y1!],
            ];
        };
        const segsFor = (slots: Slot[]) => {
            const segs: Cubic[] = [];
            for (let i = 0; i < slots.length - 1; ) {
                if (slots[i + 1]!.shown) {
                    segs.push(cubic(slots[i]!, slots[i + 1]!));
                    i += 1;
                } else {
                    segs.push(...split(cubic(slots[i]!, slots[i + 2]!)));
                    i += 2;
                }
            }
            return segs;
        };

        const hint = svg.querySelector<SVGGElement>("[data-hint]");
        const NET_Y = 85;
        const NAMES: Record<string, string> = {
            fn: "Lambda",
            db: "DynamoDB",
        };
        const laneOf = (key: string, m = current) =>
            m.lanes[key] === "c" ? "c" : "m";
        const describe = () =>
            boxes.forEach((g) => {
                const key = g.dataset.drag;
                if (!key) return;
                const inCloud = laneOf(key) === "c";
                g.setAttribute(
                    "aria-label",
                    `${NAMES[key]}, ${inCloud ? "in the cloud" : "on your machine"}. Press Enter to move it ${inCloud ? "to your machine" : "to the cloud"}.`,
                );
            });
        const target = (key: string, lane: "m" | "c") => {
            const fn = key === "fn" ? lane : laneOf("fn");
            const db = key === "db" ? lane : laneOf("db");
            return modes.find(
                (m) => laneOf("fn", m) === fn && laneOf("db", m) === db,
            )!;
        };

        const switchTo = (next: ModeData, from: ModeData) => {
            cancelAnimationFrame(frame);
            if (next !== current) {
                hint?.classList.add("is-hidden");
                headline.textContent = next.headline;
                sub.textContent = next.sub;
                done?.classList.toggle("is-hidden", !next.local);
                svg.setAttribute("aria-label", next.aria);
            }
            current = next;
            describe();
            fig.classList.add("is-switching");
            boxes.forEach((g, i) => {
                const s = next.slots[i]!;
                g.classList.toggle("is-ghost", !s.shown);
                if (s.label) g.querySelector("text")!.textContent = s.label;
                const rect = g.querySelector("rect")!;
                rect.setAttribute("x", String(-s.w / 2));
                rect.setAttribute("width", String(s.w));
            });
            if (reduced) {
                boxes.forEach((g, i) => place(g, next.slots[i]!));
                land(next);
                return;
            }
            // Glide: interpolate every slot and every route control point, so the
            // line bends with the boxes and lands exactly on the new route.
            const t0 = performance.now();
            const tick = (now: number) => {
                const k = ease(Math.min(1, (now - t0) / MOVE_MS));
                boxes.forEach((g, i) => {
                    const f = from.slots[i]!;
                    const s = next.slots[i]!;
                    place(g, s, f.x + (s.x - f.x) * k, f.y + (s.y - f.y) * k);
                });
                path.setAttribute(
                    "d",
                    draw(
                        from.segs.map((seg, si) =>
                            seg.map(
                                (n, ni) => n + (next.segs[si]![ni]! - n) * k,
                            ),
                        ),
                    ),
                );
                if (k < 1) frame = requestAnimationFrame(tick);
                else land(next);
            };
            frame = requestAnimationFrame(tick);
        };

        // Drag Lambda or DynamoDB across the network line. While dragging, the
        // box follows the pointer and the route bends to it; on release the
        // row settles into whichever setup the boxes now describe.
        const toSvg = (e: PointerEvent) => {
            const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(
                svg.getScreenCTM()!.inverse(),
            );
            return { x: pt.x, y: pt.y };
        };
        let drag: {
            g: SVGGElement;
            i: number;
            key: string;
            dx: number;
            dy: number;
            slots: Slot[];
        } | null = null;
        for (const g of boxes) {
            const key = g.dataset.drag;
            if (!key) continue;
            const i = boxes.indexOf(g);
            g.addEventListener("pointerdown", (e) => {
                if (e.button !== 0) return;
                cancelAnimationFrame(frame);
                const s = current.slots[i]!;
                const p = toSvg(e);
                drag = {
                    g, i, key,
                    dx: p.x - s.x,
                    dy: p.y - s.y,
                    slots: current.slots.map((x) => ({ ...x })),
                };
                g.setPointerCapture(e.pointerId);
                fig.classList.add("is-switching", "is-dragging");
                hint?.classList.add("is-hidden");
                e.preventDefault();
            });
            g.addEventListener("pointermove", (e) => {
                if (!drag || drag.g !== g) return;
                const p = toSvg(e);
                const s = drag.slots[i]!;
                const home = current.slots[i]!;
                // Free vertically between the lanes, a little give sideways.
                s.y = Math.max(40, Math.min(130, p.y - drag.dy));
                s.x = home.x + Math.max(-24, Math.min(24, p.x - drag.dx - home.x));
                place(g, s);
                path.setAttribute("d", draw(segsFor(drag.slots)));
                g.classList.toggle("is-over", (s.y > NET_Y) !== (laneOf(key) === "c"));
            });
            const drop = () => {
                if (!drag || drag.g !== g) return;
                const s = drag.slots[i]!;
                const from = { ...current, slots: drag.slots, segs: segsFor(drag.slots) };
                drag = null;
                g.classList.remove("is-over");
                fig.classList.remove("is-dragging");
                switchTo(target(key, s.y > NET_Y ? "c" : "m"), from);
            };
            g.addEventListener("pointerup", drop);
            g.addEventListener("pointercancel", drop);
            g.addEventListener("keydown", (e) => {
                if (e.key !== "Enter" && e.key !== " ") return;
                e.preventDefault();
                switchTo(target(key, laneOf(key) === "c" ? "m" : "c"), current);
            });
        }
        describe();
    }
</script>

<script>
    import { play } from "cuelume";

    // Resources you can't move (anything but Alchemy's Lambda and DynamoDB)
    // give a little under the pointer, then snap back with a red flash and
    // cuelume's error sound. The first node (browser / edit) and deploy steps
    // aren't resources, so they're left alone.
    const GIVE = 7; // max offset in SVG units
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    for (const svg of document.querySelectorAll<SVGSVGElement>(".dg-trace svg")) {
        svg.addEventListener("pointerdown", (e) => {
            const g = (e.target as Element).closest<SVGGElement>(
                ".dg-hop:not([data-drag]):not(.is-ghost):not(.is-boundary):not([data-hop='0'])",
            );
            if (!g || e.button !== 0) return;
            const toSvg = (ev: PointerEvent) =>
                new DOMPoint(ev.clientX, ev.clientY).matrixTransform(
                    svg.getScreenCTM()!.inverse(),
                );
            const start = toSvg(e);
            const base = g.style.transform;
            let moved = false;
            g.classList.remove("is-snapping");
            g.setPointerCapture(e.pointerId);
            // Resists harder the further you pull, never past GIVE.
            const give = (d: number) => GIVE * Math.tanh(d / (GIVE * 3));
            const move = (ev: PointerEvent) => {
                const p = toSvg(ev);
                const dx = p.x - start.x;
                const dy = p.y - start.y;
                if (Math.hypot(dx, dy) > 3) moved = true;
                if (!reduced) {
                    g.style.transform = `${base} translate(${give(dx)}px, ${give(dy)}px)`;
                }
            };
            const end = (ev: PointerEvent) => {
                g.removeEventListener("pointermove", move);
                g.removeEventListener("pointerup", end);
                g.removeEventListener("pointercancel", end);
                g.classList.add("is-snapping");
                g.style.transform = base;
                if (moved && ev.type === "pointerup") {
                    g.classList.remove("is-refused");
                    void g.getBoundingClientRect(); // restart the flash
                    g.classList.add("is-refused");
                    play("error");
                }
            };
            g.addEventListener("pointermove", move);
            g.addEventListener("pointerup", end);
            g.addEventListener("pointercancel", end);
            e.preventDefault();
        });
        svg.addEventListener("animationend", (e) => {
            (e.target as Element).closest(".dg-hop")?.classList.remove("is-refused");
        });
        svg.addEventListener("transitionend", (e) => {
            if (e.propertyName === "transform") {
                (e.target as Element).classList.remove("is-snapping");
            }
        });
    }
</script>

