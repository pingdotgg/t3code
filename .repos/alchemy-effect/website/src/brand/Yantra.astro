---
import { yantraSvg, type YantraOptions } from "./yantra";

interface Props extends Omit<YantraOptions, "output"> {
  class?: string;
}

const { size = 42, theme = "auto", class: className } = Astro.props;
const svg = yantraSvg({ size, theme });
---

<span class={className} aria-hidden="true" set:html={svg} />
