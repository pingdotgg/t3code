---
import { YANTRA_THEMES, yantraSvg } from "./yantra";

interface Props {
  size?: number;
  stroke?: string;
  dot?: string;
  bg?: string;
  strokeWidth?: number;
  /** Inherit color from surrounding text (default true for inline use). */
  useCurrentColor?: boolean;
  class?: string;
}

const {
  size = 42,
  stroke,
  dot,
  bg,
  strokeWidth,
  useCurrentColor = true,
  class: className,
} = Astro.props;

// Theme-aware bindu, defined per theme in tokens.css. The fallback covers
// use outside the website, where the token isn't defined.
const resolvedDot = dot ?? `var(--alc-yantra-dot, ${YANTRA_THEMES.light.dot})`;

const svg = yantraSvg({
  size,
  stroke,
  dot: resolvedDot,
  bg,
  strokeWidth,
  useCurrentColor,
});
---

<span class={className} aria-hidden="true" set:html={svg} />
