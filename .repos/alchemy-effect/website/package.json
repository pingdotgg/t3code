{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "build:reference": "node ../scripts/generate-api-reference.ts",
    "build:llms": "bun scripts/generate-llms-txt.ts",
    "docs:generate": "bun run build:reference && bun run build:llms",
    "docs:build": "bun run build",
    "docs:check": "bun run docs:generate && DOCS_FAST=1 astro build",
    "generate:readme-hero": "bun scripts/generate-readme-hero.ts",
    "generate:patterns": "bun scripts/generate-yantra-patterns.ts",
    "generate:backfill-charts": "bun scripts/generate-backfill-charts.ts",
    "build": "bun scripts/generate-brand-assets.ts && bun run build:reference && bun run build:llms && astro build",
    "dev:site": "API_REFERENCE_COPY_MARKERS=1 bun run build:reference && astro dev",
    "deploy": "alchemy deploy",
    "dev": "alchemy dev",
    "destroy": "alchemy destroy",
    "preview": "astro preview"
  },
  "dependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/cloudflare": "workspace:*",
    "@alchemy.run/docker": "workspace:*",
    "@alchemy.run/domain": "workspace:*",
    "@alchemy.run/gcp": "workspace:*",
    "@alchemy.run/github": "workspace:*",
    "@alchemy.run/kubernetes": "workspace:*",
    "@alchemy.run/redis": "workspace:*",
    "@alchemy.run/sql": "workspace:*",
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@astrojs/react": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@astrojs/starlight": "catalog:",
    "@astrojs/starlight-tailwind": "catalog:",
    "@effect/platform-node": "catalog:",
    "@fontsource-variable/caveat": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/source-serif-4": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify/react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "alchemy": "workspace:*",
    "astro": "catalog:",
    "cuelume": "catalog:",
    "effect": "catalog:",
    "marked": "^17.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "satteri": "catalog:",
    "starlight-blog": "catalog:",
    "tailwindcss": "catalog:",
    "takumi-js": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
