{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "build:reference": "bun ../scripts/generate-api-reference.ts",
    "build:llms": "bun scripts/generate-llms-txt.ts",
    "docs:generate": "bun run build:reference && bun run build:llms",
    "docs:build": "bun run build",
    "docs:check": "bun run build:reference && DOCS_FAST=1 astro build",
    "generate:readme-hero": "bun scripts/generate-readme-hero.ts",
    "build": "bun scripts/generate-brand-assets.ts && bun run build:reference && bun run build:llms && astro build",
    "dev:site": "astro dev",
    "deploy": "alchemy deploy",
    "dev": "alchemy dev",
    "destroy": "alchemy destroy",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "0.42.0",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@effect/platform-node": "catalog:effect",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "catalog:frontend",
    "alchemy": "workspace:*",
    "astro": "catalog:frontend",
    "effect": "catalog:effect",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "satteri": "^0.10.5",
    "starlight-blog": "^0.29.0",
    "tailwindcss": "catalog:frontend",
    "takumi-js": "^2.13.5",
    "yaml": "catalog:shared"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.94",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "typescript": "catalog:build"
  }
}
