{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "vinext/types", "@cloudflare/workers-types"]
  },
  "include": ["alchemy.run.ts", "vite.config.ts", "proxy.ts", "app", "worker", "src", "test"],
  "references": [
    {
      "path": "../../packages/alchemy"
    }
  ]
}
