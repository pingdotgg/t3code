{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.jsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
