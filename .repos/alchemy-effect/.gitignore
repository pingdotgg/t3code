# Emitted by `prisma contract emit` (the example's prepare script).
examples/prisma-tanstack-start/src/prisma/contract.json
# Emitted Prisma ORM v8 contract types: imported by the fixtures/example that
# consume them, so a clean checkout must typecheck without running a deploy.
!examples/cloudflare-neon-prisma/src/prisma/generated/contract.d.ts
!packages/integration-tests/test/Cloudflare/Workers/fixtures/prisma-orm/generated/contract.d.ts
!packages/integration-tests/test/Prisma/ORM/fixtures/client/generated/contract.d.ts
# drizzle-kit's generated durable-sqlite migrations bundle (checked-in test fixture)
!packages/integration-tests/test/Cloudflare/Workers/fixtures/drizzle-do/drizzle/migrations.js
# Container image contexts COPY these into the image; without the negation
# a fresh checkout has an empty build context and the container never boots.
!packages/integration-tests/test/Cloudflare/Container/fixtures/**/*.js
*.map

