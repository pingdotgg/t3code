# First-class sibling repositories we maintain.
#
# Distilled is part of the TypeScript workspace and is initialized by
# `git submodule update --init`. Floci is a large Java tree used only to
# build the local AWS emulator, so it is skipped unless requested:
# `git submodule update --init --checkout -- submodules/floci`.
[submodule "distilled"]
	path = submodules/distilled
	url = https://github.com/alchemy-run/distilled.git
[submodule "floci"]
	path = submodules/floci
	url = https://github.com/alchemy-run/floci.git
	shallow = true
	update = none
	ignore = all
