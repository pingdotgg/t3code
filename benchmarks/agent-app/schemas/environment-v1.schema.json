              "description": "a value greater than 0"
            }
          ]
        },
        {
          "type": "string",
          "enum": ["Infinity", "-Infinity", "NaN"]
        }
      ]
    },
    "displayScale": {
      "anyOf": [
        {
          "type": "number",
          "allOf": [
            {
              "description": "a finite number"
            },
            {
              "exclusiveMinimum": 0,
