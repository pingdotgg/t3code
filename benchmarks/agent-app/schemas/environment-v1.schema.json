        },
        {
          "minLength": 1,
          "description": "a value with a length of at least 1"
        },
        {
          "maxLength": 256,
          "description": "a value with a length of at most 256"
        }
      ]
    },
    "architecture": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
