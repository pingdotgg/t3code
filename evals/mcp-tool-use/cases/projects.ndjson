{"id": "title-only-project-creation-side-effects", "area": "projects", "kind": "guard", "pattern": "describe scaffold writes and the initial commit before approval", "experience": "The shortened project-create description omitted the README, icon and initial-commit effects of title-only creation.", "source": {"pullRequest": "https://github.com/pingdotgg/t3code/pull/23531", "reviewComment": "https://github.com/pingdotgg/t3code/pull/23531#discussion_r4415614078"}, "privacy": "commit-safe", "setup": {"role": "top", "context": "Explain the current tool behavior from its description. This is a preview of a proposed creation, not approval to execute it."}, "prompt": "I plan to call t3_project_create with title Docs and no workspaceRoot. Before I approve it, tell me which files and Git operations it creates. Do not create anything yet.", "expect": {"textMust": ["README\\.md", "assets/icon\\.svg", "([Ii]nitial commit|[Cc]ommit attempt|[Aa]ttempt.{0,50}commit|[Tt]ries?.{0,50}commit)"], "notCalls": ["t3_project_create", "t3_project_update", "t3_project_clone", "t3_project_delete"]}, "maxSteps": 8}
