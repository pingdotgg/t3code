{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "FORMA_LOG_WS_EVENTS",
    "FORMA_MODE",
    "FORMA_DESKTOP_DEV",
    "FORMA_PORT",
    "FORMA_NO_BROWSER",
    "FORMA_HOME",
    "FORMA_AUTH_TOKEN",
    "FORMA_DESKTOP_WS_URL",
    "FORMA_TRACE_MIN_LEVEL",
    "FORMA_TRACE_TIMING_ENABLED",
    "FORMA_TRACE_FILE",
    "FORMA_TRACE_MAX_BYTES",
    "FORMA_TRACE_MAX_FILES",
    "FORMA_TRACE_BATCH_WINDOW_MS",
    "FORMA_OTLP_TRACES_URL",
    "FORMA_OTLP_METRICS_URL",
    "FORMA_OTLP_EXPORT_INTERVAL_MS",
    "FORMA_OTLP_SERVICE_NAME"
  ],
  "globalPassThroughEnv": ["PATHEXT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["@forma/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    }
  }
}
