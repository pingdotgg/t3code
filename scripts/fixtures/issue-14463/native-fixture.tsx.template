function ansi(cols: number, rows: number, normal: boolean) {
  if (normal) return '\x1b[?1049l\x1b[0m\x1b[2J\x1b[H' + Array.from({length:60},(_,i)=>`ROW ${String(i+1).padStart(3,'0')} | ${'0123456789'.repeat(12)}\r\n`).join('') + 'CURSOR> \x1b[?25h\x1b[?12l';
  const width = Math.max(4,cols), height=Math.max(7,rows);
  let out='\x1b[?1049h\x1b[0m\x1b[2J\x1b[H';
  for(let row=0;row<height;row++) {
    const inner=row===0||row===height-1?'-'.repeat(width-2):
      (row===1?`Shared terminal ${width} columns x ${height} rows`:row===2?'Every border must be visible':row===3?'0123456789'.repeat(40):row===height-2?'BOTTOM EDGE':'').slice(0,width-2).padEnd(width-2);
    out+=`\x1b[${row+1};1H${row===0||row===height-1?'+':'|'}${inner}${row===0||row===height-1?'+':'|'}`;
  }
  return out+'\x1b[6;4H\x1b[?25h\x1b[?12l';
}
